# ============================================================
# IAHub — Configuracao de Ambiente
# Copie este arquivo para .env e preencha os valores abaixo
# ============================================================

# --- Inteligencia Artificial ---

# Chave da API do Groq (obtenha gratis em https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave da API do Google Gemini (fallback quando Groq atinge limite)
# Obtenha em https://aistudio.google.com
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Acesso ao Sistema ---

# Usuario e senha do administrador
ADMIN_USER=admin
ADMIN_PASS=iahub@2024

# Segredo para criptografia de sessao (mude para uma string aleatoria longa)
SESSION_SECRET=mude-para-uma-chave-secreta-aleatoria-longa

# --- IA Hub Shell / Sistemas ---

# Recrutamento exige sessao valida emitida pelo IA Hub Shell
IA_HUB_AUTH_REQUIRED=true

# Quando false, bloqueia acesso direto ao Recrutamento sem sessao/sistema selecionado
ALLOW_STANDALONE_ACCESS=false

# URL publica do Shell usada em redirecionamentos de seguranca
IA_HUB_SHELL_URL=https://iahub.com.br

# --- IA Command / Tokens internos servidor-a-servidor ---
# Segredos compartilhados usados para autenticar chamadas que nao tem sessao de
# usuario do IAHub (Windows Service do WhatsApp, agente local, canal Protheus).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Autentica o Windows Service do WhatsApp ao publicar eventos (header X-Worker-Token)
IAC_HUB_INTERNAL_TOKEN=

# Autentica a rotina ADVPL do Protheus ao solicitar token de sessao do chat
# (header X-Protheus-Secret em POST /api/ia-command/protheus/token).
# Sem esta variavel definida, o endpoint fica aberto — nao deixar vazio em producao.
IAC_PROTHEUS_CHAT_SECRET=

# --- Alertas operacionais (Telegram) ---
# Notifica quando o WhatsApp cai e reconexao automatica nao resolve (LOGOUT ou limite de
# tentativas esgotado). Nao depende de QR/sessao do WhatsApp, por isso funciona mesmo com
# o canal principal fora do ar. Deixar em branco desativa o alerta (falha silenciosa).
# Criacao do bot: fale com @BotFather no Telegram, /newbot, copie o token gerado.
IAC_TELEGRAM_BOT_TOKEN=
# chat_id de quem deve receber o alerta — inicie uma conversa com o bot e consulte
# https://api.telegram.org/bot<TOKEN>/getUpdates para descobrir o chat_id.
IAC_TELEGRAM_ALERT_CHAT_ID=

# --- Servidor ---

# Porta em que o Node.js vai rodar (padrao: 3000)
# PORT=3000

# Caminho do Chrome instalado (obrigatorio em Windows Server)
# O script 2-configurar-servico.ps1 adiciona esta linha automaticamente
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
