# ── Banco de dados ERP (SQL Server / Protheus) ────────────────────────────────
DB_HOST=192.168.1.100
DB_PORT=1433
DB_NAME=PROTHEUS
DB_USER=sa
DB_PASS=sua_senha_aqui
DB_DRIVER=ODBC Driver 17 for SQL Server
FILIAL=01

# ── API ───────────────────────────────────────────────────────────────────────
# Porta onde o agente vai escutar (padrão: 8765)
API_PORT=8765

# Token de autenticação compartilhado com a nuvem IA Command
# Gere pelo painel admin ou execute: python -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=

# ── Painel administrativo ─────────────────────────────────────────────────────
# Hash bcrypt da senha de acesso ao painel (gerado automaticamente no primeiro login)
ADMIN_HASH=

# Chave de sessão HTTP (gerada automaticamente se vazia)
SESSION_SECRET=
