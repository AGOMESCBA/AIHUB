<script>
  const impState = { rows: [], sortField: 'periodoInicio', sortDir: 'desc' };
  function showError(msg) { const el = document.getElementById('error-banner'); el.textContent = msg; el.style.display = 'block'; }
  function hideError() { document.getElementById('error-banner').style.display = 'none'; }
  function escapeHtml(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c])); }
  async function api(path, opts = {}) {
    const r = await fetch(path, { headers: { 'Content-Type': 'application/json' }, ...opts });
    const body = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(body.error || `Erro ${r.status}`);
    return body;
  }
  function empresaIdAtual() { return window._iahubEmpresa?.id || null; }
  function dataParaYyyymmdd(dataIso) { return dataIso.replaceAll('-', ''); }
  function activateTab(id) {
    document.querySelectorAll('.tab-panel').forEach(el => el.classList.toggle('active', el.id === id));
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.tab === id));
  }
  document.querySelectorAll('.tab-btn').forEach(btn => btn.addEventListener('click', () => activateTab(btn.dataset.tab)));
  async function carregarResumo() {
    const empresaId = empresaIdAtual();
    const resumo = await api(`/api/ia-service/base-historica/resumo?empresa_id=${empresaId}`);
    document.getElementById('resumo-grid').innerHTML = `
      <div class="metric"><span>Clientes</span><strong>${resumo.clientes}</strong></div>
      <div class="metric"><span>Usuários</span><strong>${resumo.usuariosCliente}</strong></div>
      <div class="metric"><span>Técnicos</span><strong>${resumo.tecnicos}</strong></div>
      <div class="metric"><span>Chamados</span><strong>${resumo.chamados}</strong></div>
      <div class="metric"><span>Posicionamentos</span><strong>${resumo.posicionamentos}</strong></div>
      <div class="metric"><span>Aguard. indexação</span><strong>${resumo.chamadosAguardandoIndexacao}</strong></div>
    `;
  }
  // Busca as connection_key já cadastradas no Agente Local para popular um
  // <select> (evita o usuário digitar de cor e errar o nome — causa real de
  // fonte "configurada" mas a importação nunca funcionar). Se a rota falhar
  // (agente numa versão antiga sem /api/conexoes-listar, ou indisponível),
  // cai em silêncio para o campo de texto manual — nunca bloqueia a tela.
  let conexoesDoAgenteDisponiveis = [];
  async function carregarConexoesDoAgente() {
    const empresaId = empresaIdAtual();
    const selectEl = document.getElementById('fonte-key-select');
    const inputEl = document.getElementById('fonte-key');
    const hintEl = document.getElementById('fonte-key-hint');
    try {
      const conexoes = await api(`/api/ia-service/base-historica/agente-local/conexoes?empresa_id=${empresaId}`);
      if (!Array.isArray(conexoes) || !conexoes.length) throw new Error('nenhuma conexão cadastrada no agente');
      conexoesDoAgenteDisponiveis = conexoes;
      selectEl.innerHTML = '<option value="">Selecione…</option>' +
        conexoes.map(c => `<option value="${escapeHtml(c.connection_key)}">${escapeHtml(c.nome || c.connection_key)} (${escapeHtml(c.connection_key)})</option>`).join('') +
        '<option value="__manual__">Digitar manualmente…</option>';
      selectEl.style.display = 'block';
      inputEl.style.display = 'none';
      hintEl.textContent = 'Lista carregada do Agente Local — escolha a conexão já cadastrada lá.';
    } catch (err) {
      // Fallback: mantém o campo de texto manual, sem erro visível (não é
      // uma falha bloqueante, é só a ausência de uma conveniência).
      selectEl.style.display = 'none';
      inputEl.style.display = 'block';
      hintEl.textContent = 'Não foi possível listar as conexões do Agente Local — digite a connection_key manualmente.';
    }
  }
  function onFonteKeySelectChange() {
    const selectEl = document.getElementById('fonte-key-select');
    const inputEl = document.getElementById('fonte-key');
    if (selectEl.value === '__manual__') {
      selectEl.style.display = 'none';
      inputEl.style.display = 'block';
      inputEl.value = '';
      inputEl.focus();
      return;
    }
    inputEl.value = selectEl.value;
    const conexao = conexoesDoAgenteDisponiveis.find(c => c.connection_key === selectEl.value);
    if (conexao && !document.getElementById('fonte-nome').value) {
      document.getElementById('fonte-nome').value = conexao.nome || conexao.connection_key;
    }
  }
  async function carregarFontes() {
    const empresaId = empresaIdAtual();
    const fontes = await api(`/api/ia-service/base-historica/fontes?empresa_id=${empresaId}`);
    const lista = document.getElementById('fontes-lista');
    const select = document.getElementById('importar-fonte');
    if (!fontes.length) {
      lista.innerHTML = '<div class="empty-state">Nenhuma fonte cadastrada ainda.</div>';
      select.innerHTML = '<option value="">Nenhuma fonte disponível</option>';
      return;
    }
    // data-* attributes em vez de serializar nome/connectionKey dentro do
    // onclick inline — nome de fonte com aspas (ex. 'Softexpert - "ITSM"')
    // quebrava o HTML do atributo e travava TODOS os botões do card
    // silenciosamente (bug real encontrado em 2026-09: clique não fazia nada).
    lista.innerHTML = fontes.map(f => `
      <div class="fonte-card">
        <div class="fonte-card-nome">${escapeHtml(f.nome)}</div>
        <div class="fonte-card-meta">${escapeHtml(f.connectionKey)} · ${escapeHtml(f.sistemaOrigem)}</div>
        <div class="fonte-card-actions">
          <button class="btn btn-ghost" type="button" onclick="testarFonte('${f.id}')">Testar SELECT 1</button>
          <button class="btn btn-ghost fonte-btn-editar" type="button" data-id="${f.id}" data-nome="${escapeHtml(f.nome)}" data-key="${escapeHtml(f.connectionKey)}">Editar</button>
          <button class="btn btn-ghost fonte-btn-limpar" type="button" data-id="${f.id}" data-nome="${escapeHtml(f.nome)}">Limpar histórico</button>
          <button class="btn btn-ghost fonte-btn-excluir" type="button" data-id="${f.id}" data-nome="${escapeHtml(f.nome)}">Excluir</button>
        </div>
      </div>
    `).join('');
    lista.querySelectorAll('.fonte-btn-editar').forEach(btn => {
      btn.addEventListener('click', () => editarFonte(btn.dataset.id, btn.dataset.nome, btn.dataset.key));
    });
    lista.querySelectorAll('.fonte-btn-limpar').forEach(btn => {
      btn.addEventListener('click', () => limparHistoricoFonte(btn.dataset.id, btn.dataset.nome));
    });
    lista.querySelectorAll('.fonte-btn-excluir').forEach(btn => {
      btn.addEventListener('click', () => excluirFonte(btn.dataset.id, btn.dataset.nome));
    });
    select.innerHTML = fontes.map(f => `<option value="${f.id}">${escapeHtml(f.nome)}</option>`).join('');
  }
  // A fonte aqui é só uma REFERÊNCIA (connection_key) — a conexão real com
  // o SQL Server já precisa estar cadastrada manualmente no Agente Local sob
  // essa mesma chave (mesmo padrão do IA Command, ver connection-factory.js).
  // Nunca envia host/porta/usuário/senha — isso não existe mais nesta tela.
  // Digitar o connection_key manualmente (copiado da tela local do agente)
  // é decisão explícita do usuário — a rota que listaria as conexões do
  // agente (GET /api/conexoes) exige sessão de admin do agente, incompatível
  // com o Bearer Token já usado aqui (2026-09, avaliado e adiado).
  let fonteEmEdicaoId = null;
  async function salvarFonte() {
    hideError();
    const empresaId = empresaIdAtual();
    const dados = {
      nome: document.getElementById('fonte-nome').value,
      connectionKey: document.getElementById('fonte-key').value,
      sistemaOrigem: 'softexpert',
      adapter: 'SoftExpertSqlServerAdapter',
    };
    try {
      if (fonteEmEdicaoId) {
        await api(`/api/ia-service/base-historica/fontes/${fonteEmEdicaoId}?empresa_id=${empresaId}`, {
          method: 'PUT',
          body: JSON.stringify(dados),
        });
      } else {
        await api(`/api/ia-service/base-historica/fontes?empresa_id=${empresaId}`, {
          method: 'POST',
          body: JSON.stringify(dados),
        });
      }
      cancelarEdicaoFonte();
      carregarFontes();
    } catch (err) { showError(`Não foi possível ${fonteEmEdicaoId ? 'salvar a edição' : 'criar'} a fonte: ` + err.message); }
  }
  function editarFonte(fonteId, nome, connectionKey) {
    fonteEmEdicaoId = fonteId;
    document.getElementById('fonte-nome').value = nome;
    const selectEl = document.getElementById('fonte-key-select');
    const inputEl = document.getElementById('fonte-key');
    const existeNaLista = conexoesDoAgenteDisponiveis.some(c => c.connection_key === connectionKey);
    if (selectEl.style.display !== 'none' && existeNaLista) {
      selectEl.value = connectionKey;
      inputEl.value = connectionKey;
    } else if (selectEl.style.display !== 'none') {
      // Valor salvo não está (mais) na lista do agente — mostra o texto
      // manual pra não esconder um connection_key que pode estar errado
      // (exatamente o cenário que esta tela existe para evitar).
      selectEl.value = '__manual__';
      selectEl.style.display = 'none';
      inputEl.style.display = 'block';
      inputEl.value = connectionKey;
    } else {
      inputEl.value = connectionKey;
    }
    document.getElementById('fonte-form-btn').textContent = 'Salvar edição';
    document.getElementById('fonte-form-cancelar').style.display = 'inline-block';
    document.getElementById('fonte-nome').scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  function cancelarEdicaoFonte() {
    fonteEmEdicaoId = null;
    document.getElementById('fonte-nome').value = '';
    document.getElementById('fonte-key').value = '';
    const selectEl = document.getElementById('fonte-key-select');
    if (selectEl.options.length > 0) {
      selectEl.value = '';
      selectEl.style.display = 'block';
      document.getElementById('fonte-key').style.display = 'none';
    }
    document.getElementById('fonte-form-btn').textContent = 'Criar fonte';
    document.getElementById('fonte-form-cancelar').style.display = 'none';
  }
  async function testarFonte(fonteId) {
    hideError();
    const empresaId = empresaIdAtual();
    try {
      await api(`/api/ia-service/base-historica/fontes/${fonteId}/testar?empresa_id=${empresaId}`, { method: 'POST' });
      alert('SELECT 1 executado com sucesso via agente.');
    } catch (err) { showError('Teste da fonte falhou: ' + err.message); }
  }
  // Exclusão SEMPRE apaga em cascata (ON DELETE CASCADE) todo o histórico
  // de importações/chamados/posicionamentos já trazidos por esta fonte —
  // decisão explícita do usuário (2026-09): depois de importado, a fonte só
  // serve pra reimportar, sem valor de rastreabilidade. Aviso deixa isso
  // claro antes de confirmar.
  async function excluirFonte(fonteId, nome) {
    hideError();
    if (!confirm(`Excluir a fonte "${nome}"?\n\nISSO APAGA TAMBÉM todo o histórico de chamados e posicionamentos já importados por ela (as importações registradas na aba Importações também somem). Se quiser só corrigir o connection_key, use "Editar" em vez de excluir.`)) return;
    const empresaId = empresaIdAtual();
    try {
      await api(`/api/ia-service/base-historica/fontes/${fonteId}?empresa_id=${empresaId}`, { method: 'DELETE' });
      if (fonteEmEdicaoId === fonteId) cancelarEdicaoFonte();
      carregarFontes();
    } catch (err) { showError('Não foi possível excluir a fonte: ' + err.message); }
  }
  // "Reset" da fonte SEM excluí-la — mantém nome/connection_key (útil
  // depois de corrigir o cadastro via dropdown), apaga só as importações e,
  // em cascata, os chamados/posicionamentos que vieram delas. Se houver uma
  // importação EXECUTANDO no momento, ela pode falhar no meio (o processo em
  // background vai tentar atualizar um registro que sumiu) — decisão
  // explícita do usuário (2026-09): não bloquear por causa disso, o aviso já
  // deixa isso claro antes de confirmar.
  async function limparHistoricoFonte(fonteId, nome) {
    hideError();
    if (!confirm(`Limpar todo o histórico de importações da fonte "${nome}"?\n\nIsso apaga as importações registradas e, em cascata, os chamados/posicionamentos já trazidos por ela — a fonte continua cadastrada (nome/connection_key preservados) para reimportar depois. Se houver uma importação em andamento agora, ela pode falhar no meio.`)) return;
    const empresaId = empresaIdAtual();
    try {
      await api(`/api/ia-service/base-historica/fontes/${fonteId}/historico?empresa_id=${empresaId}`, { method: 'DELETE' });
      carregarResumo();
      carregarImportacoes();
    } catch (err) { showError('Não foi possível limpar o histórico da fonte: ' + err.message); }
  }
  async function iniciarImportacao() {
    hideError();
    const empresaId = empresaIdAtual();
    const fonteId = document.getElementById('importar-fonte').value;
    if (!fonteId) return showError('Cadastre e selecione uma fonte antes de importar.');
    try {
      await api(`/api/ia-service/base-historica/fontes/${fonteId}/importar?empresa_id=${empresaId}`, {
        method: 'POST',
        body: JSON.stringify({
          periodoInicio: dataParaYyyymmdd(document.getElementById('importar-inicio').value),
          periodoFim: dataParaYyyymmdd(document.getElementById('importar-fim').value),
        }),
      });
      carregarImportacoes();
    } catch (err) { showError('Não foi possível iniciar a importação: ' + err.message); }
  }
  async function sincronizarIncremental() {
    hideError();
    const empresaId = empresaIdAtual();
    const fonteId = document.getElementById('importar-fonte').value;
    if (!fonteId) return showError('Selecione uma fonte.');
    try {
      await api(`/api/ia-service/base-historica/fontes/${fonteId}/sincronizar-incremental?empresa_id=${empresaId}`, { method: 'POST', body: JSON.stringify({}) });
      carregarImportacoes();
    } catch (err) { showError('Não foi possível iniciar a sincronização: ' + err.message); }
  }
  function renderImportacoesTable() {
    const rows = [...impState.rows].sort((a, b) => {
      const dir = impState.sortDir === 'asc' ? 1 : -1;
      const av = String(a[impState.sortField] ?? '').toLowerCase();
      const bv = String(b[impState.sortField] ?? '').toLowerCase();
      return av.localeCompare(bv, 'pt-BR') * dir;
    });
    document.getElementById('importacoes-empty').style.display = rows.length ? 'none' : 'block';
    document.getElementById('importacoes-tbody').innerHTML = rows.map(i => `
      <tr>
        <td>${escapeHtml(i.tipo)}</td>
        <td><span class="status-badge ${i.status}">${escapeHtml(i.status)}</span></td>
        <td>${i.periodoInicio || '?'} a ${i.periodoFim || '?'}</td>
        <td>
          Lidos: ${i.registrosLidos} · Inseridos: ${i.registrosInseridos} · Atualizados: ${i.registrosAtualizados} ·
          Sem alteração: ${i.registrosIgnorados} · Erros: ${i.registrosErro}<br>
          Posicionamentos — Lidos: ${i.posicionamentosLidos} · Inseridos: ${i.posicionamentosInseridos} · Atualizados: ${i.posicionamentosAtualizados}
          ${i.mensagemErro ? `<br><span style="color:#991b1b">${escapeHtml(i.mensagemErro)}</span>` : ''}
          ${i.status === 'falhou' || i.status === 'interrompido' ? `<div style="margin-top:6px"><button class="btn btn-ghost" type="button" onclick="retomarImportacao('${i.fonteId}','${i.id}')">Retomar</button></div>` : ''}
        </td>
      </tr>
    `).join('');
  }
  async function carregarImportacoes() {
    const empresaId = empresaIdAtual();
    impState.rows = await api(`/api/ia-service/base-historica/importacoes?empresa_id=${empresaId}&limite=50`);
    renderImportacoesTable();
  }
  document.querySelectorAll('#tab-importacoes th.sortable').forEach(th => th.addEventListener('click', () => {
    const field = th.dataset.sort;
    if (impState.sortField === field) impState.sortDir = impState.sortDir === 'asc' ? 'desc' : 'asc';
    else { impState.sortField = field; impState.sortDir = 'asc'; }
    renderImportacoesTable();
  }));
  async function retomarImportacao(fonteId, importacaoId) {
    hideError();
    const empresaId = empresaIdAtual();
    try {
      await api(`/api/ia-service/base-historica/fontes/${fonteId}/importar/retomar/${importacaoId}?empresa_id=${empresaId}`, { method: 'POST' });
      carregarImportacoes();
    } catch (err) { showError('Não foi possível retomar a importação: ' + err.message); }
  }
  async function carregarTudo() {
    try {
      await Promise.all([carregarResumo(), carregarConexoesDoAgente(), carregarFontes(), carregarImportacoes()]);
    } catch (err) { showError('Falha ao carregar a página: ' + err.message); }
  }
  window._iahubAuthReady?.then(carregarTudo) ?? carregarTudo();
  setInterval(() => { carregarResumo(); carregarImportacoes(); }, 10000);
</script>
</body>
</html>
