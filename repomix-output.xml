<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Glossario de Conceitos Analiticos - IA Command</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    :root { --accent:#7c3aed; --accent-light:#a78bfa; --accent-glow:rgba(124,58,237,.1); }
    .sidebar-logo .logo-icon { background:#7c3aed !important; }
    .topbar-menu-btn { flex-shrink:0;background:none;border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;color:var(--text-md);transition:background var(--transition),color var(--transition); }
    .topbar-menu-btn:hover { background:var(--bg-hover);color:var(--text-hi); }
    .topbar-title { flex:1;min-width:0;font-weight:700; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:700;margin-bottom:3px; }
    .head-row { display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:12px; }
    .head-title { font-size:20px;font-weight:800;color:var(--text-hi);display:flex;align-items:baseline;gap:8px;line-height:1.2; }
    .head-count { font-size:12px;color:var(--text-lo);font-weight:500; }
    .head-actions { display:flex;align-items:center;gap:8px;flex-wrap:wrap; }
    .table-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden; }
    .table-wrap { height:calc(100vh - 210px);min-height:360px;overflow:auto;background:var(--bg-card); }
    .glossario-table { width:100%;min-width:1100px;border-collapse:separate;border-spacing:0;table-layout:fixed;font-size:13px; }
    .glossario-table thead th { position:sticky;top:0;z-index:2;background:var(--bg-card);border-bottom:1px solid var(--border);color:var(--text-lo);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:9px 10px;white-space:nowrap; }
    .glossario-table thead th.sortable { cursor:pointer;user-select:none; }
    .glossario-table thead th.sortable:hover { color:var(--accent);background:var(--bg-hover); }
    .glossario-table thead .filter-cell th { top:34px;padding:6px 10px;background:var(--bg-card); }
    .glossario-table thead input, .glossario-table thead select { width:100%;height:26px;border:1px solid var(--border);border-radius:5px;background:var(--bg-base);color:var(--text-hi);font-size:11px;padding:3px 6px;box-sizing:border-box; }
    .glossario-table tbody td { border-bottom:1px solid var(--border);color:var(--text-md);padding:10px;vertical-align:top;background:var(--bg-card); }
    .glossario-table tbody tr.data-row { cursor:pointer; }
    .glossario-table tbody tr.data-row:hover td { background:var(--bg-hover); }
    .glossario-table tbody tr.inativo td { opacity:.55; }
    .col-action { width:42px;text-align:center; }
    .col-termo { width:220px; }
    .col-dominio { width:180px; }
    .col-origem { width:130px; }
    .col-data { width:150px; }
    .col-status { width:100px; }
    .text-preview { display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;line-height:1.35;word-break:break-word; }
    .termo-label { color:var(--text-hi);font-weight:800; }
    .empty-state { height:320px;display:flex;align-items:center;justify-content:center;color:var(--text-lo);font-size:22px;font-weight:800; }
    .badge { display:inline-flex;align-items:center;justify-content:center;border-radius:99px;padding:2px 8px;font-size:11px;font-weight:800;white-space:nowrap; }
    .badge-ok { background:#dcfce7;color:#15803d; }
    .badge-warn { background:#fef3c7;color:#92400e; }
    .badge-blue { background:#dbeafe;color:#1d4ed8; }
    .badge-purple { background:#ede9fe;color:#6d28d9; }
    .badge-muted { background:var(--bg-base);color:var(--text-md);border:1px solid var(--border); }
    .icon-btn { width:28px;height:28px;border:none;background:transparent;border-radius:6px;color:var(--text-md);cursor:pointer;display:inline-flex;align-items:center;justify-content:center; }
    .icon-btn:hover { background:var(--bg-hover);color:var(--accent); }
    .detail-shell { display:none; }
    .detail-shell.open { display:block; }
    .editor-bar { display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;margin-bottom:12px;box-shadow:var(--shadow-sm); }
    .editor-title strong { display:block;color:var(--text-hi);font-size:16px; }
    .editor-title span { color:var(--text-lo);font-size:12px; }
    .editor-actions { display:flex;gap:8px; }
    .detail-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:18px; }
    .meta-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:14px; }
    .meta-item { background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px;min-width:0; }
    .meta-item span { display:block;font-size:11px;color:var(--text-lo);margin-bottom:4px;font-weight:700;text-transform:uppercase;letter-spacing:.04em; }
    .meta-item strong { display:block;color:var(--text-hi);font-size:13px;word-break:break-word; }
    .text-box { background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px;margin-bottom:14px; }
    .text-box label { display:block;font-size:11px;font-weight:800;color:var(--text-lo);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px; }
    .text-box textarea { width:100%;min-height:160px;resize:vertical;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-card);color:var(--text-hi);font-family:inherit;font-size:14px;line-height:1.55;padding:10px; box-sizing:border-box; }
    .text-box pre { margin:0;white-space:pre-wrap;word-break:break-word;font-family:inherit;font-size:14px;color:var(--text-hi);line-height:1.55; }
    .save-row { display:flex;justify-content:flex-end;gap:8px;margin-top:10px; }
    .save-hint { font-size:12px;color:var(--text-lo);margin-right:auto;align-self:center; }
    .help-drawer { position:fixed;top:0;right:0;bottom:0;width:min(520px,100vw);background:var(--bg-card);border-left:1px solid var(--border);z-index:510;transform:translateX(100%);transition:transform .24s;display:flex;flex-direction:column; }
    .help-drawer.open { transform:translateX(0); }
    .help-head { display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--border); }
    .help-body { padding:20px;overflow:auto;color:var(--text-md);font-size:13px;line-height:1.65; }
    .help-body h3 { color:var(--accent);font-size:12px;text-transform:uppercase;letter-spacing:.06em;margin:0 0 10px; }
    .modal-close { border:none;background:transparent;color:var(--text-lo);font-size:22px;line-height:1;cursor:pointer; }
    @media (max-width: 900px) {
      .head-row, .editor-bar { align-items:flex-start;flex-direction:column; }
      .head-actions { width:100%; }
      .table-wrap { height:calc(100vh - 300px); }
    }
  </style>
</head>
