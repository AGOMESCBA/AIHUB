<script>
  function esc(v) {
    return String(v ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }
  function pct(v) {
    return v === null || v === undefined ? '-' : `${(Number(v) * 100).toFixed(2)}%`;
  }
  function num(v) {
    return Number(v || 0).toLocaleString('pt-BR');
  }
  function score(v) {
    return v === null || v === undefined ? '-' : Number(v).toFixed(3);
  }
  function riscoBadge(row) {
    if (!row.com_candidato) return '<span class="badge badge-neutro">Sem amostra</span>';
    if (Number(row.precisao_template) >= 0.995 && row.com_candidato >= 30) return '<span class="badge badge-ok">Forte</span>';
    if (Number(row.precisao_template) >= 0.98 && row.com_candidato >= 10) return '<span class="badge badge-warn">Observar</span>';
    return '<span class="badge badge-fail">Risco</span>';
  }
  function paramsFiltros() {
    const p = new URLSearchParams();
    for (const [id, nome] of [['f-inicio','inicio'], ['f-fim','fim'], ['f-modulo','modulo'], ['f-fonte','fonte'], ['f-limit','limit']]) {
      const v = document.getElementById(id)?.value || '';
      if (v) p.set(nome, v);
    }
    return p.toString();
  }
  function setLoading(on) {
    document.getElementById('loading').classList.toggle('show', !!on);
  }
  function atualizarMetricas(resumo) {
    document.getElementById('m-total').textContent = num(resumo.total);
    document.getElementById('m-candidato').textContent = num(resumo.com_candidato);
    document.getElementById('m-precisao').textContent = pct(resumo.precisao_template);
    document.getElementById('m-match-total').textContent = pct(resumo.precisao_match_total);
    document.getElementById('m-mismatch').textContent = num(resumo.mismatch);
    document.getElementById('m-invalido').textContent = num(resumo.template_invalido);
  }
  function atualizarRecomendacao(rec) {
    const box = document.getElementById('recomendacao');
    const ok = rec?.status === 'recomendado';
    box.classList.toggle('ok', ok);
    box.classList.toggle('warn', !ok);
    document.getElementById('rec-title').textContent = ok ? 'Limiar recomendado para estudo' : 'Amostra insuficiente para recomendar limiar';
    document.getElementById('rec-desc').textContent = rec?.criterio || '-';
    document.getElementById('rec-value').textContent = ok ? score(rec.limiar) : '-';
  }
  function tabelaSimples(elId, rows, columns) {
    const el = document.getElementById(elId);
    if (!rows || !rows.length) {
      el.innerHTML = '<div class="empty">Sem dados para os filtros selecionados.</div>';
      return;
    }
    el.innerHTML = `<table class="data-table"><thead><tr>${columns.map(c => `<th class="${c.cls || ''}">${esc(c.title)}</th>`).join('')}</tr></thead><tbody>${
      rows.map(row => `<tr>${columns.map(c => `<td class="${c.cls || ''}">${c.render ? c.render(row) : esc(row[c.field])}</td>`).join('')}</tr>`).join('')
    }</tbody></table>`;
  }
  function render(payload) {
    document.getElementById('count').textContent = `${num(payload.amostra_lida)} registro(s)`;
    atualizarMetricas(payload.resumo || {});
    atualizarRecomendacao(payload.recomendacao || {});
    const colsBase = [
      { title: 'Grupo', field: 'label', render: r => `<strong>${esc(r.label)}</strong>` },
      { title: 'Amostra', cls: 'num', render: r => num(r.com_candidato) },
      { title: 'Precisao', cls: 'num', render: r => pct(r.precisao_template) },
      { title: 'Match total', cls: 'num', render: r => pct(r.precisao_match_total) },
      { title: 'Mismatch', cls: 'num', render: r => num(r.mismatch) },
      { title: 'Status', render: riscoBadge },
    ];
    tabelaSimples('tbl-faixas', payload.faixas || [], colsBase);
    tabelaSimples('tbl-modulos', payload.modulos || [], [
      { title: 'Modulo', field: 'label', render: r => `<strong>${esc(r.label)}</strong>` },
      { title: 'Total', cls: 'num', render: r => num(r.total) },
      { title: 'Cand.', cls: 'num', render: r => num(r.com_candidato) },
      { title: 'Precisao', cls: 'num', render: r => pct(r.precisao_template) },
      { title: 'Risco', render: riscoBadge },
    ]);
    tabelaSimples('tbl-fontes', payload.fontes || [], [
      { title: 'Fonte', field: 'label', render: r => `<strong>${esc(r.label)}</strong>` },
      { title: 'Total', cls: 'num', render: r => num(r.total) },
      { title: 'Cand.', cls: 'num', render: r => num(r.com_candidato) },
      { title: 'Precisao', cls: 'num', render: r => pct(r.precisao_template) },
      { title: 'Mismatch', cls: 'num', render: r => num(r.mismatch) },
    ]);
    tabelaSimples('tbl-classificacoes', payload.classificacoes || [], [
      { title: 'Classificacao', field: 'label', render: r => `<strong>${esc(r.label)}</strong>` },
      { title: 'Total', cls: 'num', render: r => num(r.total) },
      { title: 'Cand.', cls: 'num', render: r => num(r.com_candidato) },
      { title: 'Precisao', cls: 'num', render: r => pct(r.precisao_template) },
      { title: 'Mismatch', cls: 'num', render: r => num(r.mismatch) },
    ]);
    tabelaSimples('tbl-modulo-faixas', payload.modulo_faixas || [], [
      { title: 'Modulo', render: r => `<strong>${esc(r.module)}</strong>` },
      { title: 'Faixa', field: 'faixa' },
      { title: 'Amostra', cls: 'num', render: r => num(r.com_candidato) },
      { title: 'Precisao', cls: 'num', render: r => pct(r.precisao_template) },
      { title: 'Mismatch', cls: 'num', render: r => num(r.mismatch) },
      { title: 'Status', render: riscoBadge },
    ]);
  }
  async function carregar() {
    setLoading(true);
    try {
      const res = await fetch(`/api/ia-command/admin/nlsql-calibracao?${paramsFiltros()}`);
      const payload = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(payload.error || `Erro ${res.status}`);
      render(payload);
    } catch (err) {
      document.getElementById('count').textContent = 'erro ao carregar';
      alert(err.message || 'Nao foi possivel carregar a calibracao.');
    } finally {
      setLoading(false);
    }
  }
  async function atualizarClick() {
    const btn = document.getElementById('btn-atualizar');
    btn.disabled = true;
    const old = btn.textContent;
    btn.textContent = 'Atualizando...';
    try { await carregar(); } finally { btn.textContent = old; btn.disabled = false; }
  }
  window._iahubAuthReady?.then(carregar) ?? carregar();
</script>
</body>
</html>
