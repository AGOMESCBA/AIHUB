                  <div class="form-section-subtitle">Nome e descrição do módulo.</div>
                </div>
                <div class="form-section-body">
                  <div class="form-group">
                    <label class="form-label">Nome <span style="color:#dc2626">*</span></label>
                    <input type="text" id="f-nome" class="form-control" placeholder="ex: Faturamento">
                    <div class="form-hint">Nome que aparece no filtro e no formulário de intenção. Prefira nomes simples e diretos.</div>
                  </div>
                  <div class="form-group" style="margin-bottom:0">
                    <label class="form-label">Descrição</label>
                    <textarea id="f-descricao" class="form-control" rows="3" placeholder="Descreva o propósito deste módulo..."></textarea>
                    <div class="form-hint">Informação de apoio para a equipe de configuração.</div>
                  </div>
                </div>
              </section>
              <section class="form-section">
                <div class="form-section-header">
                  <div class="form-section-title">Aparência</div>
                  <div class="form-section-subtitle">Cor usada no badge da lista de intenções.</div>
                </div>
                <div class="form-section-body">
                  <div class="form-group" style="margin-bottom:0">
                    <label class="form-label">Cor do badge</label>
                    <div class="cor-wrap">
                      <div class="cor-preview" id="cor-preview" onclick="document.getElementById('f-cor-picker').click()"></div>
                      <input type="color" id="f-cor-picker" value="#7c3aed" oninput="sincronizarCor(this.value)">
                      <input type="text" id="f-cor" class="form-control" value="#7c3aed"
                        placeholder="#7c3aed" style="max-width:120px;font-family:monospace"
                        oninput="sincronizarCorTexto(this.value)">
                      <span style="font-size:12px;color:var(--text-lo)">Clique na bolinha ou digite o código hex</span>
                    </div>
                  </div>
                </div>
              </section>
            </main>
            <aside class="editor-side">
              <section class="form-section" style="position:sticky;top:56px">
                <div class="form-section-header">
                  <div class="form-section-title">Dados do Registro</div>
                </div>
                <div class="form-section-body">
                  <div class="reg-field">
                    <div class="reg-label">ID do Registro</div>
                    <input type="text" id="f-id" class="form-control" disabled placeholder="(gerado automaticamente)"
                      style="font-family:monospace;font-size:12px;color:var(--text-lo);background:var(--bg-hover)">
                  </div>
                  <div class="reg-field">
                    <div class="reg-label">ID da Empresa</div>
                    <input type="text" id="f-empresa-id" class="form-control" disabled
                      style="font-family:monospace;font-size:12px;color:var(--text-lo);background:var(--bg-hover)">
                  </div>
                  <div class="reg-field">
                    <div class="reg-label">Empresa</div>
                    <input type="text" id="f-empresa-nome" class="form-control" disabled
                      style="font-size:13px;color:var(--text-lo);background:var(--bg-hover)">
                  </div>
                  <div class="reg-field">
                    <div class="reg-label">Status</div>
                    <select id="f-ativo" class="form-control">
                      <option value="1">Ativo</option>
                      <option value="0">Inativo</option>
                    </select>
                  </div>
                  <p style="font-size:12px;color:var(--text-lo);line-height:1.5;margin-top:14px">
                    Após salvar, o ID é gerado automaticamente e não pode ser alterado.
                  </p>
                </div>
              </section>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/grid-group-panel.js?v=20260617-grid-guard-v2"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
  let table, gp;
  let _dados = [];
  let _filtrosVisiveis = false;
  let _quickFilterFn = null;
  let _editId = null;
  // ── Formulário inline ──────────────────────────────────────────────────────
  function abrirFormulario(id) {
    _editId = id || null;
    _resetForm();
    document.getElementById('form-title').textContent    = id ? 'Editar Módulo' : 'Novo Módulo';
    document.getElementById('form-subtitle').textContent = id ? 'Revise os campos e salve.' : 'Preencha os campos e salve.';
    document.getElementById('sec-lista').style.display = 'none';
    document.getElementById('sec-form').style.display  = '';
    if (id) _carregarForm(id);
    else if (window._iahubEmpresa) {
      document.getElementById('f-empresa-id').value   = window._iahubEmpresa.id;
      document.getElementById('f-empresa-nome').value = window._iahubEmpresa.nome;
    }
  }
  function fecharModal() {
    document.getElementById('sec-form').style.display  = 'none';
    document.getElementById('sec-lista').style.display = '';
    _editId = null;
  }
  function _resetForm() {
    document.getElementById('f-id').value           = '';
    document.getElementById('f-empresa-id').value   = '';
    document.getElementById('f-empresa-nome').value = '';
    document.getElementById('f-nome').value         = '';
    document.getElementById('f-descricao').value    = '';
    document.getElementById('f-ativo').value        = '1';
    document.getElementById('save-feedback').textContent = '';
    document.getElementById('save-feedback').className   = 'save-feedback';
    sincronizarCor('#7c3aed');
  }
  async function _carregarForm(id) {
    const row = await fetch(`/api/ia-command/admin/modulos/${id}`).then(r => r.json()).catch(() => null);
    if (!row) return;
    document.getElementById('f-id').value           = row.id;
    document.getElementById('f-empresa-id').value   = row.empresa_id;
    document.getElementById('f-empresa-nome').value = '—';
    document.getElementById('f-nome').value         = row.nome      || '';
    document.getElementById('f-descricao').value    = row.descricao || '';
    document.getElementById('f-ativo').value        = String(row.ativo ?? 1);
    sincronizarCor(row.cor || '#7c3aed');
    document.getElementById('form-title').textContent    = row.nome;
    document.getElementById('form-subtitle').textContent =
      `ID ${row.id.slice(0,8)}… · editado em ${row.atualizado_em?.slice(0,16).replace('T',' ') || '—'}`;
  }
  function sincronizarCor(val) {
    document.getElementById('f-cor').value = val;
    document.getElementById('f-cor-picker').value = val;
    document.getElementById('cor-preview').style.background = val;
  }
  function sincronizarCorTexto(val) {
    if (/^#[0-9a-fA-F]{6}$/.test(val)) {
      document.getElementById('f-cor-picker').value = val;
      document.getElementById('cor-preview').style.background = val;
    }
  }
  async function salvarModal() {
    const nome = document.getElementById('f-nome').value.trim();
    if (!nome) { _feedback('Campo Nome é obrigatório.', false); return; }
    const body = {
      nome,
      descricao: document.getElementById('f-descricao').value.trim() || null,
      cor:       document.getElementById('f-cor').value.trim() || '#7c3aed',
      ativo:     parseInt(document.getElementById('f-ativo').value),
    };
    const url    = _editId ? `/api/ia-command/admin/modulos/${_editId}` : '/api/ia-command/admin/modulos';
    const method = _editId ? 'PUT' : 'POST';
    const res    = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    if (!res.ok) {
      const e = await res.json().catch(() => ({}));
      _feedback(e.error || 'Erro ao salvar.', false);
      return;
    }
    const saved = await res.json();
    if (!_editId) _editId = saved.id;
    _feedback('Salvo com sucesso!', true);
    document.getElementById('form-title').textContent = saved.nome;
    setTimeout(() => { fecharModal(); carregar(); }, 700);
  }
  function _feedback(msg, ok) {
    const el = document.getElementById('save-feedback');
    el.textContent = msg;
    el.className   = 'save-feedback ' + (ok ? 'ok' : 'fail');
  }
  // ── Filtros ────────────────────────────────────────────────────────────────
  function toggleFiltros() {
    _filtrosVisiveis = !_filtrosVisiveis;
    document.getElementById('filter-area').style.display = _filtrosVisiveis ? '' : 'none';
    document.getElementById('btn-filtros').textContent   = _filtrosVisiveis ? '− Ocultar filtros' : '+ Mostrar filtros';
    if (_filtrosVisiveis && gp) setTimeout(() => gp.refresh(), 50);
  }
  function filtrar() {
    if (!table) return;
    if (_quickFilterFn) { table.removeFilter(_quickFilterFn); _quickFilterFn = null; }
    const b = document.getElementById('f-busca').value.trim().toLowerCase();
    const a = document.getElementById('f-ativo').value;
    if (b || a !== '') {
      _quickFilterFn = row => {
        if (a !== '' && String(row.ativo) !== a) return false;
        if (b && !(row.nome || '').toLowerCase().includes(b)) return false;
        return true;
      };
      table.addFilter(_quickFilterFn);
    }
    const ativos = [b, a].filter(Boolean).length;
    document.getElementById('filter-status').textContent =
      ativos ? `${ativos} filtro(s) ativo(s)` : 'Sem filtros ou agrupamentos ativos';
  }
  function limparFiltros() {
    document.getElementById('f-busca').value = '';
    document.getElementById('f-ativo').value = '';
    filtrar();
  }
  // ── CRUD ───────────────────────────────────────────────────────────────────
  async function excluir(id) {
    if (!confirm('Excluir este módulo?')) return;
    await fetch(`/api/ia-command/admin/modulos/${id}`, { method: 'DELETE' });
    carregar();
  }
  function esc(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  // ── Dados ──────────────────────────────────────────────────────────────────
  async function carregar() {
    _dados = await fetch('/api/ia-command/admin/modulos').then(r => r.json()).catch(() => []);
    if (table) { table.replaceData(_dados); return; }
    _criarTabela(_dados);
  }
  function _criarTabela(data) {
    gp = createGroupPanel({ chipsRowId:'gp-chips-row', dropZoneId:'dz', storageKey:'iac_admin_modulos_group', getTable:()=>table });
    table = new Tabulator('#tabela', {
      data, index:'id', layout:'fitColumns', movableColumns:true,
      height:'calc(100vh - 330px)', groupBy:gp.getActiveFields(), groupStartOpen:true,
      placeholder:'<div style="padding:40px;text-align:center;color:var(--text-lo)">Nenhum módulo cadastrado.</div>',
      columns:[
        { title:'#', field:'id', width:200, headerFilter:false, groupable:false,
          formatter:c=>`<span style="font-family:monospace;font-size:11px;color:var(--text-lo)">${c.getValue()?.slice(0,8)}…</span>` },
        { title:'Nome', field:'nome', minWidth:160, headerFilter:true,
          formatter:c=>{
            const row=c.getRow().getData(); const cor=row.cor||'#7c3aed';
            return `<span style="display:inline-flex;align-items:center;gap:7px"><span style="width:10px;height:10px;border-radius:50%;background:${esc(cor)};flex-shrink:0"></span><strong style="color:var(--text-hi)">${esc(c.getValue())}</strong></span>`;
          }},
        { title:'Descrição', field:'descricao', minWidth:200, headerFilter:true,
          formatter:c=>`<span style="color:var(--text-lo)">${esc(c.getValue()||'—')}</span>` },
        { title:'Status', field:'ativo', width:100,
          headerFilter:'select', headerFilterParams:{values:{'':'Todos','1':'Ativo','0':'Inativo'}},
          formatter:c=>c.getValue()?'<span class="badge-ativo">● Ativo</span>':'<span class="badge-inativo">○ Inativo</span>' },
        { title:'Criado em', field:'criado_em', width:150,
          formatter:c=>c.getValue()?.slice(0,16).replace('T',' ')||'' },
        { title:'Ações', field:'id', width:80, headerFilter:false, groupable:false, hozAlign:'right',
          formatter:cell=>{
            const id=cell.getValue();
            return `<button class="btn-icon" onclick="event.stopPropagation();abrirFormulario('${id}')" title="Editar">✏️</button>
                    <button class="btn-icon" onclick="event.stopPropagation();excluir('${id}')" title="Excluir" style="color:#dc2626">🗑</button>`;
          }},
      ],
      rowClick:(e,row)=>{ if(!e.target.closest('button')) abrirFormulario(row.getData().id); },
      dataFiltered:(_f,rows)=>{
        const total=_dados.length, qtd=rows?.length??total;
        document.getElementById('count').textContent = qtd===total?_label(qtd):`${qtd} de ${total} módulos`;
      },
    });
    gp.refresh(); gp.applyToTable();
    document.getElementById('count').textContent = _label(data.length);
  }
  function _label(n) { return n===1?'1 módulo':`${n} módulos`; }
  window._iahubAuthReady?.then(carregar) ?? carregar();
</script>
<div class="help-overlay" id="help-overlay" onclick="fecharAjuda()"></div>
<div class="help-drawer" id="help-drawer">
  <div class="help-drawer-header">
    <span class="help-drawer-title">Ajuda — Módulos de Intenção</span>
    <button class="help-drawer-close" onclick="fecharAjuda()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
  </div>
  <div class="help-drawer-body">
    <div class="help-section">
      <div class="help-section-title">O que são Módulos</div>
      <div class="help-item-desc">Módulos são categorias que agrupam intenções por área funcional. Ex: <em>Faturamento</em>, <em>Financeiro</em>, <em>Estoque</em>.</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Campos</div>
      <div class="help-item"><div class="help-item-label">Nome</div><div class="help-item-desc">Nome simples: <em>Faturamento</em>, <em>Compras</em>.</div></div>
      <div class="help-item"><div class="help-item-label">Cor</div><div class="help-item-desc">Cor do badge na lista de intenções.</div></div>
      <div class="help-item"><div class="help-item-label">Ativo</div><div class="help-item-desc">Módulos inativos não aparecem nos selects de intenção.</div></div>
    </div>
    <div class="help-tip">Cadastre os módulos antes de criar as intenções.</div>
  </div>
</div>
<script>
  function abrirAjuda() { document.getElementById('help-overlay').classList.add('open'); document.getElementById('help-drawer').classList.add('open'); }
  function fecharAjuda() { document.getElementById('help-overlay').classList.remove('open'); document.getElementById('help-drawer').classList.remove('open'); }
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (document.getElementById('sec-form').style.display !== 'none') fecharModal();
    else fecharAjuda();
  });
</script>
</body>
