    .quick-row { display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
    .filter-area { padding-top:12px;border-top:1px solid var(--border);margin-top:12px; }
    .filter-status { font-size:12px;color:var(--text-lo);flex:1; }
    .quick-row .form-control { height:36px;font-size:13px; }
    .quick-row input.form-control { flex:1;min-width:200px; }
    .quick-row select.form-control { width:auto;min-width:145px; }
    .gp-wrap { margin-top:10px; }
    .gp-chips-row { display:flex;align-items:center;gap:6px;flex-wrap:wrap;position:relative; }
    .gp-label { font-size:11px;color:var(--text-lo);white-space:nowrap; }
    .grid-toolbar { display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg-card); }
    .grid-title { font-size:13px;font-weight:600;color:var(--text-hi); }
    .grid-meta { font-size:12px;color:var(--text-lo);margin-top:1px; }
    .badge-ativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:#dcfce7;color:#15803d; }
    .badge-inativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:var(--bg-hover);color:var(--text-lo); }
    .btn-icon { background:none;border:none;cursor:pointer;padding:4px 6px;border-radius:5px;font-size:15px;transition:background .15s; }
    .btn-icon:hover { background:var(--bg-hover); }
    .tabulator { border:none !important;background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important;border-right:none !important;color:var(--text-lo) !important;font-size:11px !important;font-weight:700 !important;text-transform:uppercase;letter-spacing:.05em; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-base) !important;color:var(--text-hi) !important;border:1px solid var(--border) !important;border-radius:4px !important;font-size:11px !important;padding:3px 6px !important;width:100% !important; }
    .tabulator .tabulator-row { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important;cursor:pointer; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important;color:var(--text-md);font-size:13px;padding:10px 12px !important; }
    .tabulator .tabulator-row.tabulator-group { background:var(--bg-base) !important;border-bottom:1px solid var(--border) !important;font-size:12px !important;font-weight:700 !important;color:var(--text-lo) !important; }
    .tabulator .tabulator-placeholder { background:var(--bg-card) !important; }
    .save-feedback { font-size:13px;color:var(--text-lo); }
    .save-feedback.ok { color:#15803d; }
    .save-feedback.fail { color:#b91c1c; }
    .form-section { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden;margin-bottom:14px; }
    .form-section-header { padding:14px 16px;border-bottom:1px solid var(--border); }
    .form-section-title { font-size:13px;font-weight:800;color:var(--text-hi); }
    .form-section-subtitle { font-size:12px;color:var(--text-lo);margin-top:2px;line-height:1.45; }
    .form-section-body { padding:16px; }
    .form-row { display:grid;grid-template-columns:1fr 170px;gap:12px; }
    textarea.form-control { min-height:84px;resize:vertical;line-height:1.45; }
    .member-toolbar { display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px; }
    .member-toolbar .form-control { flex:1;min-width:220px;height:36px;font-size:13px; }
    .member-list { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-height:360px;overflow:auto;border:1px solid var(--border);border-radius:8px;background:var(--bg-base);padding:8px; }
    .member-item { display:flex;align-items:flex-start;gap:8px;border:1px solid var(--border);border-radius:8px;padding:9px;background:var(--bg-card);cursor:pointer;min-width:0; }
    .member-item:hover { border-color:var(--accent-light); }
    .member-item input { margin-top:2px;flex-shrink:0; }
    .member-name { display:block;color:var(--text-hi);font-weight:800;font-size:13px;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
    .member-num { display:block;color:var(--text-lo);font-size:12px;font-family:Consolas,'Courier New',monospace;margin-top:2px;word-break:break-all; }
    .empty { padding:28px 18px;text-align:center;color:var(--text-md);font-size:13px;line-height:1.6; }
    .editor-actionbar { display:flex;align-items:center;justify-content:space-between;gap:14px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:12px 14px;margin-bottom:14px; }
    .editor-actionbar-title { min-width:0;display:grid;gap:2px; }
    .editor-actionbar-title strong { color:var(--text-hi);font-size:15px;line-height:1.3; }
    .editor-actionbar-title span { color:var(--text-lo);font-size:12px;line-height:1.35; }
    .editor-actions { display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end; }
    .d-none { display:none !important; }
    @media (max-width: 860px) {
      .page-head, .editor-actionbar { align-items:flex-start;flex-direction:column; }
      .form-row, .member-list { grid-template-columns:1fr; }
      .editor-actions { justify-content:flex-start; }
    }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command &rsaquo;</span> Grupos WhatsApp</span>
    </div>
    <div class="page-content">
      <div id="sec-lista">
        <div class="page-head">
          <div>
            <div class="page-kicker">Configuracao</div>
            <div class="page-title">Grupos WhatsApp</div>
            <div class="page-subtitle">Grupos de numeros autorizados da empresa ativa para agendamentos e rotinas.</div>
          </div>
          <button class="btn btn-primary" type="button" onclick="abrirFormulario()">+ Novo Grupo</button>
        </div>
        <div class="quick-panel">
          <div class="quick-row">
            <button class="btn btn-ghost" id="btn-filtros" type="button" onclick="toggleFiltros()">+ Mostrar filtros</button>
            <span class="filter-status" id="filter-status">Sem filtros ou agrupamentos ativos</span>
          </div>
          <div class="filter-area" id="filter-area" style="display:none">
            <div class="quick-row" style="margin-bottom:10px">
              <input id="q-busca" type="text" class="form-control" placeholder="Buscar por nome ou descricao..." oninput="filtrar()">
              <select id="f-ativos" class="form-control" onchange="filtrar()">
                <option value="ativos">Ativos</option>
                <option value="todos">Todos</option>
                <option value="inativos">Inativos</option>
              </select>
              <button class="btn btn-ghost" type="button" onclick="limparFiltros()">Limpar</button>
            </div>
            <div class="gp-wrap">
              <div class="gp-chips-row" id="gp-chips-row"><span class="gp-label">Agrupar por:</span></div>
              <div id="dz"></div>
            </div>
          </div>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <div class="grid-toolbar">
            <div>
              <div class="grid-title">Grupos cadastrados</div>
              <div id="count" class="grid-meta"></div>
            </div>
          </div>
          <div id="tabela"></div>
        </div>
      </div>
      <div id="sec-form" style="display:none">
        <div class="editor-shell">
          <div class="editor-actionbar">
            <div class="editor-actionbar-title">
              <strong id="form-title">Novo Grupo</strong>
              <span id="form-subtitle">Um numero pode participar de varios grupos.</span>
            </div>
            <div class="editor-actions">
              <span class="save-feedback" id="save-feedback"></span>
              <button class="btn btn-ghost d-none" id="btn-inativar" type="button" onclick="inativarGrupo()">Inativar</button>
              <button class="btn btn-ghost" type="button" onclick="fecharFormulario()">← Voltar a lista</button>
              <button class="btn btn-primary" type="button" onclick="salvarGrupo()">Salvar</button>
            </div>
          </div>
          <main class="editor-main">
            <section class="form-section">
              <div class="form-section-header">
                <div class="form-section-title">Identificacao</div>
                <div class="form-section-subtitle">Nome interno, descricao e status do grupo na empresa ativa.</div>
              </div>
              <div class="form-section-body">
                <input type="hidden" id="f-id">
                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label">Nome <span style="color:#dc2626">*</span></label>
                    <input id="f-nome" class="form-control" placeholder="Ex: Diretoria">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Status</label>
                    <select id="f-ativo" class="form-control">
                      <option value="1">Ativo</option>
                      <option value="0">Inativo</option>
                    </select>
                  </div>
                </div>
                <div class="form-group" style="margin-bottom:0">
                  <label class="form-label">Descricao</label>
                  <textarea id="f-descricao" class="form-control" placeholder="Opcional"></textarea>
                </div>
              </div>
            </section>
            <section class="form-section">
              <div class="form-section-header">
                <div class="form-section-title">Membros</div>
                <div class="form-section-subtitle">A lista vem dos numeros autorizados da empresa ativa.</div>
              </div>
              <div class="form-section-body">
                <div class="member-toolbar">
                  <input id="q-membros" class="form-control" placeholder="Filtrar membros..." oninput="renderMembros()">
                  <button class="btn btn-ghost" type="button" onclick="marcarMembros(true)">Marcar todos</button>
                  <button class="btn btn-ghost" type="button" onclick="marcarMembros(false)">Limpar</button>
                </div>
                <div class="member-list" id="membros"></div>
              </div>
            </section>
          </main>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/grid-group-panel.js?v=20260617-grid-guard-v2"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
  let table, gp;
  let dados = [];
  let numeros = [];
  let editId = null;
  let selectedMembers = new Set();
  let filtrosVisiveis = false;
  let quickFilterFn = null;
  function esc(v) {
    return String(v ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  }
  async function api(url, opts = {}) {
    const res = await fetch(url, opts);
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Falha na requisicao.');
    return data;
  }
  function feedback(msg, ok) {
    const el = document.getElementById('save-feedback');
    el.textContent = msg || '';
    el.className = 'save-feedback' + (msg ? ' ' + (ok ? 'ok' : 'fail') : '');
  }
  function label(n) {
    return n === 1 ? '1 grupo' : `${n} grupos`;
  }
  function abrirFormulario(id) {
    editId = id || null;
    resetForm();
    document.getElementById('form-title').textContent = id ? 'Editar Grupo' : 'Novo Grupo';
    document.getElementById('form-subtitle').textContent = id ? 'Revise os membros e salve.' : 'Um numero pode participar de varios grupos.';
    document.getElementById('sec-lista').style.display = 'none';
    document.getElementById('sec-form').style.display = '';
    if (id) carregarForm(id);
    else renderMembros();
  }
  function fecharFormulario() {
    document.getElementById('sec-form').style.display = 'none';
    document.getElementById('sec-lista').style.display = '';
    editId = null;
    feedback('', true);
  }
  function resetForm() {
    document.getElementById('f-id').value = '';
    document.getElementById('f-nome').value = '';
    document.getElementById('f-descricao').value = '';
    document.getElementById('f-ativo').value = '1';
    document.getElementById('q-membros').value = '';
    selectedMembers = new Set();
    document.getElementById('btn-inativar').classList.add('d-none');
    feedback('', true);
  }
  async function carregarForm(id) {
    try {
      const grupo = await api(`/api/ia-command/admin/grupos-whatsapp/${encodeURIComponent(id)}`);
      editId = grupo.id;
      document.getElementById('f-id').value = grupo.id;
      document.getElementById('f-nome').value = grupo.nome || '';
      document.getElementById('f-descricao').value = grupo.descricao || '';
      document.getElementById('f-ativo').value = Number(grupo.ativo || 0) === 1 ? '1' : '0';
      document.getElementById('form-title').textContent = grupo.nome || 'Editar Grupo';
      document.getElementById('form-subtitle').textContent = `ID ${String(grupo.id).slice(0,8)}...`;
      selectedMembers = new Set((grupo.membros || []).filter(m => Number(m.numero_ativo || 0) === 1).map(m => String(m.numero_id)));
      document.getElementById('btn-inativar').classList.toggle('d-none', Number(grupo.ativo || 0) !== 1);
      renderMembros();
    } catch (err) {
      feedback(err.message || 'Falha ao carregar grupo.', false);
    }
  }
  function renderMembros() {
    const busca = document.getElementById('q-membros').value.trim().toLowerCase();
    const rows = numeros.filter(n => !busca || `${n.nome} ${n.numero}`.toLowerCase().includes(busca));
    const el = document.getElementById('membros');
    if (!rows.length) {
      el.innerHTML = '<div class="empty">Nenhum numero autorizado disponivel nesta empresa.</div>';
      return;
    }
    el.innerHTML = rows.map(n => `
      <label class="member-item">
        <input type="checkbox" value="${esc(n.id)}" ${selectedMembers.has(String(n.id)) ? 'checked' : ''} onchange="toggleMembro(this)">
        <span style="min-width:0">
          <span class="member-name">${esc(n.nome)}</span>
          <span class="member-num">${esc(n.numero)}</span>
        </span>
      </label>
    `).join('');
  }
  function toggleMembro(el) {
    if (el.checked) selectedMembers.add(String(el.value));
    else selectedMembers.delete(String(el.value));
  }
  function marcarMembros(marcar) {
    const busca = document.getElementById('q-membros').value.trim().toLowerCase();
    numeros
      .filter(n => !busca || `${n.nome} ${n.numero}`.toLowerCase().includes(busca))
      .forEach(n => marcar ? selectedMembers.add(String(n.id)) : selectedMembers.delete(String(n.id)));
    renderMembros();
  }
  async function salvarGrupo() {
    const nome = document.getElementById('f-nome').value.trim();
    if (!nome) return feedback('Campo Nome e obrigatorio.', false);
    try {
      const body = {
        nome,
        descricao: document.getElementById('f-descricao').value.trim() || null,
        ativo: document.getElementById('f-ativo').value === '1',
      };
      const grupo = editId
        ? await api(`/api/ia-command/admin/grupos-whatsapp/${encodeURIComponent(editId)}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) })
        : await api('/api/ia-command/admin/grupos-whatsapp', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
      await api(`/api/ia-command/admin/grupos-whatsapp/${encodeURIComponent(grupo.id)}/membros`, {
        method:'PUT',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ membros: [...selectedMembers] }),
      });
      feedback('Salvo com sucesso!', true);
      setTimeout(async () => {
        await carregar();
        fecharFormulario();
      }, 500);
    } catch (err) {
      feedback(err.message || 'Erro ao salvar.', false);
    }
  }
  async function inativarGrupo() {
    if (!editId) return;
    if (!confirm('Inativar este grupo? Agendamentos futuros deixarao de usar este grupo.')) return;
    try {
      await api(`/api/ia-command/admin/grupos-whatsapp/${encodeURIComponent(editId)}`, { method:'DELETE' });
      await carregar();
      fecharFormulario();
    } catch (err) {
      feedback(err.message || 'Falha ao inativar grupo.', false);
    }
  }
  async function excluir(id) {
    if (!confirm('Inativar este grupo?')) return;
    await api(`/api/ia-command/admin/grupos-whatsapp/${encodeURIComponent(id)}`, { method:'DELETE' });
    carregar();
  }
  function toggleFiltros() {
    filtrosVisiveis = !filtrosVisiveis;
    document.getElementById('filter-area').style.display = filtrosVisiveis ? '' : 'none';
    document.getElementById('btn-filtros').textContent = filtrosVisiveis ? '- Ocultar filtros' : '+ Mostrar filtros';
    if (filtrosVisiveis && gp) setTimeout(() => gp.refresh(), 50);
  }
  function filtrar() {
    if (!table) return;
    if (quickFilterFn) { table.removeFilter(quickFilterFn); quickFilterFn = null; }
    const busca = document.getElementById('q-busca').value.trim().toLowerCase();
    const modo = document.getElementById('f-ativos').value;
    quickFilterFn = row => {
      if (modo === 'ativos' && Number(row.ativo || 0) !== 1) return false;
      if (modo === 'inativos' && Number(row.ativo || 0) === 1) return false;
      if (!busca) return true;
      return `${row.nome || ''} ${row.descricao || ''}`.toLowerCase().includes(busca);
    };
    table.addFilter(quickFilterFn);
    const filtros = (busca ? 1 : 0) + (modo !== 'todos' ? 1 : 0);
    document.getElementById('filter-status').textContent = filtros ? `${filtros} filtro(s) ativo(s)` : 'Sem filtros ou agrupamentos ativos';
  }
  function limparFiltros() {
    document.getElementById('q-busca').value = '';
    document.getElementById('f-ativos').value = 'ativos';
    filtrar();
  }
  async function carregar() {
    [dados, numeros] = await Promise.all([
      api('/api/ia-command/admin/grupos-whatsapp?ativos=0'),
      api('/api/ia-command/admin/grupos-whatsapp/numeros-autorizados', { cache:'no-store' }),
    ]);
    if (table) {
      await table.replaceData(dados);
      filtrar();
      return;
    }
    criarTabela(dados);
    filtrar();
  }
  function criarTabela(data) {
    gp = createGroupPanel({ chipsRowId:'gp-chips-row', dropZoneId:'dz', storageKey:'iac_admin_grupos_whatsapp_group', getTable:()=>table });
    table = new Tabulator('#tabela', {
      data,
      index:'id',
      layout:'fitColumns',
      movableColumns:true,
      height:'calc(100vh - 330px)',
      groupBy:gp.getActiveFields(),
      groupStartOpen:true,
      placeholder:'<div style="padding:40px;text-align:center;color:var(--text-lo)">Nenhum grupo cadastrado.</div>',
      columns:[
        { title:'#', field:'id', width:200, headerFilter:false, groupable:false, formatter:c=>`<span style="font-family:monospace;font-size:11px;color:var(--text-lo)">${esc(String(c.getValue() || '').slice(0,8))}...</span>` },
        { title:'Nome', field:'nome', minWidth:210, headerFilter:true, formatter:c=>`<strong style="color:var(--text-hi)">${esc(c.getValue())}</strong>` },
        { title:'Descricao', field:'descricao', minWidth:240, headerFilter:true, formatter:c=>esc(c.getValue() || '-') },
        { title:'Membros', field:'membros_count', width:120, hozAlign:'right', headerFilter:false, formatter:c=>`${Number(c.getValue() || 0)} membro(s)` },
        { title:'Status', field:'ativo', width:110, headerFilter:false, formatter:c=>{
          const ativo = Number(c.getValue() || 0) === 1;
          return `<span class="${ativo ? 'badge-ativo' : 'badge-inativo'}">${ativo ? 'Ativo' : 'Inativo'}</span>`;
        }},
        { title:'Criado em', field:'criado_em', width:150, formatter:c=>c.getValue()?.slice(0,16).replace('T',' ') || '' },
        { title:'Acoes', field:'id', width:90, headerFilter:false, groupable:false, hozAlign:'right', formatter:cell=>{
          const id = cell.getValue();
          return `<button class="btn-icon" onclick="event.stopPropagation();abrirFormulario('${esc(id)}')" title="Editar">✏️</button>
                  <button class="btn-icon" onclick="event.stopPropagation();excluir('${esc(id)}')" title="Inativar" style="color:#dc2626">🗑</button>`;
        }},
      ],
      rowClick:(e,row)=>{ if(!e.target.closest('button')) abrirFormulario(row.getData().id); },
      dataFiltered:(_f, rows)=>{
        const total = dados.length;
        const qtd = rows?.length ?? total;
        document.getElementById('count').textContent = qtd === total ? label(qtd) : `${qtd} de ${total} grupos`;
      },
    });
    gp.refresh();
    gp.applyToTable();
    document.getElementById('count').textContent = label(data.length);
  }
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && document.getElementById('sec-form').style.display !== 'none') fecharFormulario();
  });
  window._iahubAuthReady?.then(carregar) ?? carregar();
</script>
</body>
</html>
</file>

<file path="apps/IA Command/frontend/admin-instalador-agente.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gerar Instalador — Agente Local — IA Command</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    :root { --accent:#7c3aed; --accent-light:#a78bfa; --accent-glow:rgba(124,58,237,.1); }
    .sidebar-logo .logo-icon { background:#7c3aed !important; }
    .topbar-menu-btn { flex-shrink:0;background:none;border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;color:var(--text-md);transition:background var(--transition),color var(--transition); }
    .topbar-menu-btn:hover { background:var(--bg-hover);color:var(--text-hi); }
    .topbar-title { flex:1;min-width:0;font-weight:700; }
    .page-head { display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:24px; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;margin-bottom:3px; }
    .page-title { font-size:20px;font-weight:700;color:var(--text-hi);line-height:1.25; }
    .page-subtitle { font-size:13px;color:var(--text-md);margin-top:4px; }
    /* Cards */
    .card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px 24px;margin-bottom:16px;box-shadow:var(--shadow-sm); }
    .card-title { font-size:13px;font-weight:700;color:var(--text-hi);margin-bottom:14px;display:flex;align-items:center;gap:8px; }
    .card-title span { font-size:16px; }
    /* Badge ISCC */
    .badge-ok    { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:600;background:#dcfce7;color:#15803d; }
    .badge-warn  { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:600;background:#fef9c3;color:#854d0e; }
    .badge-info  { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:600;background:var(--accent-glow);color:var(--accent); }
    /* Status row */
    .status-row { display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px; }
    .status-item { display:flex;flex-direction:column;gap:2px; }
    .status-label { font-size:11px;color:var(--text-lo);text-transform:uppercase;letter-spacing:.05em; }
    .status-val { font-size:13px;color:var(--text-md);font-family:ui-monospace,monospace; }
    /* Alerta ISCC */
    .alert-warn { display:flex;align-items:flex-start;gap:12px;padding:14px 16px;background:#fef9c3;border:1px solid #fde047;border-radius:var(--radius);font-size:13px;color:#854d0e;line-height:1.6;margin-bottom:16px; }
    .alert-warn strong { display:block;margin-bottom:4px; }
    .alert-warn code { background:rgba(0,0,0,.08);padding:1px 6px;border-radius:4px;font-size:12px; }
    .alert-warn a { color:#92400e;font-weight:600; }
    .alert-ok { display:flex;align-items:center;gap:12px;padding:12px 16px;background:#dcfce7;border:1px solid #86efac;border-radius:var(--radius);font-size:13px;color:#15803d;margin-bottom:16px; }
    /* Formulário */
    .form-row { display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap; }
    .form-row .form-group { flex:1;min-width:160px; }
    .form-row .form-group:last-child { flex:0 0 auto; }
    /* Barra de progresso */
    .progress-wrap { display:none;margin-top:16px; }
    .progress-wrap.show { display:block; }
    .progress-label { font-size:12px;font-weight:600;color:var(--text-md);margin-bottom:6px; }
    .progress-outer { height:10px;background:var(--bg-base);border-radius:99px;overflow:hidden;border:1px solid var(--border); }
    .progress-inner { height:100%;border-radius:99px;background:var(--accent);transition:width .3s ease; }
    /* Log */
    .log-box { margin-top:14px;background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 14px;font-family:ui-monospace,monospace;font-size:12px;color:var(--text-md);max-height:180px;overflow-y:auto;line-height:1.7;white-space:pre-wrap;display:none; }
    .log-box.show { display:block; }
    .log-ok   { color:#22c55e; }
    .log-warn { color:#f59e0b; }
    .log-err  { color:#ef4444; }
    /* Resultado download */
    .result-download { display:none;margin-top:16px;padding:14px 18px;background:#dcfce7;border:1px solid #86efac;border-radius:var(--radius);align-items:center;gap:14px; }
    .result-download.show { display:flex; }
    .result-download .rd-icon { font-size:24px; }
    .result-download .rd-info { flex:1; }
    .result-download .rd-name { font-size:13px;font-weight:700;color:#15803d; }
    .result-download .rd-size { font-size:12px;color:#16a34a;margin-top:2px; }
    .result-download .btn-dl  { flex-shrink:0; }
    /* Último gerado */
    .last-build { display:none;align-items:center;gap:12px;padding:12px 16px;background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius);font-size:13px; }
    .last-build.show { display:flex; }
    .last-build .lb-icon { font-size:20px; }
    .last-build .lb-info { flex:1;color:var(--text-md); }
    .last-build .lb-name { font-weight:600;color:var(--text-hi); }
    /* Inno Setup instructions */
    .inno-steps { list-style:none;padding:0;margin:10px 0 0;font-size:13px;color:var(--text-md);line-height:2; }
    .inno-steps li::before { content:'→ ';color:var(--accent); }
    .inno-steps a { color:var(--accent); }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">⚡</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title">
        <span style="color:var(--text-lo);font-weight:400">IA Command › Administração ›</span> Gerar Instalador Agente Local
      </span>
    </div>
    <div class="page-content">
      <div class="page-head">
        <div>
          <div class="page-kicker">Administração</div>
          <div class="page-title">Instalador do Agente Local</div>
          <div class="page-subtitle">Gera um programa instalador <strong>.exe</strong> (Inno Setup) ou <strong>.zip</strong> para distribuir o Agente Local aos clientes.</div>
        </div>
      </div>
      <div class="card" id="cardStatus">
        <div class="card-title"><span>🔍</span> Ambiente de Build</div>
        <div id="statusLoading" style="font-size:13px;color:var(--text-lo)">Verificando...</div>
        <div id="statusContent" style="display:none">
          <div class="status-row">
            <div class="status-item">
              <span class="status-label">Compilador</span>
              <span id="isccBadge"></span>
            </div>
            <div class="status-item" id="isccPathWrap" style="display:none">
              <span class="status-label">Caminho ISCC</span>
              <span class="status-val" id="isccPath"></span>
            </div>
            <div class="status-item">
              <span class="status-label">Pasta do Agente</span>
              <span class="status-val" id="agenteDir" style="font-size:11px"></span>
