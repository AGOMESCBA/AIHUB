<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Segurança — IAHub</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css">
  <style>
    .config-section { margin-bottom:28px; }
    .config-section-title {
      font-size:13px;font-weight:700;text-transform:uppercase;
      letter-spacing:.06em;color:var(--text-lo);margin-bottom:16px;
      padding-bottom:8px;border-bottom:1px solid var(--border);
    }
    .form-row   { display:grid;grid-template-columns:1fr 1fr;gap:16px; }
    .hint       { font-size:11px;color:var(--text-lo);margin-top:4px; }
    .save-bar   {
      position:sticky;bottom:0;background:var(--bg-card);
      border-top:1px solid var(--border);padding:14px 24px;
      display:flex;align-items:center;gap:12px;z-index:10;
    }
    .save-msg { font-size:13px;color:var(--success);display:none; }
    .tab-content { display:none; }
    .tab-content.active { display:block; }
    /* ── Filtros de auditoria ── */
    .audit-filters {
      display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-bottom:16px;
    }
    .audit-filters .form-group { margin:0;flex:1;min-width:140px; }
    .audit-filters .form-label { font-size:11px;margin-bottom:4px; }
    .audit-filters .form-control { font-size:12px;padding:6px 10px; }
    .acao-badge {
      display:inline-block;padding:2px 8px;border-radius:12px;
      font-size:11px;font-weight:600;
    }
    .acao-login_sucesso   { background:rgba(22,163,74,.12); color:var(--success); }
    .acao-login_falha     { background:rgba(239,68,68,.10); color:#dc2626; }
    .acao-login_bloqueado { background:rgba(239,68,68,.18); color:#dc2626; }
    .acao-logout          { background:var(--bg-hover);    color:var(--text-md); }
    .acao-empresa_selecionada { background:rgba(37,99,235,.1); color:var(--accent); }
    .acao-default         { background:var(--bg-hover);    color:var(--text-lo); }
    /* ── Group panel ── */
    .gp-chips-row { display:flex;align-items:center;gap:6px;flex-wrap:wrap;position:relative; }
    .gp-label     { font-size:11px;color:var(--text-lo);white-space:nowrap; }
    /* ── Tabulator overrides ── */
    .tabulator { border:none !important; background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important; border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important; border-right:none !important; color:var(--text-lo) !important; font-size:11px !important; font-weight:700 !important; text-transform:uppercase; letter-spacing:.05em; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-body) !important; color:var(--text-hi) !important; border:1px solid var(--border) !important; border-radius:4px !important; font-size:11px !important; padding:3px 6px !important; width:100% !important; }
    .tabulator .tabulator-row { background:var(--bg-card) !important; border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important; color:var(--text-md); font-size:13px; padding:10px 12px !important; }
    .tabulator .tabulator-row.tabulator-group { background:var(--bg-body) !important; border-bottom:1px solid var(--border) !important; font-size:12px !important; font-weight:700 !important; color:var(--text-lo) !important; }
    .tabulator .tabulator-placeholder { background:var(--bg-card) !important; }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IAHub</span>
    </div>
    <div class="sidebar-nav">
    </div>
    <div class="sidebar-footer">
    </div>
  </nav>
  <div class="main">
    <div class="topbar">
      <span class="topbar-title"><span class="topbar-path">Configurador › Administração ›</span> Segurança</span>
    </div>
    <div class="page-content" style="padding-bottom:0">
      <div class="card">
        <div class="tabs-header" style="padding:0 24px">
          <button class="tab-btn active" id="tab-btn-config"    onclick="mudarAba('config',    this)">Configurações de Segurança</button>
          <button class="tab-btn"        id="tab-btn-auditoria" onclick="mudarAba('auditoria', this)">Auditoria de Acessos</button>
        </div>
        <div class="tab-content active" id="tab-config">
          <div style="padding:24px 24px 0">
            <div class="config-section">
              <div class="config-section-title">Sessão</div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">Tempo máximo de sessão (horas)</label>
                  <input id="cfg-sessao" type="number" min="1" max="24" class="form-control" placeholder="8">
                  <div class="hint">Usuário será desconectado após este tempo de inatividade.</div>
                </div>
              </div>
            </div>
            <div class="config-section">
              <div class="config-section-title">Tentativas de Login</div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">Máximo de tentativas antes do bloqueio</label>
                  <input id="cfg-tentativas" type="number" min="1" max="20" class="form-control" placeholder="5">
                  <div class="hint">Após este número de falhas, o IP será bloqueado temporariamente.</div>
                </div>
                <div class="form-group">
                  <label class="form-label">Duração do bloqueio (minutos)</label>
                  <input id="cfg-bloqueio" type="number" min="1" max="1440" class="form-control" placeholder="15">
                  <div class="hint">Tempo que o IP ficará bloqueado após exceder as tentativas.</div>
                </div>
              </div>
            </div>
            <div class="config-section" style="margin-bottom:0">
              <div class="config-section-title">Política de Senha</div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">Nível mínimo de força</label>
                  <select id="cfg-senha" class="form-control">
                    <option value="basico">Básico — mín. 6 caracteres</option>
                    <option value="medio">Médio — mín. 8 chars + maiúscula + número</option>
                    <option value="forte">Forte — mín. 10 chars + maiúscula + número + especial</option>
                  </select>
                  <div class="hint">Aplica-se ao cadastro e alteração de senhas de usuários.</div>
                </div>
              </div>
            </div>
          </div>
          <div class="save-bar">
            <button class="btn btn-primary" id="btn-salvar" onclick="salvar()">Salvar Configurações</button>
            <span class="save-msg" id="save-msg">✓ Configurações salvas</span>
            <div id="save-error" class="login-error" style="display:none;margin:0"></div>
          </div>
        </div>
        <div class="tab-content" id="tab-auditoria">
          <div style="padding:20px 24px 0">
            <div class="audit-filters">
              <div class="form-group">
                <label class="form-label">Usuário</label>
                <input id="f-usuario" type="text" class="form-control" placeholder="Filtrar por usuário">
              </div>
              <div class="form-group">
                <label class="form-label">Ação</label>
                <select id="f-acao" class="form-control">
                  <option value="">Todas</option>
                  <option value="login_sucesso">Login com sucesso</option>
                  <option value="login_falha">Login com falha</option>
                  <option value="login_bloqueado">Login bloqueado</option>
                  <option value="logout">Logout</option>
                  <option value="empresa_selecionada">Empresa selecionada</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Data início</label>
                <input id="f-data-ini" type="date" class="form-control">
              </div>
              <div class="form-group">
                <label class="form-label">Data fim</label>
                <input id="f-data-fim" type="date" class="form-control">
              </div>
              <div class="form-group" style="min-width:auto">
                <label class="form-label" style="visibility:hidden">.</label>
                <button class="btn btn-secondary" onclick="carregarAuditoria()" style="white-space:nowrap">🔍 Filtrar</button>
              </div>
            </div>
            <div class="gp-chips-row" id="aud-gp-chips" style="margin-bottom:6px">
              <span class="gp-label">Agrupar:</span>
            </div>
            <div id="aud-gp-dz" style="margin-bottom:12px"></div>
          </div>
          <div id="audit-grid"></div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/sidebar.js"></script>
<script src="/js/grid-group-panel.js"></script>
<script>
  // ── Auditoria ────────────────────────────────────────────────────────────────
  let auditTable = null;
  let auditGp    = null;
  function initAuditGroupPanel() {
    auditGp = createGroupPanel({
      chipsRowId: 'aud-gp-chips',
      dropZoneId: 'aud-gp-dz',
      storageKey: 'auditoria_group_fields',
      getTable:   () => auditTable,
    });
  }
  function initAuditTabulator(dados) {
    auditTable = new Tabulator('#audit-grid', {
      data: dados,
      layout: 'fitColumns',
      height: 'calc(100vh - 360px)',
      groupStartOpen: true,
      groupBy: auditGp.getActiveFields(),
      initialSort: [{ column: 'ts', dir: 'desc' }],
      placeholder: '<div style="text-align:center;padding:40px;color:var(--text-lo);font-size:13px">Nenhum registro encontrado.</div>',
      columns: [
        {
          title: 'Data / Hora', field: 'ts', width: 165, headerFilter: false, sorter: 'string', groupable: false,
          formatter: cell => `<span style="font-size:12px;color:var(--text-md);white-space:nowrap">${new Date(cell.getValue()).toLocaleString('pt-BR')}</span>`,
        },
        {
          title: 'Usuário', field: 'usuario', minWidth: 120, headerFilter: true,
          formatter: cell => `<span style="font-weight:600;color:var(--text-hi)">${esc(cell.getValue())}</span>`,
        },
        {
          title: 'Ação', field: 'acao', minWidth: 160,
          headerFilter: 'select',
          headerFilterParams: {
            values: {
              '': 'Todas',
              login_sucesso: 'Login com sucesso',
              login_falha: 'Login com falha',
              login_bloqueado: 'Login bloqueado',
              logout: 'Logout',
              empresa_selecionada: 'Empresa selecionada',
            },
          },
          formatter: cell => {
            const v = cell.getValue() || '';
            return `<span class="acao-badge acao-${v}">${esc(v)}</span>`;
          },
        },
        {
          title: 'IP', field: 'ip', width: 140, headerFilter: true,
          formatter: cell => `<span style="font-family:monospace;font-size:12px">${esc(cell.getValue())}</span>`,
        },
        {
          title: 'Empresa', field: 'empresa_id', width: 90, headerFilter: false, groupable: false,
          formatter: cell => cell.getValue()
            ? `<span style="font-size:12px">#${cell.getValue()}</span>`
            : `<span style="color:var(--text-lo)">—</span>`,
        },
        {
          title: 'Detalhes', field: 'detalhes', headerFilter: true, groupable: false,
          formatter: cell => `<span style="font-size:12px;color:var(--text-md)">${esc(cell.getValue())}</span>`,
        },
      ],
    });
  }
  // ── Abas ─────────────────────────────────────────────────────────────────────
  function mudarAba(aba, btn) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + aba).classList.add('active');
    btn.classList.add('active');
    if (aba === 'auditoria') {
      if (!auditGp) initAuditGroupPanel();
      carregarAuditoria();
    }
  }
  // ── Configurações ─────────────────────────────────────────────────────────────
  async function carregarConfig() {
    try {
      const res = await fetch('/api/seguranca');
      const cfg = await res.json();
      document.getElementById('cfg-sessao').value     = cfg.sessao_timeout_horas;
      document.getElementById('cfg-tentativas').value = cfg.login_max_tentativas;
      document.getElementById('cfg-bloqueio').value   = cfg.login_bloqueio_min;
      document.getElementById('cfg-senha').value      = cfg.senha_nivel_minimo;
    } catch (_) {
      document.getElementById('save-error').textContent = 'Erro ao carregar configurações.';
      document.getElementById('save-error').style.display = 'block';
    }
  }
  async function salvar() {
    const errEl = document.getElementById('save-error');
    const msgEl = document.getElementById('save-msg');
    errEl.style.display = 'none';
    msgEl.style.display = 'none';
    const dados = {
      sessao_timeout_horas: document.getElementById('cfg-sessao').value,
      login_max_tentativas: document.getElementById('cfg-tentativas').value,
      login_bloqueio_min:   document.getElementById('cfg-bloqueio').value,
      senha_nivel_minimo:   document.getElementById('cfg-senha').value,
    };
    const btn = document.getElementById('btn-salvar');
    btn.textContent = 'Salvando...';
    btn.disabled    = true;
    try {
      const res = await fetch('/api/seguranca', {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(dados),
      });
      if (res.ok) {
        msgEl.style.display = 'inline';
        setTimeout(() => msgEl.style.display = 'none', 3000);
      } else {
        const err = await res.json().catch(() => ({}));
        errEl.textContent = err.error || 'Erro ao salvar.';
        errEl.style.display = 'block';
      }
    } finally {
      btn.textContent = 'Salvar Configurações';
      btn.disabled    = false;
    }
  }
  // ── Auditoria: carregar ───────────────────────────────────────────────────────
  async function carregarAuditoria() {
    const params = new URLSearchParams({
      limite:   200,
      usuario:  document.getElementById('f-usuario').value,
      acao:     document.getElementById('f-acao').value,
      data_ini: document.getElementById('f-data-ini').value,
      data_fim: document.getElementById('f-data-fim').value,
    });
    try {
      const res       = await fetch(`/api/seguranca/auditoria?${params}`);
      const registros = await res.json();
      if (auditTable) {
        auditTable.replaceData(registros);
      } else {
        initAuditTabulator(registros);
        setTimeout(() => auditGp.refresh(), 0);
      }
    } catch (_) {
      console.error('Erro ao carregar auditoria.');
    }
  }
  function esc(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  document.addEventListener('DOMContentLoaded', carregarConfig);
</script>
</body>
</html>
