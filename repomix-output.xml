</div>
<script src="/js/audit-fields.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/sidebar.js"></script>
<script>
let _curSource = 'legacy';
let _flows     = [];
const _params = new URLSearchParams(location.search);
const _returnTab = _params.get('returnTab');
const _configTab = _params.get('configTab');
const _validTabs = new Set(['curriculos', 'funcoes', 'vagas']);
// ── Abas ───────────────────────────────────────────────────────
function mudarAba(aba, btn) {
  btn = btn || document.getElementById('config-tab-btn-' + aba);
  if (!btn || !_validTabs.has(aba)) return;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-' + aba).classList.add('active');
}
function retornarParaOrigem(aba) {
  if (!_validTabs.has(aba)) return;
  setTimeout(() => {
    if (window.parent && window.parent !== window) {
      window.parent.postMessage({ type: 'se-integracoes:return-tab', tab: aba }, location.origin);
    } else {
      location.href = '/se-integracoes.html#' + aba;
    }
  }, 600);
}
// ── Helpers ────────────────────────────────────────────────────
function mostrarMsg(id, texto, ok) {
  const el = document.getElementById(id);
  el.textContent   = texto;
  el.style.color   = ok ? 'var(--success)' : 'var(--error)';
  if (ok) setTimeout(() => { el.textContent = ''; }, 3000);
}
function popularSelect(selId, flows, valorAtual) {
  const sel = document.getElementById(selId);
  sel.innerHTML = '<option value="">— Selecione um flow —</option>';
  flows.forEach(f => {
    const opt = document.createElement('option');
    opt.value = f.id;
    opt.textContent = `${f.nome} (${f.steps_count} step${f.steps_count!==1?'s':''})${f.descricao?' — '+f.descricao:''}`;
    if (f.id === valorAtual) opt.selected = true;
    sel.appendChild(opt);
  });
}
// ── Currículos ─────────────────────────────────────────────────
function selecionarSourceCur(src) {
  _curSource = src;
  document.getElementById('cur-opt-legacy').classList.toggle('active', src === 'legacy');
  document.getElementById('cur-opt-flow').classList.toggle('active',   src === 'flow');
  document.getElementById('cur-opt-grid').classList.toggle('active',   src === 'grid');
  document.getElementById('cur-legacy-fields').style.display = src === 'legacy' ? 'block' : 'none';
  document.getElementById('cur-flow-fields').style.display   = src === 'flow'   ? 'block' : 'none';
  document.getElementById('cur-grid-fields').style.display   = src === 'grid'   ? 'block' : 'none';
}
async function carregarCurriculos() {
  const [cfg, flows] = await Promise.all([
    fetch('/api/integracoes/se/config').then(r => r.json()).catch(() => ({})),
    fetch('/api/integracoes/se/flows').then(r => r.json()).catch(() => []),
  ]);
  _flows = flows;
  popularSelect('cur-flow-id',      flows, cfg.se_api_flow_id);
  popularSelect('cur-grid-flow-id', flows, cfg.se_api_grid_flow_id);
  document.getElementById('cur-se-url').value         = cfg.se_url            || '';
  document.getElementById('cur-se-token').value       = cfg.se_token          || '';
  document.getElementById('cur-campo-emp-id').value   = cfg.campo_empresa_id  || '';
  document.getElementById('cur-campo-emp-nome').value = cfg.campo_empresa_nome|| '';
  selecionarSourceCur(cfg.integration_source || 'legacy');
}
async function salvarCurriculos() {
  const body = {
    integration_source:  _curSource,
    se_url:              document.getElementById('cur-se-url').value.trim(),
    se_token:            document.getElementById('cur-se-token').value.trim(),
    campo_empresa_id:    document.getElementById('cur-campo-emp-id').value.trim(),
    campo_empresa_nome:  document.getElementById('cur-campo-emp-nome').value.trim(),
    se_api_flow_id:      _curSource === 'flow' ? Number(document.getElementById('cur-flow-id').value) : null,
    se_api_grid_config_id: _curSource === 'grid' ? Number(document.getElementById('cur-grid-flow-id').value) : null,
  };
  try {
    const r = await fetch('/api/integracoes/se/config', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || 'Erro ao salvar');
    mostrarMsg('cur-msg', '✓ Configuração de currículos salva', true);
    retornarParaOrigem(_returnTab);
  } catch (err) { mostrarMsg('cur-msg', `✗ ${err.message}`, false); }
}
// ── Funções ────────────────────────────────────────────────────
async function carregarFuncoes() {
  const [cfg, flows] = await Promise.all([
    fetch('/api/integracoes/se-funcao/config').then(r => r.json()).catch(() => ({})),
    fetch('/api/integracoes/se-funcao/flows').then(r => r.json()).catch(() => []),
  ]);
  popularSelect('func-flow-id', flows, cfg.se_api_flow_id);
  const flow = flows.find(f => f.id === cfg.se_api_flow_id);
  if (flow) {
    document.getElementById('func-flow-nome-badge').textContent = flow.nome;
    document.getElementById('func-flow-badge').style.display    = 'inline-flex';
  }
}
async function salvarFuncoes() {
  const flowId = document.getElementById('func-flow-id').value;
  if (!flowId) { mostrarMsg('func-msg', '✗ Selecione um flow', false); return; }
  try {
    const r = await fetch('/api/integracoes/se-funcao/config', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ se_api_flow_id: Number(flowId) }),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || 'Erro ao salvar');
    mostrarMsg('func-msg', '✓ Configuração de funções salva', true);
    carregarFuncoes();
    retornarParaOrigem(_returnTab);
  } catch (err) { mostrarMsg('func-msg', `✗ ${err.message}`, false); }
}
// ── Vagas ──────────────────────────────────────────────────────
async function carregarVagas() {
  const [cfg, flows] = await Promise.all([
    fetch('/api/integracoes/se-vaga/config').then(r => r.json()).catch(() => ({})),
    fetch('/api/integracoes/se-vaga/flows').then(r => r.json()).catch(() => []),
  ]);
  popularSelect('vaga-flow-id', flows, cfg.se_api_flow_id);
  const flow = flows.find(f => f.id === cfg.se_api_flow_id);
  if (flow) {
    document.getElementById('vaga-flow-nome-badge').textContent = flow.nome;
    document.getElementById('vaga-flow-badge').style.display    = 'inline-flex';
  }
}
async function salvarVagas() {
  const flowId = document.getElementById('vaga-flow-id').value;
  if (!flowId) { mostrarMsg('vaga-msg', '✗ Selecione um flow', false); return; }
  try {
    const r = await fetch('/api/integracoes/se-vaga/config', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ se_api_flow_id: Number(flowId) }),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || 'Erro ao salvar');
    mostrarMsg('vaga-msg', '✓ Configuração de vagas salva', true);
    carregarVagas();
    retornarParaOrigem(_returnTab);
  } catch (err) { mostrarMsg('vaga-msg', `✗ ${err.message}`, false); }
}
(async () => {
  await window._iahubAuthReady;
  await Promise.all([carregarCurriculos(), carregarFuncoes(), carregarVagas()]);
  if (_validTabs.has(_configTab)) mudarAba(_configTab);
})();
</script>
</body>
