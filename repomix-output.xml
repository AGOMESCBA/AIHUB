      cursor:pointer;
      transition:color .15s,border-color .15s;
      display:flex;
      align-items:center;
      gap:7px;
      white-space:nowrap;
    }
    .tab-btn:hover { color:var(--accent); }
    .tab-btn.active { color:var(--accent); border-bottom-color:var(--accent); }
    .tab-pane { display:none; }
    .tab-pane.active { display:block; }
    .tab-frame {
      width:100%;
      border:0;
      display:block;
      min-height:560px;
      background:transparent;
    }
    .tab-loading {
      padding:48px 20px;
      text-align:center;
      color:var(--text-lo);
      font-size:13px;
    }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IAHub</span>
    </div>
