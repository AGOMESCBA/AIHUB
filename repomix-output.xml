<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Vagas em Aberto — IAHub</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    html, body { height: auto; overflow: auto; }
    body { background: var(--bg-base); font-size: 15px; }
    /* ── Topbar ─────────────────────────────────────────────────── */
    .pub-topbar {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      height: 62px;
      display: flex;
      align-items: center;
      padding: 0 36px;
      position: sticky;
      top: 0;
      z-index: 200;
      box-shadow: var(--shadow-sm);
    }
    .pub-logo { display: flex; align-items: center; gap: 12px; }
    .pub-logo-icon {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, var(--accent), #6366f1);
      border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 900; color: #fff;
      box-shadow: 0 2px 8px rgba(37,99,235,.18);
    }
    .pub-logo-name {
      font-size: 17px; font-weight: 700;
      background: linear-gradient(135deg, var(--accent), #6366f1);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .pub-logo-sep  { color: var(--border-hi); }
    .pub-logo-sub  { font-size: 14px; color: var(--text-lo); }
    /* ── Hero ───────────────────────────────────────────────────── */
    .pub-hero {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      padding: 24px 36px 20px;
      text-align: center;
    }
    .pub-hero h1 {
      font-size: clamp(20px, 2.5vw, 26px);
      font-weight: 700;
