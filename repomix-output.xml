    .tabs          { display:flex;gap:0;border-bottom:2px solid var(--border);margin-bottom:28px; }
    .tab-btn       { padding:10px 22px;font-size:13px;font-weight:600;color:var(--text-lo);background:none;border:none;border-bottom:2px solid transparent;margin-bottom:-2px;cursor:pointer;transition:color .15s,border-color .15s; }
