            <main class="editor-main">
              <section class="form-section">
                <div class="form-section-header">
                  <div class="form-section-title">Identificacao</div>
                  <div class="form-section-subtitle">Dados do canal usado pelo monitor e pela sessao WhatsApp.</div>
                </div>
                <div class="form-section-body">
                  <div class="form-group">
                    <label class="form-label">Nome <span style="color:#dc2626">*</span></label>
                    <input id="f-nome" class="form-control" placeholder="ex: WhatsApp Principal">
