    /* Group panel */
    .gp-wrap      { margin-top:12px;padding-top:12px;border-top:1px solid var(--border); }
    .gp-chips-row { display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:8px;position:relative; }
    .gp-label     { font-size:11px;color:var(--text-lo);white-space:nowrap; }
    /* Tabulator skin */
    .tabulator { font-family:inherit;font-size:14px;border:none !important; }
    .tabulator .tabulator-header { background:var(--bg-hover);border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-col { background:transparent;border-right:none !important; }
    .tabulator .tabulator-col-title { font-size:11px;color:var(--text-lo);font-weight:600;text-transform:uppercase;letter-spacing:.04em; }
    .tabulator-row { border-bottom:1px solid var(--border) !important;cursor:pointer; }
    .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator-cell { border-right:none !important;padding:9px 12px; }
    .tabulator-header-filter input,
    .tabulator-header-filter select { width:100%;font-size:11px;border:1px solid var(--border);border-radius:4px;padding:3px 6px;background:#fff;color:var(--text);margin-top:4px; }
    .tabulator-group { background:var(--bg-hover) !important;border-bottom:1px solid var(--border) !important;font-weight:600;font-size:13px;padding:8px 14px !important; }
    @media(max-width:920px) {
      .page-head { flex-direction:column; }
      .page-head .btn { align-self:flex-start; }
      .grid-toolbar { flex-wrap:wrap; }
      .sel-bar { width:100%;margin-left:0; }
    }
    @media(max-width:560px) {
      .quick-search { min-width:100%; }
      .quick-row select.form-control { width:100%; }
    }
  </style>
  <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IAHub</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <span class="topbar-title"><span class="topbar-path">Recrutamento ›</span> Cadastro de Funções</span>
    </div>
    <div class="page-content">
      <div class="page-head">
        <div>
          <div class="page-kicker">Recrutamento</div>
          <div class="page-title">Cadastro de Funções</div>
          <div class="page-subtitle">Gerencie funções, palavras-chave e integração com SE em uma visão de trabalho.</div>
        </div>
        <button class="btn btn-primary" onclick="abrirModal()">＋ Nova Função</button>
      </div>
      <div class="quick-panel">
        <div class="quick-row">
          <input id="q-busca" class="form-control quick-search" placeholder="Buscar por função, área ou palavra-chave..." oninput="aplicarFiltrosRapidos()">
          <select id="q-area" class="form-control" onchange="aplicarFiltrosRapidos()">
            <option value="">Todas as áreas</option>
          </select>
          <select id="q-nivel" class="form-control" onchange="aplicarFiltrosRapidos()">
            <option value="">Todos os níveis</option>
            <option value="Júnior">Júnior</option>
            <option value="Pleno">Pleno</option>
            <option value="Sênior">Sênior</option>
            <option value="Especialista">Especialista</option>
            <option value="Não especificado">Não especificado</option>
          </select>
          <select id="q-se" class="form-control" onchange="aplicarFiltrosRapidos()">
            <option value="">Todos no SE</option>
            <option value="pendente">Não integrado</option>
            <option value="sucesso">Integrado</option>
            <option value="parcial">Parcial</option>
            <option value="erro">Erro</option>
            <option value="revertido">Revertido</option>
          </select>
          <button class="btn btn-ghost" onclick="limparFiltrosRapidos()">Limpar</button>
        </div>
        <div class="gp-wrap">
          <div class="gp-chips-row" id="gp-chips-row">
            <span class="gp-label">Agrupar por:</span>
          </div>
          <div id="dz"></div>
        </div>
      </div>
      <div class="card">
        <div class="card-body" style="padding:0">
          <div class="grid-toolbar">
            <div>
              <div class="grid-title">Funções cadastradas</div>
              <div id="count" class="grid-meta"></div>
            </div>
            <div class="sel-bar" id="sel-bar">
              <span id="sel-count" style="font-weight:600"></span>
              <span style="color:var(--text-lo);font-size:12px">funções selecionadas</span>
              <button class="btn btn-primary" style="font-size:12px;padding:5px 14px;margin-left:auto" onclick="integrarSelecionados()">🔗 Integrar ao SE</button>
              <button class="btn btn-ghost" style="font-size:12px;padding:5px 10px" onclick="limparSelecao()">✕ Limpar</button>
            </div>
          </div>
          <div id="tabela"></div>
          <div id="empty" class="d-none" style="text-align:center;padding:60px;color:var(--text-lo)">
            📋 Nenhuma função cadastrada.<br>
            <span style="font-size:12px">Clique em <strong>+ Nova Função</strong> para começar.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div id="modal" class="modal-overlay d-none">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title" id="modal-title">Nova Função</span>
      <button class="modal-close" onclick="fecharModal()">✕</button>
    </div>
    <div class="form-row-3 audit-row" style="margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid var(--border)">
      <div class="form-group">
        <label class="form-label" style="color:var(--text-lo)">ID do Registro</label>
        <input type="text" id="f-audit-id" class="form-control" disabled style="color:var(--text-lo);background:var(--bg-hover);font-family:monospace;font-size:13px">
      </div>
      <div class="form-group">
        <label class="form-label" style="color:var(--text-lo)">ID da Empresa</label>
        <input type="text" id="f-audit-emp-id" class="form-control" disabled style="color:var(--text-lo);background:var(--bg-hover);font-family:monospace;font-size:13px">
      </div>
      <div class="form-group">
        <label class="form-label" style="color:var(--text-lo)">Empresa</label>
        <input type="text" id="f-audit-emp-nome" class="form-control" disabled style="color:var(--text-lo);background:var(--bg-hover);font-size:13px">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Nome da Função *</label>
        <input type="text" id="f-nome" class="form-control" placeholder="Ex: Desenvolvedor Full Stack">
      </div>
      <div class="form-group">
        <label class="form-label">Área / Departamento</label>
        <input type="text" id="f-area" class="form-control" placeholder="Ex: Tecnologia">
      </div>
    </div>
    <div class="form-row-3">
      <div class="form-group">
        <label class="form-label">Nível de Experiência</label>
        <select id="f-nivel" class="form-control">
          <option value="Não especificado">Não especificado</option>
          <option value="Júnior">Júnior</option>
          <option value="Pleno">Pleno</option>
          <option value="Sênior">Sênior</option>
          <option value="Especialista">Especialista</option>
        </select>
      </div>
      <div class="form-group" style="grid-column:span 2">
        <label class="form-label">Formação Necessária</label>
        <input type="text" id="f-formacao" class="form-control" placeholder="Ex: Análise de Sistemas ou área correlata">
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Descrição da Função</label>
      <textarea id="f-descricao" class="form-control" rows="3" data-rich-text placeholder="Descreva as responsabilidades e atividades da função..."></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Requisitos Obrigatórios</label>
        <textarea id="f-req-obrig" class="form-control" rows="3" data-rich-text placeholder="Liste os requisitos indispensáveis..."></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">Requisitos Desejáveis</label>
        <textarea id="f-req-desej" class="form-control" rows="3" data-rich-text placeholder="Liste os requisitos diferenciais..."></textarea>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Habilidades Técnicas</label>
        <textarea id="f-habilidades" class="form-control" rows="2" placeholder="Separe por vírgula: React, Node.js, SQL..."></textarea>
        <div class="form-hint">Separe cada habilidade por vírgula.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Palavras-chave para Análise</label>
        <textarea id="f-keywords" class="form-control" rows="2" placeholder="javascript, api, backend, agile..."></textarea>
        <div class="form-hint">Usadas pelo analisador de currículos.</div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mapear" id="btn-mapear" onclick="gerarEquivalencias()">✨ Mapear Equivalências</button>
      <button class="btn btn-ghost" onclick="fecharModal()">Cancelar</button>
      <button class="btn btn-primary" onclick="salvar()">Salvar Função</button>
    </div>
  </div>
</div>
<div id="modal-view" class="modal-overlay d-none">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title" id="view-titulo">Detalhes da Função</span>
      <button class="modal-close" onclick="document.getElementById('modal-view').classList.add('d-none')">✕</button>
    </div>
    <div id="view-content"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="document.getElementById('modal-view').classList.add('d-none')">Fechar</button>
    </div>
  </div>
</div>
<div id="modal-equiv" class="modal-overlay d-none">
  <div class="modal" style="width:min(740px,95vw)">
    <div class="modal-header">
      <span class="modal-title">✨ Revisar Equivalências</span>
      <button class="modal-close" onclick="fecharModalEquiv()">✕</button>
    </div>
    <p style="font-size:13px;color:var(--text-md);margin-bottom:20px;line-height:1.6">
      Revise os sinônimos mapeados pela IA para cada palavra-chave. Adicione ou remova variantes antes de salvar.<br>
      <span style="font-size:11px;color:var(--text-lo)">Apenas palavras-chave com ao menos uma variante serão salvas.</span>
    </p>
    <div id="equiv-review-list" style="max-height:55vh;overflow-y:auto;padding-right:4px"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="fecharModalEquiv()">Cancelar</button>
      <button class="btn btn-primary" id="btn-salvar-equiv" onclick="salvarTodasEquivalencias()">Salvar Equivalências</button>
    </div>
  </div>
</div>
<script src="/js/audit-fields.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/sidebar.js"></script>
<script src="/js/grid-group-panel.js"></script>
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script src="/js/rich-text.js?v=quill-2"></script>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script>
const NIVEIS = {
  'Júnior':'nivel-junior','Pleno':'nivel-pleno',
  'Sênior':'nivel-senior','Especialista':'nivel-especialista',
  'Não especificado':'nivel-nao-especificado',
};
let funcoes      = [];
let editandoId   = null;
let reviewItems  = [];
let table        = null;
let _seStatusMap = {};
let _selecionados = new Set();
let _quickFilterFn = null;
function escH(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function campoRico(id) {
  return window.getRichValue ? getRichValue(id).trim() : document.getElementById(id).value.trim();
}
function textoRico(value) {
  return window.richPlainText ? richPlainText(value) : String(value || '').replace(/<[^>]*>/g, '').trim();
}
function renderRico(value) {
  const html = window.richRender ? richRender(value) : escH(value || '').replace(/\n/g, '<br>');
  return html ? `<div class="rich-content">${html}</div>` : '';
}
function seBadge(id) {
  const st = _seStatusMap[id];
  if (!st) return `<span class="se-badge se-pendente">● Não integrado</span>`;
  const map = { sucesso:'se-sucesso ● Integrado', erro:'se-erro ✗ Erro', parcial:'se-parcial ⚠ Parcial', revertido:'se-revertido ↩ Revertido' };
  const [cls, label] = (map[st] || 'se-pendente — Desconhecido').split(' ', 1).concat([(map[st]||'').replace(/^\S+ /,'')]);
  return `<span class="se-badge ${cls}">${label}</span>`;
}
function toggleSelecao(id) {
  if (_selecionados.has(id)) _selecionados.delete(id);
  else _selecionados.add(id);
  atualizarSelBar();
  if (table) table.redraw();
}
function atualizarSelBar() {
  const bar = document.getElementById('sel-bar');
  const cnt = document.getElementById('sel-count');
  if (_selecionados.size > 0) { bar.classList.add('active'); cnt.textContent = _selecionados.size; }
  else bar.classList.remove('active');
}
function limparSelecao() {
  _selecionados.clear();
  atualizarSelBar();
  if (table) table.redraw();
}
function statusSE(id) {
  return _seStatusMap[id] || 'pendente';
}
function popularFiltroAreas() {
  const el = document.getElementById('q-area');
  const atual = el.value;
  const areas = [...new Set(funcoes.map(f => (f.area || '').trim()).filter(Boolean))]
    .sort((a, b) => a.localeCompare(b, 'pt-BR'));
  el.innerHTML = '<option value="">Todas as áreas</option>'
    + areas.map(area => `<option value="${escH(area)}">${escH(area)}</option>`).join('');
  if (areas.includes(atual)) el.value = atual;
}
function aplicarFiltrosRapidos() {
  if (!table) return;
  const busca = document.getElementById('q-busca').value.trim().toLowerCase();
  const area = document.getElementById('q-area').value;
  const nivel = document.getElementById('q-nivel').value;
  const se = document.getElementById('q-se').value;
  if (_quickFilterFn) {
    table.removeFilter(_quickFilterFn);
    _quickFilterFn = null;
  }
  if (!busca && !area && !nivel && !se) return;
  _quickFilterFn = rowData => {
    if (area && (rowData.area || '') !== area) return false;
    if (nivel && (rowData.nivel_experiencia || 'Não especificado') !== nivel) return false;
    if (se && statusSE(rowData.id) !== se) return false;
    if (busca) {
      const termos = [
        rowData.nome || '',
        rowData.area || '',
        ...(rowData.palavras_chave || []),
      ].join(' ').toLowerCase();
      if (!termos.includes(busca)) return false;
    }
    return true;
  };
  table.addFilter(_quickFilterFn);
}
function limparFiltrosRapidos() {
  document.getElementById('q-busca').value = '';
  document.getElementById('q-area').value = '';
  document.getElementById('q-nivel').value = '';
  document.getElementById('q-se').value = '';
  aplicarFiltrosRapidos();
}
function labelFuncoes(qtd) {
  return qtd === 1 ? '1 função' : `${qtd} funções`;
}
async function integrarSelecionados() {
  if (!_selecionados.size) return;
  const ids = [..._selecionados];
  if (!confirm(`Integrar ${ids.length} função(ões) ao SE via Flow configurado?`)) return;
  try {
    const r = await fetch('/api/integracoes/se-funcao/enviar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ funcao_ids: ids }),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || 'Erro');
    alert(`✓ Integração concluída — ${data.sucesso} sucesso, ${data.erros} erro(s).`);
    limparSelecao();
    await carregarSEStatus();
    if (table) table.redraw();
  } catch (err) { alert(`✗ Erro: ${err.message}`); }
}
async function carregarSEStatus() {
  try {
    _seStatusMap = await fetch('/api/integracoes/se-funcao/status-mapa').then(r => r.json());
  } catch { _seStatusMap = {}; }
}
window._toggleSel = id => toggleSelecao(id);
window._integrarUm = async id => {
  if (!confirm(`Integrar a função #${id} ao SE?`)) return;
  try {
    const r = await fetch('/api/integracoes/se-funcao/enviar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ funcao_ids: [id] }),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || 'Erro');
    const st = data.resultados?.[0]?.status || '?';
    alert(`✓ Integração concluída — status: ${st}`);
    await carregarSEStatus();
    if (table) table.redraw();
  } catch (err) { alert(`✗ Erro: ${err.message}`); }
};
function parseTags(str) {
  if (!str) return [];
  return str.split(',').map(s => s.trim()).filter(Boolean);
}
function tagsHtml(arr) {
  if (!arr?.length) return '<span style="color:var(--text-lo)">—</span>';
  return arr.slice(0, 5).map(t => `<span class="tag">${escH(t)}</span>`).join('')
       + (arr.length > 5 ? `<span class="tag">+${arr.length - 5}</span>` : '');
}
const gp = createGroupPanel({
  chipsRowId: 'gp-chips-row',
  dropZoneId: 'dz',
  storageKey: 'ac_funcoes_group_fields',
  getTable  : () => table,
});
// ── Tabulator ──────────────────────────────────────────────────
function initTabulator(data) {
  table = new Tabulator('#tabela', {
    data,
    index: 'id',
    layout: 'fitColumns',
    movableColumns: true,
    columnDefaults: { resizable: true, headerSort: true },
    groupBy: gp.getActiveFields(),
    groupStartOpen: true,
    columns: [
      {
        title: '', field: 'id', width: 38, minWidth: 38,
        headerSort: false, groupable: false, resizable: false,
        hozAlign: 'center', headerHozAlign: 'center',
        formatter: c => {
          const id  = c.getValue();
          const chk = _selecionados.has(id) ? 'checked' : '';
          return `<input type="checkbox" ${chk} onclick="event.stopPropagation();_toggleSel(${id})" style="width:15px;height:15px;cursor:pointer;accent-color:var(--accent)">`;
        }
      },
      {
        title: 'ID', field: 'id', width: 60, groupable: false,
        hozAlign: 'center', headerHozAlign: 'center',
        formatter: c => `<span style="font-size:11px;font-family:monospace;color:var(--text-lo)">${c.getValue()}</span>`
      },
      {
        title: 'Nome da Função', field: 'nome',
        headerFilter: true,
        formatter: c => `<strong style="color:var(--accent-light)">${escH(c.getValue() || '—')}</strong>`
      },
      {
        title: 'Área', field: 'area',
        headerFilter: true,
        formatter: c => `<span style="color:var(--text-md)">${escH(c.getValue() || '—')}</span>`
      },
      {
        title: 'Nível', field: 'nivel_experiencia', width: 145,
        headerFilter: 'select',
        headerFilterParams: { values: { '': 'Todos', 'Júnior': 'Júnior', 'Pleno': 'Pleno', 'Sênior': 'Sênior', 'Especialista': 'Especialista', 'Não especificado': 'Não esp.' } },
        formatter: c => {
          const n = c.getValue() || 'Não especificado';
          return `<span class="nivel-badge ${NIVEIS[n] || 'nivel-nao-especificado'}">${escH(n)}</span>`;
        }
      },
      {
        title: 'Palavras-chave', field: 'palavras_chave',
        headerFilter: true, groupable: false,
        headerFilterFunc: (val, _v, rowData) =>
          !val || (rowData.palavras_chave || []).some(k => k.toLowerCase().includes(val.toLowerCase())),
        formatter: c => `<div class="tag-list">${tagsHtml(c.getValue())}</div>`
      },
      {
        title: 'SE', field: 'id',
        headerFilter: false, headerSort: false, width: 130, minWidth: 130, groupable: false,
        formatter: c => seBadge(c.getValue())
      },
      {
        title: '', field: 'id',
        headerFilter: false, headerSort: false, width: 150, groupable: false,
        hozAlign: 'right',
        formatter: c => {
          const id   = c.getValue();
          const nome = escH(c.getRow().getData().nome || '');
          return `
            <button class="btn btn-ghost" style="font-size:12px;padding:4px 8px" onclick="event.stopPropagation();visualizar(${id})" title="Visualizar">👁</button>
            <button class="btn btn-ghost" style="font-size:12px;padding:4px 8px" onclick="event.stopPropagation();editar(${id})" title="Editar">✏️</button>
            <button class="btn btn-ghost" style="font-size:12px;padding:4px 8px;color:#6d28d9" onclick="event.stopPropagation();_integrarUm(${id})" title="Integrar ao SE">🔗</button>
            <button class="btn btn-ghost" style="font-size:12px;padding:4px 8px" onclick="event.stopPropagation();excluir(${id},'${nome}')" title="Excluir">🗑️</button>`;
        }
      },
    ],
    rowClick: (_e, row) => visualizar(row.getData().id),
    dataFiltered: (_filters, rows) => {
      const t = rows?.length ?? funcoes.length;
      document.getElementById('count').textContent =
        t === funcoes.length
          ? labelFuncoes(t)
          : `${t} de ${funcoes.length} funções`;
    },
  });
}
// ── Carregamento ───────────────────────────────────────────────
async function carregar() {
  await window._iahubAuthReady;
  [funcoes] = await Promise.all([
    fetch('/api/funcoes').then(r => r.json()),
    carregarSEStatus(),
  ]);
  popularFiltroAreas();
  const empty = document.getElementById('empty');
  if (!funcoes.length) {
    empty.classList.remove('d-none');
    document.getElementById('count').textContent = '0 funções';
    return;
  }
  empty.classList.add('d-none');
  document.getElementById('count').textContent =
    labelFuncoes(funcoes.length);
  if (!table) {
    initTabulator(funcoes);
    setTimeout(() => gp.refresh(), 0);
  } else {
    table.replaceData(funcoes);
  }
  aplicarFiltrosRapidos();
}
// ── Modal criar/editar ─────────────────────────────────────────
function abrirModal(f = null) {
  editandoId  = f ? f.id : null;
  reviewItems = [];
  document.getElementById('modal-title').textContent = f ? 'Editar Função' : 'Nova Função';
  const _emp = window._iahubEmpresa || { id: '—', nome: '—' };
  document.getElementById('f-audit-id').value       = f?.id ?? '—';
  document.getElementById('f-audit-emp-id').value   = _emp.id;
  document.getElementById('f-audit-emp-nome').value = _emp.nome;
  document.getElementById('f-nome').value        = f?.nome || '';
  document.getElementById('f-area').value        = f?.area || '';
  document.getElementById('f-nivel').value       = f?.nivel_experiencia || 'Não especificado';
  document.getElementById('f-formacao').value    = f?.formacao_necessaria || '';
  setRichValue('f-descricao', f?.descricao || '');
  setRichValue('f-req-obrig', f?.requisitos_obrigatorios || '');
  setRichValue('f-req-desej', f?.requisitos_desejaveis || '');
  document.getElementById('f-habilidades').value = Array.isArray(f?.habilidades_tecnicas)
    ? f.habilidades_tecnicas.join(', ') : (f?.habilidades_tecnicas || '');
  document.getElementById('f-keywords').value    = Array.isArray(f?.palavras_chave)
    ? f.palavras_chave.join(', ') : (f?.palavras_chave || '');
  resetEquivUI();
  document.getElementById('modal').classList.remove('d-none');
}
function fecharModal() {
  document.getElementById('modal').classList.add('d-none');
  resetEquivUI();
}
function resetEquivUI() {
  const btn = document.getElementById('btn-mapear');
  btn.disabled    = false;
  btn.textContent = '✨ Mapear Equivalências';
}
// ── Equivalências com IA ───────────────────────────────────────
function coletarKeywords() {
  const habs = parseTags(document.getElementById('f-habilidades').value);
  const reqs = textoRico(campoRico('f-req-obrig'))
    .split(/[\n,;]+/).map(s => s.replace(/^[-•]\s*/, '').trim()).filter(Boolean);
  return [...new Set([...habs, ...reqs])];
}
async function gerarEquivalencias() {
  const kws = coletarKeywords();
  if (!kws.length) { document.getElementById('f-habilidades').focus(); return; }
  const btn = document.getElementById('btn-mapear');
  btn.disabled = true; btn.textContent = '⏳ Consultando IA...';
  try {
    const [sugestoes, todasEquiv] = await Promise.all([
      fetch('/api/equivalencias/sugerir-lote', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ keywords: kws, preview: true }),
      }).then(r => r.json()),
      fetch('/api/equivalencias').then(r => r.json()),
    ]);
    const dbMap   = new Map(todasEquiv.map(e => [e.keyword.toLowerCase(), e.variantes]));
    const geradas = sugestoes.geradas || {};
    reviewItems   = [];
    for (const kw of kws.map(k => k.toLowerCase().trim())) {
      const merged = [...new Set([...(dbMap.get(kw) || []), ...(geradas[kw] || [])])];
      if (!merged.length) continue;
      reviewItems.push({ kw, tags: merged, isNew: !dbMap.has(kw) });
    }
    abrirModalEquiv();
    btn.textContent = '✨ Mapear Equivalências';
  } catch (err) {
    alert('Erro ao consultar IA: ' + err.message);
    btn.textContent = '✨ Mapear Equivalências';
  } finally {
    btn.disabled = false;
  }
}
function abrirModalEquiv() {
  const list = document.getElementById('equiv-review-list');
  if (!reviewItems.length) {
    list.innerHTML = '<p style="color:var(--text-lo);font-size:13px">Nenhuma equivalência encontrada para as palavras-chave desta função.</p>';
    document.getElementById('modal-equiv').classList.remove('d-none');
    return;
  }
  list.innerHTML = reviewItems.map((item, idx) => `
    <div class="review-kw-row">
      <div class="review-kw-header">
        <span class="review-kw-label">${escH(item.kw)}</span>
        <span class="${item.isNew ? 'badge-new' : 'badge-existing'}">${item.isNew ? 'novo' : 'já existe — editando'}</span>
      </div>
      <div style="display:flex;gap:6px;align-items:flex-start">
        <div class="tag-input-box" style="flex:1" onclick="document.getElementById('rinput-${idx}').focus()">
          <div id="rtags-${idx}" style="display:contents"></div>
          <input id="rinput-${idx}" type="text" placeholder="Adicionar variante..." onkeydown="reviewKeydown(event,${idx})">
        </div>
        <button type="button" onclick="reviewAddFromBtn(${idx})"
          style="height:38px;padding:0 14px;border:1px solid var(--accent);border-radius:8px;background:var(--accent);color:#fff;font-size:18px;cursor:pointer;line-height:1;flex-shrink:0">+</button>
      </div>
    </div>`).join('');
  reviewItems.forEach((_, idx) => renderReviewTags(idx));
  document.getElementById('modal-equiv').classList.remove('d-none');
}
function fecharModalEquiv() {
  document.getElementById('modal-equiv').classList.add('d-none');
  reviewItems = [];
}
function renderReviewTags(idx) {
  const c = document.getElementById('rtags-' + idx);
  if (!c) return;
  c.innerHTML = (reviewItems[idx]?.tags || []).map((t, ti) =>
    `<span class="tag-pill">${escH(t)}<span class="rm" onclick="reviewRemoveTag(${idx},${ti})">×</span></span>`
  ).join('');
}
function reviewAddTag(idx, val) {
  const v = val.trim().toLowerCase().replace(/,+$/, '');
  if (!v || reviewItems[idx]?.tags.includes(v)) return false;
  reviewItems[idx].tags.push(v);
  renderReviewTags(idx);
  return true;
}
function reviewRemoveTag(idx, ti) {
  reviewItems[idx].tags.splice(ti, 1);
  renderReviewTags(idx);
}
function reviewKeydown(e, idx) {
  if (e.key === 'Enter' || e.key === ',') {
    e.preventDefault(); e.stopPropagation();
    if (reviewAddTag(idx, e.target.value)) e.target.value = '';
  }
  if (e.key === 'Backspace' && !e.target.value && reviewItems[idx]?.tags.length)
    reviewRemoveTag(idx, reviewItems[idx].tags.length - 1);
}
function reviewAddFromBtn(idx) {
  const inp = document.getElementById('rinput-' + idx);
  if (!inp) return;
  if (reviewAddTag(idx, inp.value)) inp.value = '';
  inp.focus();
}
async function salvarTodasEquivalencias() {
  const btn = document.getElementById('btn-salvar-equiv');
  btn.disabled = true; btn.textContent = '⏳ Salvando...';
  try {
    for (const item of reviewItems) {
      if (!item.tags.length) continue;
      await fetch('/api/equivalencias', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ keyword: item.kw, variantes: item.tags }),
      });
    }
    fecharModalEquiv();
    document.getElementById('btn-mapear').textContent = '✨ Equivalências salvas ✓';
  } catch (err) {
    alert('Erro ao salvar: ' + err.message);
  } finally {
    btn.disabled = false; btn.textContent = 'Salvar Equivalências';
  }
}
// ── CRUD ───────────────────────────────────────────────────────
async function salvar() {
  const nome = document.getElementById('f-nome').value.trim();
  if (!nome) { alert('O nome da função é obrigatório.'); return; }
  const body = {
    nome,
    area:                    document.getElementById('f-area').value.trim(),
    nivel_experiencia:       document.getElementById('f-nivel').value,
    formacao_necessaria:     document.getElementById('f-formacao').value.trim(),
    descricao:               campoRico('f-descricao'),
    requisitos_obrigatorios: campoRico('f-req-obrig'),
    requisitos_desejaveis:   campoRico('f-req-desej'),
    habilidades_tecnicas:    parseTags(document.getElementById('f-habilidades').value),
    palavras_chave:          parseTags(document.getElementById('f-keywords').value),
  };
  const url    = editandoId ? `/api/funcoes/${editandoId}` : '/api/funcoes';
  const method = editandoId ? 'PUT' : 'POST';
  await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  fecharModal();
  carregar();
}
async function editar(id) {
  const f = await fetch(`/api/funcoes/${id}`).then(r => r.json());
  abrirModal(f);
}
async function excluir(id, nome) {
  if (!confirm(`Excluir a função "${nome}"?\nEsta ação não pode ser desfeita.`)) return;
  await fetch(`/api/funcoes/${id}`, { method: 'DELETE' });
  carregar();
}
async function visualizar(id) {
  const f = await fetch(`/api/funcoes/${id}`).then(r => r.json());
  document.getElementById('view-titulo').textContent = f.nome;
  const tags  = arr => Array.isArray(arr) && arr.length
    ? `<div class="tag-list">${arr.map(t => `<span class="tag">${escH(t)}</span>`).join('')}</div>`
    : '<span style="color:var(--text-lo)">—</span>';
  const campo = (label, val) => val
    ? `<div class="view-field"><div class="view-label">${label}</div><div class="view-value">${val}</div></div>` : '';
  document.getElementById('view-content').innerHTML = `
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:20px">
      ${campo('Área', f.area)}
      ${campo('Nível', `<span class="nivel-badge ${NIVEIS[f.nivel_experiencia]||'nivel-nao-especificado'}">${escH(f.nivel_experiencia||'—')}</span>`)}
      ${campo('Formação', escH(f.formacao_necessaria))}
    </div>
    ${campo('Descrição da Função', renderRico(f.descricao))}
    ${campo('Requisitos Obrigatórios', renderRico(f.requisitos_obrigatorios))}
    ${campo('Requisitos Desejáveis', renderRico(f.requisitos_desejaveis))}
    <div class="view-field"><div class="view-label">Habilidades Técnicas</div>${tags(f.habilidades_tecnicas)}</div>
    <div class="view-field"><div class="view-label">Palavras-chave</div>${tags(f.palavras_chave)}</div>
    <div style="margin-top:16px;font-size:12px;color:var(--text-lo)">Cadastrado em ${new Date(f.criado_em).toLocaleString('pt-BR')}</div>`;
  document.getElementById('modal-view').classList.remove('d-none');
}
initRichEditors();
carregar();
</script>
</body>
</html>
</file>

