    }
    .panel-head {
      padding: 22px 22px 18px;
      background: linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .02));
      border-bottom: 1px solid var(--border);
    }
    .eyebrow {
      color: var(--accent-2);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .panel-head h2 {
      margin-top: 8px;
      font-size: 24px;
      line-height: 1.2;
      letter-spacing: 0;
    }
    .panel-head p {
      margin-top: 10px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.55;
    }
    .panel-body {
      padding: 22px;
    }
    .step { display: none; }
    .step.active { display: block; }
    label {
      display: block;
      margin-bottom: 8px;
      color: var(--soft);
      font-size: 12px;
      font-weight: 900;
