              <label class="form-label" for="confirmar">Digite MIGRAR para confirmar</label>
              <input class="form-control" id="confirmar" placeholder="MIGRAR" style="text-transform:uppercase">
            </div>
            <button class="btn btn-primary" id="btn-exec" onclick="executarMigracao()">Migrar Dados</button>
          </div>
        </section>
        <section class="mig-card">
          <div class="mig-card-hd">Tabelas para copiar</div>
          <div class="mig-panel-tools">
            <div class="mig-panel-tools-left">
              <button class="btn-light" onclick="carregarPreview()">Atualizar contagem de registros</button>
              <button class="btn-light" onclick="marcarDefaults()">Regras e configurações</button>
              <button class="btn-light" onclick="marcarTodas(true)">Marcar todas</button>
              <button class="btn-light" onclick="marcarTodas(false)">Limpar</button>
            </div>
            <span id="sel-count">0 selecionadas</span>
          </div>
          <div class="mig-cols-hd">
            <div></div>
            <div>Tabela</div>
            <div style="text-align:right;padding-right:8px">Origem</div>
            <div style="text-align:right;padding-right:8px">Destino</div>
          </div>
          <div id="tabelas-panel">
            <div style="padding:16px;color:var(--text-lo);font-size:13px">Carregando...</div>
          </div>
        </section>
      </div>
      </div>
      <div id="aba-backups" class="mig-aba" style="display:none">
        <section class="mig-card">
          <div class="mig-card-hd">Backups de migração</div>
          <div class="mig-panel-tools">
            <div class="mig-panel-tools-left">
              <button class="btn-light" onclick="carregarBackups()">Atualizar lista</button>
            </div>
            <span id="backup-count">0 backup(s)</span>
          </div>
          <div id="backups-panel">
            <div style="padding:16px;color:var(--text-lo);font-size:13px">Carregando...</div>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script>
const IAC_MODE = location.pathname.startsWith('/app/ia-command/');
if (IAC_MODE) {
  document.body.classList.add('iac-mode');
  document.getElementById('mig-logo-icon').textContent = '⚡';
  document.getElementById('mig-logo-text').textContent = 'IA Command';
  document.getElementById('mig-topbar-path').textContent = 'Configuração >';
}
const sidebarScript = document.createElement('script');
sidebarScript.src = IAC_MODE ? '/app/ia-command/js/sidebar.js' : '/js/sidebar.js';
document.head.appendChild(sidebarScript);
// ─── Abas ──────────────────────────────────────────────────────────────────
let _backupsCarregados = false;
function mostrarAba(nome) {
  document.querySelectorAll('.mig-tab').forEach(b => b.classList.toggle('active', b.dataset.tab === nome));
  document.getElementById('aba-migrar').style.display  = nome === 'migrar'  ? '' : 'none';
  document.getElementById('aba-backups').style.display = nome === 'backups' ? '' : 'none';
  if (nome === 'backups' && !_backupsCarregados) {
    _backupsCarregados = true;
    carregarBackups();
  }
}
// ─── Estado ────────────────────────────────────────────────────────────────
let tabelas = [];
let preview = [];
const SISTEMA_META = {
  iahub: { label: 'IAHub — IA Recruit', icon: '🏢' },
  iac:   { label: 'IA Command',          icon: '⚡' },
};
const STORE_KEY = 'mig_collapse_v1';
function loadCollapse() { try { return JSON.parse(localStorage.getItem(STORE_KEY) || '{}'); } catch { return {}; } }
function saveCollapse(s) { localStorage.setItem(STORE_KEY, JSON.stringify(s)); }
// ─── Utilitários ───────────────────────────────────────────────────────────
function esc(v) {
  return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function safeId(v) { return String(v).replace(/[^a-z0-9_]/gi, '_'); }
function setMsg(texto, tipo = 'info') {
  const el = document.getElementById('msg');
  el.className = `mig-alert ${tipo} show`;
  el.innerHTML = texto;
}
function limparMsg() { const el = document.getElementById('msg'); el.className = 'mig-alert'; el.textContent = ''; }
function popularSelect(id, empresas) {
  document.getElementById(id).innerHTML = empresas.map(e => `<option value="${e.id}">${esc(e.nome)}</option>`).join('');
}
// ─── Colapso ───────────────────────────────────────────────────────────────
function toggleSys(sisId) {
  const body = document.getElementById(`sysbody-${safeId(sisId)}`);
  const chev = document.getElementById(`syschev-${safeId(sisId)}`);
  const state = loadCollapse();
  const now = body.classList.toggle('collapsed');
  chev.classList.toggle('closed', now);
  state[`sys_${sisId}`] = now;
  saveCollapse(state);
}
function toggleGrp(grpId) {
  const body = document.getElementById(`grpbody-${safeId(grpId)}`);
  const chev = document.getElementById(`grpchev-${safeId(grpId)}`);
  const state = loadCollapse();
  const now = body.classList.toggle('collapsed');
  chev.classList.toggle('closed', now);
  state[`grp_${grpId}`] = now;
  saveCollapse(state);
}
// ─── Render tabelas ────────────────────────────────────────────────────────
function renderTabelas() {
  const mapPv   = new Map(preview.map(t => [t.id, t]));
  const collapse = loadCollapse();
  // Preserva a seleção atual entre re-renders (ex.: clique em "Atualizar prévia").
  // null = ainda não há estado na tela (primeira carga) → cai no default de cada tabela.
  const jaRenderizado = !!document.querySelector('.mig-check');
  const marcadosAntes = new Set(
    Array.from(document.querySelectorAll('.mig-check:checked')).map(c => c.dataset.id)
  );
  const sistemas = {};
  for (const t of tabelas) {
    const sis = t.sistema || 'iahub';
    if (!sistemas[sis]) sistemas[sis] = {};
    if (!sistemas[sis][t.grupo]) sistemas[sis][t.grupo] = [];
    sistemas[sis][t.grupo].push(t);
  }
  let html = '';
  for (const [sisId, grupos] of Object.entries(sistemas)) {
    const meta    = SISTEMA_META[sisId] || { label: sisId, icon: '📦' };
    const sysColl = !!collapse[`sys_${sisId}`];
    html += `<div class="sys-section">
      <div class="sys-hd" onclick="toggleSys('${esc(sisId)}')">
        <span class="sys-icon">${meta.icon}</span>
        <span class="sys-name">${esc(meta.label)}</span>
        <span class="sys-actions" onclick="event.stopPropagation()">
          <button type="button" class="btn-mini" onclick="marcarSistema('${esc(sisId)}', true)">Marcar todas</button>
          <button type="button" class="btn-mini" onclick="marcarSistema('${esc(sisId)}', false)">Limpar</button>
        </span>
        <span class="sys-chevron${sysColl ? ' closed' : ''}" id="syschev-${safeId(sisId)}">▼</span>
      </div>
      <div class="sys-body${sysColl ? ' collapsed' : ''}" id="sysbody-${safeId(sisId)}">`;
    for (const [grupo, rows] of Object.entries(grupos)) {
      const grpId   = `${sisId}_${grupo.replace(/[^a-z0-9]/gi, '_')}`;
      const grpColl = !!collapse[`grp_${grpId}`];
      html += `<div class="grp-section">
        <div class="grp-hd" onclick="toggleGrp('${esc(grpId)}')">
          <span class="grp-label">${esc(grupo)}</span>
          <span class="grp-chevron${grpColl ? ' closed' : ''}" id="grpchev-${safeId(grpId)}">▼</span>
        </div>
        <div class="grp-body${grpColl ? ' collapsed' : ''}" id="grpbody-${safeId(grpId)}">`;
      for (const t of rows) {
        const p   = mapPv.get(t.id) || {};
        const cls = Number(p.destino || 0) > 0 ? ' cheio' : '';
        const marcado = jaRenderizado ? marcadosAntes.has(t.id) : !!t.default;
        html += `<div class="mig-row">
          <div><input class="mig-check" type="checkbox" data-id="${esc(t.id)}" data-sistema="${esc(sisId)}" ${marcado ? 'checked' : ''} onchange="atualizarSelecionadas()"></div>
          <div class="mig-row-label">${esc(t.label)}</div>
          <div class="mig-num">${p.origem ?? '-'}</div>
          <div class="mig-num${cls}">${p.destino ?? '-'}</div>
        </div>`;
      }
      html += `</div></div>`;
    }
    html += `</div></div>`;
  }
  document.getElementById('tabelas-panel').innerHTML = html || '<div style="padding:16px;color:var(--text-lo);font-size:13px">Nenhuma tabela disponível.</div>';
  atualizarSelecionadas();
}
// ─── Dependências entre tabelas ────────────────────────────────────────────
// Dependências entre rotinas migradas.
const DEPS = {
  iac_sx2: ['iac_conexoes'],
  iac_sx3: ['iac_conexoes'],
  iac_protheus_company_tree: ['iac_conexoes'],
  iac_protheus_company_profile: ['iac_conexoes'],
  iac_wa_grupos: ['iac_wa_numeros'],
  iac_scheduled_questions: ['iac_wa_numeros'],
};
function aplicarDependencias() {
  const checks = document.querySelectorAll('.mig-check');
  // Descobre quais pré-requisitos são obrigatórios por causa de dependentes marcados
  const obrigatorios = new Set();
  for (const [dep, reqs] of Object.entries(DEPS)) {
    const el = document.querySelector(`.mig-check[data-id="${dep}"]`);
    if (el?.checked) reqs.forEach(r => obrigatorios.add(r));
  }
  for (const c of checks) {
    if (obrigatorios.has(c.dataset.id)) {
      c.checked = true;
      c.disabled = true;
      c.title = 'Obrigatório como pré-requisito das rotinas selecionadas';
    } else {
      c.disabled = false;
      c.title = '';
    }
  }
}
// ─── Seleção ───────────────────────────────────────────────────────────────
function selecionadas() { return Array.from(document.querySelectorAll('.mig-check:checked')).map(c => c.dataset.id); }
function atualizarSelecionadas() {
  aplicarDependencias();
  const n = selecionadas().length;
  document.getElementById('sel-count').textContent = `${n} selecionada${n === 1 ? '' : 's'}`;
}
function marcarTodas(v) { document.querySelectorAll('.mig-check').forEach(c => { c.checked = v; }); atualizarSelecionadas(); }
function marcarSistema(sisId, v) {
  document.querySelectorAll(`.mig-check[data-sistema="${sisId}"]`).forEach(c => { c.checked = v; });
  atualizarSelecionadas();
}
function marcarDefaults() {
  document.querySelectorAll('.mig-check').forEach(c => {
    c.checked = !!(tabelas.find(t => t.id === c.dataset.id)?.default);
  });
  atualizarSelecionadas();
}
// ─── SPLASH ────────────────────────────────────────────────────────────────
let _splashTotal = 0;
let _splashDone  = 0;
let _splashOk    = 0;
let _splashErro  = 0;
function mostrarSplash(ids) {
  _splashTotal = ids.length;
  _splashDone  = 0;
  _splashOk    = 0;
  _splashErro  = 0;
  // Monta lista de itens
  const SIS = { iahub: 'IAHub', iac: 'IA Command' };
  const listHtml = ids.map(id => {
    const t   = tabelas.find(x => x.id === id) || { label: id, grupo: '', sistema: 'iahub' };
    const sid = safeId(id);
    return `<div class="mig-splash-row" id="sp-row-${sid}">
      <div class="mig-splash-row-icon" id="sp-icon-${sid}">
        <span class="ico-pending">·</span>
      </div>
      <div class="mig-splash-row-info">
        <div class="mig-splash-row-label">${esc(t.label)}</div>
        <div class="mig-splash-row-meta">${esc(SIS[t.sistema] || t.sistema)} · ${esc(t.grupo)}</div>
        <div class="mig-splash-row-err" id="sp-err-${sid}" style="display:none"></div>
      </div>
    </div>`;
  }).join('');
  document.getElementById('sp-list').innerHTML = listHtml;
  document.getElementById('sp-title').textContent = 'Copiando dados...';
  document.getElementById('sp-title-icon').innerHTML = '<div class="mig-spin"></div>';
  document.getElementById('sp-sub').textContent = `0 de ${_splashTotal} tabela(s) processada(s)`;
  document.getElementById('sp-ft-info').textContent = '';
  document.getElementById('sp-btn-fechar').style.display = 'none';
  document.getElementById('sp-summary').style.display = 'none';
  document.getElementById('sp-progress-bar').style.width = '0%';
  const overlay = document.getElementById('mig-splash');
  overlay.style.display = 'flex';
  requestAnimationFrame(() => overlay.classList.add('visible'));
}
function atualizarSplashItem(id, estado, erroMsg) {
  const sid  = safeId(id);
  const row  = document.getElementById(`sp-row-${sid}`);
  const icon = document.getElementById(`sp-icon-${sid}`);
  const err  = document.getElementById(`sp-err-${sid}`);
  if (!row) return;
  row.classList.remove('current', 'done');
  if (estado === 'processando') {
    row.classList.add('current');
    icon.innerHTML = '<div class="mig-spin"></div>';
    row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  } else if (estado === 'ok') {
    row.classList.add('done');
    icon.innerHTML = '<span class="ico-ok">✓</span>';
    _splashDone++;
    _splashOk++;
    _atualizarProgresso();
  } else if (estado === 'erro') {
    row.classList.add('done');
    icon.innerHTML = '<span class="ico-err">✗</span>';
    _splashDone++;
    _splashErro++;
    if (erroMsg) { err.textContent = erroMsg; err.style.display = 'block'; }
    _atualizarProgresso();
  }
}
function _atualizarProgresso() {
  const pct = Math.round((_splashDone / _splashTotal) * 100);
  document.getElementById('sp-progress-bar').style.width = pct + '%';
  document.getElementById('sp-sub').textContent = `${_splashDone} de ${_splashTotal} tabela(s) processada(s)`;
}
function finalizarSplash(migradas, erros) {
  const temErro = erros.length > 0;
  document.getElementById('sp-title').textContent = temErro
    ? `Concluído com ${erros.length} erro(s)`
    : 'Cópia concluída!';
  document.getElementById('sp-title-icon').innerHTML = temErro
    ? '<span style="font-size:20px;line-height:1">⚠️</span>'
    : '<span class="ico-ok" style="font-size:22px">✓</span>';
  document.getElementById('sp-progress-bar').style.width = '100%';
  // Resumo
  const sumEl    = document.getElementById('sp-summary');
  const sumTitle = document.getElementById('sp-summary-title');
  const sumList  = document.getElementById('sp-summary-list');
  sumTitle.textContent = `${migradas.length} tabela(s) copiada(s) com sucesso`;
  const itens = [
    ...migradas.map(id => {
      const t = tabelas.find(x => x.id === id);
      return `<li>${esc(t?.label || id)}</li>`;
    }),
    ...erros.map(({ id, erro }) => {
      const t = tabelas.find(x => x.id === id);
      return `<li class="err" title="${esc(erro)}">${esc(t?.label || id)} — erro</li>`;
    }),
  ];
  sumList.innerHTML = itens.join('');
  sumEl.style.display = 'block';
  // Rodapé
  const ftInfo = document.getElementById('sp-ft-info');
  ftInfo.innerHTML = `<strong>${migradas.length}</strong> copiada(s)` +
    (erros.length ? `, <strong style="color:#dc2626">${erros.length}</strong> com erro` : '');
  document.getElementById('sp-btn-fechar').style.display = 'block';
}
function fecharSplash() {
  const overlay = document.getElementById('mig-splash');
  overlay.classList.remove('visible');
  setTimeout(() => { overlay.style.display = 'none'; }, 220);
  document.getElementById('confirmar').value = '';
  carregarPreview();
}
// ─── Dados ─────────────────────────────────────────────────────────────────
async function carregarMeta() {
  const data = await fetch('/api/config/migracao/meta').then(r => r.json());
  if (data.error) throw new Error(data.error);
  tabelas = data.tabelas || [];
  popularSelect('origem', data.empresas || []);
  popularSelect('destino', data.empresas || []);
  if (data.empresas?.[1]) document.getElementById('destino').value = data.empresas[1].id;
  renderTabelas();
  await carregarPreview();
}
async function carregarPreview() {
  limparMsg();
  const origem  = document.getElementById('origem').value;
  const destino = document.getElementById('destino').value;
  if (!origem || !destino) return;
  if (origem === destino) {
    preview = []; renderTabelas();
    setMsg('Escolha empresas diferentes para origem e destino.', 'err');
    return;
  }
  const params = new URLSearchParams({ origem_id: origem, destino_id: destino });
  const res  = await fetch(`/api/config/migracao/preview?${params}`);
  const data = await res.json();
  if (!res.ok) { setMsg(data.error || 'Erro ao carregar prévia.', 'err'); return; }
  preview = data.tabelas || [];
  renderTabelas();
}
// ─── Execução — uma tabela por vez para progresso real ─────────────────────
async function executarMigracao() {
  limparMsg();
  const ids      = selecionadas();
  const confirmar = document.getElementById('confirmar').value.toUpperCase().trim();
  const origemId  = Number(document.getElementById('origem').value);
  const destinoId = Number(document.getElementById('destino').value);
  if (!ids.length) { setMsg('Selecione ao menos uma tabela.', 'err'); return; }
  if (origemId === destinoId) { setMsg('Escolha empresas diferentes para origem e destino.', 'err'); return; }
  if (confirmar !== 'MIGRAR') { setMsg('Digite <strong>MIGRAR</strong> no campo de confirmação.', 'err'); return; }
  // Bloqueia botão e abre splash
  document.getElementById('btn-exec').disabled = true;
  mostrarSplash(ids);
  // Um lote_id por clique — o backend usa isso para criar apenas 1 backup para
  // toda a migração, mesmo fazendo 1 requisição por tabela (para progresso no splash).
  const loteId = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
  const migradas = [];
  const erros    = [];
  for (const tabelaId of ids) {
    atualizarSplashItem(tabelaId, 'processando');
    try {
      const res = await fetch('/api/config/migracao/executar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          origem_id:  origemId,
          destino_id: destinoId,
          tabelas:    [tabelaId],
          confirmar:  'MIGRAR',
          lote_id:    loteId,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Erro desconhecido.');
      atualizarSplashItem(tabelaId, 'ok');
      migradas.push(tabelaId);
    } catch (err) {
      atualizarSplashItem(tabelaId, 'erro', err.message);
      erros.push({ id: tabelaId, erro: err.message });
    }
  }
  document.getElementById('btn-exec').disabled = false;
  finalizarSplash(migradas, erros);
  carregarBackups();
}
// ─── Backups de migração ────────────────────────────────────────────────────
const ORIGEM_BACKUP_LABEL = { iahub: 'IAHub', iac: 'IA Command' };
function formatarTamanho(bytes) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  if (bytes < 1024 * 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  return `${(bytes / (1024 * 1024 * 1024)).toFixed(2)} GB`;
}
function formatarDataBackup(iso) {
  const d = new Date(iso);
  return d.toLocaleString('pt-BR');
}
async function carregarBackups() {
  const painel = document.getElementById('backups-panel');
  painel.innerHTML = '<div style="padding:16px;color:var(--text-lo);font-size:13px">Carregando...</div>';
  try {
    const data = await fetch('/api/config/migracao/backups').then(r => r.json());
    renderBackups(data.backups || []);
  } catch (err) {
    painel.innerHTML = `<div style="padding:16px;color:#991b1b;font-size:13px">Erro ao carregar backups: ${esc(err.message)}</div>`;
  }
}
function renderBackups(backups) {
  const painel = document.getElementById('backups-panel');
  document.getElementById('backup-count').textContent = `${backups.length} backup${backups.length === 1 ? '' : 's'}`;
  if (!backups.length) {
    painel.innerHTML = '<div style="padding:16px;color:var(--text-lo);font-size:13px">Nenhum backup encontrado.</div>';
    return;
  }
  painel.innerHTML = backups.map(b => `
    <div class="bkp-row">
      <span class="bkp-tag">${esc(ORIGEM_BACKUP_LABEL[b.origem] || b.origem)}</span>
      <div class="bkp-info">
        <div class="bkp-nome">${esc(b.nome)}</div>
        <div class="bkp-meta">${formatarDataBackup(b.criado_em)} · ${formatarTamanho(b.tamanho)}</div>
      </div>
      <button type="button" class="btn-danger-light" onclick="apagarBackup('${esc(b.origem)}', '${esc(encodeURIComponent(b.nome))}')">Apagar</button>
    </div>
  `).join('');
}
async function apagarBackup(origem, nomeCodificado) {
  const nome = decodeURIComponent(nomeCodificado);
  if (!confirm(`Apagar o backup "${nome}"? Esta ação não pode ser desfeita.`)) return;
  try {
    const res = await fetch(`/api/config/migracao/backups/${encodeURIComponent(origem)}/${nomeCodificado}`, {
      method: 'DELETE',
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Erro ao apagar backup.');
    carregarBackups();
  } catch (err) {
    alert(`Erro ao apagar backup: ${err.message}`);
  }
}
// ─── Init ──────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
  try {
    await (window._iahubAuthReady || Promise.resolve());
    await carregarMeta();
  } catch (err) {
    setMsg(err.message || 'Erro ao carregar dados.', 'err');
  }
});
</script>
</body>
</html>
