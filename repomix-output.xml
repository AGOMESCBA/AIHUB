<file path="modules/configuracoes/frontend/migrar-dados.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Migrar Dados - IAHub</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    .page-content { padding-top: 16px; }
    /* Abas da página */
    .mig-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 16px; }
    .mig-tab {
      background: none; border: none; border-bottom: 2px solid transparent;
      padding: 10px 16px; cursor: pointer; font: inherit; font-size: 13px; font-weight: 700;
      color: var(--text-md); margin-bottom: -1px;
    }
    .mig-tab:hover { color: var(--text-hi); }
    .mig-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
    .mig-layout { display: grid; grid-template-columns: minmax(280px, 360px) minmax(0, 1fr); gap: 16px; align-items: start; }
    .mig-card { border: 1px solid var(--border); background: var(--bg-card); border-radius: 8px; overflow: hidden; }
    .mig-card-hd { padding: 14px 16px; border-bottom: 1px solid var(--border); font-size: 13px; font-weight: 800; color: var(--text-hi); }
    .mig-card-bd { padding: 16px; }
    .mig-grid { display: grid; gap: 12px; }
    .mig-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
    .mig-alert { display: none; border-radius: 8px; padding: 11px 13px; font-size: 13px; line-height: 1.45; margin-top: 12px; }
    .mig-alert.show { display: block; }
    .mig-alert.ok  { color: #166534; background: #f0fdf4; border: 1px solid #bbf7d0; }
    .mig-alert.err { color: #991b1b; background: #fef2f2; border: 1px solid #fecaca; }
    .mig-alert.info { color: var(--text-md); background: var(--bg-hover); border: 1px solid var(--border); }
    .mig-confirm { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }
    .btn-light { background: var(--bg-hover); color: var(--text-hi); border: 1px solid var(--border); border-radius: 8px; padding: 8px 13px; cursor: pointer; font: inherit; font-weight: 700; }
    .btn-light:hover { border-color: var(--accent); color: var(--accent); }
    /* Painel de tabelas */
    .mig-panel-tools { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--border); background: var(--bg-hover); }
    .mig-panel-tools-left { display: flex; gap: 8px; flex-wrap: wrap; }
    #sel-count { font-size: 13px; font-variant-numeric: tabular-nums; color: var(--text-md); white-space: nowrap; }
    .mig-cols-hd {
      display: grid;
      grid-template-columns: 38px 1fr 72px 72px;
      padding: 8px 12px;
      background: var(--bg-hover);
      border-bottom: 1px solid var(--border);
      font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: var(--text-lo);
    }
    /* Sistema */
    .sys-section { border-bottom: 2px solid var(--border); }
    .sys-section:last-child { border-bottom: none; }
    .sys-hd {
      display: flex; align-items: center; gap: 10px;
      padding: 11px 14px; cursor: pointer; user-select: none;
      background: var(--bg-card); border-bottom: 1px solid var(--border);
      transition: background var(--transition);
    }
    .sys-hd:hover { background: var(--bg-hover); }
    .sys-icon { font-size: 15px; flex-shrink: 0; }
    .sys-name { font-size: 13px; font-weight: 800; color: var(--text-hi); flex: 1; }
    .sys-actions { display: flex; gap: 6px; flex-shrink: 0; }
    .btn-mini { background: var(--bg-card); color: var(--text-md); border: 1px solid var(--border); border-radius: 6px; padding: 4px 9px; cursor: pointer; font: inherit; font-size: 11px; font-weight: 700; }
    .btn-mini:hover { border-color: var(--accent); color: var(--accent); }
    .sys-chevron { font-size: 11px; color: var(--text-lo); transition: transform var(--transition); }
    .sys-chevron.closed { transform: rotate(-90deg); }
    .sys-body { max-height: 6000px; overflow: hidden; transition: max-height .35s cubic-bezier(.4,0,.2,1); }
    .sys-body.collapsed { max-height: 0; }
    /* Grupo */
    .grp-section { border-bottom: 1px solid var(--border); }
    .grp-section:last-child { border-bottom: none; }
    .grp-hd {
      display: flex; align-items: center; gap: 8px;
      padding: 8px 14px 8px 20px; cursor: pointer; user-select: none;
      background: var(--bg-hover); transition: background var(--transition);
    }
    .grp-hd:hover { background: var(--bg-base); }
    .grp-label { font-size: 11px; font-weight: 800; color: var(--accent); text-transform: uppercase; letter-spacing: .05em; flex: 1; }
    .grp-chevron { font-size: 10px; color: var(--text-lo); transition: transform var(--transition); }
    .grp-chevron.closed { transform: rotate(-90deg); }
    .grp-body { max-height: 2000px; overflow: hidden; transition: max-height .25s cubic-bezier(.4,0,.2,1); }
    .grp-body.collapsed { max-height: 0; }
    /* Linha de tabela */
    .mig-row {
      display: grid; grid-template-columns: 38px 1fr 72px 72px;
      align-items: center; padding: 9px 12px 9px 28px;
      border-bottom: 1px solid var(--border);
      transition: background var(--transition);
    }
    .mig-row:last-child { border-bottom: none; }
    .mig-row:hover { background: var(--bg-hover); }
    .mig-check { width: 17px; height: 17px; accent-color: var(--accent); cursor: pointer; }
    .mig-row-label { font-size: 13px; color: var(--text-hi); }
    .mig-num { font-size: 13px; font-variant-numeric: tabular-nums; color: var(--text-md); text-align: right; padding-right: 8px; }
    .mig-num.cheio { color: #b45309; font-weight: 700; }
    /* Linha de backup */
    .bkp-row {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; border-bottom: 1px solid var(--border);
      transition: background var(--transition);
    }
    .bkp-row:last-child { border-bottom: none; }
    .bkp-row:hover { background: var(--bg-hover); }
    .bkp-info { flex: 1; min-width: 0; }
    .bkp-nome { font-size: 12px; color: var(--text-hi); word-break: break-all; }
    .bkp-meta { font-size: 11px; color: var(--text-lo); margin-top: 2px; }
    .bkp-tag {
      font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em;
      padding: 2px 7px; border-radius: 99px; flex-shrink: 0;
      background: var(--bg-hover); color: var(--text-md); border: 1px solid var(--border);
    }
    .btn-danger-light {
      background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; border-radius: 6px;
      padding: 5px 10px; cursor: pointer; font: inherit; font-size: 11px; font-weight: 700; flex-shrink: 0;
    }
    .btn-danger-light:hover { background: #fee2e2; border-color: #fca5a5; }
    /* ── SPLASH ─────────────────────────────────────────────────────────── */
    .mig-splash-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: rgba(0,0,0,.48);
      backdrop-filter: blur(3px);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity .2s ease;
    }
    .mig-splash-overlay.visible { opacity: 1; }
    .mig-splash-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      width: min(520px, calc(100vw - 32px));
      max-height: calc(100vh - 64px);
      display: flex; flex-direction: column;
      box-shadow: 0 24px 64px rgba(0,0,0,.28);
      overflow: hidden;
    }
    .mig-splash-hd {
      padding: 22px 24px 18px;
      border-bottom: 1px solid var(--border);
    }
    .mig-splash-title {
      display: flex; align-items: center; gap: 12px;
      font-size: 17px; font-weight: 800; color: var(--text-hi);
    }
    .mig-splash-sub {
      font-size: 13px; color: var(--text-md); margin-top: 5px; margin-left: 36px;
    }
    .mig-splash-list {
      overflow-y: auto; flex: 1;
      padding: 6px 0;
    }
    .mig-splash-row {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 11px 24px;
      border-bottom: 1px solid var(--border);
      transition: background var(--transition);
    }
    .mig-splash-row:last-child { border-bottom: none; }
    .mig-splash-row.current { background: var(--bg-hover); }
    .mig-splash-row.done    { opacity: .75; }
    .mig-splash-row-icon {
      width: 24px; height: 24px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      margin-top: 1px;
    }
    .mig-splash-row-info { flex: 1; min-width: 0; }
    .mig-splash-row-label { font-size: 13px; font-weight: 600; color: var(--text-hi); }
    .mig-splash-row-meta  { font-size: 11px; color: var(--text-lo); margin-top: 2px; }
    .mig-splash-row-err   { font-size: 11px; color: #dc2626; margin-top: 3px; }
    /* Spinner */
    @keyframes _spin { to { transform: rotate(360deg); } }
    .mig-spin {
      width: 18px; height: 18px;
      border: 2px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: _spin .6s linear infinite;
    }
    /* Ícones de estado */
    .ico-pending { color: var(--text-lo); font-size: 18px; line-height: 1; }
    .ico-ok      { color: #16a34a; font-size: 18px; font-weight: 900; line-height: 1; }
    .ico-err     { color: #dc2626; font-size: 18px; font-weight: 900; line-height: 1; }
    /* Barra de progresso */
    .mig-splash-progress {
      height: 4px; background: var(--border);
      border-radius: 0;
      overflow: hidden;
    }
    .mig-splash-progress-bar {
      height: 100%; background: var(--accent);
      width: 0%; transition: width .3s ease;
      border-radius: 0;
    }
    /* Rodapé do splash */
    .mig-splash-ft {
      padding: 16px 24px;
      border-top: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }
    .mig-splash-ft-info { font-size: 13px; color: var(--text-md); }
    .mig-splash-ft-info strong { color: var(--text-hi); }
    /* Resumo final */
    .mig-splash-summary {
      padding: 16px 24px;
      border-top: 1px solid var(--border);
      background: var(--bg-hover);
    }
    .mig-splash-summary-title {
      font-size: 13px; font-weight: 800; color: var(--text-hi); margin-bottom: 6px;
    }
    .mig-splash-summary-list {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; gap: 6px;
    }
    .mig-splash-summary-list li {
      font-size: 12px; padding: 3px 9px; border-radius: 99px;
      background: var(--bg-card); border: 1px solid var(--border);
      color: var(--text-md);
    }
    .mig-splash-summary-list li.err {
      border-color: #fecaca; background: #fef2f2; color: #991b1b;
    }
    body.iac-mode { --accent: #7c3aed; }
    body.iac-mode .sidebar-logo .logo-icon { background: #7c3aed !important; }
    @media (max-width: 920px) { .mig-layout { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
<div id="mig-splash" class="mig-splash-overlay" style="display:none">
  <div class="mig-splash-card">
    <div class="mig-splash-hd">
      <div class="mig-splash-title">
        <div id="sp-title-icon" style="width:24px;height:24px;display:flex;align-items:center;justify-content:center"></div>
        <span id="sp-title">Copiando dados...</span>
      </div>
      <div class="mig-splash-sub" id="sp-sub"></div>
    </div>
    <div class="mig-splash-progress">
      <div class="mig-splash-progress-bar" id="sp-progress-bar"></div>
    </div>
    <div class="mig-splash-list" id="sp-list"></div>
    <div id="sp-summary" style="display:none" class="mig-splash-summary">
      <div class="mig-splash-summary-title" id="sp-summary-title"></div>
      <ul class="mig-splash-summary-list" id="sp-summary-list"></ul>
    </div>
    <div class="mig-splash-ft">
      <span class="mig-splash-ft-info" id="sp-ft-info"></span>
      <button class="btn btn-primary" id="sp-btn-fechar" onclick="fecharSplash()" style="display:none">
        Fechar
      </button>
    </div>
  </div>
</div>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon" id="mig-logo-icon">IA</div>
      <span class="logo-text" id="mig-logo-text">IAHub</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <span class="topbar-title">
        <span class="topbar-path" id="mig-topbar-path">Configurador &gt;</span> Copiar Dados
      </span>
    </div>
    <div class="page-content">
      <div class="mig-tabs">
        <button type="button" class="mig-tab active" data-tab="migrar" onclick="mostrarAba('migrar')">Migrar Dados</button>
        <button type="button" class="mig-tab" data-tab="backups" onclick="mostrarAba('backups')">Backups</button>
      </div>
      <div id="aba-migrar" class="mig-aba">
      <div class="mig-layout">
        <section class="mig-card">
          <div class="mig-card-hd">Origem e destino</div>
          <div class="mig-card-bd">
            <div class="mig-grid">
              <div class="form-group">
                <label class="form-label" for="origem">Empresa origem</label>
                <select class="form-control" id="origem" onchange="carregarPreview()"></select>
              </div>
              <div class="form-group">
                <label class="form-label" for="destino">Empresa destino</label>
                <select class="form-control" id="destino" onchange="carregarPreview()"></select>
              </div>
            </div>
            <div class="mig-alert info show">
              Para cada tabela marcada, os dados da origem <strong>substituem</strong> os dados do destino —
              o conteúdo atual do destino nessa tabela é apagado antes da cópia (não é somado/adicionado).
              A origem não é alterada. Antes de gravar, o sistema cria um backup automático (arquivo da empresa
              destino para tabelas IAHub, banco do IA Command para tabelas IA Command) na pasta <code>backups/</code>
              de cada módulo. A restauração, se necessário, é manual — feita por quem administra o servidor.
            </div>
