                  <input id="cur-campo-emp-id" class="form-control" placeholder="ex: EMP_ID">
                </div>
                <div>
                  <label class="form-label">Campo Empresa Nome (opcional)</label>
                  <input id="cur-campo-emp-nome" class="form-control" placeholder="ex: EMP_NOME">
                </div>
              </div>
            </div>
            <div id="cur-flow-fields" style="display:none">
              <label class="form-label">Flow a executar</label>
              <select id="cur-flow-id" class="form-control" style="max-width:420px">
                <option value="">Carregando flows...</option>
              </select>
              <div style="font-size:11.5px;color:var(--text-lo);margin-top:6px">
                Configure flows no <a href="/se-api-configurador.html" style="color:var(--accent)">SE API Configurador</a>.
                Cada Config deve ter <strong>Tabela de Origem: currículos</strong>.
              </div>
            </div>
            <div id="cur-grid-fields" style="display:none">
              <label class="form-label">Flow a executar (GRID)</label>
              <select id="cur-grid-flow-id" class="form-control" style="max-width:420px">
                <option value="">Carregando flows...</option>
              </select>
              <div style="font-size:11.5px;color:var(--text-lo);margin-top:6px">
                Configure um Flow no <a href="/se-api-configurador.html" style="color:var(--accent)">SE API Configurador</a> com:<br>
                • <strong>Step 1:</strong> Config tipo <strong>GRID</strong> — template com <code>{{workflow_id}}</code> e <code>{{grid_rows}}</code><br>
                • <strong>Step 2 (opcional):</strong> Config tipo <strong>MOVE</strong> — para avançar atividade após inserir os candidatos<br>
                O <code>{{workflow_id}}</code> é preenchido automaticamente com o WorkflowID da vaga integrada.
              </div>
            </div>
            <div class="save-row">
              <button class="btn btn-primary" onclick="salvarCurriculos()">Salvar Configuração</button>
              <span id="cur-msg" class="cfg-status"></span>
