<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Noticias & Sentimento - Crypto Radar AI</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="./css/master-crypto.css">
  <style>
    body { background: var(--bg-base, #f8fafc); padding: 16px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .news-list { display:flex; flex-direction:column; gap:10px; }
    .news-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 16px; box-shadow: var(--shadow-sm); }
    .news-card h4 { margin: 0 0 6px; color: var(--text-hi); font-size: 15px; }
    .news-card p { margin: 0; color: var(--text-md); font-size: 13px; line-height: 1.5; }
    .news-meta { font-size: 11px; color: var(--text-lo); font-weight: 800; margin-top: 8px; text-transform: uppercase; }
    .empty-state { height:220px; display:flex; align-items:center; justify-content:center; color:var(--text-lo); font-weight:800; }
  </style>
</head>
<body>
  <div class="page-kicker">ESTRATEGIAS / NOTICIAS & SENTIMENTO</div>
  <div class="head-row">
    <div class="head-title">
      <span>Noticias & Sentimento Macro</span>
      <span class="head-count" id="statusText">carregando...</span>
    </div>
    <div class="head-actions">
      <button class="btn btn-secondary" type="button" onclick="loadNews()">Atualizar</button>
    </div>
  </div>
  <div class="meta-grid" id="sentimentGrid"></div>
  <div class="news-list" id="newsList"></div>
  <div class="empty-state" id="emptyState" style="display:none">Nenhuma noticia retornada pelo motor</div>
  <script src="/js/auth.js"></script>
  <script>
    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
    }
    function firstDefined(obj, keys, fallback = '-') {
      for (const key of keys) if (obj && obj[key] != null && obj[key] !== '') return obj[key];
      return fallback;
    }
    function renderSentiment(summary) {
      document.getElementById('sentimentGrid').innerHTML = `
        <div class="meta-item"><span>Sentimento geral</span><strong>${esc(firstDefined(summary, ['overall_sentiment', 'sentiment', 'label']))}</strong></div>
        <div class="meta-item"><span>Score macro</span><strong class="text-positive">${esc(firstDefined(summary, ['score', 'sentiment_score', 'impact_score'], 0))}</strong></div>
        <div class="meta-item"><span>Noticias avaliadas</span><strong>${esc(firstDefined(summary, ['news_count', 'count'], '-'))}</strong></div>
        <div class="meta-item"><span>Modo</span><strong>Feed protegido IAHUB</strong></div>
      `;
    }
    function renderArticles(articles) {
      const list = document.getElementById('newsList');
      const empty = document.getElementById('emptyState');
      list.innerHTML = articles.map(article => {
        const title = firstDefined(article, ['title_pt', 'title', 'headline']);
        const summary = firstDefined(article, ['summary_pt', 'summary', 'description'], '');
        const source = firstDefined(article, ['source', 'publisher']);
        const sentiment = firstDefined(article, ['sentiment_pt', 'sentiment']);
        const impact = firstDefined(article, ['impact_score', 'score']);
        return `
          <article class="news-card">
            <h4>${esc(title)}</h4>
            <p>${esc(summary)}</p>
            <div class="news-meta">${esc(source)} - Sentimento: ${esc(sentiment)} - Impacto ${esc(impact)}</div>
          </article>
        `;
      }).join('');
      empty.style.display = articles.length ? 'none' : 'flex';
    }
    async function loadNews() {
      await (window._iahubAuthReady || Promise.resolve());
      document.getElementById('statusText').textContent = 'consultando feed...';
      try {
        const data = await fetch('/api/master-crypto/news/feed?limit=10').then(r => r.json());
        const summary = data.sentiment_summary || {};
        renderSentiment({ ...summary, news_count: data.news_count });
        renderArticles(Array.isArray(data.articles) ? data.articles : []);
        document.getElementById('statusText').textContent = `${Number(data.news_count || 0)} noticias`;
      } catch (_) {
        document.getElementById('statusText').textContent = 'backend indisponivel';
        renderSentiment({});
        renderArticles([]);
      }
    }
    window.addEventListener('DOMContentLoaded', loadNews);
  </script>
</body>
</html>
</file>

<file path="apps/Master Crypto/frontend/paper-trading.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Paper Trading - Crypto Radar AI</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="./css/master-crypto.css">
  <style>
    body { background: #f8fafc; padding: 16px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .head-title { margin-bottom: 12px; }
    .empty-state { height: 220px; display: flex; align-items: center; justify-content: center; color: var(--text-lo); font-weight: 800; }
    .status-line { font-size: 12px; color: var(--text-lo); margin-bottom: 12px; }
  </style>
</head>
<body>
<div class="page-kicker">SIMULACAO / PAPER TRADING</div>
<div class="head-row">
  <div>
    <div class="head-title">Gestao de Banca Virtual & Ordens Simuladas</div>
    <div class="status-line" id="statusLine">Carregando dados da empresa...</div>
  </div>
  <div class="head-actions">
    <button class="btn btn-secondary" type="button" onclick="loadPaperTrading()">Atualizar</button>
  </div>
</div>
<div class="meta-grid">
  <div class="meta-item"><span>Banca Virtual Atual</span><strong class="text-positive" id="balanceValue">-</strong></div>
  <div class="meta-item"><span>Win Rate Simulado</span><strong class="text-positive" id="winRateValue">-</strong></div>
  <div class="meta-item"><span>Profit Factor</span><strong id="profitFactorValue">-</strong></div>
  <div class="meta-item"><span>Lucro Total Acumulado</span><strong id="netPnlValue">-</strong></div>
</div>
<div class="table-card">
  <div class="table-wrap" style="min-height:320px">
    <table class="history-table">
      <thead>
        <tr>
          <th>Ativo</th>
          <th>Estrategia</th>
          <th>Entrada</th>
          <th>Stop Loss</th>
          <th>Alvo T2</th>
          <th>Quantidade</th>
          <th>R/R</th>
          <th>Acao</th>
        </tr>
      </thead>
      <tbody id="activeTradesBody"></tbody>
    </table>
    <div class="empty-state" id="emptyState" style="display:none">Nenhuma ordem simulada aberta nesta empresa</div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script>
  const fmtUsd = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'USD' });
  const fmtPct = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 2 });
  function esc(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }
  function setMetric(id, value, positive = null) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = value;
    if (positive !== null) {
      el.classList.toggle('text-positive', positive);
      el.classList.toggle('text-negative', !positive);
    }
  }
  async function loadPaperTrading() {
    await (window._iahubAuthReady || Promise.resolve());
    const status = document.getElementById('statusLine');
    status.textContent = 'Atualizando dados da empresa...';
    try {
      const [metrics, active] = await Promise.all([
        fetch('/api/master-crypto/paper/metrics').then(r => r.json()),
        fetch('/api/master-crypto/paper/active').then(r => r.json()),
      ]);
      const net = Number(metrics.net_pnl_usd || 0);
      setMetric('balanceValue', fmtUsd.format(Number(metrics.current_balance_usd || 0)), true);
      setMetric('winRateValue', `${fmtPct.format(Number(metrics.win_rate_pct || 0))}%`, true);
      setMetric('profitFactorValue', String(metrics.profit_factor ?? '0'));
      setMetric('netPnlValue', `${net >= 0 ? '+' : ''}${fmtUsd.format(net)}`, net >= 0);
      renderTrades(Array.isArray(active.trades) ? active.trades : []);
      status.textContent = `Dados carregados para ${window._iahubEmpresa?.nome || 'empresa selecionada'}.`;
    } catch (err) {
      status.textContent = 'Nao foi possivel carregar o Paper Trading desta empresa.';
      renderTrades([]);
    }
  }
  function renderTrades(trades) {
    const tbody = document.getElementById('activeTradesBody');
    const empty = document.getElementById('emptyState');
    tbody.innerHTML = '';
    empty.style.display = trades.length ? 'none' : 'flex';
    trades.forEach(trade => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><strong>${esc(trade.symbol)}</strong></td>
        <td>${esc(trade.strategy)}</td>
        <td>${fmtUsd.format(Number(trade.simulated_fill_price || trade.entry_price || 0))}</td>
        <td><span class="text-negative">${fmtUsd.format(Number(trade.stop_loss || 0))}</span></td>
        <td><span class="text-positive">${fmtUsd.format(Number(trade.target_t2 || 0))}</span></td>
        <td>${Number(trade.quantity || 0).toFixed(6)}</td>
        <td>1:${esc(trade.risk_reward_ratio || '-')}</td>
        <td><button class="btn btn-sm btn-danger" type="button" onclick="closeTrade('${esc(trade.id)}', '${esc(trade.symbol)}')">Encerrar</button></td>
      `;
      tbody.appendChild(tr);
    });
  }
  async function closeTrade(tradeId, symbol) {
    const status = document.getElementById('statusLine');
    const cleanSymbol = String(symbol || '').replace('/', '').toUpperCase();
    if (!cleanSymbol) return;
    status.textContent = `Consultando preco real da Binance para ${cleanSymbol}...`;
    try {
      const priceData = await fetch(`/api/master-crypto/market/price?symbol=${encodeURIComponent(cleanSymbol)}`).then(r => {
        if (!r.ok) throw new Error('price');
        return r.json();
      });
      const current = Number(priceData.price || 0);
      if (!current || current <= 0) throw new Error('invalid-price');
      const res = await fetch('/api/master-crypto/paper/close', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trade_id: tradeId, current_market_price: current }),
      });
      if (!res.ok) throw new Error('close');
      await loadPaperTrading();
    } catch (_) {
      status.textContent = 'Nao foi possivel buscar preco real na Binance para encerrar a ordem simulada.';
    }
  }
  window.addEventListener('DOMContentLoaded', loadPaperTrading);
</script>
</body>
</html>
</file>

<file path="apps/Master Crypto/frontend/plano-trade.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Plano de Trade - Crypto Radar AI</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="./css/master-crypto.css">
  <style>
    body { background: var(--bg-base, #f8fafc); padding: 16px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .trade-shell { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(320px, .8fr); gap: 14px; }
    .chart-box { background: #0b0e11; border: 1px solid #1f2937; border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 14px; min-height: 320px; }
    .chart-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; color:#e5e7eb; }
    .chart-head strong { color:#f8fafc; }
    canvas.binance-chart { width: 100%; height: 260px; display:block; background:#0b0e11; border-radius:8px; }
    .side-stack { display:flex; flex-direction:column; gap:12px; }
    .plan-note { color: var(--text-md); font-size: 13px; line-height: 1.55; margin: 0; }
    .status-line { font-size:12px; color:var(--text-lo); margin-top:8px; }
    @media (max-width: 980px) { .trade-shell { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <div class="page-kicker">ANALISE / PLANO DE TRADE</div>
  <div class="head-row">
    <div class="head-title">
      <span id="pageTitle">Plano de Trade</span>
      <span class="head-count" id="pageSub">carregando...</span>
    </div>
    <div class="head-actions">
      <button class="btn btn-secondary" type="button" onclick="loadPlan()">Atualizar</button>
      <button class="btn btn-primary" type="button" onclick="startPaperTrade()">Simular compra</button>
    </div>
  </div>
  <div class="trade-shell">
    <section class="chart-box">
      <div class="chart-head">
        <strong id="chartTitle">Grafico Binance Pro</strong>
        <span id="chartMeta">4H</span>
      </div>
      <canvas id="tradeCanvas" class="binance-chart"></canvas>
    </section>
    <aside class="side-stack">
      <div class="meta-grid" id="planGrid"></div>
      <div class="meta-item">
        <span>Leitura operacional</span>
        <p class="plan-note" id="planNote">Aguardando scanner.</p>
        <div class="status-line" id="paperStatus"></div>
      </div>
      <div class="meta-item">
        <span>Criterio IAHUB</span>
        <p class="plan-note">A oportunidade vem do scanner global. A execucao simulada, banca e historico sao gravados somente na empresa ativa desta aba.</p>
      </div>
    </aside>
  </div>
  <script src="/js/auth.js"></script>
  <script>
    let selectedOpportunity = null;
    let candles = [];
    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
    }
    function normalizeOpportunity(raw) {
      const score = raw.opportunity || {};
      const plan = raw.trade_plan || score.trade_plan || {};
      const position = raw.position_sizing || {};
      const totalScore = Number(raw.opportunity_score ?? score.total_score ?? raw.score ?? 0);
      const entryMin = Number(plan.entry_zone_min ?? raw.entry_min ?? 0);
      const entryMax = Number(plan.entry_zone_max ?? raw.entry_max ?? 0);
      const stop = Number(plan.stop_loss ?? raw.stop_loss ?? 0);
      const target2 = Number(plan.target_t2 ?? raw.target_2 ?? 0);
      return {
        symbol: raw.symbol || score.symbol || plan.symbol || '-',
        score: totalScore,
        strategy: raw.strategy || plan.strategy || '-',
        entryLabel: entryMin && entryMax ? `${entryMin.toFixed(2)} - ${entryMax.toFixed(2)}` : '-',
        stopLabel: stop ? stop.toFixed(2) : '-',
        targetLabel: target2 ? target2.toFixed(2) : '-',
        rr: Number(plan.risk_reward_ratio ?? raw.risk_reward_ratio ?? 0),
        potential: Number(plan.potential_gain_pct || 0),
        plan,
        positionSizeUsd: Number(position.position_size_usd || 200),
        currentPrice: Number(raw.current_price || raw.last_price || (entryMin && entryMax ? (entryMin + entryMax) / 2 : 0)),
      };
    }
    function renderEmpty(message) {
      document.getElementById('pageSub').textContent = 'sem oportunidade';
      document.getElementById('planGrid').innerHTML = '<div class="meta-item"><span>Status</span><strong>Nenhum plano ativo</strong></div>';
      document.getElementById('planNote').textContent = message;
      drawChart([]);
    }
    function renderPlan(op) {
      document.getElementById('pageTitle').textContent = `Plano Estrategico - ${op.symbol}`;
      document.getElementById('pageSub').textContent = `${op.strategy} - Score ${op.score.toFixed(0)}/100`;
      document.getElementById('chartTitle').textContent = `${op.symbol} / Binance`;
      document.getElementById('planGrid').innerHTML = `
        <div class="meta-item"><span>Entrada ideal</span><strong style="color:#2563eb">${esc(op.entryLabel)}</strong></div>
        <div class="meta-item"><span>Stop loss tecnico</span><strong class="text-negative">${esc(op.stopLabel)}</strong></div>
        <div class="meta-item"><span>Alvo T2</span><strong class="text-positive">${esc(op.targetLabel)}</strong></div>
        <div class="meta-item"><span>Risco/Retorno</span><strong>${op.rr ? `1:${op.rr}` : '-'}</strong></div>
      `;
      document.getElementById('planNote').textContent = `Setup ${op.strategy} com potencial estimado de ${op.potential ? op.potential.toFixed(2) + '%' : '-'} no alvo T2. Antes de executar, confira se o preco esta dentro da zona de entrada e respeite o risco configurado para a empresa.`;
    }
    async function loadPlan() {
      await (window._iahubAuthReady || Promise.resolve());
      document.getElementById('pageSub').textContent = 'carregando...';
      try {
        const summary = await fetch('/api/master-crypto/company/summary').then(r => r.json()).catch(() => ({}));
        const settings = summary.settings || {};
        const timeframe = settings.scanner_timeframe || '4h';
        const topLimit = Number(settings.scanner_top_limit || 20);
        document.getElementById('chartMeta').textContent = timeframe.toUpperCase();
        const data = await fetch(`/api/master-crypto/opportunities/active?top_limit=${topLimit}&timeframe=${encodeURIComponent(timeframe)}`).then(r => r.json());
        const list = Array.isArray(data.opportunities) ? data.opportunities : [];
        if (!list.length) {
          selectedOpportunity = null;
          renderEmpty('O scanner nao retornou uma oportunidade valida no momento.');
          return;
        }
        selectedOpportunity = normalizeOpportunity(list[0]);
        renderPlan(selectedOpportunity);
        await loadCandles(selectedOpportunity.symbol, timeframe);
      } catch (_) {
        selectedOpportunity = null;
        renderEmpty('Nao foi possivel carregar o plano pelo backend agora.');
      }
    }
    async function loadCandles(symbol, timeframe) {
      try {
        const cleanSymbol = String(symbol).replace('/', '');
        const data = await fetch(`/api/master-crypto/market/candles?symbol=${encodeURIComponent(cleanSymbol)}&interval=${encodeURIComponent(timeframe)}&limit=60`).then(r => r.json());
        candles = Array.isArray(data.candles) ? data.candles : [];
      } catch (_) {
        candles = [];
      }
      drawChart(candles);
    }
    function candleValue(candle, key, fallbackIndex) {
      if (Array.isArray(candle)) return Number(candle[fallbackIndex]);
      return Number(candle[key] ?? candle[key.toUpperCase()] ?? 0);
    }
    function drawChart(rows) {
      const canvas = document.getElementById('tradeCanvas');
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      ctx.fillStyle = '#0b0e11';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = '#1f2937';
      for (let i = 1; i < 5; i += 1) {
        const y = (canvas.height / 5) * i;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }
      if (!rows.length) {
        ctx.fillStyle = '#94a3b8';
        ctx.font = '13px Segoe UI';
        ctx.fillText('Sem candles disponiveis', 18, 34);
        return;
      }
      const slice = rows.slice(-50);
      const highs = slice.map(c => candleValue(c, 'high', 2));
      const lows = slice.map(c => candleValue(c, 'low', 3));
      const max = Math.max(...highs);
      const min = Math.min(...lows);
      const range = Math.max(max - min, 1);
      const gap = canvas.width / slice.length;
      slice.forEach((candle, index) => {
        const open = candleValue(candle, 'open', 1);
        const high = candleValue(candle, 'high', 2);
        const low = candleValue(candle, 'low', 3);
        const close = candleValue(candle, 'close', 4);
        const x = index * gap + gap / 2;
        const yHigh = canvas.height - ((high - min) / range) * (canvas.height - 22) - 11;
        const yLow = canvas.height - ((low - min) / range) * (canvas.height - 22) - 11;
        const yOpen = canvas.height - ((open - min) / range) * (canvas.height - 22) - 11;
        const yClose = canvas.height - ((close - min) / range) * (canvas.height - 22) - 11;
        ctx.strokeStyle = close >= open ? '#0ecb81' : '#ef4444';
        ctx.fillStyle = ctx.strokeStyle;
        ctx.beginPath();
        ctx.moveTo(x, yHigh);
        ctx.lineTo(x, yLow);
        ctx.stroke();
        ctx.fillRect(x - Math.max(gap * .28, 2), Math.min(yOpen, yClose), Math.max(gap * .56, 4), Math.max(Math.abs(yClose - yOpen), 2));
      });
    }
    async function startPaperTrade() {
      const status = document.getElementById('paperStatus');
      if (!selectedOpportunity?.plan?.symbol) {
        status.textContent = 'Nenhum plano valido carregado para simulacao.';
        return;
      }
      status.textContent = 'Registrando simulacao nesta empresa...';
      const tradeId = `${selectedOpportunity.symbol}-${Date.now()}`.replace(/[^A-Za-z0-9_-]/g, '_');
      try {
        const res = await fetch('/api/master-crypto/paper/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            trade_id: tradeId,
            symbol: selectedOpportunity.symbol,
            current_market_price: selectedOpportunity.currentPrice,
            trade_plan: selectedOpportunity.plan,
            position_size_usd: selectedOpportunity.positionSizeUsd,
          }),
        });
        const data = await res.json().catch(() => ({}));
        status.textContent = res.ok && data.status !== 'REJECTED'
          ? 'Compra simulada registrada na empresa atual.'
          : (data.reason || 'Nao foi possivel registrar a simulacao.');
      } catch (_) {
        status.textContent = 'Backend indisponivel para paper trading.';
      }
    }
    window.addEventListener('resize', () => drawChart(candles));
    window.addEventListener('DOMContentLoaded', loadPlan);
  </script>
</body>
</html>
</file>

