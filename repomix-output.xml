          <button class="btn btn-primary btn-dl" id="btnDownload" onclick="baixarInstalador()">
            ⬇ Baixar
          </button>
        </div>
      </div>
      <div class="card">
        <div class="card-title"><span>🗂</span> Último Instalador Gerado</div>
        <div id="lastBuildEmpty" style="font-size:13px;color:var(--text-lo)">Nenhum instalador gerado ainda nesta sessão.</div>
        <div class="last-build" id="lastBuild">
          <div class="lb-icon" id="lbIcon"></div>
          <div class="lb-info">
            <div class="lb-name" id="lbNome"></div>
            <div id="lbSize" style="font-size:12px;color:var(--text-lo);margin-top:2px"></div>
          </div>
          <button class="btn btn-secondary" onclick="baixarUltimo()">⬇ Baixar</button>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/iahub-auth.js"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
  let _statusData  = null;
  let _arquivoAtual = null;
  // ── Utilitários ─────────────────────────────────────────────────────────────
  function formatBytes(b) {
    if (b == null) return '';
    if (b < 1024)        return b + ' B';
    if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
    return (b / 1024 / 1024).toFixed(2) + ' MB';
  }
  function log(msg, tipo) {
    const box = document.getElementById('logBox');
    box.classList.add('show');
    const cls = tipo === 'ok' ? 'log-ok' : tipo === 'warn' ? 'log-warn' : tipo === 'err' ? 'log-err' : '';
    box.innerHTML += (cls ? `<span class="${cls}">` : '') + msg + (cls ? '</span>' : '') + '\n';
    box.scrollTop = box.scrollHeight;
  }
  function setProgress(pct, label) {
    const wrap = document.getElementById('progressWrap');
    wrap.classList.add('show');
    document.getElementById('progressBar').style.width  = pct + '%';
    document.getElementById('progressLabel').textContent = label;
    if (pct >= 100) {
      document.getElementById('progressBar').style.background = '#22c55e';
    }
  }
  // ── Carregar status ──────────────────────────────────────────────────────────
  async function carregarStatus() {
    try {
      const r = await fetch('/api/ia-command/admin/instalador-agente/status');
      if (!r.ok) throw new Error(await r.text());
      _statusData = await r.json();
      renderStatus(_statusData);
    } catch (e) {
      document.getElementById('statusLoading').textContent = 'Erro ao verificar ambiente: ' + e.message;
    }
  }
  function renderStatus(d) {
    document.getElementById('statusLoading').style.display = 'none';
    document.getElementById('statusContent').style.display = 'block';
    const badgeEl = document.getElementById('isccBadge');
    if (d.isccDisponivel) {
      badgeEl.innerHTML = '<span class="badge-ok">✅ Inno Setup disponível → .exe</span>';
      document.getElementById('isccPathWrap').style.display = 'flex';
      document.getElementById('isccPath').textContent = d.isccPath;
      document.getElementById('alertISCCOk').style.display = 'flex';
    } else {
      badgeEl.innerHTML = '<span class="badge-warn">⚠ Inno Setup ausente → .zip</span>';
      document.getElementById('alertISCC').style.display = 'flex';
    }
    document.getElementById('agenteDir').textContent = d.agenteDir;
    if (d.ultimoNome) {
      renderUltimo(d.ultimoNome, d.ultimoTamanho);
    }
  }
  function renderUltimo(nome, tamanho) {
    document.getElementById('lastBuildEmpty').style.display = 'none';
    const lb = document.getElementById('lastBuild');
    lb.classList.add('show');
    document.getElementById('lbIcon').textContent = nome.endsWith('.exe') ? '📦' : '🗜';
    document.getElementById('lbNome').textContent  = nome;
    document.getElementById('lbSize').textContent  = tamanho ? formatBytes(tamanho) : '';
    lb.dataset.arquivo = nome;
  }
  // ── Gerar instalador ─────────────────────────────────────────────────────────
  async function gerarInstalador(formato) {
    const versao = document.getElementById('inputVersao').value.trim();
    if (!versao || !/^\d+\.\d+/.test(versao)) {
      alert('Informe uma versão válida (ex: 1.0.0).');
      return;
    }
    const btnExe = document.getElementById('btnGerarExe');
    const btnZip = document.getElementById('btnGerarZip');
    btnExe.disabled = true;
    btnZip.disabled = true;
    const btn = formato === 'zip' ? btnZip : btnExe;
    const originalText = btn.textContent;
    btn.textContent = formato === 'zip' ? '⏳ Gerando ZIP...' : '⏳ Gerando EXE...';
    // Reset UI
    document.getElementById('logBox').innerHTML     = '';
    document.getElementById('logBox').classList.remove('show');
    document.getElementById('resultDownload').classList.remove('show');
    document.getElementById('progressWrap').classList.remove('show');
    document.getElementById('progressBar').style.background = 'var(--accent)';
    log('Iniciando geração do instalador v' + versao + ' em ' + formato.toUpperCase() + '...');
    setProgress(15, 'Empacotando arquivos do Agente Local...');
    try {
      const r = await fetch('/api/ia-command/admin/instalador-agente/gerar', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ versao, formato }),
      });
      setProgress(75, formato === 'zip' ? 'Compactando instalador...' : 'Compilando instalador...');
      const data = await r.json();
      if (!data.ok) {
        log('━━━ ERRO ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'err');
        log((data.erro || 'Falha desconhecida.'), 'err');
        if (data.saidaCompleta) {
          log('━━━ SAÍDA COMPLETA DO ISCC ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
          log(data.saidaCompleta);
        }
        setProgress(100, '✗ Falha na geração');
        document.getElementById('progressBar').style.background = '#ef4444';
        return;
      }
      setProgress(100, '✓ Instalador gerado com sucesso!');
      if (data.aviso) log('AVISO: ' + data.aviso, 'warn');
      if (data.saida) log(data.saida);
      log('Arquivo gerado: ' + data.arquivo, 'ok');
      _arquivoAtual = data.arquivo;
      // Mostrar área de download
      const isExe = data.arquivo.endsWith('.exe');
      document.getElementById('rdNome').textContent = data.arquivo;
      document.getElementById('rdSize').textContent  = isExe
        ? 'Instalador Windows (.exe) — wizard com seleção de diretório'
        : 'Pacote compactado (.zip) — extraia e execute o instalador';
      document.getElementById('resultDownload').classList.add('show');
      // Atualizar "último gerado"
      renderUltimo(data.arquivo, null);
      document.getElementById('lastBuild').dataset.arquivo = data.arquivo;
    } catch (e) {
      log('Erro de comunicação: ' + e.message, 'err');
      setProgress(100, '✗ Erro');
      document.getElementById('progressBar').style.background = '#ef4444';
    } finally {
      btnExe.disabled = false;
      btnZip.disabled = false;
      btn.textContent = originalText;
    }
  }
  // ── Download ─────────────────────────────────────────────────────────────────
  function baixarInstalador() {
    if (!_arquivoAtual) return;
    window.location = `/api/ia-command/admin/instalador-agente/download?arquivo=${encodeURIComponent(_arquivoAtual)}`;
  }
  function baixarUltimo() {
    const lb  = document.getElementById('lastBuild');
    const arq = lb.dataset.arquivo;
    if (arq) window.location = `/api/ia-command/admin/instalador-agente/download?arquivo=${encodeURIComponent(arq)}`;
  }
  // ── Init ──────────────────────────────────────────────────────────────────────
  carregarStatus();
</script>
</body>
</html>
