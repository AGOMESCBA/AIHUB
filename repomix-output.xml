<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script>
  let table, gp;
  let _sqlAtual = '';
  let _grupoVisivel = false;
  function toggleGrupo() {
    _grupoVisivel = !_grupoVisivel;
    document.getElementById('grupo-area').style.display = _grupoVisivel ? '' : 'none';
    document.getElementById('btn-grupo').textContent = _grupoVisivel ? '- Ocultar agrupamento' : '+ Mostrar agrupamento';
    if (table) table.setHeight(_grupoVisivel ? 'calc(100vh - 240px)' : 'calc(100vh - 172px)');
    if (_grupoVisivel && gp) setTimeout(() => gp.refresh(), 50);
  }
  const MODULOS = {
    compras:     { label: 'Compras',     icon: '📦', badge: 'badge-info' },
    faturamento: { label: 'Faturamento', icon: '🧾', badge: 'badge-warn' },
    financeiro:  { label: 'Financeiro',  icon: '🏦', badge: 'badge-ok' },
    comissao:    { label: 'Comissão',    icon: '💰', badge: 'badge-purple' },
  };
  function formatMs(ms) {
    if (ms == null) return '—';
    return ms < 1000 ? `${ms}ms` : `${(ms / 1000).toFixed(1)}s`;
  }
  const fmtData = (iso) => {
    if (!iso) return '—';
    const d = new Date(iso);
    return d.toLocaleString('pt-BR', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });
  };
  const prettyJson = (v) => {
    if (!v) return '[]';
    try { return JSON.stringify(typeof v === 'string' ? JSON.parse(v) : v, null, 2); }
    catch (_) { return String(v); }
  };
  const badgeModulo = (v) => {
    if (!v) return '<span style="color:var(--text-lo);font-size:12px">—</span>';
    const m = MODULOS[v];
    if (!m) return `<span class="badge-info">${v}</span>`;
    return `<span class="${m.badge}">${m.icon} ${m.label}</span>`;
  };
  const badgeStatus = (v) => {
    if (!v) return '<span class="badge-warn">—</span>';
    if (v === 'sucesso_ai_sql' || v === 'sucesso') return '<span class="badge-ok">✓ Sucesso</span>';
    if (v === 'erro')      return '<span class="badge-fail">✗ Erro</span>';
    if (v === 'sem_dados') return '<span class="badge-warn">⚠ Sem dados</span>';
    if (v === 'dialogo')   return '<span class="badge-info">💬 Diálogo</span>';
    return `<span class="badge-info">${v}</span>`;
  };
  // Lê ?modulo= da URL para pré-filtrar por header filter
  const _urlParams = new URLSearchParams(location.search);
  const _moduloInicial = _urlParams.get('modulo') || '';
  function inicializarTabela(dados) {
    if (table) { table.replaceData(dados); return; }
    if (!gp) gp = createGroupPanel({
      chipsRowId:'gp-chips-row', dropZoneId:'dz',
      storageKey:'iac_admin_logs_consultas_group', getTable:()=>table,
      onChange: (fields) => {
        const el = document.getElementById('grupo-status');
        if (el) el.textContent = fields.length ? `${fields.length} campo(s) agrupado(s)` : 'Sem agrupamento ativo';
      },
    });
    table = new Tabulator('#grid-logs', {
      data: dados,
      layout: 'fitColumns',
      height: 'calc(100vh - 172px)',
      movableColumns: true,
      groupBy: gp.getActiveFields(),
      groupStartOpen: true,
      placeholder: 'Nenhuma consulta encontrada.',
      tableBuilt: () => {
        gp.refresh(); gp.applyToTable();
        if (_moduloInicial) table.setHeaderFilterValue('modulo', _moduloInicial);
      },
      rowClick: (e, row) => abrirDetalhe(row.getData()),
      columns: [
        {
          title: 'Data/Hora', field: 'criado_em', width: 155, sorter: 'string', sorterParams:{alignEmptyValues:'bottom'},
          formatter: c => fmtData(c.getValue()),
          headerFilter: false, groupable: false,
        },
        {
          title: 'Módulo', field: 'modulo', width: 130,
          headerFilter: 'select',
          headerFilterParams: { values: { '':'Todos', compras:'Compras', faturamento:'Faturamento', financeiro:'Financeiro', comissao:'Comissão' } },
          formatter: c => badgeModulo(c.getValue()),
        },
        {
          title: 'Pergunta', field: 'texto_original', minWidth: 220, sorter: 'string',
          headerFilter: 'input',
          formatter: c => {
            const v = c.getValue() || '';
            return `<span title="${v.replace(/"/g,'&quot;')}">${v.length > 75 ? v.slice(0,75)+'…' : v}</span>`;
          },
        },
        {
          title: 'SQL gerado', field: 'sql_gerado', minWidth: 160, sorter: 'string',
          headerFilter: 'input',
          formatter: c => {
            const v = c.getValue() || '';
            if (!v) return '<span style="color:var(--text-lo)">—</span>';
            const trecho = v.replace(/\s+/g,' ').slice(0, 65);
            return `<code style="font-size:11px;color:var(--text-md)">${trecho}${v.length > 65 ? '…' : ''}</code>`;
          },
        },
        {
          title: 'Status', field: 'resultado_tipo', width: 130,
          headerFilter: 'select',
          headerFilterParams: { values: { '':'Todos', sucesso_ai_sql:'Sucesso', sucesso:'Sucesso (geral)', erro:'Erro', sem_dados:'Sem dados', dialogo:'Diálogo' } },
          formatter: c => badgeStatus(c.getValue()),
        },
        {
          title: 'Rows', field: 'rows_count', width: 75, sorter: 'number', hozAlign: 'right',
          formatter: c => c.getValue() != null ? c.getValue().toLocaleString('pt-BR') : '—',
          headerFilter: false,
        },
        {
          title: 'Provider', field: 'provedor', width: 95,
          headerFilter: 'input',
          formatter: c => c.getValue() || '—',
        },
        {
          title: 'Proc.', field: 'duracao_ms', width: 80, sorter: 'number', hozAlign: 'right',
          formatter: c => formatMs(c.getValue()),
          headerFilter: false,
          groupable: false,
        },
        {
          title: 'Pipeline', field: 'pipeline_ms', width: 85, sorter: 'number', hozAlign: 'right',
          formatter: c => formatMs(c.getValue()),
          headerFilter: false,
          groupable: false,
        },
        {
          title: 'Entregue', field: 'entregue_ms', width: 85, sorter: 'number', hozAlign: 'right',
          formatter: c => formatMs(c.getValue()),
          headerFilter: false,
          groupable: false,
        },
        {
          title: '', field: 'id', width: 60, hozAlign: 'center', headerFilter: false, groupable: false, resizable: false, sorter: false,
          formatter: (cell) => {
            const btn = document.createElement('button');
            btn.className = 'btn-icon';
            btn.title = 'Ver detalhes';
            btn.textContent = '🔍';
            btn.addEventListener('click', e => { e.stopPropagation(); abrirDetalhe(cell.getRow().getData()); });
            return btn;
          },
        },
      ],
    });
  }
  function abrirDetalhe(row) {
    _sqlAtual = row.sql_gerado || '';
    const m = MODULOS[row.modulo];
    document.getElementById('d-title').textContent    = 'Detalhe da Consulta';
    document.getElementById('d-subtitle').textContent = fmtData(row.criado_em);
    document.getElementById('d-pergunta').textContent = row.texto_original || '—';
    document.getElementById('d-sql').textContent      = row.sql_gerado || '(SQL não registrado)';
    document.getElementById('d-resposta').textContent = row.resposta_entregue || '—';
    document.getElementById('d-trace').textContent    = prettyJson(row.trace_json);
    document.getElementById('d-data').textContent     = fmtData(row.criado_em);
    document.getElementById('d-modulo').innerHTML     = badgeModulo(row.modulo);
    document.getElementById('d-provider').textContent = row.provedor || '—';
    document.getElementById('d-usuario').textContent  = [row.usuario, row.numero_wa].filter(Boolean).join(' · ') || '—';
    document.getElementById('d-rows').textContent     = row.rows_count != null ? row.rows_count.toLocaleString('pt-BR') + ' linha(s)' : '—';
    document.getElementById('d-tempo').textContent        = formatMs(row.duracao_ms);
    document.getElementById('d-pipeline-ms').textContent  = formatMs(row.pipeline_ms);
    document.getElementById('d-entregue-ms').textContent  = formatMs(row.entregue_ms);
    document.getElementById('d-status').innerHTML     = badgeStatus(row.resultado_tipo);
    document.getElementById('copy-btn').textContent   = '📋 Copiar SQL';
    document.getElementById('sec-lista').style.display   = 'none';
    document.getElementById('sec-detalhe').style.display = '';
  }
  function fecharDetalhe() {
    document.getElementById('sec-detalhe').style.display = 'none';
    document.getElementById('sec-lista').style.display   = '';
  }
  function copiarSQL() {
    if (!_sqlAtual) return;
    navigator.clipboard.writeText(_sqlAtual).then(() => {
      const btn = document.getElementById('copy-btn');
      btn.textContent = '✓ Copiado!';
      setTimeout(() => { btn.textContent = '📋 Copiar SQL'; }, 2000);
    });
  }
  async function carregar() {
    document.getElementById('count').textContent = '• carregando...';
    try {
      const res  = await fetch('/api/ia-command/admin/logs/consultas');
      if (!res.ok) {
        const msg = res.status === 403 ? 'Sem permissão (iac-admin-auditoria)' : `Erro ${res.status}`;
        throw new Error(msg);
      }
      const dados = await res.json();
      inicializarTabela(dados);
      document.getElementById('count').textContent = `• ${dados.length} registro(s)`;
    } catch (e) {
      document.getElementById('count').textContent = '• erro ao carregar';
    }
  }
  function abrirLimpeza() {
    const hoje = new Date(); const h30 = new Date(hoje); h30.setDate(h30.getDate() - 30);
    const toISO = d => d.toISOString().slice(0, 10);
    document.getElementById('cleanup-inicio').value = toISO(h30);
    document.getElementById('cleanup-fim').value    = toISO(hoje);
    document.getElementById('cleanup-modulo').value = '';
    document.querySelector('input[name="cleanup-modo"][value="periodo"]').checked = true;
    atualizarModoLimpeza();
    document.getElementById('cleanup-error').style.display = 'none';
    document.getElementById('cleanup-btn').textContent = 'Limpar registros';
    document.getElementById('cleanup-btn').disabled = false;
    document.getElementById('cleanup-overlay').style.display = 'flex';
  }
  function fecharLimpeza() {
    document.getElementById('cleanup-overlay').style.display = 'none';
  }
  function atualizarModoLimpeza() {
    const modo = document.querySelector('input[name="cleanup-modo"]:checked')?.value || 'periodo';
    document.getElementById('cleanup-period').style.display = modo === 'periodo' ? 'flex' : 'none';
  }
  async function confirmarLimpeza() {
    const modo   = document.querySelector('input[name="cleanup-modo"]:checked')?.value || 'periodo';
    const modulo = document.getElementById('cleanup-modulo').value;
    const body   = { modo, modulo: modulo || undefined };
    if (modo === 'periodo') {
      body.data_inicio = document.getElementById('cleanup-inicio').value;
      body.data_fim    = document.getElementById('cleanup-fim').value;
    }
    const errEl = document.getElementById('cleanup-error');
    errEl.style.display = 'none';
    const btn = document.getElementById('cleanup-btn');
    btn.disabled = true; btn.textContent = 'Limpando...';
    try {
      const res = await fetch('/api/ia-command/admin/logs/consultas/limpar', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `Erro ${res.status}`);
      fecharLimpeza();
      carregar();
    } catch (e) {
      errEl.textContent = e.message; errEl.style.display = 'block';
      btn.disabled = false; btn.textContent = 'Limpar registros';
    }
  }
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (document.getElementById('cleanup-overlay')?.style.display === 'flex') fecharLimpeza();
    else if (document.getElementById('help-drawer')?.classList.contains('open')) fecharAjuda();
    else if (document.getElementById('sec-detalhe').style.display !== 'none') fecharDetalhe();
  });
  function abrirAjuda() { document.getElementById('help-overlay').classList.add('open'); document.getElementById('help-drawer').classList.add('open'); }
  function fecharAjuda() { document.getElementById('help-overlay').classList.remove('open'); document.getElementById('help-drawer').classList.remove('open'); }
  window._iahubAuthReady?.then(carregar) ?? carregar();
</script>
</body>
</html>
</file>

<file path="apps/IA Command/frontend/admin-mensagens-whatsapp.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mensagens WhatsApp - IA Command</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css">
  <style>
    :root { --accent:#7c3aed; --accent-light:#a78bfa; --accent-glow:rgba(124,58,237,.1); }
    .sidebar-logo .logo-icon { background:#7c3aed !important; }
    .topbar-menu-btn { flex-shrink:0;background:none;border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;color:var(--text-md);transition:background var(--transition),color var(--transition); }
    .topbar-menu-btn:hover { background:var(--bg-hover);color:var(--text-hi); }
    .topbar-title { flex:1;min-width:0;font-weight:700; }
    .page-head { display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;margin-bottom:3px; }
    .page-title { font-size:20px;font-weight:700;color:var(--text-hi);line-height:1.25; }
    .page-subtitle { font-size:13px;color:var(--text-md);margin-top:4px; }
    .quick-panel { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:12px 16px;margin-bottom:16px;box-shadow:var(--shadow-sm); }
    .quick-row { display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
    .quick-row .form-control { height:36px;font-size:13px;flex:1;min-width:220px; }
    .grid-toolbar { display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg-card); }
    .grid-title { font-size:13px;font-weight:600;color:var(--text-hi); }
    .grid-meta { font-size:12px;color:var(--text-lo);margin-top:1px; }
    .badge-ativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:#dcfce7;color:#15803d; }
    .badge-inativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:var(--bg-hover);color:var(--text-lo); }
    .badge-custom { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:var(--accent-glow);color:var(--accent); }
    .btn-icon { background:none;border:none;cursor:pointer;padding:4px 6px;border-radius:5px;font-size:15px;transition:background .15s; }
    .btn-icon:hover { background:var(--bg-hover); }
    .tabulator { border:none !important;background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important;border-right:none !important;color:var(--text-lo) !important;font-size:11px !important;font-weight:700 !important;text-transform:uppercase;letter-spacing:.05em; }
    .tabulator .tabulator-row { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important;cursor:pointer; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important;color:var(--text-md);font-size:13px;padding:10px 12px !important; }
    .save-feedback { font-size:13px;color:var(--text-lo); }
    .save-feedback.ok { color:#15803d; }
    .save-feedback.fail { color:#b91c1c; }
    .reg-field { margin-bottom:16px; }
    .reg-label { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:700;margin-bottom:5px; }
    .vars { display:flex;flex-wrap:wrap;gap:6px;margin-top:8px; }
    .var-chip { border:1px solid var(--border);background:var(--bg-hover);border-radius:99px;padding:3px 8px;font-family:monospace;font-size:11px;color:var(--text-md);cursor:pointer; }
    .filter-area { padding-top:12px;border-top:1px solid var(--border);margin-top:12px; }
    .filter-status { font-size:12px;color:var(--text-lo);flex:1; }
    .quick-row input.form-control { flex:1;min-width:200px; }
    .quick-row select.form-control { width:auto;min-width:145px; }
    .gp-wrap { margin-top:10px; }
    .gp-chips-row { display:flex;align-items:center;gap:6px;flex-wrap:wrap;position:relative; }
    .gp-label { font-size:11px;color:var(--text-lo);white-space:nowrap; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-base) !important;color:var(--text-hi) !important;border:1px solid var(--border) !important;border-radius:4px !important;font-size:11px !important;padding:3px 6px !important;width:100% !important; }
    .tabulator .tabulator-row.tabulator-group { background:var(--bg-base) !important;border-bottom:1px solid var(--border) !important;font-size:12px !important;font-weight:700 !important;color:var(--text-lo) !important; }
    .tabulator .tabulator-placeholder { background:var(--bg-card) !important; }
    /* Help drawer */
    .help-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:300;opacity:0;pointer-events:none;transition:opacity .25s;}
    .help-overlay.open{opacity:1;pointer-events:all;}
    .help-drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,100vw);background:var(--bg-card);border-left:1px solid var(--border);z-index:301;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);overflow:hidden;}
    .help-drawer.open{transform:translateX(0);}
    .help-drawer-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--border);flex-shrink:0;}
    .help-drawer-title{font-size:15px;font-weight:700;color:var(--text-hi);}
    .help-drawer-close{width:30px;height:30px;border:none;background:none;cursor:pointer;border-radius:6px;color:var(--text-lo);display:flex;align-items:center;justify-content:center;transition:background var(--transition),color var(--transition);}
    .help-drawer-close:hover{background:var(--bg-hover);color:var(--text-hi);}
    .help-drawer-body{flex:1;overflow-y:auto;}
    .help-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0;padding:0 22px;}
    .help-tab{padding:10px 14px;font-size:12px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;color:var(--text-lo);transition:color var(--transition),border-color var(--transition);}
    .help-tab.active{color:var(--accent);border-bottom-color:var(--accent);}
    .help-panel{display:none;padding:22px;} .help-panel.active{display:block;}
    .help-section{margin-bottom:28px;} .help-section:last-child{margin-bottom:0;}
    .help-section-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--accent);margin-bottom:12px;}
    .fmt-table{width:100%;border-collapse:collapse;font-size:12px;}
    .fmt-table th,.fmt-table td{padding:6px 10px;border:1px solid var(--border);text-align:left;}
    .fmt-table th{background:var(--bg-hover);font-weight:700;color:var(--text-hi);}
    .fmt-table td:first-child{white-space:nowrap;}
    .fmt-table code{background:var(--bg-hover);padding:1px 4px;border-radius:3px;font-size:11px;}
    .help-item{margin-bottom:14px;}
    .help-item-label{font-size:13px;font-weight:700;color:var(--text-hi);margin-bottom:4px;}
    .help-item-desc{font-size:13px;color:var(--text-md);line-height:1.65;}
    .help-tip{background:var(--accent-glow);border-left:3px solid var(--accent);border-radius:0 6px 6px 0;padding:10px 14px;font-size:13px;color:var(--text-md);line-height:1.6;margin-top:12px;}
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">⚡</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command ›</span> Mensagens WhatsApp</span>
    </div>
    <div class="page-content">
      <div id="sec-lista">
        <div class="page-head">
          <div>
            <div class="page-kicker">WhatsApp</div>
            <div class="page-title">Mensagens Internas</div>
            <div class="page-subtitle">Templates usados pelo IA Command nas respostas enviadas via biblioteca WhatsApp.</div>
          </div>
          <button class="btn btn-ghost" onclick="abrirAjuda()" style="display:flex;align-items:center;gap:6px">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            Ajuda
          </button>
        </div>
        <div class="quick-panel">
          <div class="quick-row">
            <button class="btn btn-ghost" id="btn-filtros" onclick="toggleFiltros()">+ Mostrar filtros</button>
            <span class="filter-status" id="filter-status">Sem filtros ou agrupamentos ativos</span>
          </div>
          <div class="filter-area" id="filter-area" style="display:none">
            <div class="quick-row" style="margin-bottom:10px">
              <input id="q-busca" type="text" class="form-control" placeholder="Buscar por chave, titulo ou texto..." oninput="filtrar()">
              <select id="q-ativo" class="form-control" onchange="filtrar()">
                <option value="">Todos os status</option>
                <option value="1">Ativo</option>
                <option value="0">Inativo</option>
              </select>
              <button class="btn btn-ghost" onclick="limparFiltros()">Limpar</button>
            </div>
            <div class="gp-wrap">
              <div class="gp-chips-row" id="gp-chips-row"><span class="gp-label">Agrupar por:</span></div>
              <div id="dz"></div>
            </div>
          </div>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <div class="grid-toolbar">
            <div>
              <div class="grid-title">Templates cadastrados</div>
              <div id="count" class="grid-meta"></div>
            </div>
          </div>
          <div id="tabela"></div>
        </div>
      </div>
      <div id="sec-form" style="display:none">
        <div class="editor-shell">
          <div class="editor-actionbar">
            <div class="editor-actionbar-title">
              <strong id="form-title">Template</strong>
              <span id="form-subtitle">Edite o texto usado pelo WhatsApp.</span>
            </div>
            <div class="editor-actions">
              <span class="save-feedback" id="save-feedback"></span>
              <button class="btn btn-ghost" onclick="restaurarPadrao()">Restaurar padrao</button>
              <button class="btn btn-ghost" onclick="fecharFormulario()">Voltar</button>
              <button class="btn btn-primary" onclick="salvar()">Salvar</button>
            </div>
          </div>
          <div class="editor-grid editor-grid-wide" style="margin-top:20px">
            <main class="editor-main">
              <section class="form-section">
                <div class="form-section-header">
                  <div class="form-section-title">Mensagem</div>
                  <div class="form-section-subtitle">Use variaveis entre chaves duplas quando necessario.</div>
                </div>
                <div class="form-section-body">
                  <div class="form-group">
                    <label class="form-label">Titulo</label>
                    <input id="f-titulo" class="form-control">
                  </div>
                  <div class="form-group" style="margin-bottom:0">
                    <label class="form-label">Template</label>
                    <textarea id="f-template" class="form-control" rows="9"></textarea>
                    <div class="vars" id="vars"></div>
                  </div>
                </div>
              </section>
              <section class="form-section">
                <div class="form-section-header">
                  <div class="form-section-title">Padrao do Sistema</div>
                </div>
                <div class="form-section-body">
                  <textarea id="f-padrao" class="form-control" rows="5" disabled style="background:var(--bg-hover)"></textarea>
                </div>
              </section>
            </main>
            <aside class="editor-side">
              <section class="form-section" style="position:sticky;top:56px">
                <div class="form-section-header"><div class="form-section-title">Registro</div></div>
                <div class="form-section-body">
                  <div class="reg-field"><div class="reg-label">Chave</div><input id="f-chave" class="form-control" disabled style="font-family:monospace;background:var(--bg-hover)"></div>
                  <div class="reg-field"><div class="reg-label">Status</div><select id="f-ativo" class="form-control"><option value="1">Ativo</option><option value="0">Inativo</option></select></div>
                  <div class="reg-field"><div class="reg-label">Customizado</div><input id="f-customizado" class="form-control" disabled style="background:var(--bg-hover)"></div>
                </div>
              </section>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/grid-group-panel.js?v=20260617-grid-guard-v2"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
  let table, gp;
  let dados = [];
  let edit = null;
  let quickFilterFn = null;
  let filtrosVisiveis = false;
  const VARS = ['{{empresa_nome}}','{{empresa_id}}','{{canal_nome}}','{{numero}}','{{opcoes_empresas}}','{{erro}}','{{transcricao}}','{{resposta}}'];
  function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  async function carregar() {
    dados = await fetch('/api/ia-command/admin/mensagens-whatsapp').then(r => r.json()).catch(() => []);
    if (table) return table.replaceData(dados);
    gp = createGroupPanel({ chipsRowId:'gp-chips-row', dropZoneId:'dz', storageKey:'iac_admin_mensagens_whatsapp_group', getTable:()=>table });
    table = new Tabulator('#tabela', {
      data:dados, index:'chave', layout:'fitColumns', height:'calc(100vh - 300px)',
      movableColumns:true,
      groupBy:gp.getActiveFields(),
      groupStartOpen:true,
      placeholder:'<div style="padding:40px;text-align:center;color:var(--text-lo)">Nenhum template encontrado.</div>',
      columns:[
        { title:'Chave', field:'chave', width:210, headerFilter:true, formatter:c=>`<span style="font-family:monospace;font-size:12px">${esc(c.getValue())}</span>` },
        { title:'Titulo', field:'titulo', minWidth:180, headerFilter:true, formatter:c=>`<strong style="color:var(--text-hi)">${esc(c.getValue())}</strong>` },
        { title:'Texto', field:'template', minWidth:300, headerFilter:true, formatter:c=>`<span style="color:var(--text-lo)">${esc(String(c.getValue() || '').replace(/\n/g, ' ').slice(0, 140))}</span>` },
        { title:'Tipo', field:'customizado', width:120, headerFilter:'select', headerFilterParams:{values:{'':'Todos','1':'Customizado','0':'Padrao'}}, headerFilterFunc:(hv,rv)=>hv===''||(hv==='1'?!!rv:!rv), formatter:c=>c.getValue()?'<span class="badge-custom">Customizado</span>':'<span class="badge-inativo">Padrao</span>' },
        { title:'Status', field:'ativo', width:100, headerFilter:'select', headerFilterParams:{values:{'':'Todos','1':'Ativo','0':'Inativo'}}, formatter:c=>c.getValue()?'<span class="badge-ativo">Ativo</span>':'<span class="badge-inativo">Inativo</span>' },
        { title:'Acoes', field:'chave', width:95, hozAlign:'right', headerFilter:false, groupable:false, formatter:c=>{
          const ch = esc(c.getValue());
          return `<button class="btn-icon" onclick="event.stopPropagation();abrirFormulario('${ch}')" title="Editar">✏️</button>
                  <button class="btn-icon" onclick="event.stopPropagation();excluirTemplate('${ch}')" title="Restaurar padrão" style="color:#dc2626">🗑</button>`;
        }},
      ],
      rowClick:(e,row)=>{ if(!e.target.closest('button')) abrirFormulario(row.getData().chave); },
      dataFiltered:(_f, rows)=>document.getElementById('count').textContent = `${rows.length} templates`,
    });
    gp.refresh();
    gp.applyToTable();
    document.getElementById('count').textContent = `${dados.length} templates`;
  }
  function toggleFiltros() {
    filtrosVisiveis = !filtrosVisiveis;
    document.getElementById('filter-area').style.display = filtrosVisiveis ? '' : 'none';
    document.getElementById('btn-filtros').textContent = filtrosVisiveis ? '- Ocultar filtros' : '+ Mostrar filtros';
    if (filtrosVisiveis && gp) setTimeout(() => gp.refresh(), 50);
  }
  function filtrar() {
    if (!table) return;
    if (quickFilterFn) { table.removeFilter(quickFilterFn); quickFilterFn = null; }
    const busca = document.getElementById('q-busca').value.trim().toLowerCase();
    const ativo = document.getElementById('q-ativo').value;
    if (busca || ativo !== '') {
      quickFilterFn = row => {
        if (ativo !== '' && String(row.ativo) !== ativo) return false;
        const texto = `${row.chave} ${row.titulo} ${row.template}`.toLowerCase();
        return !busca || texto.includes(busca);
      };
      table.addFilter(quickFilterFn);
    }
    const qtd = [busca, ativo].filter(Boolean).length;
    document.getElementById('filter-status').textContent = qtd ? `${qtd} filtro(s) ativo(s)` : 'Sem filtros ou agrupamentos ativos';
  }
  async function excluirTemplate(chave) {
    const row = dados.find(x => x.chave === chave);
    if (!row) return;
    if (row.customizado) {
      if (!confirm('Restaurar o padrão deste template?\n\nIsso remove a customização da empresa e volta ao texto original do sistema.')) return;
    } else {
      if (!confirm('Excluir este registro?\n\nComo o template não está customizado, isso não tem efeito visível — o sistema já usa o padrão.')) return;
    }
    await fetch(`/api/ia-command/admin/mensagens-whatsapp/${encodeURIComponent(chave)}`, { method: 'DELETE' });
    carregar();
  }
  function limparFiltros() {
    document.getElementById('q-busca').value = '';
    document.getElementById('q-ativo').value = '';
    filtrar();
  }
  function abrirFormulario(chave) {
    edit = dados.find(x => x.chave === chave);
    if (!edit) return;
    document.getElementById('sec-lista').style.display = 'none';
    document.getElementById('sec-form').style.display = '';
    document.getElementById('form-title').textContent = edit.titulo;
    document.getElementById('f-chave').value = edit.chave;
    document.getElementById('f-titulo').value = edit.titulo || '';
    document.getElementById('f-template').value = edit.template || '';
    document.getElementById('f-padrao').value = edit.template_padrao || '';
    document.getElementById('f-ativo').value = String(edit.ativo ?? 1);
    document.getElementById('f-customizado').value = edit.customizado ? 'Sim' : 'Nao';
    document.getElementById('save-feedback').textContent = '';
    document.getElementById('vars').innerHTML = VARS.map(v => `<button type="button" class="var-chip" onclick="inserirVar('${v}')">${esc(v)}</button>`).join('');
  }
  function inserirVar(v) {
    const el = document.getElementById('f-template');
    const start = el.selectionStart || el.value.length;
    el.value = el.value.slice(0, start) + v + el.value.slice(el.selectionEnd || start);
    el.focus();
    el.selectionStart = el.selectionEnd = start + v.length;
  }
  function fecharFormulario() {
    document.getElementById('sec-form').style.display = 'none';
    document.getElementById('sec-lista').style.display = '';
    edit = null;
  }
  async function salvar() {
    if (!edit) return;
    const res = await fetch(`/api/ia-command/admin/mensagens-whatsapp/${encodeURIComponent(edit.chave)}`, {
      method:'PUT',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        titulo: document.getElementById('f-titulo').value.trim(),
        template: document.getElementById('f-template').value,
        ativo: parseInt(document.getElementById('f-ativo').value),
      }),
    });
    const data = await res.json().catch(() => ({}));
    feedback(res.ok ? 'Salvo com sucesso!' : (data.error || 'Erro ao salvar.'), res.ok);
    if (res.ok) setTimeout(() => { fecharFormulario(); carregar(); }, 700);
  }
  async function restaurarPadrao() {
    if (!edit || !confirm('Restaurar o texto padrao deste template?')) return;
    const res = await fetch(`/api/ia-command/admin/mensagens-whatsapp/${encodeURIComponent(edit.chave)}`, { method:'DELETE' });
    feedback(res.ok ? 'Padrao restaurado.' : 'Erro ao restaurar.', res.ok);
    if (res.ok) setTimeout(() => { fecharFormulario(); carregar(); }, 700);
  }
  function feedback(msg, ok) {
    const el = document.getElementById('save-feedback');
    el.textContent = msg;
    el.className = 'save-feedback ' + (ok ? 'ok' : 'fail');
  }
  window._iahubAuthReady?.then(carregar) ?? carregar();
</script>
<div class="help-overlay" id="help-overlay" onclick="fecharAjuda()"></div>
<div class="help-drawer" id="help-drawer">
  <div class="help-drawer-header">
    <span class="help-drawer-title">Ajuda — Mensagens WhatsApp</span>
    <button class="help-drawer-close" onclick="fecharAjuda()" title="Fechar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
  </div>
  <div class="help-tabs">
    <div class="help-tab active" onclick="helpTab(this,'ht-geral')">Geral</div>
    <div class="help-tab" onclick="helpTab(this,'ht-variaveis')">Variáveis</div>
    <div class="help-tab" onclick="helpTab(this,'ht-pratica')">Boas Práticas</div>
  </div>
  <div class="help-drawer-body" style="padding:0;overflow-y:auto;flex:1;">
  <div id="ht-geral" class="help-panel active">
    <div class="help-section">
      <div class="help-section-title">O que são os templates</div>
      <div class="help-item-desc">Os templates são os textos que o IA Command envia automaticamente pelo WhatsApp em resposta a eventos específicos — boas-vindas, erros, seleção de empresa, resultado de consulta, etc. Cada template tem uma <strong>chave única</strong> que identifica em qual situação ele é usado.</div>
      <div class="help-tip">Os templates não controlam a lógica — apenas o texto. A situação em que cada um é disparado é fixada no código do sistema.</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Padrão vs. Customizado</div>
      <div class="help-item">
        <div class="help-item-label">Padrão</div>
        <div class="help-item-desc">Texto original definido pelo sistema. Sempre disponível como referência no campo <strong>Padrão do Sistema</strong> ao editar.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Customizado</div>
        <div class="help-item-desc">Indica que o texto foi editado pela empresa. O motor usa este texto no lugar do padrão. A coluna <em>Tipo</em> na lista exibe o badge <span style="background:rgba(124,58,237,.1);color:#7c3aed;font-size:11px;font-weight:600;padding:1px 6px;border-radius:99px">Customizado</span> para facilitar identificação.</div>
      </div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Campos do formulário</div>
      <div class="help-item">
        <div class="help-item-label">Chave</div>
        <div class="help-item-desc">Identificador técnico do template. Não pode ser alterado — é o código que o sistema usa para encontrar a mensagem certa.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Título</div>
        <div class="help-item-desc">Nome descritivo para facilitar identificação na lista. Pode ser editado livremente.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Template</div>
        <div class="help-item-desc">Texto que será enviado no WhatsApp. Suporta variáveis entre chaves duplas, quebras de linha e formatação simples.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Status</div>
        <div class="help-item-desc">Quando <strong>Inativo</strong>, o template é ignorado e o sistema usa o texto padrão embutido.</div>
      </div>
    </div>
  </div>
  <div id="ht-variaveis" class="help-panel">
    <div class="help-section">
      <div class="help-section-title">Como usar variáveis</div>
      <div class="help-item-desc">Variáveis são substituídas em tempo real pelos valores reais do contexto da mensagem. Escreva entre chaves duplas: <code style="background:var(--bg-hover);padding:2px 6px;border-radius:4px">&#123;&#123;nome_da_variavel&#125;&#125;</code>. Na tela de edição, clique nos chips abaixo do textarea para inserir no cursor.</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Variáveis disponíveis</div>
      <table class="fmt-table" style="margin-top:8px">
        <thead><tr><th>Variável</th><th>O que substitui</th></tr></thead>
        <tbody>
          <tr><td><code>&#123;&#123;empresa_nome&#125;&#125;</code></td><td>Nome da empresa da sessão ativa do usuário</td></tr>
          <tr><td><code>&#123;&#123;empresa_id&#125;&#125;</code></td><td>ID interno da empresa ativa</td></tr>
          <tr><td><code>&#123;&#123;canal_nome&#125;&#125;</code></td><td>Nome do canal WhatsApp que recebeu a mensagem</td></tr>
          <tr><td><code>&#123;&#123;numero&#125;&#125;</code></td><td>Número de telefone do remetente (formato internacional)</td></tr>
          <tr><td><code>&#123;&#123;opcoes_empresas&#125;&#125;</code></td><td>Lista numerada de empresas disponíveis para seleção</td></tr>
          <tr><td><code>&#123;&#123;erro&#125;&#125;</code></td><td>Descrição técnica do erro ocorrido</td></tr>
          <tr><td><code>&#123;&#123;transcricao&#125;&#125;</code></td><td>Texto transcrito de um áudio enviado pelo usuário</td></tr>
          <tr><td><code>&#123;&#123;resposta&#125;&#125;</code></td><td>Resposta gerada pelo motor de IA para a consulta</td></tr>
        </tbody>
      </table>
      <div class="help-tip">Nem toda variável está disponível em todos os templates — depende do contexto do evento. Se uma variável não tiver valor, ela é substituída por vazio. Verifique o <strong>Padrão do Sistema</strong> para saber quais variáveis o template original usa.</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Exemplo de template com variáveis</div>
      <div style="background:var(--bg-hover);border-radius:8px;padding:12px 14px;font-size:13px;line-height:1.75;font-family:monospace;color:var(--text-hi)">
        Olá! Você está conectado ao IA Command.<br>
        Empresa ativa: <strong>&#123;&#123;empresa_nome&#125;&#125;</strong><br><br>
        Como posso ajudar?
      </div>
      <div style="margin-top:10px;font-size:13px;color:var(--text-md)">O usuário recebe:</div>
      <div style="background:var(--bg-base);border:1px solid var(--border);border-radius:8px;padding:12px 14px;font-size:13px;line-height:1.75;margin-top:6px;color:var(--text-hi)">
        Olá! Você está conectado ao IA Command.<br>
        Empresa ativa: <strong>J2A Consultoria</strong><br><br>
        Como posso ajudar?
      </div>
    </div>
  </div>
  <div id="ht-pratica" class="help-panel">
    <div class="help-section">
      <div class="help-section-title">Quando customizar</div>
      <div class="help-item">
        <div class="help-item-label">Adaptar ao tom da empresa</div>
        <div class="help-item-desc">O padrão usa uma linguagem neutra e técnica. Se a empresa preferir um tom mais informal, comercial ou com a identidade da marca, edite os templates relevantes.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Corrigir mensagens de erro confusas</div>
        <div class="help-item-desc">Se os usuários reclamarem que uma mensagem específica está difícil de entender, localize o template pela chave ou pelo texto no campo de busca e reescreva com linguagem mais clara.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Adicionar orientações específicas</div>
        <div class="help-item-desc">Em templates como boas-vindas ou seleção de empresa, você pode incluir instruções extras — por exemplo, listar os tipos de consulta disponíveis.</div>
      </div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Restaurar padrão</div>
      <div class="help-item-desc">O botão <strong>Restaurar padrão</strong> no formulário desfaz todas as customizações do template e volta ao texto original do sistema. Use quando uma edição causar problemas ou o template ficar desatualizado após uma atualização do sistema.</div>
      <div class="help-tip">Antes de restaurar, copie o texto customizado se quiser guardar como referência — a ação não tem desfazer.</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Inativar vs. Excluir</div>
      <div class="help-item-desc">Os templates não podem ser excluídos — apenas inativados. Quando inativo, o sistema usa o texto padrão embutido. Isso garante que o IA Command sempre tenha uma mensagem de fallback para cada situação, mesmo que o template customizado esteja com problema.</div>
    </div>
  </div>
  </div>
</div>
<script>
  function abrirAjuda() { document.getElementById('help-overlay').classList.add('open'); document.getElementById('help-drawer').classList.add('open'); }
  function fecharAjuda() { document.getElementById('help-overlay').classList.remove('open'); document.getElementById('help-drawer').classList.remove('open'); }
  function helpTab(el, id) {
    el.closest('.help-drawer').querySelectorAll('.help-tab').forEach(t => t.classList.remove('active'));
    el.closest('.help-drawer').querySelectorAll('.help-panel').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    document.getElementById(id).classList.add('active');
  }
  document.addEventListener('keydown', e => { if (e.key === 'Escape') fecharAjuda(); });
</script>
</body>
</html>
