    .head-actions { display:flex;align-items:center;gap:8px;flex-wrap:wrap; }
    .group-panel { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:12px 14px;margin-bottom:12px; }
    .group-panel-row { display:flex;align-items:center;gap:12px;flex-wrap:wrap; }
    .group-panel-status { font-size:12px;color:var(--text-lo); }
    .group-panel-options { display:none;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px;padding-top:10px;border-top:1px dashed var(--border); }
    .group-panel.open .group-panel-options { display:flex; }
    .group-chip { height:30px;border:1px solid var(--border);border-radius:6px;background:var(--bg-base);color:var(--text-md);font-size:12px;font-weight:700;padding:0 10px;cursor:pointer; }
    .group-chip:hover, .group-chip.active { border-color:var(--accent);color:var(--accent);background:var(--accent-glow); }
    .group-target-row { flex:1 1 100%;display:flex;align-items:center;gap:12px;margin-top:2px; }
    .group-dropzone { flex:1;min-width:260px;min-height:38px;border:1px dashed var(--border);border-radius:7px;background:var(--bg-base);color:var(--text-lo);display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:7px 10px;font-size:12px; }
    .group-dropzone.drag-over { border-color:var(--accent);background:var(--accent-glow);color:var(--accent); }
    .active-group-chip { display:inline-flex;align-items:center;gap:6px;border:1px solid var(--accent);border-radius:6px;background:var(--accent-glow);color:var(--accent);font-size:12px;font-weight:700;padding:4px 8px; }
    .active-group-chip[draggable="true"] { cursor:grab; }
    .active-group-remove { border:none;background:transparent;color:inherit;font-weight:900;line-height:1;cursor:pointer;padding:0 1px;font-size:14px; }
    .status-text { display:none;font-size:12px;color:var(--text-lo); }
    .table-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden; }
    .table-wrap { height:calc(100vh - 235px);min-height:360px;overflow:auto;background:var(--bg-card); }
    .history-table { width:100%;min-width:1420px;border-collapse:separate;border-spacing:0;table-layout:fixed;font-size:13px; }
    .history-table thead th { position:sticky;top:0;z-index:2;background:var(--bg-card);border-bottom:1px solid var(--border);color:var(--text-lo);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:9px 10px;white-space:nowrap; }
    .history-table thead th.sortable { cursor:pointer;user-select:none; }
    .history-table thead th.sortable:hover { color:var(--accent);background:var(--bg-hover); }
    .history-table thead .filter-cell th { top:34px;padding:6px 10px;background:var(--bg-card); }
    .history-table thead input, .history-table thead select { width:100%;height:26px;border:1px solid var(--border);border-radius:5px;background:var(--bg-base);color:var(--text-hi);font-size:11px;padding:3px 6px;box-sizing:border-box; }
    .history-table tbody td { border-bottom:1px solid var(--border);color:var(--text-md);padding:10px;vertical-align:top;background:var(--bg-card); }
    .history-table tbody tr.data-row { cursor:pointer; }
    .history-table tbody tr.data-row:hover td { background:var(--bg-hover); }
    .history-table tbody tr.group-row td { background:var(--bg-base);color:var(--text-hi);font-weight:800;font-size:12px;padding:8px 10px;border-bottom:1px solid var(--border); }
    .history-table tbody tr.group-row { cursor:pointer; }
    .history-table tbody tr.group-row:hover td { background:var(--bg-hover); }
    .history-table tbody tr.group-row.level-1 td { padding-left:28px; }
    .history-table tbody tr.group-row.level-2 td { padding-left:46px; }
    .history-table tbody tr.group-row.level-3 td { padding-left:64px; }
    .group-toggle-btn { width:22px;height:22px;border:1px solid var(--border);border-radius:5px;background:var(--bg-card);color:var(--text-hi);font-size:14px;font-weight:900;line-height:1;cursor:pointer;margin-right:8px;vertical-align:middle; }
    .group-toggle-btn:hover { border-color:var(--accent);color:var(--accent);background:var(--accent-glow); }
    .col-action { width:42px;text-align:center; }
    .col-user { width:155px; }
    .col-name { width:210px; }
    .col-phone { width:150px; }
    .col-company { width:190px; }
    .col-summary { width:245px; }
    .col-count { width:88px; }
    .col-status { width:95px; }
    .col-date { width:160px; }
    .text-cut { white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
    .empty-state { height:320px;display:flex;align-items:center;justify-content:center;color:var(--text-lo);font-size:22px;font-weight:800; }
    .badge { display:inline-flex;align-items:center;justify-content:center;border-radius:99px;padding:2px 8px;font-size:11px;font-weight:800;white-space:nowrap; }
    .badge-ok { background:#dcfce7;color:#15803d; }
    .badge-muted { background:var(--bg-base);color:var(--text-md);border:1px solid var(--border); }
    .icon-btn { width:28px;height:28px;border:none;background:transparent;border-radius:6px;color:var(--text-md);cursor:pointer;display:inline-flex;align-items:center;justify-content:center; }
    .icon-btn:hover { background:var(--bg-hover);color:var(--accent); }
    .detail-shell { display:none; }
    .detail-shell.open { display:block; }
    .editor-bar { display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;margin-bottom:12px;box-shadow:var(--shadow-sm); }
    .editor-title strong { display:block;color:var(--text-hi);font-size:16px; }
    .editor-title span { color:var(--text-lo);font-size:12px; }
    .detail-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:18px; }
    .form-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px; }
    .form-label { display:block;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--text-lo);margin-bottom:5px; }
    .json-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px; }
    textarea.json { min-height:260px;font-family:ui-monospace,Consolas,monospace;font-size:12px;line-height:1.5;resize:vertical; }
    .json-details summary { cursor:pointer;font-size:12px;font-weight:700;color:var(--text-lo);user-select:none; }
    .json-details summary:hover { color:var(--accent); }
    .acessos-tree { border:1px solid var(--border);border-radius:var(--radius);background:var(--bg-base);padding:4px;max-height:320px;overflow:auto; }
    .acessos-tree-empty { padding:16px;text-align:center;color:var(--text-lo);font-size:13px; }
    .acessos-empresa { border-bottom:1px solid var(--border); }
    .acessos-empresa:last-child { border-bottom:none; }
    .acessos-empresa-head { display:flex;align-items:center;gap:8px;padding:10px 12px;font-weight:700;color:var(--text-hi);font-size:13px; }
    .acessos-empresa-head svg { color:var(--accent);flex-shrink:0; }
    .acessos-empresa-codigo { font-size:11px;font-weight:700;color:var(--text-lo);background:var(--bg-card);border:1px solid var(--border);border-radius:5px;padding:1px 6px; }
    .acessos-empresa-badge { margin-left:auto;font-size:11px;font-weight:700;color:var(--accent);background:var(--accent-glow);border-radius:99px;padding:2px 9px;white-space:nowrap; }
    .acessos-filiais-lista { list-style:none;margin:0;padding:0 12px 10px 34px;display:flex;flex-direction:column;gap:4px; }
    .acessos-filial-item { display:flex;align-items:center;gap:7px;font-size:12px;color:var(--text-md); }
    .acessos-filial-item svg { color:var(--text-lo);flex-shrink:0; }
    .acessos-filial-chave { font-family:ui-monospace,Consolas,monospace;font-size:11px;color:var(--text-lo); }
    .save-feedback { font-size:13px;color:var(--text-lo); }
    .save-feedback.ok { color:#15803d; }
    .save-feedback.fail { color:#b91c1c; }
    @media (max-width:900px) { .head-row,.editor-bar{align-items:flex-start;flex-direction:column}.head-actions{width:100%}.form-grid,.json-grid{grid-template-columns:1fr}.group-target-row{align-items:stretch;flex-direction:column}.table-wrap{height:calc(100vh - 300px)} }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()"><div class="logo-icon">IA</div><span class="logo-text">IA Command</span></div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command &rsaquo;</span> Usuarios Protheus</span>
    </div>
    <div class="page-content">
      <section id="list-view">
        <div class="head-row">
          <div>
            <div class="page-kicker">WhatsApp Web</div>
            <div class="head-title">Usuarios Protheus <span class="head-count" id="count">carregando...</span></div>
          </div>
          <div class="head-actions">
            <button class="btn btn-ghost" id="refresh-btn" type="button" style="font-weight:700;color:#1e3a8a;padding:5px 14px">Atualizar</button>
            <button class="btn btn-primary" id="new-btn" type="button">+ Novo</button>
          </div>
        </div>
        <div class="group-panel" id="group-panel">
          <div class="group-panel-row">
            <button class="btn btn-ghost" id="group-toggle" type="button">+ Mostrar agrupamento</button>
            <span class="group-panel-status" id="group-status">Sem agrupamento ativo</span>
            <span class="status-text" id="filter-status">Sem filtros ativos</span>
          </div>
          <div class="group-panel-options" id="group-options">
            <span class="group-panel-status">Arraste para agrupar:</span>
            <button class="group-chip" type="button" draggable="true" data-group-field="empresa_nome">Empresa IAHub</button>
            <button class="group-chip" type="button" draggable="true" data-group-field="empresa_protheus">Empresa Protheus</button>
            <button class="group-chip" type="button" draggable="true" data-group-field="filial_protheus">Filial</button>
            <button class="group-chip" type="button" draggable="true" data-group-field="status_label">Status</button>
            <button class="group-chip" type="button" draggable="true" data-group-field="usuario_id">Usuario</button>
            <button class="group-chip" type="button" draggable="true" data-group-field="celular_fmt">Telefone</button>
            <button class="group-chip" type="button" draggable="true" data-group-field="origem">Origem</button>
            <div class="group-target-row">
              <button class="btn btn-ghost" id="group-clear" type="button">Limpar agrupamento</button>
              <div class="group-dropzone" id="group-dropzone">Solte um campo aqui para agrupar</div>
            </div>
          </div>
        </div>
        <div class="table-card">
          <div class="table-wrap">
            <table class="history-table">
              <thead>
                <tr>
                  <th class="col-action"></th>
                  <th class="col-user sortable" draggable="true" data-group-field="usuario_id" data-sort="usuario_id">Usuario</th>
                  <th class="col-name sortable" data-sort="usuario_nome">Nome</th>
                  <th class="col-phone sortable" draggable="true" data-group-field="celular_fmt" data-sort="celular">Telefone</th>
                  <th class="col-company sortable" draggable="true" data-group-field="empresa_nome" data-sort="empresa_nome">Empresa IAHub</th>
                  <th class="col-summary sortable" draggable="true" data-group-field="empresa_protheus" data-sort="empresas_resumo">Empresas Protheus</th>
                  <th class="col-summary sortable" draggable="true" data-group-field="filial_protheus" data-sort="filiais_resumo">Filiais</th>
                  <th class="col-count sortable" data-sort="qtd_empresas">Empresas</th>
                  <th class="col-count sortable" data-sort="qtd_filiais">Filiais</th>
                  <th class="col-status sortable" draggable="true" data-group-field="status_label" data-sort="ativo">Status</th>
                  <th class="col-date sortable" data-sort="ultimo_sync_em">Ultimo sync</th>
                </tr>
                <tr class="filter-cell">
                  <th></th>
                  <th><input data-filter="usuario_id" autocomplete="off" spellcheck="false"></th>
                  <th><input data-filter="usuario_nome" autocomplete="off" spellcheck="false"></th>
                  <th><input data-filter="celular" autocomplete="off" spellcheck="false"></th>
                  <th><input data-filter="empresa_nome" autocomplete="off" spellcheck="false"></th>
                  <th><input data-filter="empresas_resumo" autocomplete="off" spellcheck="false"></th>
                  <th><input data-filter="filiais_resumo" autocomplete="off" spellcheck="false"></th>
                  <th></th>
                  <th></th>
                  <th><select data-filter="status_label" autocomplete="off"><option value="">Todos</option><option value="Ativo">Ativo</option><option value="Inativo">Inativo</option></select></th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="tbody"></tbody>
            </table>
            <div class="empty-state" id="empty-state" style="display:none">Nenhum usuario sincronizado</div>
          </div>
        </div>
      </section>
      <section id="detail-view" class="detail-shell">
        <div class="editor-bar">
          <div class="editor-title"><strong id="detail-title">Usuario</strong><span id="detail-subtitle">-</span></div>
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <span class="save-feedback" id="save-feedback"></span>
            <button class="btn btn-ghost" id="back-btn" type="button">Voltar a lista</button>
            <button class="btn btn-danger" id="delete-btn" type="button" style="display:none">Excluir</button>
            <button class="btn btn-primary" id="save-btn" type="button">Salvar</button>
          </div>
        </div>
        <div class="detail-card">
          <div class="form-grid">
            <div><label class="form-label">Usuario Protheus</label><input class="form-control" id="f-usuario-id"></div>
            <div><label class="form-label">Nome</label><input class="form-control" id="f-usuario-nome"></div>
            <div><label class="form-label">Telefone</label><input class="form-control" id="f-celular"></div>
            <div><label class="form-label">Status</label><select class="form-control" id="f-ativo"><option value="1">Ativo</option><option value="0">Inativo</option></select></div>
            <div><label class="form-label">Empresa IAHub</label><input class="form-control" id="f-empresa" disabled></div>
            <div><label class="form-label">Ultimo sync</label><input class="form-control" id="f-sync" disabled></div>
          </div>
          <div style="margin-top:14px"><label class="form-label">Observacoes</label><textarea class="form-control" id="f-observacoes" rows="3"></textarea></div>
          <div style="margin-top:14px">
            <label class="form-label">Acessos liberados</label>
            <div class="acessos-tree" id="acessos-tree"></div>
          </div>
          <details class="json-details" style="margin-top:14px">
            <summary>Editar JSON bruto (avancado)</summary>
            <div class="json-grid">
              <div><label class="form-label">Empresas permitidas JSON</label><textarea class="form-control json" id="f-empresas"></textarea></div>
              <div><label class="form-label">Filiais permitidas JSON</label><textarea class="form-control json" id="f-filiais"></textarea></div>
            </div>
          </details>
        </div>
      </section>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
(function () {
  const GRID_STATE_KEY = 'iac_admin_protheus_web_users_grid_state';
  const state = { rows: [], view: [], sortField: 'usuario_nome', sortDir: 'asc', filters: {}, groupFields: [], groupPanelOpen: false, collapsedGroups: new Set(), detail: null, empresas: [], isNew: false, arvoreDisponivel: null };
  const $ = id => document.getElementById(id);
  function esc(v){ return String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtDate(v){ if(!v) return '-'; const d = new Date(v); if(Number.isNaN(d.getTime())) return v; const p = n => String(n).padStart(2,'0'); return `${p(d.getDate())}/${p(d.getMonth()+1)}/${d.getFullYear()} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`; }
  function fmtPhone(value){ const digits = String(value || '').replace(/\D/g, ''); const local = digits.startsWith('55') && digits.length >= 12 ? digits.slice(2) : digits; if(local.length === 11) return `(${local.slice(0,2)}) ${local.slice(2,7)}-${local.slice(7)}`; if(local.length === 10) return `(${local.slice(0,2)}) ${local.slice(2,6)}-${local.slice(6)}`; return digits || '-'; }
  function jsonFmt(v){ return JSON.stringify(v || [], null, 2); }
  function badge(value, cls){ return `<span class="badge ${cls || 'badge-muted'}">${esc(value || '-')}</span>`; }
  function statusLabel(row){ return Number(row.ativo) ? 'Ativo' : 'Inativo'; }
  function firstListLabel(value){ return String(value || '').split(/[;,]/).map(v => v.trim()).filter(Boolean)[0] || '-'; }
  function groupName(field){ return { empresa_nome:'Empresa IAHub', empresa_protheus:'Empresa Protheus', filial_protheus:'Filial', status_label:'Status', usuario_id:'Usuario', celular_fmt:'Telefone', origem:'Origem' }[field] || ''; }
  function rowValue(row, field){
    if(field === 'status_label') return statusLabel(row);
    if(field === 'celular_fmt') return fmtPhone(row.celular);
    if(field === 'empresa_protheus') return firstListLabel(row.empresas_resumo);
    if(field === 'filial_protheus') return firstListLabel(row.filiais_resumo);
    return row[field] ?? '';
  }
  function readGridState(){
    try {
      const saved = JSON.parse(localStorage.getItem(GRID_STATE_KEY) || 'null');
      if(!saved || typeof saved !== 'object') return;
      state.groupFields = Array.isArray(saved.groupFields) ? saved.groupFields.filter(field => !!groupName(field)) : [];
      state.groupPanelOpen = !!saved.groupPanelOpen;
      state.collapsedGroups = new Set(Array.isArray(saved.collapsedGroups) ? saved.collapsedGroups.filter(Boolean) : []);
    } catch (_) { localStorage.removeItem(GRID_STATE_KEY); }
  }
  function saveGridState(){
    try { localStorage.setItem(GRID_STATE_KEY, JSON.stringify({ version:1, groupFields:state.groupFields, groupPanelOpen:state.groupPanelOpen, collapsedGroups:[...state.collapsedGroups] })); } catch (_) {}
  }
  function applyGroupPanelState(){
    $('group-panel').classList.toggle('open', state.groupPanelOpen);
    $('group-toggle').textContent = state.groupPanelOpen ? '- Ocultar agrupamento' : '+ Mostrar agrupamento';
  }
  function hasFilters(){ return Object.values(state.filters).some(Boolean); }
  function applyFilters(){
    state.view = state.rows.filter(row => {
      for (const [field, raw] of Object.entries(state.filters)) {
        const needle = String(raw || '').trim().toLowerCase();
        if(!needle) continue;
        if(!String(rowValue(row, field) || '').toLowerCase().includes(needle)) return false;
      }
      return true;
    });
    sortRows();
    renderTable();
  }
  function sortRows(){
    const field = state.sortField;
    const dir = state.sortDir === 'asc' ? 1 : -1;
    state.view.sort((a,b) => {
      const av = rowValue(a, field);
      const bv = rowValue(b, field);
      const cmp = (typeof av === 'number' || typeof bv === 'number') ? Number(av || 0) - Number(bv || 0) : String(av || '').localeCompare(String(bv || ''), 'pt-BR');
      return cmp * dir;
    });
  }
  function renderDataRow(row){
    return `
      <tr class="data-row" data-id="${esc(row.id)}">
        <td class="col-action"><button class="icon-btn" type="button" title="Visualizar" data-id="${esc(row.id)}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button></td>
        <td class="text-cut" title="${esc(row.usuario_id || '')}">${esc(row.usuario_id || '-')}</td>
        <td class="text-cut" title="${esc(row.usuario_nome || '')}">${esc(row.usuario_nome || '-')}</td>
        <td>${esc(fmtPhone(row.celular))}</td>
        <td class="text-cut" title="${esc(row.empresa_nome || '')}">${esc(row.empresa_nome || '-')}</td>
        <td class="text-cut" title="${esc(row.empresas_resumo || '')}">${esc(row.empresas_resumo || '-')}</td>
        <td class="text-cut" title="${esc(row.filiais_resumo || '')}">${esc(row.filiais_resumo || '-')}</td>
        <td>${Number(row.qtd_empresas || 0)}</td>
        <td>${Number(row.qtd_filiais || 0)}</td>
        <td>${Number(row.ativo) ? badge('Ativo','badge-ok') : badge('Inativo','badge-muted')}</td>
        <td>${esc(fmtDate(row.ultimo_sync_em || row.atualizado_em))}</td>
      </tr>`;
  }
  function renderTable(){
    const rows = state.view;
    $('empty-state').style.display = rows.length ? 'none' : 'flex';
    $('count').textContent = `${rows.length} de ${state.rows.length} usuario(s)`;
    $('filter-status').textContent = hasFilters() ? 'Filtros ativos' : 'Sem filtros ativos';
    renderGroupState();
    if(!rows.length) { $('tbody').innerHTML = ''; return; }
    if(!state.groupFields.length) $('tbody').innerHTML = rows.map(renderDataRow).join('');
    else {
      const parts = [];
      renderGroupedRows(parts, rows, state.groupFields, 0, []);
      $('tbody').innerHTML = parts.join('');
    }
  }
  function renderGroupedRows(parts, rows, groups, level, path){
    const field = groups[level];
    const buckets = new Map();
    rows.forEach(row => {
      const label = rowValue(row, field) || '-';
      if(!buckets.has(label)) buckets.set(label, []);
      buckets.get(label).push(row);
    });
    [...buckets.entries()].forEach(([label, items]) => {
      const key = groupKey(path.concat([[field, label]]));
      const collapsed = state.collapsedGroups.has(key);
      parts.push(`<tr class="group-row level-${Math.min(level,3)}" data-group-key="${esc(key)}"><td colspan="11"><button class="group-toggle-btn" type="button" data-group-toggle="${esc(key)}" aria-label="${collapsed ? 'Expandir agrupamento' : 'Recolher agrupamento'}">${collapsed ? '+' : '-'}</button><span class="group-row-label">${esc(groupName(field) + ': ' + label)} (${items.length})</span></td></tr>`);
      if(collapsed) return;
      if(level + 1 < groups.length) renderGroupedRows(parts, items, groups, level + 1, path.concat([[field, label]]));
      else items.forEach(row => parts.push(renderDataRow(row)));
    });
  }
  function groupKey(path){ return path.map(([field,label]) => `${field}:${encodeURIComponent(String(label))}`).join('|'); }
  function toggleGroupCollapsed(key){ if(!key) return; if(state.collapsedGroups.has(key)) state.collapsedGroups.delete(key); else state.collapsedGroups.add(key); saveGridState(); renderTable(); }
  function clearColumnFilters(){ document.querySelectorAll('[data-filter]').forEach(el => { el.value = ''; }); state.filters = {}; }
  function renderGroupState(){
    const activeNames = state.groupFields.map(groupName).filter(Boolean);
    $('group-status').textContent = activeNames.length ? `Agrupamento ativo: ${activeNames.join(' > ')}` : 'Sem agrupamento ativo';
    $('group-dropzone').innerHTML = activeNames.length ? state.groupFields.map(field => `<span class="active-group-chip" draggable="true" data-active-group="${esc(field)}" title="Arraste para reordenar">${esc(groupName(field))}<button class="active-group-remove" type="button" data-remove-group="${esc(field)}" title="Remover agrupamento">&times;</button></span>`).join('') : 'Solte um campo aqui para agrupar';
    document.querySelectorAll('[data-group-field]').forEach(btn => btn.classList.toggle('active', state.groupFields.includes(btn.dataset.groupField)));
  }
  function addGroupField(field){ if(!groupName(field) || state.groupFields.includes(field)) return; clearColumnFilters(); state.groupFields.push(field); state.collapsedGroups.clear(); saveGridState(); applyFilters(); }
  function removeGroupField(field){ state.groupFields = state.groupFields.filter(item => item !== field); state.collapsedGroups.clear(); clearColumnFilters(); saveGridState(); applyFilters(); }
  function reorderGroupField(field, beforeField){ if(!state.groupFields.includes(field)) return; const next = state.groupFields.filter(item => item !== field); const index = beforeField ? next.indexOf(beforeField) : -1; if(index >= 0) next.splice(index, 0, field); else next.push(field); state.groupFields = next; state.collapsedGroups.clear(); saveGridState(); applyFilters(); }
  function clearGridState(){ clearColumnFilters(); state.groupFields = []; state.collapsedGroups.clear(); state.sortField = 'usuario_nome'; state.sortDir = 'asc'; saveGridState(); applyFilters(); }
  async function api(path, opts){
    const res = await fetch('/api/ia-command/admin/protheus-web-users' + path, { headers:{ 'Content-Type':'application/json' }, ...opts });
    if(res.status === 401) { location.href = '/login.html'; return null; }
    const body = await res.json().catch(() => ({}));
    if(!res.ok) throw new Error(body.error || 'Erro ' + res.status);
    return body;
  }
  async function carregar(options = {}){
    if(options.clearState) clearGridState();
    $('count').textContent = 'carregando...';
    const data = await api('?inativos=1');
    if(!data) return;
    state.rows = Array.isArray(data.rows) ? data.rows : [];
    state.empresas = Array.isArray(data.empresas) ? data.empresas : [];
    applyFilters();
  }
  const ICON_EMPRESA = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="1"/><path d="M9 21V7a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v14"/></svg>';
  const ICON_FILIAL = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11z"/></svg>';
  async function carregarArvoreDisponivel(){
    if(state.arvoreDisponivel) return state.arvoreDisponivel;
    const data = await api('/arvore-disponivel');
    state.arvoreDisponivel = data || { loboGuara: false, empresas: [] };
    return state.arvoreDisponivel;
  }
  // Reconstroi {empresasPermitidas, filiaisPermitidas} no formato aceito pelo backend
  // a partir dos checkboxes marcados na arvore editavel.
  function lerSelecaoArvore(){
    const empresaAtual = state.empresas[0];
    const marcadosEmpresa = [...document.querySelectorAll('[data-chk-empresa]:checked')].map(el => el.dataset.chkEmpresa);
    const marcadosFilial = [...document.querySelectorAll('[data-chk-filial]:checked')];
    if(!state.arvoreDisponivel || !state.arvoreDisponivel.loboGuara){
      // Empresa sem arvore Protheus (modelo tradicional) -> acesso e a empresa IAHub inteira
      return {
        empresasPermitidas: empresaAtual ? [{ empresaId: empresaAtual.id, codigoProtheus: '', nomeProtheus: empresaAtual.nome || '' }] : [],
        filiaisPermitidas: []
      };
    }
    const empresasPermitidas = marcadosEmpresa.map(codigo => {
      const emp = state.arvoreDisponivel.empresas.find(e => e.codigoProtheus === codigo);
      return { empresaId: empresaAtual ? empresaAtual.id : null, codigoProtheus: codigo, nomeProtheus: emp ? emp.nome : codigo };
    });
    const filiaisPorCodigo = new Map();
    marcadosFilial.forEach(el => {
      const codigo = el.dataset.chkFilialEmpresa;
      if(!filiaisPorCodigo.has(codigo)) filiaisPorCodigo.set(codigo, []);
      filiaisPorCodigo.get(codigo).push(el.dataset.chkFilial);
    });
    // Empresa marcada mas sem nenhuma filial marcada = acesso a todas as filiais dela (sem entrada em filiaisPermitidas)
    const filiaisPermitidas = [...filiaisPorCodigo.entries()].map(([codigoProtheus, filiais]) => ({ codigoProtheus, filiais }));
    return { empresasPermitidas, filiaisPermitidas };
  }
  function empresaMarcada(codigo, empresasPermitidas){
    return (empresasPermitidas || []).some(e => String(e.codigoProtheus || '').trim() === codigo);
  }
  function filiaisMarcadasDaEmpresa(codigo, filiaisPermitidas){
    const item = (filiaisPermitidas || []).find(f => String(f.codigoProtheus || '').trim() === codigo);
    return item ? item.filiais : null; // null = todas (nao restringido)
  }
  async function renderArvoreAcessos(empresasPermitidas, filiaisPermitidas){
    const el = $('acessos-tree');
    el.innerHTML = '<div class="acessos-tree-empty">Carregando...</div>';
    const arvore = await carregarArvoreDisponivel();
    if(!arvore.loboGuara || !arvore.empresas.length){
      el.innerHTML = '<div class="acessos-tree-empty">Esta empresa nao tem multiplas empresas/filiais Protheus cadastradas — o acesso ja e a empresa inteira, nao ha selecao adicional a fazer.</div>';
      return;
    }
    el.innerHTML = arvore.empresas.map(emp => {
      const marcada = empresaMarcada(emp.codigoProtheus, empresasPermitidas);
      const filiaisMarcadas = filiaisMarcadasDaEmpresa(emp.codigoProtheus, filiaisPermitidas);
      const filiaisHtml = emp.filiais.map(f => {
        const checked = marcada && (filiaisMarcadas === null || filiaisMarcadas.includes(f.chave));
        return `<li class="acessos-filial-item">
          <label style="display:flex;align-items:center;gap:7px;cursor:pointer">
            <input type="checkbox" data-chk-filial="${esc(f.chave)}" data-chk-filial-empresa="${esc(emp.codigoProtheus)}" ${checked ? 'checked' : ''} ${marcada ? '' : 'disabled'}>
            ${ICON_FILIAL}<span>${esc(f.nome)}</span><span class="acessos-filial-chave">${esc(f.chave)}</span>
          </label>
        </li>`;
      }).join('');
      return `
        <div class="acessos-empresa">
          <div class="acessos-empresa-head">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;flex:1">
              <input type="checkbox" data-chk-empresa="${esc(emp.codigoProtheus)}" ${marcada ? 'checked' : ''}>
              ${ICON_EMPRESA}<span>${esc(emp.nome)}</span><span class="acessos-empresa-codigo">${esc(emp.codigoProtheus)}</span>
            </label>
            <span class="acessos-empresa-badge">${marcada ? (filiaisMarcadas === null ? 'Todas as filiais' : filiaisMarcadas.length + ' filial(is)') : 'Sem acesso'}</span>
          </div>
          <ul class="acessos-filiais-lista">${filiaisHtml}</ul>
        </div>`;
    }).join('');
    // Marcar/desmarcar a empresa habilita/desabilita os checkboxes de filial dela
    el.querySelectorAll('[data-chk-empresa]').forEach(chkEmpresa => {
      chkEmpresa.addEventListener('change', () => {
        const codigo = chkEmpresa.dataset.chkEmpresa;
        el.querySelectorAll(`[data-chk-filial-empresa="${CSS.escape(codigo)}"]`).forEach(chkFilial => {
          chkFilial.disabled = !chkEmpresa.checked;
          if(chkEmpresa.checked) chkFilial.checked = true; // marcar empresa = todas as filiais por padrao
          else chkFilial.checked = false;
        });
      });
    });
  }
  function abrirEditor(){
    $('save-feedback').textContent = '';
    $('list-view').style.display = 'none';
    $('detail-view').classList.add('open');
  }
  async function abrir(id){
    const data = await api('/' + encodeURIComponent(id));
    if(!data) return;
    state.detail = data;
    state.isNew = false;
    $('detail-title').textContent = data.usuario_nome || data.usuario_id || data.celular || 'Usuario';
    $('detail-subtitle').textContent = (data.empresa_nome || 'Empresa') + ' - ' + fmtPhone(data.celular);
    $('f-usuario-id').value = data.usuario_id || '';
    $('f-usuario-nome').value = data.usuario_nome || '';
    $('f-celular').value = data.celular || '';
    $('f-ativo').value = Number(data.ativo) ? '1' : '0';
    $('f-empresa').value = data.empresa_nome || data.empresa_id || '';
    $('f-sync').value = fmtDate(data.ultimo_sync_em || data.atualizado_em);
    $('f-observacoes').value = data.observacoes || '';
    $('f-empresas').value = jsonFmt(data.empresasPermitidas);
    $('f-filiais').value = jsonFmt(data.filiaisPermitidas);
    $('delete-btn').style.display = '';
    abrirEditor();
    renderArvoreAcessos(data.empresasPermitidas, data.filiaisPermitidas);
  }
  function novo(){
    state.detail = null;
    state.isNew = true;
    $('detail-title').textContent = 'Novo usuario';
    $('detail-subtitle').textContent = 'Cadastro manual';
    $('f-usuario-id').value = '';
    $('f-usuario-nome').value = '';
    $('f-celular').value = '';
    $('f-ativo').value = '1';
    const empresaAtual = state.empresas[0];
    $('f-empresa').value = empresaAtual ? empresaAtual.nome : '';
    $('f-sync').value = '-';
    $('f-observacoes').value = '';
    $('f-empresas').value = jsonFmt([]);
    $('f-filiais').value = jsonFmt([]);
    $('delete-btn').style.display = 'none';
    abrirEditor();
    renderArvoreAcessos([], []);
  }
  async function salvar(){
    try {
      // A arvore clicavel e a fonte primaria de selecao; sincroniza o JSON bruto
      // antes de ler, para que quem editar o textarea diretamente tambem funcione
      // (ultima edicao manual no textarea prevalece se o usuario mexeu nela).
      if(state.arvoreDisponivel && state.arvoreDisponivel.loboGuara){
        const selecao = lerSelecaoArvore();
        $('f-empresas').value = jsonFmt(selecao.empresasPermitidas);
        $('f-filiais').value = jsonFmt(selecao.filiaisPermitidas);
      }
      const payload = {
        usuario_id: $('f-usuario-id').value.trim(),
        usuario_nome: $('f-usuario-nome').value.trim(),
        celular: $('f-celular').value.trim(),
        ativo: $('f-ativo').value === '1',
        observacoes: $('f-observacoes').value.trim() || null,
        empresasPermitidas: JSON.parse($('f-empresas').value || '[]'),
        filiaisPermitidas: JSON.parse($('f-filiais').value || '[]'),
      };
      if(state.isNew){
        state.detail = await api('', { method:'POST', body:JSON.stringify(payload) });
        state.isNew = false;
      } else {
        state.detail = await api('/' + encodeURIComponent(state.detail.id), { method:'PUT', body:JSON.stringify(payload) });
      }
      $('save-feedback').textContent = 'Salvo';
      $('save-feedback').className = 'save-feedback ok';
      await carregar();
    } catch (err) {
      $('save-feedback').textContent = err.message;
      $('save-feedback').className = 'save-feedback fail';
    }
  }
  async function excluir(){
    if(!state.detail || state.isNew) return;
    if(!confirm('Excluir este usuario sincronizado? Esta acao nao pode ser desfeita.')) return;
    try {
      await api('/' + encodeURIComponent(state.detail.id), { method:'DELETE' });
      voltar();
      await carregar();
    } catch (err) {
      $('save-feedback').textContent = err.message;
      $('save-feedback').className = 'save-feedback fail';
    }
  }
  function voltar(){ $('detail-view').classList.remove('open'); $('list-view').style.display = ''; $('save-feedback').textContent = ''; }
  readGridState();
  applyGroupPanelState();
  $('group-toggle').addEventListener('click', () => { state.groupPanelOpen = !state.groupPanelOpen; saveGridState(); applyGroupPanelState(); });
  $('group-clear').addEventListener('click', clearGridState);
  document.querySelectorAll('[data-group-field]').forEach(el => {
    el.addEventListener('click', () => addGroupField(el.dataset.groupField));
    el.addEventListener('dragstart', event => event.dataTransfer.setData('text/group-field', el.dataset.groupField));
  });
  $('group-dropzone').addEventListener('dragover', event => { event.preventDefault(); $('group-dropzone').classList.add('drag-over'); });
  $('group-dropzone').addEventListener('dragleave', () => $('group-dropzone').classList.remove('drag-over'));
  $('group-dropzone').addEventListener('drop', event => {
    event.preventDefault();
    $('group-dropzone').classList.remove('drag-over');
    const field = event.dataTransfer.getData('text/active-group') || event.dataTransfer.getData('text/group-field');
    const target = event.target.closest('[data-active-group]');
    if(event.dataTransfer.getData('text/active-group')) reorderGroupField(field, target ? target.dataset.activeGroup : null);
    else addGroupField(field);
  });
  $('group-dropzone').addEventListener('dragstart', event => {
    const chip = event.target.closest('[data-active-group]');
    if(chip) event.dataTransfer.setData('text/active-group', chip.dataset.activeGroup);
  });
  $('group-dropzone').addEventListener('click', event => {
    const remove = event.target.closest('[data-remove-group]');
    if(remove) removeGroupField(remove.dataset.removeGroup);
  });
  document.querySelectorAll('[data-filter]').forEach(el => {
    el.addEventListener('input', () => { state.filters[el.dataset.filter] = el.value; applyFilters(); });
    el.addEventListener('change', () => { state.filters[el.dataset.filter] = el.value; applyFilters(); });
  });
  document.querySelectorAll('th[data-sort]').forEach(th => th.addEventListener('click', event => {
    if(event.target.closest('input,select,button')) return;
    const field = th.dataset.sort;
    if(state.sortField === field) state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
    else { state.sortField = field; state.sortDir = 'asc'; }
    applyFilters();
  }));
  $('tbody').addEventListener('click', event => {
    const groupToggle = event.target.closest('[data-group-toggle]');
    if(groupToggle) { toggleGroupCollapsed(groupToggle.dataset.groupToggle); return; }
    const groupRow = event.target.closest('tr.group-row');
    if(groupRow) { toggleGroupCollapsed(groupRow.dataset.groupKey); return; }
    const tr = event.target.closest('tr[data-id]');
    if(tr) abrir(tr.dataset.id);
  });
  $('refresh-btn').addEventListener('click', () => carregar());
  $('new-btn').addEventListener('click', novo);
  $('back-btn').addEventListener('click', voltar);
  $('save-btn').addEventListener('click', salvar);
  $('delete-btn').addEventListener('click', excluir);
  carregar().catch(err => { $('count').textContent = err.message; });
})();
</script>
</body>
</html>
</file>

