      <div id="tokenCopiedMsg" style="display: none; margin-top: 10px; font-size: 13px; font-weight: 700; color: #166534; background: #dcfce7; padding: 8px 12px; border-radius: 6px; border: 1px solid #86efac;">
        ✅ Token copiado para a área de transferência! Insira no App Mobile.
      </div>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script>
  const fields = ['initial_bank_usd', 'risk_per_trade_pct', 'min_risk_reward_ratio', 'scanner_top_limit', 'scanner_timeframe', 'mode', 'selected_exchange', 'exchange_api_key', 'exchange_api_secret'];
  function getEmpresaId() {
    return window._iahubEmpresa?.id || window._iahubEmpresa?.empresa_id || '';
  }
  function apiUrl(path) {
    const companyId = getEmpresaId();
    if (!companyId) return path;
    const sep = path.includes('?') ? '&' : '?';
    return `${path}${sep}empresa_id=${encodeURIComponent(companyId)}`;
  }
  async function loadCompanyToken() {
    const tokenInput = document.getElementById('companyTokenInput');
    if (!tokenInput) return;
    tokenInput.value = 'Carregando token...';
    try {
      const data = await fetch(apiUrl('/api/master-crypto/company/mobile-token')).then(r => r.json());
      tokenInput.value = data.mobile_token || '';
    } catch (_) {
      tokenInput.value = 'Nao foi possivel carregar o token';
    }
  }
  async function copyCompanyToken() {
    const tokenInput = document.getElementById('companyTokenInput');
    if (!tokenInput?.value || tokenInput.value.includes('Carregando') || tokenInput.value.includes('Nao foi')) return;
    const copied = await copyTextToClipboard(tokenInput.value, tokenInput);
    if (!copied) {
      alert('Nao foi possivel copiar automaticamente. Selecione o token e copie manualmente com Ctrl+C.');
      return;
    }
    showCopyToast();
    const msg = document.getElementById('tokenCopiedMsg');
    msg.style.display = 'block';
    setTimeout(() => { msg.style.display = 'none'; }, 3000);
  }
  async function copyTextToClipboard(text, inputEl) {
    inputEl.focus();
    inputEl.select();
    inputEl.setSelectionRange(0, text.length);
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch (_) {}
    try {
      return document.execCommand('copy');
    } catch (_) {
      return false;
    }
  }
  function showCopyToast() {
    const toast = document.getElementById('copyToast');
    if (!toast) return;
    toast.classList.add('show');
    clearTimeout(window._copyToastTimer);
    window._copyToastTimer = setTimeout(() => {
      toast.classList.remove('show');
    }, 2600);
  }
  async function generateNewCompanyToken() {
    if (!confirm('Gerar novo token? O token anterior deixara de autenticar o app mobile desta empresa.')) return;
    const tokenInput = document.getElementById('companyTokenInput');
    tokenInput.value = 'Gerando novo token...';
    try {
      const data = await fetch(apiUrl('/api/master-crypto/company/mobile-token/regenerate'), { method: 'POST' }).then(r => r.json());
      tokenInput.value = data.mobile_token || '';
      alert('Novo token gerado e salvo para esta empresa. Atualize o token no aplicativo celular.');
    } catch (_) {
      await loadCompanyToken();
      alert('Nao foi possivel gerar um novo token agora.');
    }
  }
  function switchTab(tabId, btn) {
    document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab-item').forEach(el => el.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    btn.classList.add('active');
  }
  function toggleVisibility(fieldId, btn) {
    const el = document.getElementById(fieldId);
    if (el.type === 'password') {
      el.type = 'text';
      btn.textContent = '🙈';
    } else {
      el.type = 'password';
      btn.textContent = '👁️';
    }
  }
  async function loadSettings() {
    await (window._iahubAuthReady || Promise.resolve());
    setStatus('Carregando parâmetros da empresa...');
    const companyName = window._iahubEmpresa?.nome || 'Empresa Selecionada';
    const companyId = window._iahubEmpresa?.id || '-';
    document.getElementById('companyActiveLabel').textContent = `${companyName} (ID: ${companyId})`;
    await loadCompanyToken();
    try {
      const data = await fetch(apiUrl('/api/master-crypto/company/settings')).then(r => r.json());
      fields.forEach(id => {
        const el = document.getElementById(id);
        if (el && data[id] !== undefined) el.value = data[id];
      });
      const keyInput = document.getElementById('exchange_api_key');
      const secretInput = document.getElementById('exchange_api_secret');
      if (keyInput && data.exchange_api_key_configured) {
        keyInput.value = '';
        keyInput.placeholder = `Configurada (${data.exchange_api_key_masked || 'protegida'}) - preencha apenas para trocar`;
      }
      if (secretInput && data.exchange_api_secret_configured) {
        secretInput.value = '';
        secretInput.placeholder = `Configurada (${data.exchange_api_secret_masked || 'protegida'}) - preencha apenas para trocar`;
      }
      setStatus(`Parâmetros carregados para ${companyName}.`);
    } catch (err) {
      setStatus('Não foi possível carregar os parâmetros desta empresa.');
    }
  }
  async function saveSettings() {
    const body = {
      initial_bank_usd: Number(document.getElementById('initial_bank_usd').value),
      risk_per_trade_pct: Number(document.getElementById('risk_per_trade_pct').value),
      min_risk_reward_ratio: Number(document.getElementById('min_risk_reward_ratio').value),
      scanner_top_limit: Number(document.getElementById('scanner_top_limit').value),
      scanner_timeframe: document.getElementById('scanner_timeframe').value,
      mode: document.getElementById('mode').value,
      selected_exchange: document.getElementById('selected_exchange').value,
    };
    const apiKey = document.getElementById('exchange_api_key').value.trim();
    const apiSecret = document.getElementById('exchange_api_secret').value.trim();
    if (apiKey) body.exchange_api_key = apiKey;
    if (apiSecret) body.exchange_api_secret = apiSecret;
    setStatus('Salvando parâmetros...');
    const res = await fetch(apiUrl('/api/master-crypto/company/settings'), {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) {
      setStatus('Não foi possível salvar os parâmetros.');
      return;
    }
    setStatus('Parâmetros salvos com sucesso para esta empresa.');
    await loadSettings();
  }
  async function testExchangeConnection() {
    const feedback = document.getElementById('testFeedback');
    feedback.style.display = 'block';
    feedback.className = 'test-feedback';
    feedback.innerHTML = '⚡ Testando conexão pública e leitura autenticada dos ativos... Aguarde...';
    const apiKey = document.getElementById('exchange_api_key').value.trim();
    const apiSecret = document.getElementById('exchange_api_secret').value.trim();
    const exchange = document.getElementById('selected_exchange').value;
    try {
      const res = await fetch(apiUrl('/api/master-crypto/company/test-exchange'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          exchange: exchange,
          api_key: apiKey,
          api_secret: apiSecret,
          empresa_id: window._iahubEmpresa?.id || window._iahubEmpresa?.empresa_id || undefined
        })
      });
      const data = await res.json();
      const checks = data.checks || {};
      const connection = checks.connection || {};
      const assets = checks.assets || {};
      feedback.className = data.success ? 'test-feedback success' : 'test-feedback error';
      feedback.innerHTML = `
        ${data.success ? '✅' : '⚠️'} <strong>Teste Binance concluído</strong>
        <div class="test-checks">
          ${renderTestCheck('Conexão pública / cotação', connection)}
          ${renderTestCheck('Leitura autenticada dos ativos', assets)}
        </div>
      `;
    } catch(err) {
      feedback.className = 'test-feedback error';
      feedback.innerHTML = `❌ <strong>Erro de Comunicação:</strong> Não foi possível testar (${err.message})`;
    }
  }
  function renderTestCheck(title, check) {
    const ok = Boolean(check?.success);
    const message = check?.message || 'Sem retorno.';
    return `
      <div class="test-check">
        <span>${ok ? '✅' : '❌'}</span>
        <span><strong>${title}</strong>${escapeHtml(message)}</span>
      </div>
    `;
  }
  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }
  function setStatus(text) {
    document.getElementById('statusLine').textContent = text;
  }
  window.addEventListener('DOMContentLoaded', loadSettings);
</script>
</body>
</html>
</file>

