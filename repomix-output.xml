  <script>
    const $ = id => document.getElementById(id);
    const state = { celular: '', destino: '', challengeId: '', expiresAt: 0, cooldownUntil: 0 };
    const params = new URLSearchParams(window.location.search || '');
    const accessKey = params.get('k') || params.get('accessKey') || '';
    const webLoginBasePath = window.location.pathname.replace(/\/+$/g, '');
    const codeInputs = [...document.querySelectorAll('#code-row input')];
    let timerHandle = null;
    function digits(v) { return String(v || '').replace(/\D/g, ''); }
    function formatPhone(v) {
      const d = digits(v);
      if (d.length === 13 && d.startsWith('55')) {
        return `+55 (${d.slice(2, 4)}) ${d.slice(4, 9)}-${d.slice(9)}`;
      }
      if (d.length === 12 && d.startsWith('55')) {
        return `+55 (${d.slice(2, 4)}) ${d.slice(4, 8)}-${d.slice(8)}`;
      }
      return d ? `+${d}` : '';
    }
    function digitCountBeforeCaret(value, caret) {
      return digits(String(value || '').slice(0, Math.max(0, caret || 0))).length;
    }
    function caretAfterDigitIndex(value, digitIndex) {
      if (digitIndex <= 0) return value.startsWith('+') ? 1 : 0;
      let seen = 0;
      for (let i = 0; i < value.length; i += 1) {
        if (/\d/.test(value[i])) {
          seen += 1;
          if (seen >= digitIndex) return i + 1;
        }
      }
      return value.length;
    }
    function setStatus(msg, type) {
      const el = $('status');
      el.textContent = msg || '';
      el.className = 'status' + (type ? ' ' + type : '');
    }
    function setLoading(btn, loading) {
      btn.disabled = !!loading;
      btn.classList.toggle('loading', !!loading);
    }
    function show(step) {
      $('step-phone').classList.toggle('active', step === 'phone');
      $('step-code').classList.toggle('active', step === 'code');
      $('pill-phone').classList.toggle('active', step === 'phone');
      $('pill-code').classList.toggle('active', step === 'code');
      $('panel-title').textContent = step === 'phone' ? 'Identifique seu WhatsApp' : 'Confirme o codigo';
      $('panel-subtitle').textContent = step === 'phone'
        ? 'Informe o numero com DDI e DDD para receber o codigo de entrada.'
        : 'Verifique a mensagem recebida e conclua o acesso ao chat.';
      setStatus('');
      if (step === 'code') setTimeout(() => codeInputs[0].focus(), 0);
      if (step === 'phone') $('phone').focus();
    }
    async function post(path, body) {
      const headers = { 'Content-Type': 'application/json' };
      if (accessKey) headers['X-Web-Login-Key'] = accessKey;
      const r = await fetch(webLoginBasePath + '/' + path, {
        method: 'POST',
        headers,
        body: JSON.stringify({ ...(body || {}), accessKey }),
      });
      const data = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(data.error || 'Erro ' + r.status);
      return data;
    }
    function codeValue() { return codeInputs.map(i => i.value).join(''); }
    function setCode(value) {
      const chars = digits(value).slice(0, 6).split('');
      codeInputs.forEach((input, idx) => { input.value = chars[idx] || ''; });
      const next = Math.min(chars.length, codeInputs.length - 1);
      codeInputs[next].focus();
    }
    function updateTimer() {
      const remaining = Math.max(0, Math.ceil((state.expiresAt - Date.now()) / 1000));
      const min = String(Math.floor(remaining / 60)).padStart(2, '0');
      const sec = String(remaining % 60).padStart(2, '0');
      const timerEl = $('timer');
      timerEl.classList.toggle('expiring', remaining > 0 && remaining <= 60);
      timerEl.classList.toggle('expired', remaining <= 0);
      timerEl.textContent = `${min}:${sec}`;
      if (remaining <= 0) {
        timerEl.textContent = 'Expirado';
        setStatus('Codigo expirado. Solicite um novo codigo para continuar.', 'error');
      }
      const cooldown = Math.max(0, Math.ceil((state.cooldownUntil - Date.now()) / 1000));
      $('resend').disabled = cooldown > 0;
      $('resend').textContent = cooldown > 0 ? `Reenviar em ${cooldown}s` : 'Reenviar codigo';
    }
    function startTimer(expiresAt) {
      state.expiresAt = expiresAt || Date.now() + 5 * 60 * 1000;
      state.cooldownUntil = Date.now() + 45 * 1000;
      clearInterval(timerHandle);
      updateTimer();
      timerHandle = setInterval(updateTimer, 1000);
    }
    async function solicitarCodigo({ reenviar = false } = {}) {
      const celular = digits($('phone').value || state.celular);
      if (celular.length < 10 || celular.length > 15) {
        setStatus('Informe o numero com DDI e DDD.', 'error');
        return;
      }
      const btn = reenviar ? $('resend') : $('send');
      setLoading(btn, true);
      setStatus(reenviar ? 'Reenviando codigo pelo WhatsApp...' : 'Enviando codigo pelo WhatsApp...');
      try {
        const data = await post('start', { celular });
        state.celular = celular;
        state.destino = data.destino || formatPhone(celular);
        state.challengeId = data.challengeId;
        $('phone-summary').textContent = state.destino;
        codeInputs.forEach(i => { i.value = ''; });
        startTimer(data.expiraEm ? new Date(data.expiraEm).getTime() : Date.now() + 5 * 60 * 1000);
        show('code');
        setStatus(reenviar ? 'Novo codigo enviado.' : 'Codigo enviado. Confira seu WhatsApp.', 'ok');
      } catch (err) {
        setStatus(err.message, 'error');
      } finally {
        setLoading(btn, false);
      }
    }
    $('send').addEventListener('click', () => solicitarCodigo());
    $('resend').addEventListener('click', () => solicitarCodigo({ reenviar: true }));
    $('verify').addEventListener('click', async () => {
      const codigo = codeValue();
      if (codigo.length !== 6) {
        setStatus('Digite os 6 digitos do codigo.', 'error');
        return;
      }
      setLoading($('verify'), true);
      setStatus('Validando codigo...');
      try {
        const data = await post('verify', { celular: state.celular, challengeId: state.challengeId, codigo });
        setStatus('Acesso liberado. Abrindo chat...', 'ok');
        window.location.href = data.chatUrl;
      } catch (err) {
        setStatus(err.message, 'error');
      } finally {
        setLoading($('verify'), false);
      }
    });
    $('back').addEventListener('click', () => {
      state.challengeId = '';
      clearInterval(timerHandle);
      codeInputs.forEach(i => { i.value = ''; });
      show('phone');
    });
    $('phone').addEventListener('input', () => {
      const input = $('phone');
      const digitIndex = digitCountBeforeCaret(input.value, input.selectionStart);
      input.value = formatPhone(input.value);
      const pos = caretAfterDigitIndex(input.value, digitIndex);
      try { input.setSelectionRange(pos, pos); } catch (_err) {}
    });
    $('phone').addEventListener('keydown', e => {
      if (e.key === 'Enter') $('send').click();
    });
    codeInputs.forEach((input, idx) => {
      input.addEventListener('input', () => {
        input.value = digits(input.value).slice(0, 1);
        if (input.value && idx < codeInputs.length - 1) codeInputs[idx + 1].focus();
        if (codeValue().length === 6) $('verify').focus();
      });
      input.addEventListener('keydown', e => {
        if (e.key === 'Backspace' && !input.value && idx > 0) codeInputs[idx - 1].focus();
        if (e.key === 'ArrowLeft' && idx > 0) codeInputs[idx - 1].focus();
        if (e.key === 'ArrowRight' && idx < codeInputs.length - 1) codeInputs[idx + 1].focus();
        if (e.key === 'Enter') $('verify').click();
      });
      input.addEventListener('paste', e => {
        e.preventDefault();
        setCode(e.clipboardData.getData('text'));
      });
    });
    show('phone');
  </script>
