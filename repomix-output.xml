      letter-spacing: -.3px;
    }
    .pub-hero p {
      font-size: 14px;
      color: var(--text-md);
      max-width: 520px;
      margin: 0 auto;
      line-height: 1.6;
    }
    /* ── Container ──────────────────────────────────────────────── */
    .pub-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 20px 32px 80px;
    }
    .section-title {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .09em;
      color: var(--text-lo);
      font-weight: 600;
      margin-bottom: 16px;
    }
    /* ── Grade de vagas ─────────────────────────────────────────── */
    .vagas-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
