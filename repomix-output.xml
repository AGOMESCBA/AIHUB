<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">⚡</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()">☰</button>
      <span class="topbar-title">IA Command › Relatório WhatsApp Financeiro</span>
    </div>
    <div class="page-content">
      <div class="page-head">
        <div>
          <div class="page-kicker">IA Command · WhatsApp</div>
          <div class="page-title">Relatório Financeiro para WhatsApp</div>
          <div class="page-subtitle">Cole os dados brutos de Contas a Pagar e gere a mensagem formatada por empresa e mês.</div>
        </div>
      </div>
      <div class="two-col">
        <div class="panel">
          <div class="panel-head">
            <span class="panel-title">📋 Dados Brutos</span>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="form-label">Nome da Empresa</label>
              <input id="inp-empresa" class="form-control" type="text"
                     placeholder="Ex: C3I, J2A Consultoria…"
                     oninput="sincronizarEmpresas()">
              <span class="hint">
                Para <strong>múltiplas empresas</strong>, insira um bloco por empresa:
                a primeira linha deve ser <code>##NOME DA EMPRESA##</code>.
              </span>
            </div>
            <div class="form-group">
              <label class="form-label">Dataset (uma linha por título)</label>
              <textarea id="inp-dados" class="form-control"
                placeholder="202605 ALELO 3375
202605 AMTU 297
202606 RECEITA FEDERAL 6556,34
…"></textarea>
              <span class="hint">
                Formato: <code>AAAAMM FORNECEDOR VALOR</code><br>
                Separador: um ou mais espaços. Valores negativos são aceitos.
              </span>
            </div>
            <div id="empresa-chips-wrap" style="display:none">
              <div class="form-label" style="margin-bottom:6px">Empresas detectadas</div>
              <div class="empresa-chips" id="empresa-chips"></div>
            </div>
            <button class="btn btn-primary" onclick="formatar()" style="align-self:flex-start">
              Formatar para WhatsApp
            </button>
          </div>
        </div>
        <div class="panel">
          <div class="panel-head">
            <span class="panel-title">📱 Mensagem Formatada</span>
            <div style="display:flex;align-items:center;gap:10px">
              <span id="copy-ok" class="copy-ok">✓ Copiado!</span>
              <button class="btn btn-ghost" onclick="copiar()" id="btn-copiar" style="display:none">Copiar</button>
            </div>
          </div>
          <div class="panel-body">
            <div id="empresa-resumo" class="empresa-list" style="display:none"></div>
            <pre id="output" class="output-pre"><span class="output-empty">A mensagem formatada aparecerá aqui…</span></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="help-overlay" id="help-overlay" onclick="fecharAjuda()"></div>
<div class="help-drawer" id="help-drawer">
  <div class="help-drawer-header">
    <span class="help-drawer-title">Ajuda - Relatorio Financeiro para WhatsApp</span>
    <button class="help-drawer-close" onclick="fecharAjuda()" title="Fechar">&times;</button>
  </div>
  <div class="help-drawer-body">
    <div class="help-section">
      <div class="help-section-title">Objetivo</div>
      <div class="help-item-desc">Esta rotina transforma dados brutos de Contas a Pagar em uma mensagem pronta para WhatsApp, agrupada por empresa, mes e fornecedor. Ela nao consulta o ERP; trabalha apenas com o texto colado na tela.</div>
      <div class="help-tip">Use para preparar comunicados financeiros rapidos, com valores consolidados e leitura amigavel no WhatsApp.</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Formato de entrada</div>
      <div class="help-item-desc">Cada titulo deve estar em uma linha no formato <strong>AAAAMM FORNECEDOR VALOR</strong>. O ultimo campo da linha e tratado como valor; todo o texto entre periodo e valor vira fornecedor.</div>
      <div class="help-code">202607 RECEITA FEDERAL 6556,34
202607 ALELO BENEFICIOS 3375
202608 ALUGUEL MATRIZ 12000,00</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Multiplas empresas</div>
      <div class="help-item-desc">Para processar mais de uma empresa no mesmo texto, separe os blocos usando uma linha com o nome entre dois pares de sustenido.</div>
      <div class="help-code">##EMPRESA A##
202607 FORNECEDOR X 1000
##EMPRESA B##
202607 FORNECEDOR Y 2500</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Como usar</div>
      <div class="help-item"><div class="help-item-label">1. Cole os dados</div><div class="help-item-desc">Cole o dataset bruto no painel da esquerda. Para empresa unica, preencha tambem o nome da empresa.</div></div>
      <div class="help-item"><div class="help-item-label">2. Formate</div><div class="help-item-desc">Clique em Formatar para WhatsApp ou use Ctrl+Enter dentro do campo de dados.</div></div>
      <div class="help-item"><div class="help-item-label">3. Revise antes de enviar</div><div class="help-item-desc">Confira empresas, meses, fornecedores e total. Depois copie a mensagem formatada.</div></div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Cuidados</div>
      <div class="help-item-desc">Valores com ponto e virgula sao aceitos, mas evite colunas extras apos o valor. Se uma linha nao seguir o padrao, ela sera ignorada no resultado final.</div>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
(function () {
  const MESES = ['JANEIRO','FEVEREIRO','MARÇO','ABRIL','MAIO','JUNHO',
                 'JULHO','AGOSTO','SETEMBRO','OUTUBRO','NOVEMBRO','DEZEMBRO'];
  /* ─── parse ───────────────────────────────────────────────────────────── */
  function parseLinha(linha) {
    linha = linha.trim();
    if (!linha) return null;
    // Captura: AAAAMM  FORNECEDOR (pode ter espaços)  VALOR (último token)
    const m = linha.match(/^(\d{6})\s+(.+?)\s+([-\d.,]+)\s*$/);
    if (!m) return null;
    const periodo   = m[1];
    const fornecedor = m[2].trim().toUpperCase();
    const valorStr  = m[3].replace('.', '').replace(',', '.');
    const valor     = parseFloat(valorStr);
    if (isNaN(valor)) return null;
    return { periodo, fornecedor, valor };
  }
  function parseBloco(texto, nomeEmpresa) {
    const linhas = texto.split('\n');
    const titulos = [];
    for (const linha of linhas) {
      const t = parseLinha(linha);
      if (t) titulos.push(t);
    }
    return { nome: nomeEmpresa, titulos };
  }
  function parseInput(textoCompleto, nomeAvulso) {
    /* Detecta múltiplos blocos via ##NOME## */
    const blocos = [];
    const empresaRe = /##([^#]+)##/g;
    let match;
    const indices = [];
    while ((match = empresaRe.exec(textoCompleto)) !== null) {
      indices.push({ inicio: match.index, fim: match.index + match[0].length, nome: match[1].trim() });
    }
    if (indices.length === 0) {
      blocos.push(parseBloco(textoCompleto, nomeAvulso || 'Empresa'));
    } else {
      for (let i = 0; i < indices.length; i++) {
        const { fim, nome } = indices[i];
        const proximo = indices[i + 1] ? indices[i + 1].inicio : textoCompleto.length;
        const corpo   = textoCompleto.slice(fim, proximo);
        blocos.push(parseBloco(corpo, nome));
      }
    }
    return blocos.filter(b => b.titulos.length > 0);
  }
  /* ─── formatação ──────────────────────────────────────────────────────── */
  function formatarValor(v) {
    const abs      = Math.abs(v);
    const inteiro  = Math.floor(abs);
    const decimal  = Math.round((abs - inteiro) * 100);
    const inteiroFmt = inteiro.toLocaleString('pt-BR');
    const decimalFmt = String(decimal).padStart(2, '0');
    return (v < 0 ? 'R$ -' : 'R$ ') + inteiroFmt + ',' + decimalFmt;
  }
  function periodoLabel(periodo) {
    const ano = periodo.slice(0, 4);
    const mes = parseInt(periodo.slice(4, 6), 10) - 1;
    return MESES[mes] + ' / ' + ano;
  }
  function formatarEmpresa(bloco) {
    const { nome, titulos } = bloco;
    // Agrupar por período
    const mapa = new Map();
    for (const t of titulos) {
      if (!mapa.has(t.periodo)) mapa.set(t.periodo, []);
      mapa.get(t.periodo).push(t);
    }
    const periodos = [...mapa.keys()].sort();
    let total = 0;
    const linhas = [];
    linhas.push(`🏢 *${nome}*`);
    linhas.push(`💰 *Detalhe por Fornecedor*`);
    for (const periodo of periodos) {
      const itens = mapa.get(periodo);
      linhas.push('');
      linhas.push(`🗓 *${periodoLabel(periodo)}*`);
      itens.forEach((item, idx) => {
        total += item.valor;
        linhas.push(`  ${idx + 1}. *${item.fornecedor}:* ${formatarValor(item.valor)}`);
      });
    }
    linhas.push('');
    linhas.push(`*Total da Empresa: ${formatarValor(total)}*`);
    linhas.push('---');
    return { texto: linhas.join('\n'), total };
  }
  /* ─── sincronizar chips de empresa ───────────────────────────────────── */
  let empresasDetectadas = [];
  function sincronizarEmpresas() {
    const textoCompleto = document.getElementById('inp-dados').value;
    const empresaRe     = /##([^#]+)##/g;
    const nomes         = [];
    let match;
    while ((match = empresaRe.exec(textoCompleto)) !== null) {
      nomes.push(match[1].trim());
    }
    empresasDetectadas = nomes;
    const wrap   = document.getElementById('empresa-chips-wrap');
    const chips  = document.getElementById('empresa-chips');
    const inpEmp = document.getElementById('inp-empresa');
    if (nomes.length > 1) {
      wrap.style.display = 'block';
      inpEmp.parentElement.style.display = 'none';
      chips.innerHTML = nomes.map(n =>
        `<span class="chip-empresa" title="${n}">${n}</span>`
      ).join('');
    } else {
      wrap.style.display = 'none';
      inpEmp.parentElement.style.display = 'flex';
    }
  }
  /* ─── ação principal ──────────────────────────────────────────────────── */
  function formatar() {
    const texto     = document.getElementById('inp-dados').value.trim();
    const nomeAvulso = document.getElementById('inp-empresa').value.trim();
    const output    = document.getElementById('output');
    const btnCopiar = document.getElementById('btn-copiar');
    const resumoEl  = document.getElementById('empresa-resumo');
    if (!texto) {
      output.innerHTML = '<span class="output-empty">Cole os dados no campo ao lado.</span>';
      btnCopiar.style.display = 'none';
      resumoEl.style.display  = 'none';
      return;
    }
    const blocos     = parseInput(texto, nomeAvulso || 'Empresa');
    const resultados = blocos.map(formatarEmpresa);
    const mensagem   = resultados.map(r => r.texto).join('\n\n');
    output.textContent = mensagem;
    btnCopiar.style.display = 'block';
    // Resumo por empresa
    if (blocos.length > 1) {
      resumoEl.style.display = 'flex';
      resumoEl.innerHTML = blocos.map((b, i) =>
        `<div class="empresa-item">
          <span class="empresa-item-icon">🏢</span>
          <span class="empresa-item-nome">${b.nome}</span>
          <span class="empresa-item-total">${formatarValor(resultados[i].total)}</span>
        </div>`
      ).join('');
    } else {
      resumoEl.style.display = 'none';
    }
  }
  /* ─── copiar ──────────────────────────────────────────────────────────── */
  function copiar() {
    const texto = document.getElementById('output').textContent;
    if (!texto || texto.includes('aparecerá aqui')) return;
    navigator.clipboard.writeText(texto).then(() => {
      const ok = document.getElementById('copy-ok');
      ok.style.display = 'inline';
      setTimeout(() => { ok.style.display = 'none'; }, 2000);
    });
  }
  /* ─── listener do textarea para detecção de blocos ───────────────────── */
  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('inp-dados').addEventListener('input', sincronizarEmpresas);
    // Atalho Ctrl+Enter para formatar
    document.getElementById('inp-dados').addEventListener('keydown', e => {
      if (e.ctrlKey && e.key === 'Enter') formatar();
    });
  });
  window.formatar = formatar;
  window.copiar   = copiar;
  window.sincronizarEmpresas = sincronizarEmpresas;
  window.abrirAjuda = function abrirAjuda() { document.getElementById('help-overlay').classList.add('open'); document.getElementById('help-drawer').classList.add('open'); };
  window.fecharAjuda = function fecharAjuda() { document.getElementById('help-overlay').classList.remove('open'); document.getElementById('help-drawer').classList.remove('open'); };
})();
</script>
</body>
</html>
