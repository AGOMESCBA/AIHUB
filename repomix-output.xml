<file path="apps/IA Command/frontend/admin-nlsql-shadow.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shadow NL-SQL - IA Command</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css">
  <style>
    :root { --accent:#7c3aed; --accent-light:#a78bfa; --accent-glow:rgba(124,58,237,.1); }
    .sidebar-logo .logo-icon { background:#7c3aed !important; }
    .topbar-menu-btn { flex-shrink:0;background:none;border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;color:var(--text-md);transition:background var(--transition),color var(--transition); }
    .topbar-menu-btn:hover { background:var(--bg-hover);color:var(--text-hi); }
    .topbar-title { flex:1;min-width:0;font-weight:700; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;margin-bottom:3px; }
    .ctrl-bar { display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:10px; }
    .ctrl-bar-title { font-size:18px;font-weight:700;color:var(--text-hi);line-height:1.25;display:flex;align-items:baseline;gap:8px; }
    .ctrl-count { font-size:12px;color:var(--text-lo);font-weight:400; }
    .ctrl-bar-right { display:flex;gap:8px;align-items:center;flex-shrink:0; }
    .filter-bar { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:10px 14px;margin-bottom:10px;box-shadow:var(--shadow-sm); }
    .filter-bar-row { display:flex;align-items:center;gap:8px;flex-wrap:wrap; }
    .filter-bar-row .form-control { height:34px;font-size:13px; }
    .filter-bar-row input[type="date"].form-control { width:150px;flex:0 0 150px; }
    .filter-bar-row select.form-control { width:auto;min-width:150px; }
    .metric-row { display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:10px;margin-bottom:10px; }
    .metric { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:12px 14px;min-width:0; }
    .metric span { display:block;font-size:11px;color:var(--text-lo);text-transform:uppercase;letter-spacing:.05em;font-weight:800;margin-bottom:5px; }
    .metric strong { display:block;font-size:20px;color:var(--text-hi);line-height:1.2; }
    .metric small { display:block;font-size:11px;color:var(--text-lo);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
    .grid-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden; }
    .badge { display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:800;white-space:nowrap; }
    .badge-ok { background:#dcfce7;color:#15803d; }
    .badge-info { background:#dbeafe;color:#1d4ed8; }
    .badge-warn { background:#fef3c7;color:#92400e; }
    .badge-fail { background:#fee2e2;color:#b91c1c; }
    .badge-neutro { background:var(--bg-base);color:var(--text-md);border:1px solid var(--border); }
    .sql-preview { display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;white-space:normal;line-height:1.35;word-break:break-word;font-family:ui-monospace,monospace;font-size:12px; }
    .tabulator { border:none !important;background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important;border-right:none !important;color:var(--text-lo) !important;font-size:11px !important;font-weight:800 !important;text-transform:uppercase;letter-spacing:.05em; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-base) !important;color:var(--text-hi) !important;border:1px solid var(--border) !important;border-radius:4px !important;font-size:11px !important;padding:3px 6px !important;width:100% !important; }
    .tabulator .tabulator-row { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important;cursor:pointer; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row.row-selecionada { background:var(--accent-glow) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important;color:var(--text-md);font-size:13px;padding:10px 12px !important; }
    .loading-panel { display:none;align-items:center;justify-content:center;flex-direction:column;gap:10px;min-height:220px;color:var(--text-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);margin-bottom:10px; }
    .loading-panel.show { display:flex; }
    .loading-spinner { width:28px;height:28px;border-radius:50%;border:3px solid rgba(124,58,237,.18);border-top-color:var(--accent);animation:spin .8s linear infinite; }
    @keyframes spin { to { transform:rotate(360deg); } }
    .detail-section { display:none;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden; }
    .detail-head { display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px;border-bottom:1px solid var(--border); }
    .detail-title { font-size:15px;font-weight:800;color:var(--text-hi); }
    .detail-body { padding:18px; }
    .meta-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;margin-bottom:14px; }
    .meta-item { background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px;min-width:0; }
    .meta-item span { color:var(--text-lo);font-size:11px;display:block;margin-bottom:4px; }
    .meta-item strong { color:var(--text-hi);font-size:13px;word-break:break-word; }
    .compare-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px; }
    .compare-pane { border:1px solid var(--border);border-radius:var(--radius-sm);overflow:hidden;background:var(--bg-base);min-width:0; }
    .compare-head { display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 12px;border-bottom:1px solid var(--border);background:var(--bg-card); }
    .compare-title { font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--text-lo); }
    .compare-pre { margin:0;padding:12px;min-height:150px;max-height:320px;overflow:auto;font-family:ui-monospace,monospace;font-size:12px;line-height:1.55;white-space:pre-wrap;word-break:break-word;color:var(--text-md); }
    .btn-mini { height:26px;border:1px solid var(--border);border-radius:6px;background:var(--bg-base);color:var(--text-md);font-size:11px;font-weight:800;padding:0 9px;cursor:pointer; }
    .btn-mini:hover { border-color:var(--accent);color:var(--accent);background:var(--accent-glow); }
    .help-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:300;opacity:0;pointer-events:none;transition:opacity .25s;}
    .help-overlay.open{opacity:1;pointer-events:all;}
    .help-drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,100vw);background:var(--bg-card);border-left:1px solid var(--border);z-index:301;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);overflow:hidden;}
    .help-drawer.open{transform:translateX(0);}
    .help-drawer-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--border);flex-shrink:0;}
    .help-drawer-title{font-size:15px;font-weight:700;color:var(--text-hi);}
    .help-drawer-close{width:30px;height:30px;border:none;background:none;cursor:pointer;border-radius:6px;color:var(--text-lo);}
    .help-drawer-body{flex:1;overflow-y:auto;padding:22px;}
    .help-section{margin-bottom:24px;}
    .help-section-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--accent);margin-bottom:10px;}
    .help-item-desc{font-size:13px;color:var(--text-md);line-height:1.65;}
    .help-tabs{display:flex;gap:6px;border-bottom:1px solid var(--border);margin:-4px 0 18px;overflow-x:auto;}
    .help-tab{border:0;background:transparent;color:var(--text-lo);cursor:pointer;padding:9px 8px;font:inherit;font-size:12px;font-weight:800;border-bottom:2px solid transparent;white-space:nowrap;}
    .help-tab.active{color:var(--accent);border-bottom-color:var(--accent);}
    .help-panel{display:none;}
    .help-panel.active{display:block;}
    .help-list{margin:8px 0 0 18px;padding:0;color:var(--text-md);font-size:13px;line-height:1.65;}
    .help-list li{margin:0 0 7px;}
    .help-callout{border:1px solid var(--border);border-radius:8px;background:var(--bg-base);padding:11px 12px;margin-top:10px;color:var(--text-md);font-size:13px;line-height:1.55;}
    @media (max-width: 1100px) { .metric-row { grid-template-columns:repeat(3,1fr); } .compare-grid { grid-template-columns:1fr; } }
    @media (max-width: 700px) { .metric-row { grid-template-columns:1fr 1fr; } .ctrl-bar { align-items:flex-start;flex-direction:column; } }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command /</span> Shadow NL-SQL</span>
      <button class="btn btn-ghost" onclick="abrirAjuda()">Ajuda</button>
    </div>
    <div class="content">
      <section id="sec-lista">
        <div class="ctrl-bar">
          <div>
            <div class="page-kicker">Aprendizado NL-SQL</div>
            <div class="ctrl-bar-title">Auditoria do Shadow Mode <span class="ctrl-count" id="count">carregando...</span></div>
          </div>
          <div class="ctrl-bar-right">
            <button class="btn btn-secondary" id="btn-atualizar" onclick="atualizarClick()">Atualizar</button>
          </div>
        </div>
        <div class="filter-bar">
          <div class="filter-bar-row">
            <input class="form-control" type="date" id="f-inicio" title="Data inicial">
            <input class="form-control" type="date" id="f-fim" title="Data final">
            <select class="form-control" id="f-modulo">
              <option value="">Todos os modulos</option>
              <option value="financeiro">Financeiro</option>
              <option value="compras">Compras</option>
              <option value="faturamento">Faturamento</option>
              <option value="comissao">Comissao</option>
              <option value="estoque">Estoque</option>
            </select>
            <select class="form-control" id="f-resultado">
              <option value="">Todos os resultados</option>
              <option value="match_template_exato">Match template exato</option>
              <option value="match_sql_aplicado_exato">Match SQL aplicado</option>
              <option value="mismatch">Mismatch</option>
              <option value="template_invalido">Template invalido</option>
              <option value="sem_candidato">Sem candidato</option>
            </select>
            <select class="form-control" id="f-elegivel">
              <option value="">Elegibilidade</option>
              <option value="1">Elegivel shadow</option>
              <option value="0">Nao elegivel</option>
            </select>
            <select class="form-control" id="f-classificacao">
              <option value="">Todas as classificacoes</option>
              <option value="aprovado_automatico">Aprovado auto</option>
              <option value="reprovado_automatico">Reprovado auto</option>
              <option value="inconclusivo">Inconclusivo</option>
              <option value="bloqueado_por_risco">Bloqueado por risco</option>
              <option value="aprovado_usuario">Aprovado usuario</option>
              <option value="reprovado_usuario">Reprovado usuario</option>
              <option value="ignorado_usuario">Ignorado usuario</option>
              <option value="bloqueado_usuario">Bloqueado usuario</option>
            </select>
            <select class="form-control" id="f-limit">
              <option value="200">200</option>
              <option value="500" selected>500</option>
              <option value="1000">1000</option>
              <option value="2000">2000</option>
            </select>
            <button class="btn btn-primary" onclick="carregar()">Aplicar</button>
          </div>
        </div>
        <div class="metric-row">
          <div class="metric"><span>Total</span><strong id="m-total">0</strong><small>Registros avaliados</small></div>
          <div class="metric"><span>Com candidato</span><strong id="m-candidato">0</strong><small>Candidato acima do limiar</small></div>
          <div class="metric"><span>Precisao template</span><strong id="m-precisao">-</strong><small>Match template / com candidato</small></div>
          <div class="metric"><span>Match exato</span><strong id="m-match">0</strong><small>Template exatamente igual</small></div>
          <div class="metric"><span>Mismatch</span><strong id="m-mismatch">0</strong><small>Candidato divergente</small></div>
          <div class="metric"><span>Elegivel</span><strong id="m-elegivel">0</strong><small>Apenas estatistico</small></div>
        </div>
        <div class="loading-panel" id="loading">
          <div class="loading-spinner"></div>
          <div style="font-size:14px;font-weight:700;color:var(--text-hi)">Carregando shadow mode</div>
          <div style="font-size:12px;color:var(--text-lo)">Lendo candidatos semanticos comparados contra SQL real</div>
        </div>
        <div class="grid-card">
          <div id="tabela"></div>
        </div>
      </section>
      <section class="detail-section" id="sec-detalhe">
        <div class="detail-head">
          <div>
            <div class="page-kicker">Detalhe do shadow</div>
            <div class="detail-title" id="d-title">Registro</div>
          </div>
          <button class="btn btn-secondary" onclick="fecharDetalhe()">Voltar</button>
        </div>
        <div class="detail-body">
          <div class="meta-grid">
            <div class="meta-item"><span>Resultado</span><strong id="d-resultado">-</strong></div>
            <div class="meta-item"><span>Modulo</span><strong id="d-modulo">-</strong></div>
            <div class="meta-item"><span>Intent</span><strong id="d-intent">-</strong></div>
            <div class="meta-item"><span>Score</span><strong id="d-score">-</strong></div>
            <div class="meta-item"><span>Template valido</span><strong id="d-template-valido">-</strong></div>
            <div class="meta-item"><span>Elegivel shadow</span><strong id="d-elegivel">-</strong></div>
            <div class="meta-item"><span>Limiar auto</span><strong id="d-limiar">-</strong></div>
            <div class="meta-item"><span>Execucao candidata</span><strong id="d-candidate-id">-</strong></div>
            <div class="meta-item"><span>Classificacao efetiva</span><strong id="d-classificacao">-</strong></div>
            <div class="meta-item"><span>Classificacao auto</span><strong id="d-classificacao-auto">-</strong></div>
            <div class="meta-item"><span>Override</span><strong id="d-override">-</strong></div>
          </div>
          <div class="filter-bar" style="margin-bottom:14px">
            <div class="filter-bar-row">
              <select class="form-control" id="d-override-classificacao">
                <option value="">Sem override</option>
                <option value="aprovado_usuario">Aprovar por usuario</option>
                <option value="reprovado_usuario">Reprovar por usuario</option>
                <option value="ignorado_usuario">Ignorar por usuario</option>
                <option value="bloqueado_usuario">Bloquear por usuario</option>
              </select>
              <input class="form-control" id="d-override-motivo" placeholder="Motivo opcional" style="min-width:260px;flex:1">
              <button class="btn btn-primary" onclick="salvarOverride()">Salvar classificacao</button>
            </div>
          </div>
          <div class="compare-grid">
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">Template candidato</span><button class="btn-mini" onclick="copiarEl('d-candidate-template', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-candidate-template"></pre>
            </div>
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">Template real da LLM</span><button class="btn-mini" onclick="copiarEl('d-actual-template', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-actual-template"></pre>
            </div>
          </div>
          <div class="compare-grid">
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">SQL candidato aplicado</span><button class="btn-mini" onclick="copiarEl('d-candidate-applied', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-candidate-applied"></pre>
            </div>
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">SQL real final</span><button class="btn-mini" onclick="copiarEl('d-actual-final', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-actual-final"></pre>
            </div>
          </div>
          <div class="compare-grid">
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">SQL canonico real</span><button class="btn-mini" onclick="copiarEl('d-actual-canonico', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-actual-canonico"></pre>
            </div>
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">Detalhes da comparacao</span><button class="btn-mini" onclick="copiarEl('d-detalhes', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-detalhes"></pre>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script>
  let table = null;
  let dados = [];
  let rowAtual = null;
  function esc(v) {
    return String(v ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }
  function fmtData(v) {
    if (!v) return '-';
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? String(v) : d.toLocaleString('pt-BR');
  }
  function pct(v) {
    return v === null || v === undefined ? '-' : `${(Number(v) * 100).toFixed(2)}%`;
  }
  function score(v) {
    return v === null || v === undefined ? '-' : Number(v).toFixed(3);
  }
  function simNao(v) {
    return Number(v) === 1 ? 'Sim' : 'Nao';
  }
  function execCandidateId(v) {
    const texto = String(v || '').trim();
    if (!texto || /^(admin|usuario|user|sistema)$/i.test(texto)) return '-';
    if (/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(texto)) return texto;
    if (/^[a-z0-9_-]{12,}$/i.test(texto)) return texto;
    return '-';
  }
  function resultadoBadge(resultado) {
    const label = {
      match_template_exato: 'Match template',
      match_sql_aplicado_exato: 'Match aplicado',
      mismatch: 'Mismatch',
      template_invalido: 'Template invalido',
      sem_candidato: 'Sem candidato',
    }[resultado] || resultado || '-';
    const cls = resultado === 'match_template_exato' ? 'badge-ok'
      : resultado === 'match_sql_aplicado_exato' ? 'badge-info'
      : resultado === 'sem_candidato' ? 'badge-neutro'
      : resultado === 'template_invalido' ? 'badge-warn'
      : 'badge-fail';
    return `<span class="badge ${cls}">${esc(label)}</span>`;
  }
  function classificacaoBadge(v) {
    const label = {
      aprovado_automatico: 'Aprovado auto',
      reprovado_automatico: 'Reprovado auto',
      inconclusivo: 'Inconclusivo',
      bloqueado_por_risco: 'Bloqueado risco',
      aprovado_usuario: 'Aprovado usuario',
      reprovado_usuario: 'Reprovado usuario',
      ignorado_usuario: 'Ignorado usuario',
      bloqueado_usuario: 'Bloqueado usuario',
    }[v] || v || 'Nao classificado';
    const cls = /aprovado/.test(String(v)) ? 'badge-ok'
      : /bloqueado|reprovado/.test(String(v)) ? 'badge-fail'
      : /ignorado|inconclusivo/.test(String(v)) ? 'badge-warn'
      : 'badge-neutro';
    return `<span class="badge ${cls}">${esc(label)}</span>`;
  }
  function setLoading(on) {
    document.getElementById('loading').classList.toggle('show', !!on);
  }
  function paramsFiltros() {
    const p = new URLSearchParams();
    for (const [id, nome] of [['f-inicio','inicio'], ['f-fim','fim'], ['f-modulo','modulo'], ['f-resultado','resultado'], ['f-elegivel','elegivel'], ['f-classificacao','classificacao'], ['f-limit','limit']]) {
      const v = document.getElementById(id)?.value || '';
      if (v) p.set(nome, v);
    }
    return p.toString();
  }
  function atualizarMetricas(resumo) {
    document.getElementById('m-total').textContent = resumo.total || 0;
    document.getElementById('m-candidato').textContent = resumo.com_candidato || 0;
    document.getElementById('m-precisao').textContent = pct(resumo.precisao_template);
    document.getElementById('m-match').textContent = resumo.match_template_exato || 0;
    document.getElementById('m-mismatch').textContent = resumo.mismatch || 0;
    document.getElementById('m-elegivel').textContent = resumo.auto_reuse_elegivel || 0;
  }
  function criarTabela(data) {
    table = new Tabulator('#tabela', {
      data, index: 'id', layout: 'fitColumns', movableColumns: true,
      height: 'calc(100vh - 310px)',
      placeholder: '<div style="padding:40px;text-align:center;color:var(--text-lo)">Nenhum registro de shadow mode encontrado.</div>',
      tableBuilt: () => protegerFiltrosHeaderShadow(),
      dataProcessed: () => protegerFiltrosHeaderShadow(),
      renderComplete: () => protegerFiltrosHeaderShadow(),
      columns: [
        { title: 'Data/Hora', field: 'criado_em', width: 155, sorter: 'string', formatter: c => fmtData(c.getValue()) },
        { title: 'Resultado', field: 'comparacao_resultado', width: 160, headerFilter: 'select',
          headerFilterParams: { values: { '': 'Todos', match_template_exato: 'Match template', match_sql_aplicado_exato: 'Match aplicado', mismatch: 'Mismatch', template_invalido: 'Template invalido', sem_candidato: 'Sem candidato' } },
          formatter: c => resultadoBadge(c.getValue()) },
        { title: 'Modulo', field: 'module', width: 120, headerFilter: true, formatter: c => esc(c.getValue() || '-') },
        { title: 'Intent', field: 'intent', width: 125, headerFilter: true, formatter: c => esc(c.getValue() || '-') },
        { title: 'Score', field: 'candidate_score', width: 90, hozAlign: 'right', sorter: 'number', formatter: c => `<strong>${score(c.getValue())}</strong>` },
        { title: 'Classificacao', field: 'classificacao_efetiva', width: 150, headerFilter: 'select',
          headerFilterParams: { values: { '': 'Todas', aprovado_automatico: 'Aprovado auto', reprovado_automatico: 'Reprovado auto', inconclusivo: 'Inconclusivo', bloqueado_por_risco: 'Bloqueado risco', aprovado_usuario: 'Aprovado usuario', reprovado_usuario: 'Reprovado usuario', ignorado_usuario: 'Ignorado usuario', bloqueado_usuario: 'Bloqueado usuario' } },
          formatter: c => classificacaoBadge(c.getValue() || c.getData().classificacao_auto) },
        { title: 'Elegivel', field: 'auto_reuse_elegivel', width: 95, hozAlign: 'center', formatter: c => Number(c.getValue()) === 1 ? '<span class="badge badge-ok">Sim</span>' : '<span class="badge badge-neutro">Nao</span>' },
        { title: 'Template', field: 'template_valido', width: 100, hozAlign: 'center', formatter: c => Number(c.getValue()) === 1 ? '<span class="badge badge-ok">Valido</span>' : '<span class="badge badge-warn">Nao</span>' },
        { title: 'Execucao candidata', field: 'candidate_execution_log_id', width: 180, headerFilter: true, formatter: c => esc(execCandidateId(c.getValue())) },
        { title: 'Template candidato', field: 'candidate_sql_template', minWidth: 250, formatter: c => `<div class="sql-preview">${esc(c.getValue() || '-')}</div>` },
        { title: 'Template real', field: 'actual_sql_template', minWidth: 250, formatter: c => `<div class="sql-preview">${esc(c.getValue() || '-')}</div>` },
      ],
      rowClick: (e, row) => verDetalhe(row.getData()),
    });
  }
  function protegerFiltrosHeaderShadow() {
    if (!table) return;
    const root = table.element || document.getElementById('tabela') || document;
    const controls = [...root.querySelectorAll('.tabulator-header-filter input, .tabulator-header-filter select')];
    if (!controls.length) return;
    controls.forEach((el, idx) => {
      el.setAttribute('autocomplete', 'off');
      el.setAttribute('name', `iac_shadow_filter_${idx}_${Date.now()}`);
      if (el.tagName === 'INPUT') {
        el.setAttribute('spellcheck', 'false');
        el.setAttribute('autocapitalize', 'off');
        if (!el.dataset.shadowReadonlyGuarded) {
          el.dataset.shadowReadonlyGuarded = '1';
          el.setAttribute('readonly', 'readonly');
          el.addEventListener('focus', () => el.removeAttribute('readonly'), { once: true });
        }
      }
      if (!el.dataset.shadowTouchGuarded) {
        el.dataset.shadowTouchGuarded = '1';
        el.addEventListener('pointerdown', () => { el.dataset.shadowUserTouched = '1'; });
        el.addEventListener('keydown', () => { el.dataset.shadowUserTouched = '1'; });
      }
    });
    const hasTouchedValue = controls.some(el => el.dataset.shadowUserTouched === '1' && String(el.value || '').trim());
    const hasUntouchedValue = controls.some(el => el.dataset.shadowUserTouched !== '1' && String(el.value || '').trim());
    if (!hasUntouchedValue || hasTouchedValue) return;
    controls.forEach(el => {
      if (el.dataset.shadowUserTouched !== '1') el.value = '';
    });
    try { table.clearHeaderFilter(); } catch (_) {}
  }
  async function carregar() {
    setLoading(true);
    try {
      const res = await fetch(`/api/ia-command/admin/nlsql-shadow?${paramsFiltros()}`);
      const payload = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(payload.error || `Erro ${res.status}`);
      dados = payload.rows || [];
      const total = payload.resumo?.total ?? dados.length;
      document.getElementById('count').textContent = dados.length === total ? `${dados.length} registro(s)` : `${dados.length} de ${total} registro(s)`;
      atualizarMetricas(payload.resumo || {});
      if (table) {
        await table.replaceData(dados);
        setTimeout(protegerFiltrosHeaderShadow, 0);
        setTimeout(protegerFiltrosHeaderShadow, 250);
      } else criarTabela(dados);
    } catch (err) {
      dados = [];
      document.getElementById('count').textContent = 'erro ao carregar';
      atualizarMetricas({});
      if (table) await table.replaceData([]);
      alert(err.message || 'Nao foi possivel carregar o shadow mode.');
    } finally {
      setLoading(false);
    }
  }
  async function verDetalhe(row) {
    rowAtual = row;
    try {
      const res = await fetch(`/api/ia-command/admin/nlsql-shadow/${encodeURIComponent(row.id)}`);
      const detalhe = await res.json().catch(() => row);
      if (!res.ok) throw new Error(detalhe.error || `Erro ${res.status}`);
      preencherDetalhe(detalhe);
    } catch {
      preencherDetalhe(row);
    }
    document.getElementById('sec-lista').style.display = 'none';
    document.getElementById('sec-detalhe').style.display = 'block';
  }
  function preencherDetalhe(row) {
    rowAtual = row;
    document.getElementById('d-title').textContent = `${fmtData(row.criado_em)} - ${row.module || 'sem modulo'}`;
    document.getElementById('d-resultado').innerHTML = resultadoBadge(row.comparacao_resultado);
    document.getElementById('d-modulo').textContent = row.module || '-';
    document.getElementById('d-intent').textContent = row.intent || '-';
    document.getElementById('d-score').textContent = score(row.candidate_score);
    document.getElementById('d-template-valido').textContent = simNao(row.template_valido);
    document.getElementById('d-elegivel').textContent = simNao(row.auto_reuse_elegivel);
    document.getElementById('d-limiar').textContent = score(row.auto_reuse_limiar);
    document.getElementById('d-candidate-id').textContent = execCandidateId(row.candidate_execution_log_id);
    document.getElementById('d-classificacao').innerHTML = classificacaoBadge(row.classificacao_efetiva || row.classificacao_auto);
    document.getElementById('d-classificacao-auto').innerHTML = classificacaoBadge(row.classificacao_auto);
    document.getElementById('d-override').textContent = row.override_classificacao ? `${row.override_classificacao} (${row.override_usuario || 'usuario'})` : 'Sem override';
    document.getElementById('d-override-classificacao').value = row.override_classificacao || '';
    document.getElementById('d-override-motivo').value = row.override_motivo || '';
    document.getElementById('d-candidate-template').textContent = row.candidate_sql_template || '(sem candidato)';
    document.getElementById('d-actual-template').textContent = row.actual_sql_template || '(nao registrado)';
    document.getElementById('d-candidate-applied').textContent = row.candidate_sql_aplicado || '(nao aplicado)';
    document.getElementById('d-actual-final').textContent = row.actual_sql_final || '(nao registrado)';
    document.getElementById('d-actual-canonico').textContent = row.actual_sql_canonico || '(nao registrado)';
    document.getElementById('d-detalhes').textContent = JSON.stringify(row.detalhes || tryJson(row.detalhes_json) || {}, null, 2);
  }
  async function salvarOverride() {
    if (!rowAtual?.id) return;
    const classificacao = document.getElementById('d-override-classificacao').value;
    const motivo = document.getElementById('d-override-motivo').value;
    const res = await fetch(`/api/ia-command/admin/nlsql-shadow/${encodeURIComponent(rowAtual.id)}/classificacao`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ classificacao, motivo }),
    });
    const payload = await res.json().catch(() => ({}));
    if (!res.ok) {
      alert(payload.error || 'Nao foi possivel salvar classificacao.');
      return;
    }
    await carregar();
    const atualizado = dados.find(r => r.id === rowAtual.id);
    if (atualizado) preencherDetalhe(atualizado);
  }
  function tryJson(v) {
    try { return JSON.parse(v || '{}'); } catch { return {}; }
  }
  function fecharDetalhe() {
    document.getElementById('sec-detalhe').style.display = 'none';
    document.getElementById('sec-lista').style.display = '';
    rowAtual = null;
  }
  function copiarEl(id, btn) {
    const texto = document.getElementById(id)?.textContent || '';
    const original = btn.textContent;
    const ok = () => { btn.textContent = 'Copiado'; setTimeout(() => { btn.textContent = original; }, 1200); };
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(texto).then(ok).catch(ok);
    else {
      const ta = document.createElement('textarea');
      ta.value = texto;
      ta.style.cssText = 'position:fixed;left:-9999px;top:-9999px';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch {}
      document.body.removeChild(ta);
      ok();
    }
  }
  async function atualizarClick() {
    const btn = document.getElementById('btn-atualizar');
    btn.disabled = true;
    const old = btn.textContent;
    btn.textContent = 'Atualizando...';
    try { await carregar(); } finally { btn.textContent = old; btn.disabled = false; }
  }
  function abrirAjuda() {
    document.getElementById('help-overlay').classList.add('open');
    document.getElementById('help-drawer').classList.add('open');
  }
  function fecharAjuda() {
    document.getElementById('help-overlay').classList.remove('open');
    document.getElementById('help-drawer').classList.remove('open');
  }
  function trocarHelpTab(id) {
    document.querySelectorAll('.help-tab').forEach(btn => btn.classList.toggle('active', btn.dataset.helpTab === id));
    document.querySelectorAll('.help-panel').forEach(panel => panel.classList.toggle('active', panel.dataset.helpPanel === id));
  }
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      fecharAjuda();
      if (document.getElementById('sec-detalhe').style.display === 'block') fecharDetalhe();
    }
  });
  window._iahubAuthReady?.then(carregar) ?? carregar();
</script>
<div class="help-overlay" id="help-overlay" onclick="fecharAjuda()"></div>
<div class="help-drawer" id="help-drawer">
  <div class="help-drawer-header">
    <span class="help-drawer-title">Ajuda - Shadow NL-SQL</span>
    <button class="help-drawer-close" onclick="fecharAjuda()" title="Fechar">X</button>
  </div>
  <div class="help-drawer-body">
    <div class="help-tabs">
      <button class="help-tab active" type="button" data-help-tab="visao" onclick="trocarHelpTab('visao')">Visao</button>
      <button class="help-tab" type="button" data-help-tab="resultados" onclick="trocarHelpTab('resultados')">Resultados</button>
      <button class="help-tab" type="button" data-help-tab="operacao" onclick="trocarHelpTab('operacao')">Ligar e desligar</button>
    </div>
    <div class="help-panel active" data-help-panel="visao">
      <div class="help-section">
        <div class="help-section-title">O que e esta tela</div>
        <div class="help-item-desc">E a auditoria comparativa do Shadow Mode. Ela mostra qual consulta semantica o sistema teria escolhido e compara esse candidato com o SQL real gerado pela LLM na execucao de verdade.</div>
      </div>
      <div class="help-section">
        <div class="help-section-title">Objetivo</div>
        <div class="help-item-desc">Validar qualidade antes de colocar auto-reuse em producao. O candidato registrado aqui nao foi executado para o usuario; ele foi apenas medido contra o resultado real para formar estatistica confiavel.</div>
      </div>
      <div class="help-section">
        <div class="help-section-title">Como usar</div>
        <div class="help-item-desc">Filtre por periodo, modulo, resultado e classificacao. Comece pelos mismatches e templates invalidos; depois confira se os matches possuem amostra suficiente para justificar liberacao automatica.</div>
      </div>
    </div>
    <div class="help-panel" data-help-panel="resultados">
      <div class="help-section">
        <div class="help-section-title">Resultados</div>
        <div class="help-item-desc"><strong>Match template exato</strong> e o melhor sinal: o candidato tinha o mesmo template do SQL real. <strong>Match SQL aplicado</strong> indica SQL final equivalente apos parametros. <strong>Mismatch</strong> mostra divergencia. <strong>Template invalido</strong> aponta candidato inutilizavel. <strong>Sem candidato</strong> indica que nada passou do limiar.</div>
      </div>
      <div class="help-section">
        <div class="help-section-title">Exemplos praticos</div>
        <div class="help-item-desc">Se Financeiro tem muitos matches com score alto, essa faixa pode virar candidata a liberacao em Decisoes Automaticas. Se Compras tem mismatches, abra o detalhe e compare Template candidato x Template real para entender qual filtro, periodo ou agrupamento confundiu o ranking.</div>
      </div>
    </div>
    <div class="help-panel" data-help-panel="operacao">
      <div class="help-section">
        <div class="help-section-title">Configuracao recomendada para subir</div>
        <ul class="help-list">
          <li><strong>Shadow Mode ligado:</strong> grava candidatos, mede precisao e alimenta esta auditoria.</li>
          <li><strong>Auto-liberar por precisao ligado:</strong> quando atingir a amostra minima e a precisao configurada, o sistema marca a politica como <strong>liberado</strong>.</li>
          <li><strong>Auto-reuse semantico desligado:</strong> mantem producao usando IA + SQL Canonico, sem servir candidato semantico automaticamente.</li>
        </ul>
        <div class="help-callout">Essa combinacao permite aprender em producao sem mudar o comportamento das respostas.</div>
      </div>
      <div class="help-section">
        <div class="help-section-title">Quando quiser executar auto-reuse</div>
        <ul class="help-list">
          <li>Ligue <strong>Auto-reuse semantico</strong> em Aprendizado NL-SQL &gt; Decisoes Automaticas.</li>
          <li>A politica precisa estar persistida como <strong>liberado</strong>.</li>
          <li>O score do candidato precisa atingir o limite de execucao.</li>
          <li>O template precisa aplicar sem pendencias e o SQL precisa passar novamente pelos validadores.</li>
        </ul>
      </div>
      <div class="help-section">
        <div class="help-section-title">Como desligar</div>
        <ul class="help-list">
          <li>Para parar apenas a execucao automatica, desligue <strong>Auto-reuse semantico</strong>. O Shadow Mode continua gravando.</li>
          <li>Para parar tambem a coleta de aprendizado, desligue <strong>Shadow Mode</strong>.</li>
          <li>Como emergencia tecnica, a variavel <strong>IAC_NLSQL_SEMANTIC_AUTO_REUSE=0</strong> desliga o auto-reuse no ambiente.</li>
        </ul>
      </div>
    </div>
  </div>
</div>
</body>
</html>
</file>

<file path="apps/IA Command/frontend/admin-normalizacao.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Normalizacao Linguistica - IA Command</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css">
  <style>
    :root { --accent:#059669; --accent-light:#34d399; --accent-glow:rgba(5,150,105,.1); }
    .sidebar-logo .logo-icon { background:#059669 !important; }
    .topbar-menu-btn { flex-shrink:0;background:none;border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;color:var(--text-md);transition:background var(--transition),color var(--transition); }
    .topbar-menu-btn:hover { background:var(--bg-hover);color:var(--text-hi); }
    .topbar-title { flex:1;min-width:0;font-weight:700; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;margin-bottom:3px; }
    .page-title { font-size:20px;font-weight:700;color:var(--text-hi);line-height:1.25; }
    .page-subtitle { font-size:13px;color:var(--text-md);margin-top:4px; }
    .page-head { display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px; }
    .quick-panel { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:12px 16px;margin-bottom:16px;box-shadow:var(--shadow-sm); }
    .quick-row { display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
    .filter-area { padding-top:12px;border-top:1px solid var(--border);margin-top:12px; }
    .filter-status { font-size:12px;color:var(--text-lo);flex:1; }
    .quick-row .form-control { height:36px;font-size:13px; }
    .quick-row input.form-control { flex:1;min-width:200px; }
    .quick-row select.form-control { width:auto;min-width:145px; }
    .gp-wrap { margin-top:10px; }
    .gp-chips-row { display:flex;align-items:center;gap:6px;flex-wrap:wrap;position:relative; }
    .gp-label { font-size:11px;color:var(--text-lo);white-space:nowrap; }
    .grid-toolbar { display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg-card); }
    .grid-title { font-size:13px;font-weight:600;color:var(--text-hi); }
    .grid-meta { font-size:12px;color:var(--text-lo);margin-top:1px; }
    .badge-ativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:#dcfce7;color:#15803d; }
    .badge-inativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:var(--bg-hover);color:var(--text-lo); }
    .badge-tipo { display:inline-block;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:rgba(5,150,105,.12);color:#059669; }
    .btn-icon { background:none;border:none;cursor:pointer;padding:4px 6px;border-radius:5px;font-size:15px;transition:background .15s; }
    .btn-icon:hover { background:var(--bg-hover); }
    .tabulator { border:none !important;background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important;border-right:none !important;color:var(--text-lo) !important;font-size:11px !important;font-weight:700 !important;text-transform:uppercase;letter-spacing:.05em; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-base) !important;color:var(--text-hi) !important;border:1px solid var(--border) !important;border-radius:4px !important;font-size:11px !important;padding:3px 6px !important;width:100% !important; }
    .tabulator .tabulator-row { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important;cursor:pointer; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important;color:var(--text-md);font-size:13px;padding:10px 12px !important; }
    .save-feedback { font-size:13px;color:var(--text-lo); }
    .save-feedback.ok { color:#15803d; }
    .save-feedback.fail { color:#b91c1c; }
    .reg-field { margin-bottom:16px; }
    .reg-label { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:700;margin-bottom:5px; }
    /* Help drawer */
    .help-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:300;opacity:0;pointer-events:none;transition:opacity .25s;}
    .help-overlay.open{opacity:1;pointer-events:all;}
    .help-drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,100vw);background:var(--bg-card);border-left:1px solid var(--border);z-index:301;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);overflow:hidden;}
    .help-drawer.open{transform:translateX(0);}
    .help-drawer-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--border);flex-shrink:0;}
    .help-drawer-title{font-size:15px;font-weight:700;color:var(--text-hi);}
    .help-drawer-close{width:30px;height:30px;border:none;background:none;cursor:pointer;border-radius:6px;color:var(--text-lo);display:flex;align-items:center;justify-content:center;transition:background var(--transition),color var(--transition);}
    .help-drawer-close:hover{background:var(--bg-hover);color:var(--text-hi);}
    .help-drawer-body{flex:1;overflow-y:auto;}
    .help-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0;padding:0 22px;}
    .help-tab{padding:10px 14px;font-size:12px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;color:var(--text-lo);transition:color var(--transition),border-color var(--transition);}
    .help-tab.active{color:var(--accent);border-bottom-color:var(--accent);}
    .help-panel{display:none;padding:22px;} .help-panel.active{display:block;}
    .help-section{margin-bottom:28px;} .help-section:last-child{margin-bottom:0;}
    .help-section-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--accent);margin-bottom:12px;}
    .fmt-table{width:100%;border-collapse:collapse;font-size:12px;}
    .fmt-table th,.fmt-table td{padding:6px 10px;border:1px solid var(--border);text-align:left;}
    .fmt-table th{background:var(--bg-hover);font-weight:700;color:var(--text-hi);}
    .fmt-table td:first-child{white-space:nowrap;}
    .fmt-table code{background:var(--bg-hover);padding:1px 4px;border-radius:3px;font-size:11px;}
    .help-item{margin-bottom:14px;}
    .help-item-label{font-size:13px;font-weight:700;color:var(--text-hi);margin-bottom:4px;}
    .help-item-desc{font-size:13px;color:var(--text-md);line-height:1.65;}
    .help-tip{background:var(--accent-glow);border-left:3px solid var(--accent);border-radius:0 6px 6px 0;padding:10px 14px;font-size:13px;color:var(--text-md);line-height:1.6;margin-top:12px;}
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command ></span> Normalizacao Linguistica</span>
    </div>
    <div class="page-content">
      <div id="sec-lista">
        <div class="page-head">
          <div>
            <div class="page-kicker">Cadastros</div>
            <div class="page-title">Normalizacao Linguistica</div>
            <div class="page-subtitle">Corrija erros de digitacao, abreviacoes e variacoes antes da interpretacao da engine.</div>
          </div>
          <div style="display:flex;gap:8px;align-items:center">
            <button class="btn btn-ghost" onclick="abrirAjuda()" style="display:flex;align-items:center;gap:6px">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              Ajuda
            </button>
            <button class="btn btn-primary" onclick="abrirFormulario()">+ Nova Regra</button>
          </div>
        </div>
        <div class="quick-panel">
          <div class="quick-row">
            <button class="btn btn-ghost" id="btn-filtros" onclick="toggleFiltros()">+ Mostrar filtros</button>
            <span class="filter-status" id="filter-status">Sem filtros ou agrupamentos ativos</span>
          </div>
          <div class="filter-area" id="filter-area" style="display:none">
            <div class="quick-row" style="margin-bottom:10px">
              <input id="f-busca" type="text" class="form-control" placeholder="Buscar por termo..." oninput="filtrar()">
              <select id="f-contexto" class="form-control" onchange="filtrar()">
                <option value="">Todos os tipos</option>
                <option value="geral">Geral</option>
                <option value="correcao">Correcao</option>
                <option value="abreviacao">Abreviacao</option>
                <option value="verbo">Verbo</option>
                <option value="metrica">Metrica</option>
              </select>
              <select id="f-ativo" class="form-control" onchange="filtrar()">
                <option value="">Todos os status</option>
                <option value="1">Ativo</option>
                <option value="0">Inativo</option>
              </select>
              <button class="btn btn-ghost" onclick="limparFiltros()">Limpar</button>
            </div>
            <div class="gp-wrap">
              <div class="gp-chips-row" id="gp-chips-row"><span class="gp-label">Agrupar por:</span></div>
              <div id="dz"></div>
            </div>
          </div>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <div class="grid-toolbar">
            <div>
              <div class="grid-title">Regras da empresa</div>
              <div id="count" class="grid-meta"></div>
            </div>
          </div>
          <div id="tabela"></div>
        </div>
      </div>
      <div id="sec-form" style="display:none">
        <div class="editor-shell">
          <div class="editor-actionbar">
            <div class="editor-actionbar-title">
              <strong id="form-title">Nova Regra</strong>
              <span id="form-subtitle">Preencha os campos e salve.</span>
            </div>
            <div class="editor-actions">
              <span class="save-feedback" id="save-feedback"></span>
              <button class="btn btn-ghost" onclick="fecharFormulario()">Voltar a lista</button>
              <button class="btn btn-primary" onclick="salvar()">Salvar</button>
            </div>
          </div>
          <div class="editor-grid editor-grid-wide" style="margin-top:16px">
            <main class="editor-main">
              <section class="form-section">
                <div class="form-section-header">
                  <div class="form-section-title">Regra de Normalizacao</div>
                  <div class="form-section-subtitle">Defina o texto digitado e a forma corrigida que a engine deve usar.</div>
                </div>
                <div class="form-section-body">
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
                    <div class="form-group" style="margin-bottom:0">
                      <label class="form-label">Termo digitado <span style="color:#dc2626">*</span></label>
                      <input id="f-termo-form" class="form-control" placeholder="ex: conparar, faturamnto">
                      <div class="form-hint">Como o usuario pode escrever no WhatsApp.</div>
                    </div>
                    <div class="form-group" style="margin-bottom:0">
                      <label class="form-label">Forma normalizada <span style="color:#dc2626">*</span></label>
                      <input id="f-equivalencia-form" class="form-control" placeholder="ex: comparar, faturamento">
                      <div class="form-hint">Texto corrigido antes da interpretacao.</div>
                    </div>
                  </div>
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div class="form-group" style="margin-bottom:0">
                      <label class="form-label">Tipo</label>
                      <select id="f-contexto-form" class="form-control">
                        <option value="geral">Geral</option>
                        <option value="correcao">Correcao</option>
                        <option value="abreviacao">Abreviacao</option>
                        <option value="verbo">Verbo</option>
                        <option value="metrica">Metrica</option>
                      </select>
                    </div>
                    <div class="form-group" style="margin-bottom:0">
                      <label class="form-label">Status</label>
                      <select id="f-ativo-form" class="form-control">
                        <option value="1">Ativo</option>
                        <option value="0">Inativo</option>
                      </select>
                    </div>
                  </div>
                </div>
              </section>
              <section class="form-section" style="margin-top:16px">
                <div class="form-section-header">
                  <div class="form-section-title">Como funciona na pratica</div>
                </div>
                <div class="form-section-body" id="exemplo-dinamico" style="font-size:13px;color:var(--text-md);line-height:1.7"></div>
              </section>
            </main>
            <aside class="editor-side">
              <section class="form-section" style="position:sticky;top:56px">
                <div class="form-section-header">
                  <div class="form-section-title">Dados do Registro</div>
                </div>
                <div class="form-section-body">
                  <div class="reg-field">
                    <div class="reg-label">ID do Registro</div>
                    <input id="f-id" class="form-control" disabled placeholder="(gerado automaticamente)" style="font-family:monospace;font-size:12px;color:var(--text-lo);background:var(--bg-hover)">
                  </div>
                  <p style="font-size:12px;color:var(--text-lo);line-height:1.5;margin-top:14px">
                    Regras de normalizacao sao aplicadas antes de intencoes, periodos, filtros e chamadas para IA externa.
                  </p>
                </div>
              </section>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/grid-group-panel.js?v=20260617-grid-guard-v2"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
let table, gp;
let dados = [];
let editId = null;
let filtrosVisiveis = false;
let quickFilterFn = null;
function esc(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function label(n) { return n === 1 ? '1 regra' : `${n} regras`; }
async function carregar() {
  dados = await fetch('/api/ia-command/admin/normalizacao').then(r => r.json()).catch(() => []);
  if (table) { table.replaceData(dados); return; }
  criarTabela(dados);
}
function criarTabela(data) {
  gp = createGroupPanel({ chipsRowId:'gp-chips-row', dropZoneId:'dz', storageKey:'iac_admin_normalizacao_group', getTable:()=>table });
  table = new Tabulator('#tabela', {
    data, index:'id', layout:'fitColumns', movableColumns:true,
    height:'calc(100vh - 380px)', groupBy:gp.getActiveFields(), groupStartOpen:true,
    placeholder:'<div style="padding:40px;text-align:center;color:var(--text-lo)">Nenhuma regra cadastrada.<br><small>Clique em "+ Nova Regra" para comecar.</small></div>',
    columns:[
      { title:'Termo', field:'termo', minWidth:150, headerFilter:true, formatter:c=>`<strong style="color:var(--text-hi)">${esc(c.getValue())}</strong>` },
      { title:'Normaliza para', field:'equivalencia', minWidth:170, headerFilter:true, formatter:c=>esc(c.getValue()) },
      { title:'Tipo', field:'contexto', width:120, headerFilter:'select', headerFilterParams:{values:{'':'Todos','geral':'Geral','correcao':'Correcao','abreviacao':'Abreviacao','verbo':'Verbo','metrica':'Metrica'}}, formatter:c=>`<span class="badge-tipo">${esc(c.getValue() || 'geral')}</span>` },
      { title:'Status', field:'ativo', width:90, headerFilter:'select', headerFilterParams:{values:{'':'Todos','1':'Ativo','0':'Inativo'}}, formatter:c=>c.getValue()?'<span class="badge-ativo">Ativo</span>':'<span class="badge-inativo">Inativo</span>' },
      { title:'Criado em', field:'criado_em', width:145, formatter:c=>c.getValue()?.slice(0,16).replace('T',' ') || '' },
      { title:'Acoes', field:'id', width:80, headerFilter:false, groupable:false, hozAlign:'right', formatter:cell=>{
        const id = cell.getValue();
        return `<button class="btn-icon" onclick="event.stopPropagation();abrirFormulario('${id}')" title="Editar">Editar</button>
                <button class="btn-icon" onclick="event.stopPropagation();excluir('${id}')" title="Excluir" style="color:#dc2626">Excluir</button>`;
      }},
    ],
    rowClick:(e,row)=>{ if(!e.target.closest('button')) abrirFormulario(row.getData().id); },
    dataFiltered:(_f, rows)=>{
      const total = dados.length, qtd = rows?.length ?? total;
      document.getElementById('count').textContent = qtd === total ? label(qtd) : `${qtd} de ${total} regras`;
    },
  });
  gp.refresh(); gp.applyToTable();
  document.getElementById('count').textContent = label(data.length);
}
function toggleFiltros() {
  filtrosVisiveis = !filtrosVisiveis;
  document.getElementById('filter-area').style.display = filtrosVisiveis ? '' : 'none';
  document.getElementById('btn-filtros').textContent = filtrosVisiveis ? '- Ocultar filtros' : '+ Mostrar filtros';
  if (filtrosVisiveis && gp) setTimeout(() => gp.refresh(), 50);
}
function filtrar() {
  if (!table) return;
  if (quickFilterFn) { table.removeFilter(quickFilterFn); quickFilterFn = null; }
  const busca = document.getElementById('f-busca').value.trim().toLowerCase();
  const contexto = document.getElementById('f-contexto').value;
  const ativo = document.getElementById('f-ativo').value;
  if (busca || contexto || ativo !== '') {
    quickFilterFn = row => {
      if (contexto && row.contexto !== contexto) return false;
      if (ativo !== '' && String(row.ativo) !== ativo) return false;
      if (busca && !(String(row.termo || '') + ' ' + String(row.equivalencia || '')).toLowerCase().includes(busca)) return false;
      return true;
    };
    table.addFilter(quickFilterFn);
  }
  const ativos = [busca, contexto, ativo].filter(Boolean).length;
  document.getElementById('filter-status').textContent = ativos ? `${ativos} filtro(s) ativo(s)` : 'Sem filtros ou agrupamentos ativos';
}
function limparFiltros() {
  document.getElementById('f-busca').value = '';
  document.getElementById('f-contexto').value = '';
  document.getElementById('f-ativo').value = '';
  filtrar();
}
function atualizarExemplo() {
  const termo = document.getElementById('f-termo-form').value.trim() || 'conparar';
  const equiv = document.getElementById('f-equivalencia-form').value.trim() || 'comparar';
  document.getElementById('exemplo-dinamico').innerHTML =
    `Quando o usuario digitar <strong>"${esc(termo)}"</strong>, a engine lera <strong>"${esc(equiv)}"</strong> antes de interpretar o pedido.<br><br>` +
    `Exemplo: <em>"${esc(termo)} faturamento de 2025 com 2026"</em> passa a ser analisado como <em>"${esc(equiv)} faturamento de 2025 com 2026"</em>.`;
}
function abrirFormulario(id) {
  editId = id || null;
  resetForm();
  document.getElementById('form-title').textContent = id ? 'Editar Regra' : 'Nova Regra';
  document.getElementById('sec-lista').style.display = 'none';
  document.getElementById('sec-form').style.display = '';
  if (id) carregarForm(id);
  atualizarExemplo();
}
function fecharFormulario() {
  document.getElementById('sec-form').style.display = 'none';
  document.getElementById('sec-lista').style.display = '';
  editId = null;
}
function resetForm() {
  ['f-id','f-termo-form','f-equivalencia-form'].forEach(id => { document.getElementById(id).value = ''; });
  document.getElementById('f-contexto-form').value = 'geral';
  document.getElementById('f-ativo-form').value = '1';
  document.getElementById('save-feedback').textContent = '';
  document.getElementById('save-feedback').className = 'save-feedback';
}
async function carregarForm(id) {
  const row = await fetch(`/api/ia-command/admin/normalizacao/${encodeURIComponent(id)}`).then(r => r.json()).catch(() => null);
  if (!row) return;
  document.getElementById('f-id').value = row.id || '';
  document.getElementById('f-termo-form').value = row.termo || '';
  document.getElementById('f-equivalencia-form').value = row.equivalencia || '';
  document.getElementById('f-contexto-form').value = row.contexto || 'geral';
  document.getElementById('f-ativo-form').value = String(row.ativo ?? 1);
  document.getElementById('form-title').textContent = `"${row.termo}"`;
  atualizarExemplo();
}
async function salvar() {
  const termo = document.getElementById('f-termo-form').value.trim();
  const equivalencia = document.getElementById('f-equivalencia-form').value.trim();
  if (!termo) return feedback('Campo Termo e obrigatorio.', false);
  if (!equivalencia) return feedback('Campo Forma normalizada e obrigatorio.', false);
  const body = {
    termo,
    equivalencia,
    contexto: document.getElementById('f-contexto-form').value || 'geral',
    ativo: parseInt(document.getElementById('f-ativo-form').value, 10),
  };
  const url = editId ? `/api/ia-command/admin/normalizacao/${encodeURIComponent(editId)}` : '/api/ia-command/admin/normalizacao';
  const method = editId ? 'PUT' : 'POST';
  const res = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });
  if (!res.ok) { const e = await res.json().catch(() => ({})); return feedback(e.error || 'Erro ao salvar.', false); }
  feedback('Salvo com sucesso!', true);
  setTimeout(() => { fecharFormulario(); carregar(); }, 700);
}
async function excluir(id) {
  if (!confirm('Excluir esta regra de normalizacao?')) return;
  await fetch(`/api/ia-command/admin/normalizacao/${encodeURIComponent(id)}`, { method:'DELETE' });
  carregar();
}
function feedback(msg, ok) {
  const el = document.getElementById('save-feedback');
  el.textContent = msg;
  el.className = 'save-feedback ' + (ok ? 'ok' : 'fail');
}
document.addEventListener('DOMContentLoaded', () => {
  ['f-termo-form','f-equivalencia-form'].forEach(id => document.getElementById(id)?.addEventListener('input', atualizarExemplo));
});
const init = async () => { await carregar(); };
window._iahubAuthReady?.then(init) ?? init();
</script>
<div class="help-overlay" id="help-overlay" onclick="fecharAjuda()"></div>
<div class="help-drawer" id="help-drawer">
  <div class="help-drawer-header">
    <span class="help-drawer-title">Ajuda — Normalização Linguística</span>
    <button class="help-drawer-close" onclick="fecharAjuda()" title="Fechar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
  </div>
  <div class="help-tabs">
    <div class="help-tab active" onclick="helpTab(this,'ht-geral')">Geral</div>
    <div class="help-tab" onclick="helpTab(this,'ht-tipos')">Tipos</div>
    <div class="help-tab" onclick="helpTab(this,'ht-pratica')">Boas Práticas</div>
  </div>
  <div class="help-drawer-body" style="padding:0;overflow-y:auto;flex:1;">
  <div id="ht-geral" class="help-panel active">
    <div class="help-section">
      <div class="help-section-title">O que é a Normalização Linguística</div>
      <div class="help-item-desc">A Normalização é a <strong>primeira camada de processamento</strong> do IA Command. Antes de qualquer interpretação de intenção, período, filtro ou chamada à IA, o motor substitui termos digitados pelo usuário por suas formas corretas — corrigindo erros de digitação, expandindo abreviações e padronizando variações de escrita.</div>
      <div class="help-tip">Exemplo: o usuário envia <em>"conparar faturamnto desse mes"</em>. A normalização transforma para <em>"comparar faturamento desse mes"</em> antes de qualquer análise.</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Posição no pipeline</div>
      <div class="help-item-desc">A normalização ocorre nesta ordem dentro do IA Command:</div>
      <div style="background:var(--bg-hover);border-radius:8px;padding:12px 16px;font-size:12px;line-height:2;margin-top:8px">
        <strong style="color:var(--accent)">1. Normalização Linguística</strong> ← você está aqui<br>
        2. Intenção (qual consulta o usuário quer)<br>
        3. Período (quando)<br>
        4. Filtros e agrupamentos<br>
        5. Execução no dataset / chamada à IA
      </div>
      <div class="help-tip">Uma regra de normalização bem configurada aumenta o índice de resolução local e reduz chamadas à IA externa, economizando tokens.</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Campos do cadastro</div>
      <div class="help-item">
        <div class="help-item-label">Termo digitado</div>
        <div class="help-item-desc">O texto exato que o usuário pode escrever no WhatsApp — com erro, abreviação ou variação. Não precisa ser uma palavra inteira; funciona como busca de substring na mensagem.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Forma normalizada</div>
        <div class="help-item-desc">O texto correto que o motor deve usar no lugar do termo digitado antes de interpretar o pedido.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Tipo</div>
        <div class="help-item-desc">Classifica a regra para facilitar organização e filtragem. Não altera o comportamento — ver aba <strong>Tipos</strong>.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Status</div>
        <div class="help-item-desc">Apenas regras <strong>Ativas</strong> são aplicadas pelo motor. Inative uma regra para suspendê-la sem excluir.</div>
      </div>
    </div>
  </div>
  <div id="ht-tipos" class="help-panel">
    <div class="help-section">
      <div class="help-section-title">Tipos disponíveis</div>
      <div class="help-item-desc">O tipo é apenas uma categoria organizacional — não muda como a regra é aplicada. Use-o para filtrar e entender a origem dos cadastros.</div>
      <table class="fmt-table" style="margin-top:12px">
        <thead><tr><th>Tipo</th><th>Quando usar</th><th>Exemplo</th></tr></thead>
        <tbody>
          <tr><td><strong>Geral</strong></td><td>Termos que não se encaixam nas categorias abaixo</td><td><code>fat</code> → <code>faturamento</code></td></tr>
          <tr><td><strong>Correcao</strong></td><td>Erros de digitação comuns no WhatsApp</td><td><code>conparar</code> → <code>comparar</code></td></tr>
          <tr><td><strong>Abreviacao</strong></td><td>Formas curtas que o usuário usa no dia a dia</td><td><code>qtde</code> → <code>quantidade</code></td></tr>
          <tr><td><strong>Verbo</strong></td><td>Conjugações ou formas verbais alternativas</td><td><code>compara</code> → <code>comparar</code></td></tr>
          <tr><td><strong>Metrica</strong></td><td>Nomes alternativos de indicadores financeiros</td><td><code>faturamnto</code> → <code>faturamento</code></td></tr>
        </tbody>
      </table>
    </div>
    <div class="help-section">
      <div class="help-section-title">Regras embutidas no sistema</div>
      <div class="help-item-desc">O IA Command já vem com variantes pré-definidas no motor (não aparecem nesta lista, pois estão no código): conjugações dos verbos <em>comparar, mostrar, trazer, listar</em>, além de variações ortográficas de palavras frequentes como <em>faturamento, vendas, pedidos</em>. As regras cadastradas aqui são aplicadas <strong>adicionalmente</strong> — priorize termos específicos do vocabulário da empresa que não estão cobertos pelo motor padrão.</div>
      <div class="help-tip">Não recadastre termos já cobertos pelo motor. Se a normalização já está funcionando para uma palavra, cadastrar novamente não causa dano, mas é redundante.</div>
    </div>
  </div>
  <div id="ht-pratica" class="help-panel">
    <div class="help-section">
      <div class="help-section-title">Normalização vs. Equivalências</div>
      <div class="help-item-desc">São camadas distintas — use esta tabela para decidir onde cadastrar:</div>
      <table class="fmt-table" style="margin-top:10px">
        <thead><tr><th>O problema é…</th><th>Solução correta</th></tr></thead>
        <tbody>
          <tr><td>Erro de digitação ou abreviação (<em>"conparar"</em>)</td><td style="color:#059669;font-weight:600">Normalização (esta tela)</td></tr>
          <tr><td>Nome alternativo de métrica (<em>"volume"</em> em vez de <em>"quantidade"</em>)</td><td style="color:#0284c7;font-weight:600">Equivalência → Coluna</td></tr>
          <tr><td>Apelido de cliente, produto ou vendedor</td><td style="color:#ea580c;font-weight:600">Equivalência → Filtro</td></tr>
          <tr><td>Nome diferente para uma consulta (<em>"movimento"</em>)</td><td style="color:#7c3aed;font-weight:600">Equivalência → Intenção</td></tr>
        </tbody>
      </table>
    </div>
    <div class="help-section">
      <div class="help-section-title">Boas práticas de cadastro</div>
      <div class="help-item">
        <div class="help-item-label">Termos curtos, sem espaços desnecessários</div>
        <div class="help-item-desc">A normalização faz correspondência de substring. Prefira termos curtos como <code style="background:var(--bg-hover);padding:1px 5px;border-radius:4px">qtde</code> em vez de <code style="background:var(--bg-hover);padding:1px 5px;border-radius:4px">qtde total</code> para evitar falsos positivos.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Sempre teste após cadastrar</div>
        <div class="help-item-desc">Envie a mensagem com o erro pelo WhatsApp e observe se a resposta melhora. O painel <strong>Monitor</strong> mostra a mensagem recebida e o que o motor interpretou.</div>
      </div>
      <div class="help-item">
        <div class="help-item-label">Alimente a partir das reclamações reais</div>
        <div class="help-item-desc">Quando um usuário reclamar que <em>"não entendeu"</em>, verifique no Monitor qual foi a mensagem recebida. Se havia um erro de digitação não coberto, cadastre a regra aqui.</div>
      </div>
      <div class="help-tip">Inative regras que causarem substituições indesejadas em vez de excluir — assim você mantém o histórico e pode reativar se necessário.</div>
    </div>
  </div>
  </div>
</div>
<script>
  function abrirAjuda() { document.getElementById('help-overlay').classList.add('open'); document.getElementById('help-drawer').classList.add('open'); }
  function fecharAjuda() { document.getElementById('help-overlay').classList.remove('open'); document.getElementById('help-drawer').classList.remove('open'); }
  function helpTab(el, id) {
    el.closest('.help-drawer').querySelectorAll('.help-tab').forEach(t => t.classList.remove('active'));
    el.closest('.help-drawer').querySelectorAll('.help-panel').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    document.getElementById(id).classList.add('active');
  }
  document.addEventListener('keydown', e => { if (e.key === 'Escape') fecharAjuda(); });
</script>
</body>
</html>
</file>

<file path="apps/IA Command/frontend/admin-protheus-chat-encaminhamentos.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Encaminhamentos WhatsApp - IA Command</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    :root { --accent:#7c3aed; --accent-light:#a78bfa; --accent-glow:rgba(124,58,237,.1); }
    .sidebar-logo .logo-icon { background:#7c3aed !important; }
    .topbar-menu-btn { flex-shrink:0;background:none;border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;color:var(--text-md);transition:background var(--transition),color var(--transition); }
    .topbar-menu-btn:hover { background:var(--bg-hover);color:var(--text-hi); }
    .topbar-title { flex:1;min-width:0;font-weight:700; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:700;margin-bottom:3px; }
    .head-row { display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:12px; }
    .head-title { font-size:20px;font-weight:800;color:var(--text-hi);display:flex;align-items:baseline;gap:8px;line-height:1.2; }
    .head-count { font-size:12px;color:var(--text-lo);font-weight:500; }
    .head-actions { display:flex;align-items:center;gap:8px;flex-wrap:wrap; }
    .filter-panel { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:12px 14px;margin-bottom:12px;display:grid;grid-template-columns:minmax(220px,1fr) 160px 160px auto;gap:10px;align-items:end; }
    .field label { display:block;font-size:11px;font-weight:800;color:var(--text-lo);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px; }
    .field input, .field select, .field textarea { width:100%;border:1px solid var(--border);border-radius:6px;background:var(--bg-base);color:var(--text-hi);font-size:13px;padding:8px 10px;box-sizing:border-box; }
    .field textarea { min-height:84px;resize:vertical;line-height:1.45; }
    .table-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden; }
    .table-wrap { height:calc(100vh - 225px);min-height:360px;overflow:auto;background:var(--bg-card); }
    .history-table { width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed;font-size:13px; }
    .history-table thead th { position:sticky;top:0;z-index:2;background:var(--bg-card);border-bottom:1px solid var(--border);color:var(--text-lo);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:9px 10px;white-space:nowrap; }
    .history-table tbody td { border-bottom:1px solid var(--border);color:var(--text-md);padding:10px;vertical-align:top;background:var(--bg-card); }
    .history-table tbody tr.data-row { cursor:pointer; }
    .history-table tbody tr.data-row:hover td { background:var(--bg-hover); }
    .history-table tbody tr.data-row.selected td { background:rgba(124,58,237,.07); }
    .col-check { width:38px;text-align:center; }
    .col-action { width:44px;text-align:center; }
    .col-date { width:158px; }
    .col-status { width:118px; }
    .col-format { width:90px; }
    .col-to { width:210px; }
    .col-from { width:175px; }
    .col-question { width:290px; }
    .col-summary { width:320px; }
    .col-rows { width:80px;text-align:right; }
    input.row-cb { width:15px;height:15px;cursor:pointer;accent-color:var(--accent); }
    .text-preview { display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;line-height:1.35;word-break:break-word; }
    .question { color:var(--text-hi);font-weight:800; }
    .empty-state { height:320px;display:none;align-items:center;justify-content:center;color:var(--text-lo);font-size:22px;font-weight:800; }
    .badge { display:inline-flex;align-items:center;justify-content:center;border-radius:99px;padding:2px 8px;font-size:11px;font-weight:800;white-space:nowrap;border:1px solid transparent; }
    .badge-pendente { background:#fef3c7;color:#92400e; }
    .badge-enviado { background:#dcfce7;color:#15803d; }
    .badge-erro { background:#fef2f2;color:#991b1b; }
    .badge-cancelado { background:var(--bg-base);color:var(--text-md);border-color:var(--border); }
    .icon-btn { width:28px;height:28px;border:none;background:transparent;border-radius:6px;color:var(--text-md);cursor:pointer;display:inline-flex;align-items:center;justify-content:center; }
    .icon-btn:hover { background:var(--bg-hover);color:var(--accent); }
    .detail-shell { display:none; }
    .detail-shell.open { display:block; }
    .editor-bar { display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;margin-bottom:12px;box-shadow:var(--shadow-sm); }
    .editor-title strong { display:block;color:var(--text-hi);font-size:16px; }
    .editor-title span { color:var(--text-lo);font-size:12px; }
    .detail-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden;padding:18px; }
    .meta-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:14px; }
    .meta-item { background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px;min-width:0; }
    .meta-item span { display:block;font-size:11px;color:var(--text-lo);margin-bottom:4px;font-weight:700;text-transform:uppercase;letter-spacing:.04em; }
    .meta-item strong { display:block;color:var(--text-hi);font-size:13px;word-break:break-word; }
    .text-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px; }
    .text-box { background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px; }
    .text-box label { display:block;font-size:11px;font-weight:800;color:var(--text-lo);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px; }
    .text-box pre { margin:0;white-space:pre-wrap;word-break:break-word;font-family:inherit;font-size:14px;color:var(--text-hi);line-height:1.55; }
    .modal-backdrop { position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(15,23,42,.48);z-index:500;padding:18px; }
    .modal-backdrop.open { display:flex; }
    .modal { width:min(720px,96vw);max-height:92vh;overflow:auto;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-md);padding:22px; }
    .modal.small { width:min(540px,96vw); }
    .modal-head { display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px; }
    .modal-title { color:var(--text-hi);font-size:16px;font-weight:800; }
    .modal-close { border:none;background:transparent;color:var(--text-lo);font-size:22px;line-height:1;cursor:pointer; }
    .modal-actions { display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--border);padding-top:14px;margin-top:16px; }
    .form-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px; }
    .form-grid .wide { grid-column:1 / -1; }
    .danger-note { background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:var(--radius-sm);padding:10px 12px;font-size:13px;line-height:1.5;margin-top:12px; }
    .date-row { display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px; }
    .error-box { display:none;background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:var(--radius-sm);padding:10px 12px;margin-bottom:12px;font-size:13px;white-space:pre-wrap;word-break:break-word; }
    @media (max-width: 900px) {
      .head-row, .editor-bar { align-items:flex-start;flex-direction:column; }
      .head-actions { width:100%; }
      .filter-panel, .text-grid, .form-grid { grid-template-columns:1fr; }
      .form-grid .wide { grid-column:auto; }
      .table-wrap { height:calc(100vh - 300px); }
    }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command &rsaquo;</span> Encaminhamentos WhatsApp</span>
    </div>
    <div class="page-content">
      <section id="list-view">
        <div class="head-row">
          <div>
            <div class="page-kicker">Chat Protheus</div>
            <div class="head-title">Encaminhamentos WhatsApp <span class="head-count" id="count">carregando...</span></div>
          </div>
          <div class="head-actions">
            <button class="btn btn-primary" id="new-btn" type="button">Novo registro</button>
            <button class="btn btn-ghost" id="sel-del-btn" type="button" style="display:none;font-weight:700;color:#fff;background:#7c3aed;padding:5px 14px;border-radius:6px">Excluir selecionados</button>
            <button class="btn btn-ghost" id="clear-btn" type="button" style="font-weight:800;color:#1e3a8a">Limpar log</button>
            <button class="btn btn-ghost" id="refresh-btn" type="button" style="font-weight:700;color:#1e3a8a;padding:5px 14px">Atualizar</button>
          </div>
        </div>
        <div class="filter-panel">
          <div class="field">
            <label for="filter-q">Pesquisar</label>
            <input id="filter-q" type="search" placeholder="Pergunta, resumo, destinatario ou remetente">
          </div>
          <div class="field">
            <label for="filter-status">Status</label>
            <select id="filter-status">
              <option value="">Todos</option>
              <option value="pendente">Pendente</option>
              <option value="enviado">Enviado</option>
              <option value="erro">Erro</option>
              <option value="cancelado">Cancelado</option>
            </select>
          </div>
          <div class="field">
            <label for="filter-formato">Formato</label>
            <select id="filter-formato">
              <option value="">Todos</option>
              <option value="texto">Texto</option>
              <option value="pdf">PDF</option>
              <option value="excel">Excel</option>
              <option value="imagem">Imagem</option>
            </select>
          </div>
          <button class="btn btn-ghost" id="clear-filters" type="button">Limpar filtros</button>
        </div>
        <div class="table-card">
          <div class="table-wrap">
            <table class="history-table">
              <thead>
                <tr>
                  <th class="col-check"><input type="checkbox" class="row-cb" id="cb-all" title="Selecionar todos"></th>
                  <th class="col-action"></th>
                  <th class="col-date">Data/Hora</th>
                  <th class="col-status">Status</th>
                  <th class="col-format">Formato</th>
                  <th class="col-to">Destinatario</th>
                  <th class="col-from">Remetente</th>
                  <th class="col-question">Pergunta</th>
                  <th class="col-summary">Resumo</th>
                  <th class="col-rows">Linhas</th>
                </tr>
              </thead>
              <tbody id="tbody"></tbody>
            </table>
            <div class="empty-state" id="empty-state">Nenhum encaminhamento registrado.</div>
          </div>
        </div>
      </section>
      <section id="detail-view" class="detail-shell">
        <div class="editor-bar">
          <div class="editor-title">
            <strong id="detail-title">Encaminhamento</strong>
            <span id="detail-subtitle">-</span>
          </div>
          <div class="head-actions">
            <button class="btn btn-ghost" id="edit-detail-btn" type="button">Editar</button>
            <button class="btn btn-primary" id="back-btn" type="button">Voltar</button>
          </div>
        </div>
        <div class="detail-card">
          <div class="meta-grid" id="detail-meta"></div>
          <div class="text-grid">
            <div class="text-box">
              <label>Pergunta</label>
              <pre id="detail-question"></pre>
            </div>
            <div class="text-box">
              <label>Resumo</label>
              <pre id="detail-summary"></pre>
            </div>
          </div>
          <div class="text-box" style="margin-top:12px">
            <label>Erro / observacao</label>
            <pre id="detail-error"></pre>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<div class="modal-backdrop" id="form-modal">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-title" id="form-title">Novo encaminhamento</div>
      <button class="modal-close" id="close-form" type="button">&times;</button>
    </div>
    <div class="error-box" id="form-error"></div>
    <form id="forward-form">
      <input type="hidden" id="form-id">
      <div class="form-grid">
        <div class="field">
          <label for="form-status">Status</label>
          <select id="form-status">
            <option value="pendente">Pendente</option>
            <option value="enviado">Enviado</option>
            <option value="erro">Erro</option>
            <option value="cancelado">Cancelado</option>
          </select>
        </div>
        <div class="field">
          <label for="form-formato">Formato</label>
          <select id="form-formato">
            <option value="texto">Texto</option>
            <option value="pdf">PDF</option>
            <option value="excel">Excel</option>
            <option value="imagem">Imagem</option>
          </select>
        </div>
        <div class="field">
          <label for="form-dest-nome">Destinatario</label>
          <input id="form-dest-nome" type="text">
        </div>
        <div class="field">
          <label for="form-dest-cel">Celular destino</label>
          <input id="form-dest-cel" type="text">
        </div>
        <div class="field">
          <label for="form-rem-user">Remetente</label>
          <input id="form-rem-user" type="text">
        </div>
        <div class="field">
          <label for="form-rem-cel">Celular remetente</label>
          <input id="form-rem-cel" type="text">
        </div>
        <div class="field">
          <label for="form-rows">Linhas</label>
          <input id="form-rows" type="number" min="0" step="1" value="0">
        </div>
        <div class="field">
          <label for="form-arquivo">Arquivo</label>
          <input id="form-arquivo" type="text">
        </div>
        <div class="field wide">
          <label for="form-question">Pergunta</label>
          <textarea id="form-question"></textarea>
        </div>
        <div class="field wide">
          <label for="form-summary">Resumo</label>
          <textarea id="form-summary"></textarea>
        </div>
        <div class="field wide">
          <label for="form-erro">Erro / observacao</label>
          <textarea id="form-erro"></textarea>
        </div>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="cancel-form" type="button">Cancelar</button>
        <button class="btn btn-primary" type="submit">Salvar</button>
      </div>
    </form>
  </div>
</div>
<div class="modal-backdrop" id="clear-modal">
  <div class="modal small">
    <div class="modal-head">
      <div class="modal-title">Limpar log de encaminhamentos</div>
      <button class="modal-close" id="close-clear" type="button">&times;</button>
    </div>
    <div class="error-box" id="clear-error"></div>
    <label><input type="radio" name="clear-mode" value="periodo" checked> Limpar por periodo</label><br>
    <label><input type="radio" name="clear-mode" value="total"> Limpar tudo desta empresa</label>
    <div class="date-row" id="clear-dates">
      <div class="field"><label for="clear-start">Data inicial</label><input type="date" id="clear-start"></div>
      <div class="field"><label for="clear-end">Data final</label><input type="date" id="clear-end"></div>
    </div>
    <div class="danger-note">Esta acao remove os registros de auditoria da tela. Use somente quando tiver certeza.</div>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="cancel-clear" type="button">Cancelar</button>
      <button class="btn btn-danger" id="confirm-clear" type="button">Limpar</button>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
(() => {
  const API = '/api/ia-command/admin/protheus-chat-encaminhamentos';
  const $ = id => document.getElementById(id);
  const state = { rows: [], selected: new Set(), detail: null };
  function esc(v) {
    return String(v ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  }
  function fmtDate(v) {
    if (!v) return '-';
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? String(v) : d.toLocaleString('pt-BR');
  }
  function badge(status) {
    const s = String(status || 'pendente').toLowerCase();
    const label = { pendente:'Pendente', enviado:'Enviado', erro:'Erro', cancelado:'Cancelado' }[s] || s;
    const cls = ['pendente', 'enviado', 'erro', 'cancelado'].includes(s) ? s : 'cancelado';
    return `<span class="badge badge-${cls}">${esc(label)}</span>`;
  }
  function fmtPessoa(nome, celular) {
    const n = String(nome || '').trim();
    const c = String(celular || '').trim();
    if (n && c) return `${esc(n)}<br><span style="color:var(--text-lo)">${esc(c)}</span>`;
    return esc(n || c || '-');
  }
  function renderRow(row) {
    const checked = state.selected.has(String(row.id)) ? 'checked' : '';
    return `<tr class="data-row ${checked ? 'selected' : ''}" data-id="${esc(row.id)}">
      <td class="col-check" data-cb-cell><input type="checkbox" class="row-cb" data-id="${esc(row.id)}" ${checked}></td>
      <td><button class="icon-btn" data-edit="${esc(row.id)}" title="Editar">✎</button></td>
      <td>${esc(fmtDate(row.criado_em))}</td>
      <td>${badge(row.status)}</td>
      <td>${esc(String(row.formato || '-').toUpperCase())}</td>
      <td>${fmtPessoa(row.destinatario_nome || '', row.destinatario_celular || '')}</td>
      <td>${fmtPessoa(row.remetente_usuario || '', row.remetente_celular || '')}</td>
      <td><div class="text-preview question" title="${esc(row.pergunta_snapshot || '')}">${esc(row.pergunta_snapshot || '-')}</div></td>
      <td><div class="text-preview" title="${esc(row.resumo_snapshot || '')}">${esc(row.resumo_snapshot || '-')}</div></td>
      <td style="text-align:right">${esc(row.rows_count || 0)}</td>
    </tr>`;
  }
  function updateSelBar() {
    const n = state.selected.size;
    const btn = $('sel-del-btn');
    btn.style.display = n ? 'inline-flex' : 'none';
    btn.textContent = n ? `Excluir selecionados (${n})` : 'Excluir selecionados';
    $('cb-all').checked = state.rows.length > 0 && state.rows.every(r => state.selected.has(String(r.id)));
  }
  function renderTable() {
    $('count').textContent = `${state.rows.length} registro(s)`;
    $('tbody').innerHTML = state.rows.map(renderRow).join('');
    $('empty-state').style.display = state.rows.length ? 'none' : 'flex';
    updateSelBar();
  }
  async function readJson(res) {
    if (res.status === 401) { location.href = '/login.html'; return null; }
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Falha na operacao.');
    return data;
  }
  async function loadRows() {
    const params = new URLSearchParams({ limit: '200' });
    if ($('filter-q').value.trim()) params.set('q', $('filter-q').value.trim());
    if ($('filter-status').value) params.set('status', $('filter-status').value);
    if ($('filter-formato').value) params.set('formato', $('filter-formato').value);
    const data = await readJson(await fetch(`${API}?${params}`));
    state.rows = Array.isArray(data) ? data : [];
    state.selected.clear();
    renderTable();
  }
  function fillDetail(row) {
    $('detail-title').textContent = `Encaminhamento #${String(row.id).slice(0, 8)}`;
    $('detail-subtitle').textContent = fmtDate(row.criado_em);
    $('detail-meta').innerHTML = [
      ['Status', row.status || '-'],
      ['Formato', String(row.formato || '-').toUpperCase()],
      ['Destinatario', row.destinatario_nome || '-'],
      ['Celular destino', row.destinatario_celular || '-'],
      ['Remetente', row.remetente_usuario || '-'],
      ['Celular remetente', row.remetente_celular || '-'],
      ['Linhas', row.rows_count || 0],
      ['Arquivo', row.arquivo_nome || row.arquivo_path || '-'],
      ['Sessao', row.sessao_id || '-'],
      ['Mensagem', row.mensagem_id || '-'],
      ['Criado em', fmtDate(row.criado_em)],
      ['Enviado em', fmtDate(row.enviado_em)],
    ].map(([k, v]) => `<div class="meta-item"><span>${esc(k)}</span><strong>${esc(v)}</strong></div>`).join('');
    $('detail-question').textContent = row.pergunta_snapshot || '(sem pergunta)';
    $('detail-summary').textContent = row.resumo_snapshot || '(sem resumo)';
    $('detail-error').textContent = row.erro || '(sem erro registrado)';
  }
  async function openDetail(id) {
    const row = await readJson(await fetch(`${API}/${encodeURIComponent(id)}`));
    if (!row) return;
    state.detail = row;
    fillDetail(row);
    $('list-view').style.display = 'none';
    $('detail-view').classList.add('open');
  }
  function closeDetail() {
    $('detail-view').classList.remove('open');
    $('list-view').style.display = '';
    state.detail = null;
  }
  function toggleRow(id, checked) {
    if (checked) state.selected.add(String(id)); else state.selected.delete(String(id));
    renderTable();
  }
  async function deleteSelected() {
    const ids = [...state.selected];
    if (!ids.length) return;
    if (!confirm(`Excluir ${ids.length} registro(s) selecionado(s)?`)) return;
    const data = await readJson(await fetch(`${API}/excluir-selecionados`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids }),
    }));
    alert(`${data.removidos || 0} registro(s) excluido(s).`);
    await loadRows();
  }
  function openForm(row) {
    const r = row || {};
    $('form-title').textContent = r.id ? 'Editar encaminhamento' : 'Novo encaminhamento';
    $('form-id').value = r.id || '';
    $('form-status').value = r.status || 'pendente';
    $('form-formato').value = r.formato || 'texto';
    $('form-dest-nome').value = r.destinatario_nome || '';
    $('form-dest-cel').value = r.destinatario_celular || '';
    $('form-rem-user').value = r.remetente_usuario || '';
    $('form-rem-cel').value = r.remetente_celular || '';
    $('form-rows').value = r.rows_count || 0;
    $('form-arquivo').value = r.arquivo_nome || '';
    $('form-question').value = r.pergunta_snapshot || '';
    $('form-summary').value = r.resumo_snapshot || '';
    $('form-erro').value = r.erro || '';
    $('form-error').style.display = 'none';
    $('form-modal').classList.add('open');
  }
  function closeForm() {
    $('form-modal').classList.remove('open');
  }
  function formPayload() {
    return {
      status: $('form-status').value,
      formato: $('form-formato').value || 'texto',
      destinatario_nome: $('form-dest-nome').value,
      destinatario_celular: $('form-dest-cel').value,
      remetente_usuario: $('form-rem-user').value,
      remetente_celular: $('form-rem-cel').value,
      rows_count: Number($('form-rows').value || 0),
      arquivo_nome: $('form-arquivo').value,
      pergunta_snapshot: $('form-question').value,
      resumo_snapshot: $('form-summary').value,
      erro: $('form-erro').value,
    };
  }
  async function saveForm(event) {
    event.preventDefault();
    const id = $('form-id').value;
    const res = await fetch(id ? `${API}/${encodeURIComponent(id)}` : API, {
      method: id ? 'PUT' : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formPayload()),
    });
    try {
      await readJson(res);
      closeForm();
      await loadRows();
      if (id && state.detail?.id === id) await openDetail(id);
    } catch (err) {
      $('form-error').textContent = err.message;
      $('form-error').style.display = 'block';
    }
  }
  function openClearModal() {
    const today = new Date().toISOString().slice(0, 10);
    document.querySelector('input[name="clear-mode"][value="periodo"]').checked = true;
    $('clear-start').value = today;
    $('clear-end').value = today;
    $('clear-dates').style.display = 'grid';
    $('clear-error').style.display = 'none';
    $('clear-modal').classList.add('open');
  }
  async function confirmClear() {
    const mode = document.querySelector('input[name="clear-mode"]:checked')?.value || 'periodo';
    const payload = { modo: mode };
    if (mode !== 'total') {
      payload.data_inicio = $('clear-start').value;
      payload.data_fim = $('clear-end').value;
    }
    try {
      const data = await readJson(await fetch(`${API}/limpar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }));
      $('clear-modal').classList.remove('open');
      alert(`${data.removidos || 0} registro(s) removido(s).`);
      await loadRows();
    } catch (err) {
      $('clear-error').textContent = err.message;
      $('clear-error').style.display = 'block';
    }
  }
  function bindEvents() {
    $('refresh-btn').addEventListener('click', () => loadRows().catch(err => alert(err.message)));
    $('clear-filters').addEventListener('click', () => {
      $('filter-q').value = '';
      $('filter-status').value = '';
      $('filter-formato').value = '';
      loadRows().catch(err => alert(err.message));
    });
    ['filter-q', 'filter-status', 'filter-formato'].forEach(id => {
      $(id).addEventListener(id === 'filter-q' ? 'input' : 'change', () => loadRows().catch(err => alert(err.message)));
    });
    $('cb-all').addEventListener('change', e => {
      if (e.target.checked) state.rows.forEach(r => state.selected.add(String(r.id)));
      else state.selected.clear();
      renderTable();
    });
    $('sel-del-btn').addEventListener('click', () => deleteSelected().catch(err => alert(err.message)));
    $('tbody').addEventListener('click', event => {
      const edit = event.target.closest('[data-edit]');
      if (edit) {
        const row = state.rows.find(r => String(r.id) === String(edit.dataset.edit));
        openForm(row);
        return;
      }
      const cb = event.target.closest('input.row-cb');
      if (cb) { toggleRow(cb.dataset.id, cb.checked); return; }
      if (event.target.closest('[data-cb-cell]')) return;
      const tr = event.target.closest('tr.data-row');
      if (tr) openDetail(tr.dataset.id).catch(err => alert(err.message));
    });
    $('new-btn').addEventListener('click', () => openForm());
    $('edit-detail-btn').addEventListener('click', () => openForm(state.detail));
    $('back-btn').addEventListener('click', closeDetail);
    $('forward-form').addEventListener('submit', saveForm);
    $('close-form').addEventListener('click', closeForm);
    $('cancel-form').addEventListener('click', closeForm);
    $('clear-btn').addEventListener('click', openClearModal);
    $('close-clear').addEventListener('click', () => $('clear-modal').classList.remove('open'));
    $('cancel-clear').addEventListener('click', () => $('clear-modal').classList.remove('open'));
    $('confirm-clear').addEventListener('click', () => confirmClear().catch(err => alert(err.message)));
    document.querySelectorAll('input[name="clear-mode"]').forEach(radio => {
      radio.addEventListener('change', () => {
        $('clear-dates').style.display = radio.value === 'total' && radio.checked ? 'none' : 'grid';
      });
    });
  }
  bindEvents();
  (window._iahubAuthReady?.then(() => loadRows().catch(err => alert(err.message))) ?? loadRows().catch(err => alert(err.message)));
})();
</script>
</body>
</html>
