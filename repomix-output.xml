    }
    .stat-card-label { font-size: 10.5px; color: var(--text-lo); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
    .stat-card-value { font-size: 20px; font-weight: 700; color: var(--text-hi); line-height: 1.2; }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IAHub</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <span class="topbar-title"><span class="topbar-path">Monitores ›</span> Monitor E-mail</span>
    </div>
    <div class="page-content">
      <div class="d-flex gap-3 mb-3" style="align-items:center;flex-wrap:wrap">
        <span id="email-status-pill" class="status-pill pill-stopped">Parado</span>
        <span id="email-log-count" class="text-muted text-sm"></span>
        <div class="toolbar ms-auto">
          <button id="email-btn-start" class="btn btn-success" onclick="startEmailService()">▶ Iniciar Serviço</button>
          <button id="email-btn-stop"  class="btn btn-danger d-none" onclick="stopEmailService()">■ Parar Serviço</button>
          <button class="btn btn-info"  onclick="saveLog()">💾 Salvar Log</button>
          <button class="btn btn-ghost" onclick="clearLog()">🗑 Limpar</button>
        </div>
      </div>
      <div class="monitor-wrap">
        <div id="terminal-email" class="terminal"></div>
        <div class="info-panel">
          <div class="info-panel-title">📧 Configuração ativa</div>
          <div class="info-row">
            <span class="info-label">Conta</span>
            <span class="info-value mono" id="info-email">—</span>
          </div>
          <div class="info-row">
            <span class="info-label">Servidor IMAP</span>
            <span class="info-value mono" id="info-imap">—</span>
          </div>
          <div class="info-row">
            <span class="info-label">Intervalo</span>
            <span class="info-value" id="info-intervalo">—</span>
          </div>
          <div class="info-panel-title" style="margin-top:4px">📊 Estatísticas</div>
          <div class="stat-card">
            <span class="stat-card-label">E-mails hoje</span>
            <span class="stat-card-value" id="stat-hoje">—</span>
          </div>
          <div class="stat-card">
            <span class="stat-card-label">Total recebidos</span>
            <span class="stat-card-value" id="stat-total">—</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/js/sidebar.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  // Empresa explícita via ?empresa=ID (modo multi-aba)
  const _qs = new URLSearchParams(location.search);
  const _monitorEid = Number(_qs.get('empresa') || _qs.get('_empresa')) || null;
  function _apiUrl(path) {
    return _monitorEid ? `${path}?empresa_id=${_monitorEid}` : path;
  }
  function _apiBody(extra = {}) {
    const body = _monitorEid ? { empresa_id: _monitorEid, ...extra } : extra;
    return Object.keys(body).length ? JSON.stringify(body) : undefined;
  }
  function _apiFetchOpts(method, extra = {}) {
    const body = _apiBody(extra);
    return { method, headers: body ? { 'Content-Type': 'application/json' } : undefined, body };
  }
  if (_monitorEid) {
    // Atualiza o título da página com o nome da empresa
    fetch('/api/empresas/minhas').then(r => r.json()).then(lista => {
      const emp = lista.find(e => e.id === _monitorEid);
      if (emp) document.title = `Monitor E-mail — ${emp.razao_social || emp.nome} — IAHub`;
    }).catch(() => {});
  }
  let emailLines = [], emailCount = 0;
  const TAG = {
    info:     ['INFO',     'tag-info',    'msg-info'],
    success:  ['SUCESSO',  'tag-success', 'msg-success'],
    error:    ['ERRO',     'tag-error',   'msg-error'],
    warning:  ['AVISO',    'tag-warning', 'msg-warning'],
    received: ['RECEBIDO', 'tag-received','msg-received'],
    saved:    ['GRAVADO',  'tag-saved',   'msg-saved'],
  };
  const terminalEmail = document.getElementById('terminal-email');
  function makeLogLine(e) {
    const [label, tagCls, msgCls] = TAG[e.type] || TAG.info;
    const d = document.createElement('div');
    d.className = 'log-line';
    d.innerHTML = `<span class="log-ts">${e.timestamp||''}</span><span class="log-tag ${tagCls}">${label}</span><span class="log-msg ${msgCls}">${e.message}</span>`;
    return d;
  }
  function addEmailLine(e) {
    terminalEmail.appendChild(makeLogLine(e));
    terminalEmail.scrollTop = terminalEmail.scrollHeight;
    emailLines.push(`[${e.timestamp}] [${(TAG[e.type]||TAG.info)[0]}] ${e.message}`);
    document.getElementById('email-log-count').textContent = `${++emailCount} linha${emailCount!==1?'s':''}`;
  }
  function saveLog() {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([emailLines.join('\n')], { type:'text/plain' }));
    a.download = `iahub_email_log_${new Date().toISOString().slice(0,19).replace(/:/g,'-')}.txt`;
    a.click();
  }
  function clearLog() {
    terminalEmail.innerHTML = '';
    emailLines = []; emailCount = 0;
    document.getElementById('email-log-count').textContent = '';
    fetch('/api/email-service/clear-log', _apiFetchOpts('POST')).catch(() => {});
  }
  const EMAIL_PILLS = {
    stopped: ['pill-stopped',   'Parado'],
    running: ['pill-connected', 'Rodando'],
  };
  function setEmailStatus(s) {
    const [cls, label] = EMAIL_PILLS[s] || EMAIL_PILLS.stopped;
    const pill = document.getElementById('email-status-pill');
    pill.className = `status-pill ${cls}`;
    pill.textContent = label;
    document.getElementById('email-btn-start').classList.toggle('d-none', s !== 'stopped');
    document.getElementById('email-btn-stop').classList.toggle('d-none',  s === 'stopped');
  }
  // ── Socket ────────────────────────────────────────────────────────────────────
  socket.on('connect', () => {
    terminalEmail.innerHTML = '';
    emailLines = []; emailCount = 0;
    document.getElementById('email-log-count').textContent = '';
    if (_monitorEid) {
      socket.emit('join-empresa-monitor', { empresaId: _monitorEid });
    } else {
      window._iahubAuthReady?.then(() => socket.emit('join-empresa'));
    }
  });
  // Limpa terminal e status quando o servidor troca de empresa (MDI mode)
  socket.on('clear-monitor', () => {
    terminalEmail.innerHTML = '';
    emailLines = []; emailCount = 0;
    document.getElementById('email-log-count').textContent = '';
    setEmailStatus('stopped');
  });
  socket.on('email-log',    addEmailLine);
  socket.on('email-status', setEmailStatus);
  // Carga inicial
  fetch(_apiUrl('/api/email-service/status')).then(r => r.json()).then(d => setEmailStatus(d.status)).catch(() => {});
  carregarInfoConfig();
  carregarStats();
  function _notificarMonitores() {
    try { new BroadcastChannel('iahub_monitors').postMessage({ type: 'status-changed' }); } catch(_) {}
  }
  // ── Controles ─────────────────────────────────────────────────────────────────
  async function startEmailService() {
    const btn = document.getElementById('email-btn-start');
    btn.disabled = true;
    try {
      const r = await fetch('/api/email-service/start', _apiFetchOpts('POST'));
      if (r.status === 401) { alert('Sessão expirada. Faça login novamente.'); location.href = '/login.html'; return; }
      const data = await r.json().catch(() => ({}));
      if (!r.ok) alert(data.error || `Erro ao iniciar serviço de e-mail (HTTP ${r.status})`);
      else {
        carregarInfoConfig(); carregarStats(); _notificarMonitores();
        setTimeout(() => fetch(_apiUrl('/api/email-service/status')).then(r => r.json()).then(d => setEmailStatus(d.status)).catch(() => {}), 600);
      }
    } catch (e) {
      alert(`Erro de conexão: ${e.message}`);
    } finally {
      btn.disabled = false;
    }
  }
  async function stopEmailService() {
    const btn = document.getElementById('email-btn-stop');
    btn.disabled = true;
    try {
      const r = await fetch('/api/email-service/stop', _apiFetchOpts('POST'));
      if (r.status === 401) { alert('Sessão expirada. Faça login novamente.'); location.href = '/login.html'; return; }
      if (!r.ok) alert(`Erro ao parar serviço de e-mail (HTTP ${r.status})`);
      else {
        _notificarMonitores();
        setTimeout(() => fetch(_apiUrl('/api/email-service/status')).then(r => r.json()).then(d => setEmailStatus(d.status)).catch(() => {}), 600);
      }
    } catch (e) {
      alert(`Erro de conexão: ${e.message}`);
    } finally {
      btn.disabled = false;
    }
  }
  // ── Painel de informações ─────────────────────────────────────────────────────
  async function carregarInfoConfig() {
    try {
      const r = await fetch(_apiUrl('/api/email-geral/config'));
      if (!r.ok) return;
      const cfg = await r.json();
      document.getElementById('info-email').textContent    = cfg.email    || '—';
      document.getElementById('info-imap').textContent     = cfg.imap_host ? `${cfg.imap_host}:${cfg.imap_port}` : '—';
      const min = cfg.imap_intervalo_min || 2;
      document.getElementById('info-intervalo').textContent = `a cada ${min} min`;
    } catch (_) {}
  }
  async function carregarStats() {
    try {
      const r = await fetch(_apiUrl('/api/stats'));
      if (!r.ok) return;
      const d = await r.json();
      document.getElementById('stat-hoje').textContent  = d.email?.hoje  ?? '—';
      document.getElementById('stat-total').textContent = d.email?.total ?? '—';
    } catch (_) {}
  }
</script>
</body>
</html>
</file>

<file path="modules/processo-seletivo/frontend/processoseletivo.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Processo Seletivo — IAHub</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    .link-box { display:flex;gap:8px;align-items:center; }
    .link-input { flex:1;font-family:monospace;font-size:12.5px;color:var(--accent-light);background:var(--bg-hover);border:1px solid var(--border);border-radius:8px;padding:9px 14px;cursor:text;user-select:all; }
    .stat-row  { display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px; }
    .stat-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:18px 22px; }
    .stat-val  { font-size:28px;font-weight:800;color:var(--accent-light);line-height:1; }
    .stat-lbl  { font-size:12px;color:var(--text-lo);margin-top:4px; }
    .vaga-item  { border-bottom:1px solid var(--border); }
    .vaga-item:last-child { border-bottom:none; }
    .vaga-row  { display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;transition:background .12s; }
    .vaga-row:hover { background:var(--bg-hover); }
    .vaga-nome { font-weight:600;color:var(--text-hi);font-size:13.5px;flex:1;min-width:0; }
    .vaga-meta { font-size:12px;color:var(--text-lo);margin-top:2px; }
    .vaga-arrow { font-size:13px;color:var(--text-lo);transition:transform .2s;flex-shrink:0; }
    .vaga-arrow.open { transform:rotate(180deg); }
    .vaga-panel { display:none;background:var(--bg-hover);border-top:1px solid var(--border);padding:0 16px 14px; }
    .vaga-panel.open { display:block; }
    .vaga-panel .table-cand th { padding-top:14px; }
    .panel-empty { padding:18px 0;font-size:13px;color:var(--text-lo);text-align:center; }
    .badge-aberta   { background:rgba(34,197,94,.12);color:var(--success);border-radius:20px;padding:2px 9px;font-size:11px;font-weight:600;white-space:nowrap; }
    .badge-cand     { background:rgba(37,99,235,.12);color:var(--accent);border-radius:20px;padding:2px 9px;font-size:11px;font-weight:600;white-space:nowrap; }
    .table-cand { width:100%;border-collapse:collapse;font-size:13px; }
    .table-cand th { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;padding:10px 12px 10px 0;border-bottom:1px solid var(--border); }
    .table-cand td { padding:11px 12px 11px 0;border-bottom:1px solid var(--border);vertical-align:middle; }
    .table-cand tr:last-child td { border-bottom:none; }
    .empty-state { text-align:center;padding:50px 20px;color:var(--text-lo); }
    .btn-warn { background:rgba(239,68,68,.08);color:#dc2626;border:1px solid rgba(239,68,68,.2);border-radius:8px;padding:7px 14px;font-size:12.5px;cursor:pointer;font-family:inherit;transition:background .15s; }
    .btn-warn:hover { background:rgba(239,68,68,.15); }
    .canal-badge { font-size:11px;padding:2px 8px;border-radius:10px; }
    .canal-email     { background:rgba(37,99,235,.1);color:var(--accent); }
    .canal-whatsapp  { background:rgba(34,197,94,.1);color:var(--success); }
    /* Botão ajuda topbar */
    .btn-ajuda-topbar { display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#fff;border:none;border-radius:8px;padding:8px 18px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:background .15s;white-space:nowrap;box-shadow:0 2px 8px rgba(37,99,235,.25); }
    .btn-ajuda-topbar:hover { background:#1d4ed8; }
    /* Modal ajuda */
    .modal-ajuda-overlay { position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:300;display:flex;align-items:center;justify-content:center; }
    .modal-ajuda { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);width:min(820px,96vw);max-height:93vh;overflow-y:auto;padding:32px;position:relative; }
    .ajuda-titulo { font-size:16px;font-weight:700;color:var(--text-hi);margin-bottom:20px; }
    .ajuda-etapa  { margin-bottom:20px; }
    .ajuda-etapa-titulo { font-size:13px;font-weight:700;color:var(--accent);margin-bottom:6px; }
    .ajuda-etapa p { font-size:13px;color:var(--text-md);line-height:1.75;margin:0 0 8px; }
    .ajuda-criterio { display:flex;align-items:flex-start;gap:12px;margin-bottom:10px; }
    .ajuda-pts { background:var(--bg-hover);border-radius:8px;padding:4px 10px;font-size:13px;font-weight:700;color:var(--accent);white-space:nowrap;min-width:48px;text-align:center; }
    .ajuda-criterio-info strong { font-size:13px;color:var(--text-hi); }
    .ajuda-criterio-info p { font-size:12px;color:var(--text-lo);margin:2px 0 0; }
    .ajuda-tabs { display:flex;gap:4px;border-bottom:1px solid var(--border);margin-bottom:20px; }
    .ajuda-tab  { background:none;border:none;border-bottom:2px solid transparent;padding:8px 16px;font-size:13px;font-weight:600;color:var(--text-lo);cursor:pointer;font-family:inherit;transition:color .15s,border-color .15s;margin-bottom:-1px; }
    .ajuda-tab:hover { color:var(--text-hi); }
    .ajuda-tab.active { color:var(--accent);border-bottom-color:var(--accent); }
    .ajuda-tab-content { display:none; }
    .ajuda-tab-content.active { display:block; }
    .fluxo-step { display:flex;gap:14px;margin-bottom:18px; }
    .fluxo-num  { flex-shrink:0;width:28px;height:28px;border-radius:50%;background:var(--accent);color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center; }
    .fluxo-body { flex:1; }
    .fluxo-title { font-size:13px;font-weight:700;color:var(--text-hi);margin-bottom:4px; }
    .fluxo-desc  { font-size:12.5px;color:var(--text-md);line-height:1.75; }
    .fluxo-sub   { font-size:12px;color:var(--text-lo);margin-top:6px;padding-left:12px;border-left:2px solid var(--border);line-height:1.8; }
    .ia-card { border:1px solid var(--border);border-radius:10px;padding:16px 18px;margin-bottom:14px; }
    .ia-card-header { display:flex;align-items:center;gap:10px;margin-bottom:10px; }
    .ia-badge { font-size:11px;font-weight:700;padding:3px 9px;border-radius:12px;white-space:nowrap; }
    .ia-badge-primary { background:#dbeafe;color:#1e40af; }
    .ia-badge-fallback { background:#fef3c7;color:#92400e; }
    .ia-card-title { font-size:14px;font-weight:700;color:var(--text-hi); }
    .ia-card p { font-size:12.5px;color:var(--text-md);line-height:1.75;margin:0 0 8px; }
    .ia-card p:last-child { margin:0; }
    .ia-ops { background:var(--bg-hover);border-radius:8px;padding:10px 14px;margin:10px 0;font-size:12.5px;color:var(--text-md);line-height:2; }
    .ia-ops strong { color:var(--text-hi); }
    .ia-link { display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;color:var(--accent);text-decoration:none;border:1px solid var(--accent);border-radius:8px;padding:5px 12px;margin-top:6px;transition:background .15s; }
    .ia-link:hover { background:#eff6ff; }
    .credito-calc { background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px 18px;margin-top:16px; }
    .credito-calc-title { font-size:13px;font-weight:700;color:#15803d;margin-bottom:8px; }
    .credito-calc p { font-size:12.5px;color:#166534;line-height:1.8;margin:0; }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IAHub</span>
    </div>
    <div class="sidebar-nav">
    </div>
    <div class="sidebar-footer">
    </div>
    </nav>
  <div class="main">
    <div class="topbar">
      <span class="topbar-title"><span class="topbar-path">Recrutamento › Processo Seletivo ›</span> Processo Seletivo</span>
      </div>
    <div class="page-content">
      <div class="stat-row" id="stat-row">
        <div class="stat-card"><div class="stat-val" id="stat-total-cand">—</div><div class="stat-lbl">Candidaturas recebidas</div></div>
        <div class="stat-card"><div class="stat-val" id="stat-vagas-abertas">—</div><div class="stat-lbl">Vagas em aberto</div></div>
        <div class="stat-card"><div class="stat-val" id="stat-hoje">—</div><div class="stat-lbl">Recebidas hoje</div></div>
      </div>
      <div class="card mb-4">
        <div class="card-header">💼 Vagas em Aberto — Candidaturas por Vaga</div>
        <div id="vagas-lista">
          <div class="empty-state" style="padding:30px">Carregando...</div>
        </div>
      </div>
    </div>
  </div>
</div>
<div id="modal-ajuda" class="modal-ajuda-overlay d-none" onclick="if(event.target===this)this.classList.add('d-none')">
  <div class="modal-ajuda">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <div class="ajuda-titulo" style="margin:0">🔍 Análise de Currículos — Ajuda</div>
      <button onclick="document.getElementById('modal-ajuda').classList.add('d-none')" style="background:none;border:none;color:var(--text-lo);font-size:22px;cursor:pointer;line-height:1">✕</button>
    </div>
    <div class="ajuda-tabs">
      <button class="ajuda-tab active" id="tab-btn-como-funciona" onclick="switchAjudaTab('como-funciona')">📖 Como funciona</button>
      <button class="ajuda-tab" id="tab-btn-fluxo" onclick="switchAjudaTab('fluxo')">🔄 Fluxo da análise</button>
      <button class="ajuda-tab" id="tab-btn-creditos" onclick="switchAjudaTab('creditos')">💳 Créditos de IA</button>
      <button class="ajuda-tab" id="tab-btn-equivalencias" onclick="switchAjudaTab('equivalencias')">⚡ Equivalências</button>
    </div>
    <div id="tab-como-funciona" class="ajuda-tab-content active">
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">⚡ Etapa 1 — Triagem automática</div>
        <p>Antes de qualquer análise detalhada, o sistema faz uma triagem rápida em todos os currículos verificando os <strong style="color:var(--text-hi)">Requisitos Obrigatórios</strong> cadastrados na Função.</p>
        <p>Quem <strong style="color:var(--error)">não atende</strong> esses critérios mínimos é eliminado e não entra na análise profunda.</p>
      </div>
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">📊 Etapa 2 — Pontuação por critérios (máx. 100 pts)</div>
        <p>Os candidatos que passaram da triagem são analisados individualmente pela IA:</p>
        <div class="ajuda-criterio">
          <div class="ajuda-pts">40 pts</div>
          <div class="ajuda-criterio-info">
            <strong>Requisitos Obrigatórios</strong>
            <p>Atende tudo = 40 pts. Parcialmente (>50%) = 20–35 pts. Poucos (<50%) = 5–15 pts. Nenhum = 0 pts <em>(score máximo cai para 25)</em>.</p>
          </div>
        </div>
        <div class="ajuda-criterio">
          <div class="ajuda-pts">30 pts</div>
          <div class="ajuda-criterio-info">
            <strong>Habilidades Técnicas</strong>
            <p>Domínio das ferramentas e tecnologias listadas na vaga. Considera equivalências (ex: "SoftExpert" = "SE Suite").</p>
          </div>
        </div>
        <div class="ajuda-criterio">
          <div class="ajuda-pts">15 pts</div>
          <div class="ajuda-criterio-info">
            <strong>Nível e Tempo de Experiência Relevante</strong>
            <p>O sistema calcula o tempo total de carreira e a IA avalia o tempo relevante para a vaga específica, classificando como Júnior / Pleno / Sênior.</p>
          </div>
        </div>
        <div class="ajuda-criterio">
          <div class="ajuda-pts">15 pts</div>
          <div class="ajuda-criterio-info">
            <strong>Formação Acadêmica</strong>
            <p>A formação atende ou supera o definido na Função.</p>
          </div>
        </div>
      </div>
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">✅ Etapa 3 — Encerrar Análise da Vaga</div>
        <p>Após revisar os resultados no <a href="/analisador.html" style="color:var(--accent)">Analisador de Currículos</a>, marque os candidatos finalistas e clique em <strong>Encerrar Análise da Vaga</strong>. O resultado fica salvo no <a href="/historico.html" style="color:var(--accent)">Histórico de Análises</a>.</p>
      </div>
      <div class="ajuda-etapa" style="margin-bottom:0">
        <div class="ajuda-etapa-titulo">🏆 Resultado final</div>
        <p>Compatibilidade: <strong style="color:#15803d">Alto (70–100 pts)</strong>, <strong style="color:#a16207">Médio (40–69 pts)</strong> ou <strong style="color:#b91c1c">Baixo (0–39 pts)</strong>.</p>
      </div>
    </div>
    <div id="tab-fluxo" class="ajuda-tab-content">
      <div class="fluxo-step">
        <div class="fluxo-num">0</div>
        <div class="fluxo-body">
          <div class="fluxo-title">Seleção de currículos</div>
          <div class="fluxo-desc">O sistema busca todos os currículos cadastrados. Se você escolher <em>"Apenas candidatos desta vaga via Processo Seletivo"</em> no analisador, somente os currículos vinculados à vaga pelo formulário público são considerados.</div>
        </div>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">1</div>
        <div class="fluxo-body">
          <div class="fluxo-title">Triagem eliminatória por palavras-chave — sem IA</div>
          <div class="fluxo-desc">Para cada currículo, o sistema extrai todo o texto e verifica se cada Requisito Obrigatório está presente, usando três camadas:</div>
          <div class="fluxo-sub">
            1. <strong>Tabela de equivalências</strong> — variantes do termo. Ex: "SoftExpert" reconhece "se suite", "sesuite".<br>
            2. <strong>Palavras significativas</strong> — cada palavra relevante verificada individualmente.<br>
            3. <strong>Fallback literal</strong> — busca o termo exatamente como escrito.<br><br>
            Currículos que <strong>não atendem todos os requisitos</strong> são eliminados com motivo detalhado.
          </div>
        </div>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">2</div>
        <div class="fluxo-body">
          <div class="fluxo-title">Cálculo automático de experiência total</div>
          <div class="fluxo-desc">O sistema calcula deterministicamente o tempo total de carreira somando os períodos de cada experiência. Suporta formatos DD/MM/YYYY, MM/YYYY, "desde", "atual", "presente" e similares.</div>
        </div>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">3</div>
        <div class="fluxo-body">
          <div class="fluxo-title">Análise profunda individual pela IA</div>
          <div class="fluxo-desc">Cada currículo aprovado é analisado individualmente. A IA pontua de acordo com a rubrica:</div>
          <div class="fluxo-sub">
            <strong>Requisitos Obrigatórios (40 pts)</strong> — Atende tudo = 40; maioria = 20–35; poucos = 5–15; nenhum = 0 (score final limitado a 25).<br>
            <strong>Habilidades Técnicas (30 pts)</strong> — Domina todas = 30; maioria = 20; algumas = 10; nenhuma = 0.<br>
            <strong>Nível/Experiência Relevante (15 pts)</strong> — Nível igual/superior = 15; um abaixo = 8; dois abaixo = 0.<br>
            <strong>Formação Acadêmica (15 pts)</strong> — Atende/supera = 15; próxima área = 8; não atende = 0.
          </div>
        </div>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">4</div>
        <div class="fluxo-body">
          <div class="fluxo-title">Fallback automático de IA e tratamento de falhas</div>
          <div class="fluxo-desc">IA primária: <strong>Llama 3.3 70B</strong> via Groq. Em caso de rate limit (429), o sistema usa <strong>Gemini 2.0 Flash</strong> automaticamente. Se ambos falharem, o candidato recebe score neutro (50 pts) e não é eliminado.</div>
        </div>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">5</div>
        <div class="fluxo-body">
          <div class="fluxo-title">Eliminação pós-IA e ordenação</div>
          <div class="fluxo-desc">Candidatos com <strong>Requisitos Obrigatórios = 0</strong> ou score ≤ 25 são movidos para eliminados. Os aprovados são ordenados do maior para o menor score.</div>
        </div>
      </div>
      <div class="fluxo-step" style="margin-bottom:0">
        <div class="fluxo-num">6</div>
        <div class="fluxo-body">
          <div class="fluxo-title">Classificação final</div>
          <div class="fluxo-sub">
            <strong style="color:#15803d">Alto (70–100 pts)</strong> — candidato altamente compatível.<br>
            <strong style="color:#a16207">Médio (40–69 pts)</strong> — candidato parcialmente compatível, merece avaliação.<br>
            <strong style="color:#b91c1c">Baixo (0–39 pts)</strong> — baixa aderência ao perfil exigido.
          </div>
        </div>
      </div>
    </div>
    <div id="tab-creditos" class="ajuda-tab-content">
      <p style="font-size:13px;color:var(--text-md);line-height:1.75;margin-bottom:18px">
        A triagem por palavras-chave e o cálculo de experiência são determinísticos — <strong style="color:var(--text-hi)">não consomem créditos</strong>. Créditos são gastos somente na <strong style="color:var(--text-hi)">análise profunda individual</strong> de cada currículo aprovado na triagem.
      </p>
      <div class="ia-card">
        <div class="ia-card-header">
          <span class="ia-badge ia-badge-primary">IA Principal</span>
          <span class="ia-card-title">Groq — Llama 3.3 70B Versatile</span>
        </div>
        <p>Motor principal da análise. Cada currículo aprovado é enviado individualmente ao modelo Llama 3.3 70B via API Groq, que retorna pontuação estruturada (JSON) nos quatro critérios.</p>
        <div class="ia-ops">
          <strong>Input estimado:</strong> 1.500 – 5.000 tokens por currículo <span style="color:var(--text-lo)">(texto do CV + perfil da função)</span><br>
          <strong>Output estimado:</strong> 400 – 800 tokens por currículo <span style="color:var(--text-lo)">(JSON com scores, pontos e resumo)</span><br>
          <strong>Média por análise:</strong> ~3.000 tokens input + ~600 tokens output
        </div>
        <p>A Groq oferece plano gratuito com limite de requisições por minuto. Para volumes maiores, utilize um plano pago.</p>
        <a class="ia-link" href="https://console.groq.com" target="_blank">🔗 console.groq.com — Criar conta / adquirir créditos</a>
      </div>
      <div class="ia-card">
        <div class="ia-card-header">
          <span class="ia-badge ia-badge-fallback">Fallback automático</span>
          <span class="ia-card-title">Google Gemini 2.0 Flash</span>
        </div>
        <p>Ativado automaticamente quando a Groq retorna erro de limite (429) ou quota excedida.</p>
        <div class="ia-ops">
          <strong>Input estimado:</strong> 1.500 – 5.000 tokens por currículo<br>
          <strong>Output estimado:</strong> 400 – 800 tokens por currículo<br>
          <strong>Plano gratuito:</strong> até 1.500 requisições/dia e 1 milhão de tokens/minuto
        </div>
        <p>Para volume alto, habilite cobrança no Google AI Studio ou utilize via Google Cloud (Vertex AI).</p>
        <a class="ia-link" href="https://aistudio.google.com" target="_blank">🔗 aistudio.google.com — Google AI Studio / créditos</a>
      </div>
      <div class="credito-calc">
        <div class="credito-calc-title">📊 Como estimar o consumo por processo seletivo</div>
        <p>
          Considere apenas os currículos que <strong>passam da triagem</strong> — os eliminados não geram chamadas de IA.<br><br>
          <strong>Fórmula simplificada (Groq):</strong><br>
          Nº de CVs aprovados × 3.600 tokens médios ÷ 1.000.000 = Milhões de tokens<br><br>
          <strong>Exemplo — 40 CVs aprovados:</strong><br>
          40 × 3.600 = 144.000 tokens ≈ custo estimado com plano pago Groq: <strong>menos de US$ 0,15 por análise completa</strong><br><br>
          <em style="font-size:11.5px">Valores de referência. Consulte sempre a tabela de preços atual de cada provedor antes de adquirir créditos.</em>
        </p>
      </div>
    </div>
    <div id="tab-equivalencias" class="ajuda-tab-content">
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">💡 Por que equivalências existem?</div>
        <p>Candidatos descrevem a mesma habilidade de formas diferentes. Um profissional de <strong style="color:var(--text-hi)">ADVPL</strong> pode escrever "Protheus", "TOTVS" ou "Microsiga" no currículo. Sem equivalências, ele seria eliminado na triagem mesmo sendo qualificado.</p>
        <p>A tabela de equivalências resolve isso: você mapeia uma vez e o sistema reconhece todas as variantes automaticamente em toda triagem futura.</p>
      </div>
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">🔍 Como a triagem usa as equivalências?</div>
        <p>Para cada <strong style="color:var(--text-hi)">Requisito Obrigatório</strong> da vaga, o sistema verifica o texto do currículo em 3 camadas em sequência:</p>
        <div class="fluxo-step" style="margin-bottom:12px">
          <div class="fluxo-num">1</div>
          <div class="fluxo-body">
            <div class="fluxo-title">Tabela de equivalências</div>
            <div class="fluxo-desc">Verifica o termo principal e todos os sinônimos cadastrados. Se <em>qualquer um</em> aparecer no currículo, o requisito é considerado atendido. Ex: requisito "SoftExpert" → reconhece "se suite", "sesuite", "se-suite".</div>
          </div>
        </div>
        <div class="fluxo-step" style="margin-bottom:12px">
          <div class="fluxo-num">2</div>
          <div class="fluxo-body">
            <div class="fluxo-title">Palavras significativas</div>
            <div class="fluxo-desc">Se o requisito é uma frase (ex: "Gestão de Pessoas"), cada palavra relevante é verificada individualmente nas equivalências. Conectivos e preposições são ignorados.</div>
          </div>
        </div>
        <div class="fluxo-step" style="margin-bottom:0">
          <div class="fluxo-num">3</div>
          <div class="fluxo-body">
            <div class="fluxo-title">Busca literal</div>
            <div class="fluxo-desc">Por último, busca o termo exatamente como escrito na vaga. Captura termos que não estão nas equivalências e não foram desmembrados nas etapas anteriores.</div>
          </div>
        </div>
      </div>
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">🏷️ Dois tipos de equivalências</div>
        <div class="ajuda-criterio" style="margin-bottom:12px">
          <div class="ajuda-pts" style="background:#f0f9ff;color:#0369a1;border:1px solid #bae6fd;font-size:11px;min-width:80px">⚙ embutido</div>
          <div class="ajuda-criterio-info">
            <strong>Padrão do sistema</strong>
            <p>Vem pré-configurado, cobrindo termos técnicos comuns (SoftExpert, SAP, Power BI, etc.). Pode ser editado — sua versão tem prioridade sobre o padrão.</p>
          </div>
        </div>
        <div class="ajuda-criterio">
          <div class="ajuda-pts" style="background:#fefce8;color:#a16207;border:1px solid #fde68a;font-size:11px;min-width:80px">★ personalizado</div>
          <div class="ajuda-criterio-info">
            <strong>Criado pelo recrutador</strong>
            <p>Equivalências específicas do seu negócio ou setor. Podem ser editadas ou excluídas a qualquer momento sem afetar o padrão.</p>
          </div>
        </div>
      </div>
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">⚡ Sugestão automática por IA</div>
        <p>Ao cadastrar ou editar uma <strong style="color:var(--text-hi)">Função</strong>, após preencher os Requisitos Obrigatórios e Habilidades Técnicas, use o botão <strong>"Sugerir equivalências com IA"</strong>. O sistema gera automaticamente variantes para cada termo e apresenta para você revisar antes de salvar.</p>
        <p>Equivalências já existentes na base são exibidas na revisão — o sistema nunca sobrescreve sem sua aprovação explícita.</p>
      </div>
      <div class="ajuda-etapa" style="margin-bottom:0">
        <div class="ajuda-etapa-titulo">⚙ Onde gerenciar</div>
        <p>Acesse <a href="/configuracoes.html" style="color:var(--accent)">Configurações → aba Equivalências</a> para visualizar, criar, editar ou excluir qualquer equivalência.</p>
        <div style="background:var(--bg-hover);border-radius:8px;padding:12px 16px;font-size:12.5px;color:var(--text-md);margin-top:10px;line-height:1.75">
          <strong style="color:var(--text-hi)">Exemplo prático:</strong><br>
          Keyword: <strong>ADVPL</strong><br>
          Variantes: <em>totvs, protheus, microsiga, advpl totvs, totvs protheus</em><br><br>
          Qualquer currículo que mencione uma dessas variantes passará pelo requisito "ADVPL" na triagem, mesmo sem citar a palavra "ADVPL".
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/js/audit-fields.js"></script>
<script src="/js/sidebar.js"></script>
<script>
let vagas = [], candidaturas = [], semVaga = [];
  function switchAjudaTab(tab) {
    document.querySelectorAll('.ajuda-tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.ajuda-tab-content').forEach(c => { c.classList.remove('active'); c.style.display = 'none'; });
    document.getElementById('tab-btn-' + tab).classList.add('active');
    const content = document.getElementById('tab-' + tab);
    content.style.display = 'block';
    content.classList.add('active');
  }
// Deduplicação por candidato dentro de uma mesma vaga (email ou nome, mais recente primeiro)
function deduplicarPorVaga(cands) {
  const seen = new Map();
  for (const c of cands) {
    const key = (c.candidato_email || '').toLowerCase() || (c.candidato_nome || '').toLowerCase() || c.id;
    if (!seen.has(key)) seen.set(key, c);
  }
  return Array.from(seen.values());
}
// Deduplicação para sem-vaga por email ou telefone (mais recente primeiro)
function deduplicarSemVaga(lista) {
  const seen = new Map();
  for (const c of lista) {
    const key = (c.email || '').toLowerCase() || c.telefone || String(c.id);
    if (!seen.has(key)) seen.set(key, c);
  }
  return Array.from(seen.values());
}
async function carregar() {
  [vagas, candidaturas, semVaga] = await Promise.all([
    fetch('/api/vagas').then(r => r.json()),
    fetch('/api/ps/candidaturas').then(r => r.json()),
    fetch('/api/ps/curriculos-sem-vaga').then(r => r.json()),
  ]);
  renderStats();
  renderVagas();
}
function renderStats() {
  const abertas  = vagas.filter(v => v.status === 'aberta').length;
  const hoje     = new Date().toISOString().slice(0, 10);
  // contagem deduplicada: por candidato+vaga
  const dedupTotal = (() => {
    const seen = new Map();
    for (const c of candidaturas) {
      const key = `${c.vaga_id}|${(c.candidato_email||'').toLowerCase()||(c.candidato_nome||'').toLowerCase()}`;
      if (!seen.has(key)) seen.set(key, c);
    }
    return seen.size;
  })();
  const hojeN = candidaturas.filter(c => c.data?.startsWith(hoje)).length;
  document.getElementById('stat-total-cand').textContent    = dedupTotal;
  document.getElementById('stat-vagas-abertas').textContent = abertas;
  document.getElementById('stat-hoje').textContent          = hojeN;
}
function renderVagas() {
  const abertas = vagas.filter(v => v.status === 'aberta');
  const el = document.getElementById('vagas-lista');
  if (!abertas.length) {
    el.innerHTML = '<div class="empty-state">Nenhuma vaga aberta. <a href="/vagas.html" style="color:var(--accent)">Cadastrar vagas →</a></div>';
    return;
  }
  const semVagaItem = (() => {
    const lista = deduplicarSemVaga(semVaga);
    const n     = lista.length;
    const _empSv = window._iahubEmpresa || { id: '—', nome: '—' };
    const _sTd   = 'color:var(--text-lo);font-size:11px;font-family:monospace;white-space:nowrap';
    const rows  = lista.map(c => `<tr>
        <td style="${_sTd}">${c.id ?? '—'}</td>
        <td style="${_sTd}">${_empSv.id}</td>
        <td style="color:var(--text-lo);font-size:11px;white-space:nowrap">${_empSv.nome}</td>
        <td style="color:var(--text-lo);white-space:nowrap">${new Date(c.recebido_em || Date.now()).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'2-digit',hour:'2-digit',minute:'2-digit'})}</td>
        <td style="font-weight:600;color:var(--text-hi)">${c.nome || '—'}</td>
        <td style="color:var(--text-lo)">${c.email || '—'}</td>
        <td><span class="canal-badge canal-whatsapp">💬 WhatsApp</span></td>
        <td style="text-align:right"><a href="/curriculo.html?id=${c.id}" target="_blank" class="btn btn-ghost" style="font-size:11px;padding:4px 10px">Ver</a></td>
      </tr>`).join('');
    return `<div class="vaga-item">
      <div class="vaga-row" onclick="toggleVaga('sem-vaga', this)">
        <div style="flex:1;min-width:0">
          <div class="vaga-nome" style="color:var(--text-md)">Sem vaga definida</div>
          <div class="vaga-meta">Currículos recebidos via WhatsApp não vinculados a nenhuma vaga</div>
        </div>
        <span class="badge-cand">${n} currículo${n !== 1 ? 's' : ''}</span>
        <span class="vaga-arrow">▾</span>
      </div>
      <div class="vaga-panel" id="panel-sem-vaga">
        ${rows ? `<table class="table-cand"><thead><tr>
            <th style="color:var(--text-lo);font-size:11px">ID Reg.</th><th style="color:var(--text-lo);font-size:11px">ID Emp.</th><th style="color:var(--text-lo);font-size:11px">Empresa</th>
            <th>Data</th><th>Candidato</th><th>E-mail</th><th>Canal</th><th style="text-align:right">Currículo</th>
          </tr></thead><tbody>${rows}</tbody></table>`
          : '<div class="panel-empty">Nenhum currículo sem vaga no momento.</div>'}
      </div>
    </div>`;
  })();
  el.innerHTML = abertas.map(v => {
    const f    = v.funcao || {};
    const cand = deduplicarPorVaga(candidaturas.filter(c => c.vaga_id === v.id));
    const n    = cand.length;
    const _empC = window._iahubEmpresa || { id: '—', nome: '—' };
    const _sCTd = 'color:var(--text-lo);font-size:11px;font-family:monospace;white-space:nowrap';
    const rows = cand.length
      ? cand.map(c => `<tr>
          <td style="${_sCTd}">${c.id ?? '—'}</td>
          <td style="${_sCTd}">${_empC.id}</td>
          <td style="color:var(--text-lo);font-size:11px;white-space:nowrap">${_empC.nome}</td>
          <td style="color:var(--text-lo);white-space:nowrap">${new Date(c.data).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'2-digit',hour:'2-digit',minute:'2-digit'})}</td>
          <td style="font-weight:600;color:var(--text-hi)">${c.candidato_nome || '—'}</td>
          <td style="color:var(--text-lo)">${c.candidato_email || '—'}</td>
          <td><span class="canal-badge canal-${c.canal}">${c.canal === 'email' ? '📧 Email' : '💬 WhatsApp'}</span></td>
          <td style="text-align:right"><a href="/curriculo.html?id=${c.curriculo_id}" target="_blank" class="btn btn-ghost" style="font-size:11px;padding:4px 10px">Ver</a></td>
        </tr>`).join('')
      : '';
    return `<div class="vaga-item">
      <div class="vaga-row" onclick="toggleVaga(${v.id}, this)">
        <div style="flex:1;min-width:0">
          <div class="vaga-nome">${f.nome || '—'}</div>
          <div class="vaga-meta">${[f.area, f.nivel_experiencia].filter(Boolean).join(' · ')} · ${v.quantidade} vaga${v.quantidade !== 1 ? 's' : ''}</div>
        </div>
        <span class="badge-aberta">● Aberta</span>
        <span class="badge-cand">${n} candidatura${n !== 1 ? 's' : ''}</span>
        <a href="/analisador.html?vaga_id=${v.id}&filtro=somente_vaga" class="btn btn-ghost" style="font-size:12px;white-space:nowrap" onclick="event.stopPropagation()">🔍 Analisar</a>
        <span class="vaga-arrow">▾</span>
      </div>
      <div class="vaga-panel" id="panel-${v.id}">
        ${rows ? `<table class="table-cand"><thead><tr>
            <th style="color:var(--text-lo);font-size:11px">ID Reg.</th><th style="color:var(--text-lo);font-size:11px">ID Emp.</th><th style="color:var(--text-lo);font-size:11px">Empresa</th>
            <th>Data</th><th>Candidato</th><th>E-mail</th><th>Canal</th><th style="text-align:right">Currículo</th>
          </tr></thead><tbody>${rows}</tbody></table>`
          : '<div class="panel-empty">Nenhuma candidatura recebida para esta vaga ainda.</div>'}
      </div>
    </div>`;
  }).join('') + semVagaItem;
}
function toggleVaga(id, row) {
  const panel = document.getElementById(`panel-${id}`);
  const arrow = row.querySelector('.vaga-arrow');
  const isOpen = panel.classList.contains('open');
  panel.classList.toggle('open', !isOpen);
  arrow.classList.toggle('open', !isOpen);
}
carregar();
</script>
</body>
</html>
