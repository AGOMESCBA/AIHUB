<script>
  const paramsCurriculo = new URLSearchParams(location.search);
  const id = paramsCurriculo.get('id');
  const returnUrl = paramsCurriculo.get('return');
  function obterRetornoSeguro(raw) {
    if (!raw) return '';
    try {
      const url = new URL(raw, location.origin);
      if (url.origin !== location.origin) return '';
      return `${url.pathname}${url.search}${url.hash}`;
    } catch (_) {
      return '';
    }
  }
  function voltarCurriculo(event) {
    event?.preventDefault?.();
    const retorno = obterRetornoSeguro(returnUrl);
    if (retorno) {
      location.href = retorno;
      return;
    }
    try {
      const ref = document.referrer ? new URL(document.referrer) : null;
      if (ref?.origin === location.origin && history.length > 1) {
        history.back();
        return;
      }
    } catch (_) {}
    location.href = '/curriculos.html';
  }
  function f(label, value, html) {
    if (!value) return '';
    return `<div class="field-l">${label}</div><div class="field-v">${html||value}</div>`;
  }
  async function carregar() {
    if (!id) return;
    const c = await fetch(`/api/curriculos/${id}`).then(r => r.json());
    document.getElementById('topbar-nome').textContent = c.nome || `Currículo #${c.id}`;
    if (c.pdf_base64) {
      document.getElementById('topbar-actions').innerHTML =
        `<button class="btn btn-info" style="font-size:12px" onclick="baixarPdf()">⬇ Baixar PDF</button>`;
      window._pdf = { data: c.pdf_base64, nome: c.pdf_nome || 'curriculo.pdf' };
    }
    const exps = (c.experiencias||[]).map(e => `
      <div class="exp-block">
        <div class="exp-emp">${e.empresa||'—'}</div>
        <div class="exp-cargo">${e.cargo||''}</div>
        <div class="exp-per">${e.periodo||''}</div>
        ${e.descricao ? `<div class="exp-desc">${e.descricao}</div>` : ''}
        ${e.atividades?.length ? `<ul class="exp-list">${e.atividades.map(a=>`<li>${a}</li>`).join('')}</ul>` : ''}
      </div>`).join('');
    const form = (c.formacao||[]).map(f =>
      `<div class="field-v"><strong>${f.instituicao||'—'}</strong> — ${f.curso||'—'} <span style="color:var(--text-lo);font-size:12px">(${f.periodo||'—'})</span></div>`
    ).join('');
    const caps  = (c.capacitacoes||[]).map(x => `<span class="badge badge-purple" style="margin:3px">${x}</span>`).join('');
    const habs  = (c.habilidades||[]).map(h => `<span class="skill-tag">${h}</span>`).join('');
    const _empCur = window._iahubEmpresa || { id: '—', nome: '—' };
    document.getElementById('page-content').innerHTML = `
      <div style="display:flex;gap:12px;margin-bottom:12px;padding:10px 14px;background:var(--bg-hover);border:1px solid var(--border);border-radius:8px">
        <span style="font-size:11px;color:var(--text-lo);font-family:monospace">ID do Registro: <strong>${c.id}</strong></span>
        <span style="font-size:11px;color:var(--text-lo);font-family:monospace">ID da Empresa: <strong>${_empCur.id}</strong></span>
        <span style="font-size:11px;color:var(--text-lo)">Empresa: <strong>${_empCur.nome}</strong></span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
        <div class="card">
          <div class="card-header">📋 Dados Pessoais</div>
          <div class="card-body">
            ${f('Nome', c.nome)}
            ${f('Telefone', c.telefone)}
            ${f('E-mail', c.email, c.email ? `<a href="mailto:${c.email}">${c.email}</a>` : null)}
            ${f('Endereço', c.endereco)}
            ${f('LinkedIn / Portfolio', c.linkedin, c.linkedin ? `<a href="${c.linkedin}" target="_blank">${c.linkedin}</a>` : null)}
            <div style="margin-top:8px;padding-top:12px;border-top:1px solid var(--border);font-size:12px;color:var(--text-lo)">
              Recebido de <strong style="color:var(--accent-light)">${c.remetente}</strong>
              em ${new Date(c.recebido_em).toLocaleString('pt-BR')}
            </div>
          </div>
        </div>
        ${c.descricao ? `
        <div class="card">
          <div class="card-header">👤 Descrição do Candidato</div>
          <div class="card-body" style="color:var(--text-md);line-height:1.75;font-size:13.5px">${c.descricao}</div>
        </div>` : '<div></div>'}
      </div>
      ${c.experiencias?.length ? `
      <div class="card mb-4">
        <div class="card-header">💼 Experiência Profissional</div>
        <div class="card-body">${exps}</div>
      </div>` : ''}
      ${habs ? `
      <div class="card mb-4">
        <div class="card-header">🛠️ Habilidades e Competências</div>
        <div class="card-body" style="line-height:2">${habs}</div>
      </div>` : ''}
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        ${c.formacao?.length ? `
        <div class="card">
          <div class="card-header">🎓 Formação Acadêmica</div>
          <div class="card-body">${form}</div>
        </div>` : ''}
        ${c.capacitacoes?.length ? `
        <div class="card">
          <div class="card-header">🏆 Capacitações e Certificações</div>
          <div class="card-body">${caps}</div>
        </div>` : ''}
      </div>`;
  }
  function baixarPdf() {
    const a = document.createElement('a');
    a.href = `data:application/pdf;base64,${window._pdf.data}`;
    a.download = window._pdf.nome;
    a.click();
  }
  // O carregamento V2 aguarda o auth.js resolver empresa/permissões antes de buscar dados.
</script>
<script>
  const fmtDataV2 = v => v ? new Date(v).toLocaleString('pt-BR') : '—';
  function escHV2(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function campoV2(label, value, html) {
    if (!value) return '';
    return `<div><div class="field-l">${label}</div><div class="field-v">${html || escHV2(value)}</div></div>`;
  }
  function statV2(label, value) {
    return `<div class="summary-pill"><strong>${value}</strong><span>${label}</span></div>`;
  }
  function canalV2(remetente) {
    if (!remetente) return 'Origem não informada';
    if (remetente.startsWith('ps:')) return 'Processo Seletivo';
    if (remetente.startsWith('email-externo:') || remetente.startsWith('email-livre:')) return 'E-mail';
    return 'WhatsApp';
  }
  function renderAnalisesV2(analises, curriculoId) {
    const itens = [];
    for (const a of analises || []) {
      for (const r of (a.resultados || [])) {
        if (Number(r.id) === Number(curriculoId)) itens.push({ analise: a, resultado: r, finalista: (a.finalistas_ids || []).includes(r.id) });
      }
    }
    if (!itens.length) return '<span style="color:var(--text-lo);font-size:13px">Este currículo ainda não aparece em uma análise salva.</span>';
    return `<div class="score-list">${itens.map(({ analise, resultado, finalista }) => {
      const pos = (resultado.pontos_positivos || []).slice(0, 4).map(p => `<li>${escHV2(p)}</li>`).join('');
      const neg = (resultado.pontos_negativos || []).slice(0, 4).map(p => `<li>${escHV2(p)}</li>`).join('');
      const score = Number(resultado.score) || 0;
      return `
        <div class="score-item">
          <div class="score-head">
            <div>
              <div class="history-title">${escHV2(analise.funcao_nome || 'Análise')}</div>
              <div class="history-meta">${fmtDataV2(analise.data)}${finalista ? ' · Finalista' : ''}</div>
            </div>
            <div style="margin-left:auto;text-align:right">
              <div class="score-num">${score}</div>
              <div style="font-size:10.5px;color:var(--text-lo)">/ 100</div>
            </div>
          </div>
          <div class="score-bar-wrap"><div class="score-bar" style="width:${Math.max(0, Math.min(100, score))}%"></div></div>
          ${resultado.resumo ? `<div class="exp-desc">${escHV2(resultado.resumo)}</div>` : ''}
          ${(pos || neg) ? `<div class="analysis-points">
            ${pos ? `<div><div class="field-l" style="color:var(--success)">Pontos positivos</div><ul class="point-list good">${pos}</ul></div>` : ''}
            ${neg ? `<div><div class="field-l" style="color:var(--error)">Pontos a avaliar</div><ul class="point-list warn">${neg}</ul></div>` : ''}
          </div>` : ''}
        </div>`;
    }).join('')}</div>`;
  }
  function renderHistoricoV2(candidaturas, vagas) {
    if (!candidaturas.length) return '<span style="color:var(--text-lo);font-size:13px">Sem candidatura vinculada no Processo Seletivo.</span>';
    return `<div class="side-list">${candidaturas.map(cand => {
      const vaga = (vagas || []).find(v => Number(v.id) === Number(cand.vaga_id));
      const funcao = vaga?.funcao?.nome || `Vaga #${cand.vaga_id || '—'}`;
      return `<div class="history-item">
        <div class="history-title">${escHV2(funcao)}</div>
        <div class="history-meta">${escHV2(cand.canal || 'canal não informado')} · ${fmtDataV2(cand.criado_em || cand.data || cand.recebido_em)}</div>
      </div>`;
    }).join('')}</div>`;
  }
  async function carregarDetalheV2() {
    if (!id) return;
    if (window._iahubAuthReady) await window._iahubAuthReady;
    const [c, analisesRes, candidaturasRes, vagasRes] = await Promise.all([
      fetch(`/api/curriculos/${id}`).then(r => r.json()),
      fetch('/api/analises').then(r => r.json()).catch(() => []),
      fetch('/api/ps/candidaturas').then(r => r.json()).catch(() => []),
      fetch('/api/vagas').then(r => r.json()).catch(() => []),
    ]);
    const analises = Array.isArray(analisesRes) ? analisesRes : [];
    const candidaturas = (Array.isArray(candidaturasRes) ? candidaturasRes : []).filter(x => Number(x.curriculo_id) === Number(c.id));
    const vagas = Array.isArray(vagasRes) ? vagasRes : [];
    const analisesDoCurriculo = analises.filter(a => (a.resultados || []).some(r => Number(r.id) === Number(c.id)));
    const _empCur = window._iahubEmpresa || { id: '—', nome: '—' };
    document.getElementById('topbar-nome').textContent = c.nome || `Currículo #${c.id}`;
    document.getElementById('topbar-actions').innerHTML = '';
    if (c.pdf_base64) window._pdf = { data: c.pdf_base64, nome: c.pdf_nome || 'curriculo.pdf' };
    const exps = (c.experiencias || []).map(e => `
      <div class="exp-block">
        <div class="exp-emp">${escHV2(e.empresa || '—')}</div>
        <div class="exp-cargo">${escHV2(e.cargo || '')}</div>
        <div class="exp-per">${escHV2(e.periodo || '')}</div>
        ${e.descricao ? `<div class="exp-desc">${escHV2(e.descricao)}</div>` : ''}
        ${e.atividades?.length ? `<ul class="exp-list">${e.atividades.map(a => `<li>${escHV2(a)}</li>`).join('')}</ul>` : ''}
      </div>`).join('');
    const form = (c.formacao || []).map(f =>
      `<div class="field-v"><strong>${escHV2(f.instituicao || '—')}</strong> — ${escHV2(f.curso || '—')} <span style="color:var(--text-lo);font-size:12px">(${escHV2(f.periodo || '—')})</span></div>`
    ).join('');
    const caps = (c.capacitacoes || []).map(x => `<span class="badge badge-purple" style="margin:3px">${escHV2(typeof x === 'string' ? x : JSON.stringify(x))}</span>`).join('');
    const habs = (c.habilidades || []).map(h => `<span class="skill-tag">${escHV2(h)}</span>`).join('');
    document.getElementById('page-content').innerHTML = `
      <div class="editor-actionbar">
        <button type="button" class="btn btn-ghost" onclick="voltarCurriculo(event)">Cancelar</button>
        <div class="editor-actionbar-title">
          <strong>#${c.id} - ${escHV2(c.nome || 'Currículo')}</strong>
          <span>${canalV2(c.remetente)} · recebido em ${fmtDataV2(c.recebido_em)}</span>
        </div>
        <div class="editor-actions">
          ${c.pdf_base64 ? '<button class="btn btn-info" onclick="baixarPdf()">Baixar PDF</button>' : ''}
        </div>
      </div>
      <div class="identity-band">
        <div>
          <div class="candidate-name">${escHV2(c.nome || 'Candidato sem nome')}</div>
          <div class="candidate-meta">
            <span>ID #${c.id}</span>
            <span>${canalV2(c.remetente)}</span>
            ${c.email ? `<span>${escHV2(c.email)}</span>` : ''}
            ${c.telefone ? `<span>${escHV2(c.telefone)}</span>` : ''}
          </div>
        </div>
        <div class="summary-stats">
          ${statV2('Experiências', (c.experiencias || []).length)}
          ${statV2('Habilidades', (c.habilidades || []).length)}
          ${statV2('Análises', analisesDoCurriculo.length)}
        </div>
      </div>
      <div class="editor-grid editor-grid-wide">
        <div class="editor-main">
          <section class="form-section">
            <div class="form-section-header">
              <div class="form-section-title">Dados Principais</div>
              <div class="form-section-subtitle">Identificação, contatos e resumo profissional do candidato.</div>
            </div>
            <div class="form-section-body">
              <div class="info-grid">
                ${campoV2('Nome', c.nome)}
                ${campoV2('Telefone', c.telefone)}
                ${campoV2('E-mail', c.email, c.email ? `<a href="mailto:${escHV2(c.email)}">${escHV2(c.email)}</a>` : null)}
                ${campoV2('Endereço', c.endereco)}
                ${campoV2('LinkedIn / Portfolio', c.linkedin, c.linkedin ? `<a href="${escHV2(c.linkedin)}" target="_blank">${escHV2(c.linkedin)}</a>` : null)}
                ${campoV2('Remetente', c.remetente)}
              </div>
              ${c.descricao ? `<div style="margin-top:8px;padding-top:14px;border-top:1px solid var(--border);color:var(--text-md);line-height:1.75;font-size:13.5px">${escHV2(c.descricao)}</div>` : ''}
            </div>
          </section>
          <section class="form-section">
            <div class="form-section-header">
              <div class="form-section-title">Análise</div>
              <div class="form-section-subtitle">Histórico de aderência deste currículo nas análises salvas.</div>
            </div>
            <div class="form-section-body">${renderAnalisesV2(analises, c.id)}</div>
          </section>
          ${c.experiencias?.length ? `<section class="form-section"><div class="form-section-header"><div class="form-section-title">Experiência Profissional</div></div><div class="form-section-body">${exps}</div></section>` : ''}
          ${habs ? `<section class="form-section"><div class="form-section-header"><div class="form-section-title">Habilidades e Competências</div></div><div class="form-section-body" style="line-height:2">${habs}</div></section>` : ''}
        </div>
        <aside class="editor-side">
          <section class="form-section">
            <div class="form-section-header"><div class="form-section-title">Anexos</div></div>
            <div class="form-section-body">
              ${c.pdf_base64 ? `<div class="history-item"><div class="history-title">${escHV2(c.pdf_nome || 'curriculo.pdf')}</div><div class="history-meta">PDF original recebido</div><button class="btn btn-info w-100" style="margin-top:10px" onclick="baixarPdf()">Baixar PDF</button></div>` : '<span style="color:var(--text-lo);font-size:13px">Nenhum PDF anexado.</span>'}
            </div>
          </section>
          <section class="form-section">
            <div class="form-section-header"><div class="form-section-title">Histórico</div></div>
            <div class="form-section-body">
              <div class="history-item" style="margin-bottom:12px">
                <div class="history-title">Recebimento do currículo</div>
                <div class="history-meta">${fmtDataV2(c.recebido_em)} · ${canalV2(c.remetente)}</div>
              </div>
              ${renderHistoricoV2(candidaturas, vagas)}
            </div>
          </section>
          <section class="form-section">
            <div class="form-section-header"><div class="form-section-title">Dados do Registro</div></div>
            <div class="form-section-body">
              <div class="side-list">
                ${campoV2('ID do Registro', c.id)}
                ${campoV2('ID da Empresa', _empCur.id)}
                ${campoV2('Empresa', _empCur.nome)}
              </div>
            </div>
          </section>
          ${(c.formacao?.length || c.capacitacoes?.length) ? `<section class="form-section"><div class="form-section-header"><div class="form-section-title">Formação</div></div><div class="form-section-body">${form}${caps ? `<div style="line-height:2">${caps}</div>` : ''}</div></section>` : ''}
        </aside>
      </div>`;
  }
  carregarDetalheV2();
</script>
</body>
</html>
</file>

<file path="modules/whatsapp-curriculo/frontend/dashboard.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — IAHub</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    /* stat cards compactos */
    .stat-card { padding:14px 16px !important; }
    .stat-label { font-size:11px !important; }
    .stat-value { font-size:26px !important; }
    /* grid de vagas */
    .vagas-grid-db { display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px; }
    .vagas-grid-db .vaga-card     { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:14px;transition:border-color .2s; }
    .vagas-grid-db .vaga-card:hover { border-color:var(--accent); }
    .vagas-grid-db .vaga-funcao   { font-size:13px;font-weight:700;color:var(--text-hi);margin-bottom:4px; }
    .vagas-grid-db .vaga-meta     { font-size:11px;color:var(--text-lo);margin-bottom:10px; }
    .vagas-grid-db .vaga-count    { font-size:26px;font-weight:800;color:var(--accent-light);line-height:1; }
    .vagas-grid-db .vaga-count-label { font-size:11px;color:var(--text-lo);margin-top:2px; }
    .vagas-grid-db .vaga-status   { display:inline-flex;align-items:center;gap:5px;font-size:11px;margin-top:8px; }
    .vagas-grid-db .dot           { width:7px;height:7px;border-radius:50%;display:inline-block; }
    .vagas-grid-db .dot-aberta    { background:var(--success); }
    .vagas-grid-db .vaga-actions  { display:flex;gap:6px;margin-top:12px;padding-top:10px;border-top:1px solid var(--border); }
    .vagas-grid-db .nivel-badge   { padding:2px 7px;border-radius:20px;font-size:10px;font-weight:600; }
    .vagas-grid-db .nivel-junior  { background:#0c2744;color:var(--accent-light); }
    .vagas-grid-db .nivel-pleno   { background:#14532d;color:var(--success); }
    .vagas-grid-db .nivel-senior  { background:#2d1e00;color:var(--warning); }
    .vagas-grid-db .nivel-especialista { background:#1e0c3a;color:#a78bfa; }
    .vagas-grid-db .nivel-nao-especificado { background:var(--bg-hover);color:var(--text-lo); }
    .ia-card-header { display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap; }
    .ia-title { font-size:14px;font-weight:700;color:var(--text-hi);display:flex;align-items:center;gap:8px; }
    .ia-actions { display:flex;align-items:center;gap:8px;flex-wrap:wrap; }
    .ia-refresh-btn { background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;border:none;box-shadow:0 6px 16px var(--accent-glow); }
    .ia-refresh-btn:hover { filter:brightness(.96);transform:translateY(-1px); }
    .ia-refresh-btn.loading { opacity:.75;pointer-events:none; }
    .ia-provider-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:16px; }
    .ia-provider { border:1px solid var(--border);border-radius:8px;padding:14px;background:var(--bg-sidebar); }
    .ia-provider-top { display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px; }
    .ia-provider-name { font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--text-md); }
    .ia-provider-value { font-size:28px;font-weight:800;color:var(--text-hi);line-height:1.05; }
    .ia-provider-sub { font-size:11.5px;color:var(--text-lo);margin-top:4px; }
    .ia-meter { height:8px;border-radius:999px;background:var(--bg-hover);overflow:hidden;margin:12px 0; }
    .ia-meter-fill { height:100%;background:linear-gradient(90deg,var(--success),var(--accent));width:0%;transition:width .25s ease; }
    .ia-metrics { display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid var(--border);padding-top:10px;margin-top:10px; }
    .ia-metric-label { font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo); }
    .ia-metric-value { font-size:13px;font-weight:700;color:var(--text-hi); }
    .ia-footer { display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:10px;font-size:11.5px;color:var(--text-lo); }
    @media (max-width: 900px) {
      .ia-provider-grid { grid-template-columns:1fr; }
      .ia-metrics { grid-template-columns:1fr 1fr; }
    }
  </style>
</head>
<body>
<div class="layout">
      <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IAHub</span>
    </div>
    <div class="sidebar-nav">
    </div>
    <div class="sidebar-footer">
    </div>
    </nav>
  <div class="main">
    <div class="topbar">
      <span class="topbar-title"><span class="topbar-path">Monitoramento ›</span> Dashboard</span>
      <span class="ms-auto text-muted text-sm" id="topbar-date"></span>
    </div>
    <div class="page-content">
      <div class="grid-3 mb-3">
        <div class="stat-card">
          <div class="stat-label">💬 WhatsApp — Hoje</div>
          <div class="stat-value stat-accent" id="stat-wa-hoje">—</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">💬 WhatsApp — Total</div>
          <div class="stat-value" id="stat-wa-total">—</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">💬 Serviço WhatsApp</div>
          <div style="margin-top:8px" id="stat-status"><span class="status-pill pill-stopped">Parado</span></div>
          <a href="/monitor.html#whatsapp" style="font-size:11px;color:var(--accent);text-decoration:none;margin-top:6px;display:inline-block">Ver Monitor →</a>
        </div>
      </div>
      <div class="grid-3 mb-4">
        <div class="stat-card">
          <div class="stat-label">📧 E-mail — Hoje</div>
          <div class="stat-value stat-accent" id="stat-email-hoje">—</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">📧 E-mail — Total</div>
          <div class="stat-value" id="stat-email-total">—</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">📧 Serviço E-mail</div>
          <div style="margin-top:8px" id="stat-email-status"><span class="status-pill pill-stopped">Parado</span></div>
          <a href="/monitor.html#email" style="font-size:11px;color:var(--accent);text-decoration:none;margin-top:6px;display:inline-block">Ver Monitor →</a>
        </div>
      </div>
      <div class="card mb-4">
        <div class="card-body">
          <div class="ia-card-header">
            <div>
              <div class="ia-title">⚡ Creditos IA</div>
              <div class="text-muted text-sm" id="ia-last-update">—</div>
            </div>
            <div class="ia-actions">
              <button class="btn ia-refresh-btn" id="ia-refresh-btn" title="Atualizar agora">⟳ Atualizar</button>
            </div>
          </div>
          <div class="ia-provider-grid">
            <div class="ia-provider" id="ia-groq-card">
              <div class="ia-provider-top">
                <span class="ia-provider-name">Groq</span>
                <span class="status-pill pill-stopped" id="ia-groq-status">Nao configurado</span>
              </div>
              <div class="ia-provider-value" id="ia-groq-available">—</div>
              <div class="ia-provider-sub" id="ia-groq-sub">—</div>
              <div class="ia-meter"><div class="ia-meter-fill" id="ia-groq-meter"></div></div>
              <div class="ia-metrics">
                <div><div class="ia-metric-label">Gasto</div><div class="ia-metric-value" id="ia-groq-cost">—</div></div>
                <div><div class="ia-metric-label">Chamadas</div><div class="ia-metric-value" id="ia-groq-calls">—</div></div>
                <div><div class="ia-metric-label">Tokens</div><div class="ia-metric-value" id="ia-groq-tokens">—</div></div>
              </div>
            </div>
            <div class="ia-provider" id="ia-gemini-card">
              <div class="ia-provider-top">
                <span class="ia-provider-name">Gemini</span>
                <span class="status-pill pill-stopped" id="ia-gemini-status">Nao configurado</span>
              </div>
              <div class="ia-provider-value" id="ia-gemini-available">—</div>
              <div class="ia-provider-sub" id="ia-gemini-sub">—</div>
              <div class="ia-meter"><div class="ia-meter-fill" id="ia-gemini-meter"></div></div>
              <div class="ia-metrics">
                <div><div class="ia-metric-label">Gasto</div><div class="ia-metric-value" id="ia-gemini-cost">—</div></div>
                <div><div class="ia-metric-label">Chamadas</div><div class="ia-metric-value" id="ia-gemini-calls">—</div></div>
                <div><div class="ia-metric-label">Tokens</div><div class="ia-metric-value" id="ia-gemini-tokens">—</div></div>
              </div>
            </div>
          </div>
          <div class="ia-footer">
            <span id="ia-pricing-note">—</span>
            <span>Limites e auto refresh em Configurador > Configuracoes > Chaves de API.</span>
          </div>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
        <span style="font-size:14px;font-weight:600;color:var(--text-hi)">💼 Vagas em Aberto</span>
        <a href="/vagas.html" style="font-size:12px;color:var(--accent);text-decoration:none">Ver todas →</a>
      </div>
      <div id="dashboard-vagas-grid" class="vagas-grid-db"></div>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/js/sidebar.js"></script>
<script>
  document.getElementById('topbar-date').textContent =
    new Date().toLocaleDateString('pt-BR', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
  const waStatusMap = {
    stopped:   ['pill-stopped',   'Parado'],
    starting:  ['pill-starting',  'Iniciando…'],
    connected: ['pill-connected', 'Conectado'],
  };
  const emailStatusMap = {
    stopped: ['pill-stopped',   'Parado'],
    running: ['pill-connected', 'Rodando'],
  };
  let iaAutoRefreshTimer = null;
  const money = v => v === null || v === undefined
    ? '—'
    : Number(v).toLocaleString('en-US', { style:'currency', currency:'USD', minimumFractionDigits:2, maximumFractionDigits:4 });
  const compact = v => Number(v || 0).toLocaleString('pt-BR');
  async function carregar() {
    const [stats, emailSvc] = await Promise.all([
      fetch('/api/stats').then(r => r.json()),
      fetch('/api/email-service/status').then(r => r.json()).catch(() => ({ status: 'stopped' })),
    ]);
    document.getElementById('stat-wa-hoje').textContent  = stats.wa?.hoje  ?? '—';
    document.getElementById('stat-wa-total').textContent = stats.wa?.total ?? '—';
    document.getElementById('stat-email-hoje').textContent  = stats.email?.hoje  ?? '—';
    document.getElementById('stat-email-total').textContent = stats.email?.total ?? '—';
    const [cls, label] = waStatusMap[stats.status] || waStatusMap.stopped;
    document.getElementById('stat-status').innerHTML =
      `<span class="status-pill ${cls}">${label}</span>`;
    const [eCls, eLabel] = emailStatusMap[emailSvc.status] || emailStatusMap.stopped;
    document.getElementById('stat-email-status').innerHTML =
      `<span class="status-pill ${eCls}">${eLabel}</span>`;
  }
  function renderIaProvider(provider, data, configured) {
    const status = document.getElementById(`ia-${provider}-status`);
    status.className = `status-pill ${configured ? 'pill-connected' : 'pill-stopped'}`;
    status.textContent = configured ? 'Configurado' : 'Nao configurado';
    const hasTokenLimit = Number(data.limit_tokens) > 0;
    const hasMoneyLimit = Number(data.limit_usd) > 0;
    document.getElementById(`ia-${provider}-available`).textContent = hasTokenLimit ? compact(data.available_tokens) : 'Sem limite';
    document.getElementById(`ia-${provider}-sub`).textContent = hasTokenLimit
      ? `tokens disponiveis de ${compact(data.limit_tokens)} no mes`
      : 'Defina um limite mensal de tokens para ver saldo estimado';
    document.getElementById(`ia-${provider}-cost`).textContent = money(data.estimated_cost_usd);
    document.getElementById(`ia-${provider}-calls`).textContent = compact(data.calls);
    document.getElementById(`ia-${provider}-tokens`).textContent = `${compact(data.total_tokens)} usados`;
    const pct = hasTokenLimit
      ? Math.min(100, (Number(data.total_tokens) / Number(data.limit_tokens)) * 100)
      : hasMoneyLimit
        ? Math.min(100, (Number(data.estimated_cost_usd) / Number(data.limit_usd)) * 100)
        : 0;
    document.getElementById(`ia-${provider}-meter`).style.width = `${pct}%`;
  }
  function configurarAutoRefresh(minutos) {
    if (iaAutoRefreshTimer) clearInterval(iaAutoRefreshTimer);
    const mins = Number(minutos) || 0;
    if (mins > 0) {
      iaAutoRefreshTimer = setInterval(carregarTudo, mins * 60 * 1000);
    }
  }
  async function carregarIaDashboard() {
    const btn = document.getElementById('ia-refresh-btn');
    btn.classList.add('loading');
    btn.textContent = '⟳ Atualizando';
    try {
      const data = await fetch('/api/ia/dashboard').then(r => r.json());
      renderIaProvider('groq', data.providers.groq, data.configured.groq);
      renderIaProvider('gemini', data.providers.gemini, data.configured.gemini);
      document.getElementById('ia-pricing-note').textContent = data.pricing_note || '';
      document.getElementById('ia-last-update').textContent =
        `Atualizado em ${new Date(data.generated_at).toLocaleString('pt-BR')}`;
      configurarAutoRefresh(data.auto_refresh_min);
    } catch (err) {
      document.getElementById('ia-last-update').textContent = 'Falha ao atualizar dados de IA.';
    } finally {
      btn.classList.remove('loading');
      btn.textContent = '⟳ Atualizar';
    }
  }
  async function carregarTudo() {
    await Promise.all([carregar(), carregarIaDashboard()]);
  }
  fetch('/api/me').then(r => r.json()).then(d => {
    document.getElementById('sidebar-user').textContent = d.user || 'Admin';
  });
  const NIVEIS_DB = {
    'Júnior': 'nivel-junior', 'Pleno': 'nivel-pleno',
    'Sênior': 'nivel-senior', 'Especialista': 'nivel-especialista',
    'Não especificado': 'nivel-nao-especificado',
  };
  async function carregarVagas() {
    const grid = document.getElementById('dashboard-vagas-grid');
    try {
      const vagas = await fetch('/api/vagas').then(r => r.json());
      const abertas = vagas.filter(v => v.status === 'aberta');
      if (!abertas.length) {
        grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-lo);font-style:italic">Nenhuma vaga em aberto no momento.</div>';
        return;
      }
      grid.className = 'vagas-grid-db';
      grid.innerHTML = abertas.map(v => {
        const f = v.funcao || {};
        const nivelCls = NIVEIS_DB[f.nivel_experiencia] || 'nivel-nao-especificado';
        return `
        <div class="vaga-card">
          <div style="display:flex;gap:8px;margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid var(--border);flex-wrap:wrap">
            <span style="font-size:11px;color:var(--text-lo);font-family:monospace">ID: <strong>${v.id}</strong></span>
            <span style="font-size:11px;color:var(--text-lo);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${(window._iahubEmpresa?.nome) || ''}</span>
          </div>
          <div class="vaga-funcao">${f.nome || '—'}</div>
          <div class="vaga-meta">
            ${f.area ? `<span>${f.area}</span>` : ''}
            ${f.nivel_experiencia ? `&nbsp;·&nbsp;<span class="nivel-badge ${nivelCls}">${f.nivel_experiencia}</span>` : ''}
          </div>
          <div class="vaga-count">${v.quantidade}</div>
          <div class="vaga-count-label">vaga${v.quantidade !== 1 ? 's' : ''} disponível${v.quantidade !== 1 ? 'eis' : ''}</div>
          <div class="vaga-status">
            <span class="dot dot-aberta"></span>
            <span style="color:var(--text-md)">Aberta</span>
          </div>
          ${v.observacoes ? `<div style="margin-top:10px;font-size:12.5px;color:var(--text-lo);line-height:1.6">${v.observacoes}</div>` : ''}
          <div class="vaga-actions">
            <a href="/analisador.html?vaga_id=${v.id}" class="btn btn-info" style="font-size:12px;flex:1;text-align:center">🔍 Analisar</a>
            <a href="/vagas.html" class="btn btn-ghost" style="font-size:12px">✏️ Editar</a>
          </div>
        </div>`;
      }).join('');
    } catch (err) {
      grid.innerHTML = '<div style="grid-column:1/-1;color:var(--error);font-size:13px">Falha ao carregar vagas.</div>';
    }
  }
  document.getElementById('ia-refresh-btn').addEventListener('click', carregarTudo);
  carregarTudo();
  (async () => { await window._iahubAuthReady; carregarVagas(); })();
  // Atualiza status quando qualquer monitor iniciar/parar um serviço
  let _bc = null;
  try {
    _bc = new BroadcastChannel('iahub_monitors');
    _bc.onmessage = (e) => { if (e.data?.type === 'status-changed') carregar(); };
  } catch(_) {}
  setInterval(carregar, 30000);
</script>
</body>
</html>
</file>

<file path="modules/whatsapp-curriculo/frontend/monitor.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Monitor WhatsApp — IAHub</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    /* ── Abas ─────────────────────────────────────────────────────────────── */
    .tabs {
      display: flex;
      gap: 0;
      border-bottom: 2px solid var(--border);
      margin-bottom: 16px;
    }
    .tab-btn {
      padding: 9px 20px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-md);
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 7px;
      transition: color .15s;
    }
    .tab-btn:hover { color: var(--text-hi); }
    .tab-btn.active {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }
    .tab-badge {
      font-size: 10.5px;
      font-weight: 600;
      padding: 1px 6px;
      border-radius: 10px;
      background: var(--bg-hover);
      color: var(--text-lo);
    }
    .tab-badge.badge-running {
      background: rgba(22,163,74,.12);
      color: var(--success);
    }
    /* ── Painel de cada aba ───────────────────────────────────────────────── */
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    /* ── Monitor (igual ao original) ─────────────────────────────────────── */
    .monitor-wrap { display:flex; gap:14px; height:calc(100vh - 218px); }
    .terminal     { flex:1; min-width:0; height:100%; }
    .toolbar      { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    /* ── Painel QR lateral ────────────────────────────────────────────────── */
    .qr-panel {
      width: 268px; min-width: 268px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      padding: 20px 16px;
      display: flex; flex-direction: column; align-items: center; gap: 12px;
      text-align: center;
      overflow-y: auto;
      transition: var(--transition);
    }
    .qr-panel-title {
      font-weight: 600; font-size: 14px; color: var(--text-hi);
      border-bottom: 1px solid var(--border); width: 100%; padding-bottom: 10px;
    }
    .qr-panel img {
      width: 220px; height: 220px;
      border-radius: 8px;
      border: 3px solid var(--accent-glow);
    }
    .qr-panel p { font-size: 11.5px; color: var(--text-md); line-height: 1.6; }
    .qr-pulse { animation: qr-glow 1.8s ease-in-out infinite; }
    @keyframes qr-glow {
      0%,100% { box-shadow: 0 0 0 0 rgba(37,99,235,.25); }
      50%      { box-shadow: 0 0 0 10px rgba(37,99,235,0); }
    }
    .qr-connected {
      background: rgba(22,163,74,.07); border:1px solid rgba(22,163,74,.25);
      border-radius: 8px; padding: 12px 14px;
      color: var(--success); font-weight: 600; font-size: 13px; width: 100%;
    }
    .qr-waiting {
      background: rgba(37,99,235,.06); border:1px solid rgba(37,99,235,.2);
      border-radius: 8px; padding: 10px 12px;
      color: var(--accent); font-size: 12px; width: 100%;
    }
    /* ── Modal Ajuda ─────────────────────────────────────────────────────────── */
    .modal-ajuda-overlay { position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:300;display:flex;align-items:center;justify-content:center; }
    .modal-ajuda { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);width:min(820px,96vw);max-height:93vh;overflow-y:auto;padding:32px;position:relative; }
    .btn-ajuda-topbar { display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#fff;border:none;border-radius:8px;padding:8px 18px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:background .15s;white-space:nowrap;box-shadow:0 2px 8px rgba(37,99,235,.25); }
    .btn-ajuda-topbar:hover { background:#1d4ed8; }
    .ajuda-titulo { font-size:16px;font-weight:700;color:var(--text-hi);margin-bottom:20px; }
    .ajuda-etapa  { margin-bottom:20px; }
    .ajuda-etapa-titulo { font-size:13px;font-weight:700;color:var(--accent);margin-bottom:6px; }
    .ajuda-etapa p { font-size:13px;color:var(--text-md);line-height:1.75;margin:0 0 8px; }
    .ajuda-tabs { display:flex;gap:4px;border-bottom:1px solid var(--border);margin-bottom:20px; }
    .ajuda-tab  { background:none;border:none;border-bottom:2px solid transparent;padding:8px 16px;font-size:13px;font-weight:600;color:var(--text-lo);cursor:pointer;font-family:inherit;transition:color .15s,border-color .15s;margin-bottom:-1px; }
    .ajuda-tab:hover { color:var(--text-hi); }
    .ajuda-tab.active { color:var(--accent);border-bottom-color:var(--accent); }
    .ajuda-tab-content { display:none; }
    .ajuda-tab-content.active { display:block; }
    .ia-card { border:1px solid var(--border);border-radius:10px;padding:16px 18px;margin-bottom:14px; }
    .ia-card-header { display:flex;align-items:center;gap:10px;margin-bottom:10px; }
    .ia-card-icon { font-size:22px; }
    .ia-card-title { font-size:14px;font-weight:700;color:var(--text-hi); }
    .ia-card p { font-size:12.5px;color:var(--text-md);line-height:1.75;margin:0 0 8px; }
    .ia-card p:last-child { margin:0; }
    .ia-link { display:inline-block;font-size:12px;color:var(--accent);margin-top:6px; }
    .fluxo-step { display:flex;align-items:flex-start;gap:12px;margin-bottom:14px; }
    .fluxo-num  { background:var(--accent);color:#fff;border-radius:50%;width:24px;height:24px;min-width:24px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;margin-top:1px; }
    .fluxo-body strong { font-size:13px;color:var(--text-hi); }
    .fluxo-body p { font-size:12.5px;color:var(--text-md);line-height:1.7;margin:2px 0 0; }
    .aviso-card { background:rgba(234,179,8,.07);border:1px solid rgba(234,179,8,.3);border-radius:8px;padding:12px 14px;font-size:12.5px;color:var(--text-md);line-height:1.7; }
    .aviso-card strong { color:#a16207; }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IAHub</span>
    </div>
    <div class="sidebar-nav">
    </div>
    <div class="sidebar-footer">
    </div>
    </nav>
  <div class="main">
    <div class="topbar">
      <span class="topbar-title"><span class="topbar-path">Monitores ›</span> Monitor WhatsApp</span>
    </div>
    <div class="page-content">
        <div id="meta-mode-banner" class="d-none mb-3"
          style="background:rgba(37,99,235,.07);border:1px solid rgba(37,99,235,.25);border-radius:8px;padding:10px 14px;font-size:12.5px;color:var(--text-md);display:flex;align-items:center;gap:10px">
          <span style="font-size:18px">🟢</span>
          <span><strong style="color:var(--accent)">Modo API Oficial Meta</strong> — mensagens são recebidas via webhook. Não é necessário escanear QR Code.
          <a href="/config.html" style="color:var(--accent);margin-left:6px">Alterar configuração →</a></span>
        </div>
        <div class="d-flex gap-3 mb-3" style="align-items:center;flex-wrap:wrap">
          <span id="status-pill" class="status-pill pill-stopped">Parado</span>
          <span id="log-count" class="text-muted text-sm"></span>
          <div class="toolbar ms-auto">
            <button id="btn-start" class="btn btn-success" onclick="startService()">▶ Iniciar Serviço</button>
            <button id="btn-stop"  class="btn btn-danger d-none" onclick="stopService()">■ Parar Serviço</button>
            <button id="btn-qr"   class="btn btn-primary" onclick="toggleQrPanel()" title="Mostrar/ocultar painel QR Code">📱 QR Code</button>
            <button class="btn btn-info"  onclick="saveLog()">💾 Salvar Log</button>
            <button class="btn btn-ghost" onclick="clearLog()">🗑 Limpar</button>
            <button class="btn-ajuda-topbar" onclick="document.getElementById('modal-ajuda-wa').classList.remove('d-none')">
              ❓ Ajuda · Como funciona
            </button>
          </div>
        </div>
        <div class="monitor-wrap">
          <div id="terminal" class="terminal"></div>
          <div id="qr-panel" class="qr-panel" style="display:none">
            <div class="qr-panel-title" style="display:flex;align-items:center;justify-content:space-between">
              <span>📱 Conectar WhatsApp</span>
              <button onclick="fecharQrPanel()" title="Fechar painel"
                style="background:none;border:none;cursor:pointer;font-size:18px;line-height:1;color:var(--text-lo);padding:0 2px"
                onmouseover="this.style.color='var(--text-hi)'" onmouseout="this.style.color='var(--text-lo)'">×</button>
            </div>
            <div id="qr-connected" class="qr-connected d-none">
              ✅ WhatsApp conectado!<br>
              <span style="font-weight:400;font-size:12px">Número ativo e recebendo currículos.</span>
            </div>
            <div id="qr-waiting" class="qr-waiting d-none">
              ⏳ Iniciando serviço…<br>aguardando QR Code.
            </div>
            <img id="qr-img" src="" alt="QR Code" class="d-none qr-pulse">
            <p id="qr-hint" class="d-none">
              No celular: <strong>WhatsApp → Menu → Dispositivos conectados → Conectar dispositivo</strong>
            </p>
            <p style="font-size:11px;color:var(--text-lo);line-height:1.5;width:100%">
              O QR conecta o celular que o escanear. Para trocar de número, use <strong>Trocar número</strong> abaixo.
            </p>
            <div id="qr-actions" style="width:100%;display:flex;flex-direction:column;gap:8px">
              <button id="btn-qr-start" class="btn btn-success" onclick="startService()" style="width:100%">
                ▶ Iniciar para gerar QR
              </button>
              <button id="btn-qr-restart" class="btn btn-warning d-none" onclick="trocarNumero()" style="width:100%;font-size:12px">
                🔄 Trocar número (novo QR)
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div id="modal-ajuda-wa" class="modal-ajuda-overlay d-none" onclick="if(event.target===this)this.classList.add('d-none')">
  <div class="modal-ajuda">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
      <div class="ajuda-titulo" style="margin:0">📱 WhatsApp para Currículos — Ajuda</div>
      <button onclick="document.getElementById('modal-ajuda-wa').classList.add('d-none')" style="background:none;border:none;color:var(--text-lo);font-size:22px;cursor:pointer;line-height:1">✕</button>
    </div>
    <div class="ajuda-tabs">
      <button class="ajuda-tab active" id="tab-btn-wa-fluxo"       onclick="switchWaTab('wa-fluxo')">🔄 Como funciona</button>
      <button class="ajuda-tab"        id="tab-btn-wa-tecnologia"   onclick="switchWaTab('wa-tecnologia')">⚙ Tecnologia</button>
      <button class="ajuda-tab"        id="tab-btn-wa-ia"           onclick="switchWaTab('wa-ia')">🤖 IA utilizada</button>
    </div>
    <div id="tab-wa-fluxo" class="ajuda-tab-content active">
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">📨 O que acontece quando um candidato envia o currículo?</div>
        <p>O candidato envia um arquivo PDF pelo WhatsApp para o número configurado. O sistema processa automaticamente em 5 etapas:</p>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">1</div>
        <div class="fluxo-body">
          <strong>Recebimento e validação do arquivo</strong>
          <p>O sistema verifica se a mensagem contém um arquivo do tipo <em>documento</em>. Outros tipos (imagem, áudio, texto) são ignorados. Se o arquivo não for PDF, o candidato recebe uma mensagem orientando a enviar em formato correto.</p>
        </div>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">2</div>
        <div class="fluxo-body">
          <strong>Extração do texto do PDF</strong>
          <p>O conteúdo textual é extraído do PDF. Se o arquivo estiver protegido ou for uma imagem escaneada sem texto legível, o candidato é notificado e o processo é encerrado para aquele envio.</p>
        </div>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">3</div>
        <div class="fluxo-body">
          <strong>Detecção de idioma e tradução</strong>
          <p>A IA identifica o idioma do currículo. Caso não esteja em português, o texto é automaticamente traduzido antes de prosseguir, garantindo que a análise funcione corretamente.</p>
        </div>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">4</div>
        <div class="fluxo-body">
          <strong>Verificação se é um currículo</strong>
          <p>A IA verifica se o documento enviado é de fato um currículo. Documentos que não forem identificados como currículo (contratos, comprovantes, etc.) são rejeitados e o candidato recebe uma mensagem explicativa.</p>
        </div>
      </div>
      <div class="fluxo-step">
        <div class="fluxo-num">5</div>
        <div class="fluxo-body">
          <strong>Análise, salvamento e notificação</strong>
          <p>O currículo é analisado pela IA, os dados são extraídos (nome, e-mail, telefone, experiências, formação) e salvos no banco. O candidato recebe uma confirmação de recebimento e, se houver um número de destino configurado, o resumo do currículo é enviado para esse número.</p>
        </div>
      </div>
      <div class="ajuda-etapa" style="margin-bottom:0">
        <div class="ajuda-etapa-titulo">⚠️ Tratamento de duplicatas</div>
        <p>Antes de salvar, o sistema verifica se já existe um currículo com o mesmo e-mail ou telefone. Se houver, o candidato recebe uma mensagem perguntando se deseja <strong>atualizar</strong> o registro existente. Ele responde <em>SIM</em> (substitui) ou <em>NÃO</em> (mantém o anterior). O candidato tem até o próximo reinício do serviço para responder.</p>
      </div>
    </div>
    <div id="tab-wa-tecnologia" class="ajuda-tab-content">
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">📦 Biblioteca utilizada: whatsapp-web.js</div>
        <p>O sistema utiliza a biblioteca open source <strong>whatsapp-web.js</strong> — uma solução <strong>totalmente gratuita</strong>, sem custos de API. Ela funciona automatizando o <strong>WhatsApp Web</strong> em um navegador Chrome rodando em segundo plano no servidor.</p>
        <p>A autenticação é feita via <strong>QR Code</strong>: basta escanear com o celular que terá o número ativo, exatamente como quando você acessa o WhatsApp Web normalmente.</p>
      </div>
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">📱 Como conectar o número</div>
        <p>1. Clique em <strong>▶ Iniciar Serviço</strong> — o Chrome sobe em segundo plano.<br>
           2. Clique em <strong>📱 QR Code</strong> para abrir o painel lateral.<br>
           3. No celular: <strong>WhatsApp → Menu (⋮) → Dispositivos conectados → Conectar dispositivo</strong>.<br>
           4. Aponte a câmera para o QR Code exibido na tela.<br>
           5. Após escanear, o status muda para <em>Conectado</em> e o número passa a receber currículos.</p>
      </div>
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">💾 Sessão persistente</div>
        <p>Após o primeiro escaneamento do QR Code, a sessão é salva automaticamente. Nas próximas vezes que o serviço for iniciado, ele reconecta sem precisar escanear novamente — desde que o número não tenha sido desconectado pelo celular. Para trocar o número, use o botão <strong>🔄 Trocar número</strong> no painel QR.</p>
      </div>
      <div class="aviso-card">
        <strong>⚠️ Importante:</strong> O whatsapp-web.js é uma solução <strong>não oficial</strong> da Meta. O WhatsApp pode limitar ou bloquear números que enviam/recebem mensagens automatizadas em alto volume. Para uso comercial intenso, use a <strong>API Oficial do WhatsApp Business (Meta)</strong> — configurável em <a href="/config.html" style="color:var(--accent)">Configuração → API Oficial Meta</a>.
      </div>
      <div class="ajuda-etapa" style="margin-top:18px;margin-bottom:0">
        <div class="ajuda-etapa-titulo">🟢 API Oficial Meta (alternativa paga)</div>
        <p>Quando ativada em <a href="/config.html" style="color:var(--accent)">Configuração</a>, o sistema usa a <strong>Cloud API da Meta</strong> em vez do whatsapp-web.js. Neste modo:</p>
        <p>• <strong>Sem QR Code</strong> — a autenticação é via token permanente gerado no Meta Developer Console.<br>
           • <strong>Sem risco de bloqueio</strong> — é a API oficial, suportada pela Meta.<br>
           • <strong>Webhook</strong> — a Meta envia mensagens para a URL <code style="color:var(--accent)">/api/whatsapp/webhook/meta</code> do seu servidor. O servidor precisa ter um endereço público (HTTPS) acessível pela Meta.<br>
           • <strong>Custo</strong> — a Meta cobra por conversa iniciada (modelo de pricing em conversas de 24h). Verifique os preços em <a href="https://developers.facebook.com/docs/whatsapp/pricing" target="_blank" style="color:var(--accent)">developers.facebook.com/docs/whatsapp/pricing</a>.</p>
      </div>
    </div>
    <div id="tab-wa-ia" class="ajuda-tab-content">
      <div class="ajuda-etapa">
        <div class="ajuda-etapa-titulo">🔄 Estratégia: Groq como primário, Gemini como fallback</div>
        <p>O sistema tenta 3 vezes antes de desistir, sempre na ordem abaixo:</p>
      </div>
      <div class="ia-card">
        <div class="ia-card-header">
          <span class="ia-card-icon">⚡</span>
          <span class="ia-card-title">1ª e 2ª tentativas — Groq (Llama 3.3 70B / Llama 3.1 8B)</span>
        </div>
        <p>Motor principal. Cada currículo é enviado ao modelo <strong>Llama 3.3 70B Versatile</strong> via API Groq. Se falhar, uma segunda tentativa usa o modelo mais rápido <strong>Llama 3.1 8B Instant</strong>.</p>
        <p>A Groq oferece um <strong>plano gratuito</strong> generoso com limite de tokens por dia — suficiente para uso moderado sem custo algum.</p>
        <a class="ia-link" href="https://console.groq.com" target="_blank">🔗 console.groq.com — Criar conta / gerenciar créditos</a>
      </div>
      <div class="ia-card">
        <div class="ia-card-header">
          <span class="ia-card-icon">🌐</span>
          <span class="ia-card-title">3ª tentativa — Google Gemini (fallback automático)</span>
        </div>
        <p>Ativado automaticamente quando a Groq retorna erro de limite (429) ou quota excedida. O sistema reanalisa o currículo com Gemini sem nenhuma intervenção do operador.</p>
        <p>O modelo usado é configurável em <strong>Configurações → Chaves de API → Modelo Gemini</strong> (padrão: <em>gemini-1.5-flash</em>).</p>
      </div>
      <div class="ajuda-etapa" style="margin-bottom:0">
        <div class="ajuda-etapa-titulo">🛡️ Proteção contra falhas</div>
        <p>Se todas as 3 tentativas falharem, o currículo ainda é <strong>salvo no banco</strong> com os dados brutos extraídos do PDF, sem ser descartado. Nenhum candidato é perdido por problemas técnicos de IA.</p>
        <p>As chaves de API são configuradas em <strong>Configurações → Chaves de API</strong> e são armazenadas por empresa (cada empresa pode ter suas próprias chaves).</p>
      </div>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/js/sidebar.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  // Empresa explícita via ?empresa=ID (standalone) ou ?_empresa=ID (MDI shell)
  const _qs = new URLSearchParams(location.search);
  const _monitorEid = Number(_qs.get('empresa') || _qs.get('_empresa')) || null;
  function _apiUrl(path) {
    return _monitorEid ? `${path}?empresa_id=${_monitorEid}` : path;
  }
  function _apiFetchOpts(method, extra = {}) {
    const body = _monitorEid ? JSON.stringify({ empresa_id: _monitorEid, ...extra }) : (Object.keys(extra).length ? JSON.stringify(extra) : undefined);
    return { method, headers: body ? { 'Content-Type': 'application/json' } : undefined, body };
  }
  if (_monitorEid) {
    fetch('/api/empresas/minhas').then(r => r.json()).then(lista => {
      const emp = lista.find(e => e.id === _monitorEid);
      if (emp) document.title = `Monitor WhatsApp — ${emp.razao_social || emp.nome} — IAHub`;
    }).catch(() => {});
  }
  // ── Estado ────────────────────────────────────────────────────────────────────
  let waLines = [], waCount = 0, timerInterval = null, timerStart = null;
  let currentStatus = 'stopped';
  let currentProvider = 'webjs';
  let qrPanelOpen = false;
  let startedByQrPanel = false;
  const TAG = {
    info:     ['INFO',     'tag-info',    'msg-info'],
    success:  ['SUCESSO',  'tag-success', 'msg-success'],
    error:    ['ERRO',     'tag-error',   'msg-error'],
    warning:  ['AVISO',    'tag-warning', 'msg-warning'],
    received: ['RECEBIDO', 'tag-received','msg-received'],
    saved:    ['GRAVADO',  'tag-saved',   'msg-saved'],
  };
  function makeLogLine(e) {
    const [label, tagCls, msgCls] = TAG[e.type] || TAG.info;
    const d = document.createElement('div');
    d.className = 'log-line';
    d.innerHTML = `<span class="log-ts">${e.timestamp||''}</span><span class="log-tag ${tagCls}">${label}</span><span class="log-msg ${msgCls}">${e.message}</span>`;
    return d;
  }
  // ── WhatsApp terminal ─────────────────────────────────────────────────────────
  const terminal = document.getElementById('terminal');
  function addLine(e) {
    terminal.appendChild(makeLogLine(e));
    terminal.scrollTop = terminal.scrollHeight;
    waLines.push(`[${e.timestamp}] [${(TAG[e.type]||TAG.info)[0]}] ${e.message}`);
    document.getElementById('log-count').textContent = `${++waCount} linha${waCount!==1?'s':''}`;
  }
  // ── Salvar / Limpar ───────────────────────────────────────────────────────────
  function saveLog() {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([waLines.join('\n')], { type:'text/plain' }));
    a.download = `iahub_wa_log_${new Date().toISOString().slice(0,19).replace(/:/g,'-')}.txt`;
    a.click();
  }
  function clearLog() {
    terminal.innerHTML = '';
    waLines = []; waCount = 0;
    document.getElementById('log-count').textContent = '';
    fetch('/api/service/clear-log', _apiFetchOpts('POST')).catch(() => {});
  }
  // ── WhatsApp status ───────────────────────────────────────────────────────────
  const PILLS = {
    stopped:   ['pill-stopped',   'Parado'],
    starting:  ['pill-starting',  'Iniciando…'],
    connected: ['pill-connected', 'Conectado'],
  };
  function pararTimer() {
    if (timerInterval) { clearInterval(timerInterval); timerInterval = null; timerStart = null; }
    localStorage.removeItem('iahub_start_ts');
  }
  function atualizarQrPanel(status) {
    const img        = document.getElementById('qr-img');
    const waiting    = document.getElementById('qr-waiting');
    const connected  = document.getElementById('qr-connected');
    const hint       = document.getElementById('qr-hint');
    const btnStart   = document.getElementById('btn-qr-start');
    const btnRestart = document.getElementById('btn-qr-restart');
    waiting.classList.add('d-none');
    connected.classList.add('d-none');
    btnStart.classList.add('d-none');
    btnRestart.classList.add('d-none');
    if (status === 'connected') {
      img.classList.add('d-none'); hint.classList.add('d-none');
      connected.classList.remove('d-none'); btnRestart.classList.remove('d-none');
    } else if (status === 'starting') {
      if (!img.src || img.src === window.location.href) {
        waiting.classList.remove('d-none');
        img.classList.add('d-none'); hint.classList.add('d-none');
      } else {
        // QR já exibido: mostra opção de trocar número
        btnRestart.classList.remove('d-none');
      }
    } else {
      img.classList.add('d-none'); hint.classList.add('d-none');
      btnStart.classList.remove('d-none');
    }
  }
  function setProvider(provider) {
    currentProvider = provider || 'webjs';
    const isMeta = currentProvider === 'meta';
    // Banner modo Meta
    const banner = document.getElementById('meta-mode-banner');
    banner.style.display = isMeta ? 'flex' : 'none';
    banner.classList.toggle('d-none', !isMeta);
    // Oculta botão QR no modo Meta (não há QR para escanear)
    document.getElementById('btn-qr').classList.toggle('d-none', isMeta);
    if (isMeta && qrPanelOpen) fecharQrPanel();
  }
  function setStatus(payload) {
    const s = typeof payload === 'object' ? payload.status   : payload;
    const p = typeof payload === 'object' ? payload.provider : currentProvider;
    currentStatus = s;
    setProvider(p);
    const [cls, label] = PILLS[s] || PILLS.stopped;
    const pill = document.getElementById('status-pill');
    pill.className = `status-pill ${cls}`;
    pill.textContent = label;
    document.getElementById('btn-start').classList.toggle('d-none', s !== 'stopped');
    document.getElementById('btn-stop').classList.toggle('d-none',  s === 'stopped');
    if (s === 'connected' || s === 'stopped') startedByQrPanel = false;
    if (qrPanelOpen) atualizarQrPanel(s);
    if (s !== 'starting') { pararTimer(); pararPollQr(); return; }
    // Modo Meta não usa polling de QR
    if (currentProvider !== 'meta') iniciarPollQr();
    const saved = localStorage.getItem('iahub_start_ts');
    timerStart  = saved ? Number(saved) : Date.now();
    if (!saved) localStorage.setItem('iahub_start_ts', timerStart);
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      const seg = Math.floor((Date.now() - timerStart) / 1000);
      pill.textContent = `Iniciando… ${seg}s`;
    }, 1000);
  }
  // ── Exibição do QR ───────────────────────────────────────────────────────────
  function mostrarQr(url) {
    const img = document.getElementById('qr-img');
    img.src = url;
    img.classList.remove('d-none');
    document.getElementById('qr-hint').classList.remove('d-none');
    document.getElementById('qr-waiting').classList.add('d-none');
    document.getElementById('btn-qr-start').classList.add('d-none');
    document.getElementById('btn-qr-restart').classList.remove('d-none');
    if (!qrPanelOpen) abrirQrPanel();
  }
  // ── Polling de fallback para QR (caso o socket perca o evento) ───────────────
  let qrPollTimer = null;
  function iniciarPollQr() {
    pararPollQr();
    qrPollTimer = setInterval(async () => {
      if (currentStatus !== 'starting') { pararPollQr(); return; }
      try {
        const r = await fetch(_apiUrl('/api/service/qr'));
        const { qr } = await r.json();
        if (qr) { mostrarQr(qr); pararPollQr(); }
      } catch (_) {}
    }, 5000);
  }
  function pararPollQr() {
    if (qrPollTimer) { clearInterval(qrPollTimer); qrPollTimer = null; }
  }
  // ── Socket events ─────────────────────────────────────────────────────────────
  socket.on('connect', () => {
    terminal.innerHTML = '';
    waLines = []; waCount = 0;
    document.getElementById('log-count').textContent = '';
    if (_monitorEid) {
      // Empresa explícita: entra na sala imediatamente (permissão validada no servidor)
      socket.emit('join-empresa-monitor', { empresaId: _monitorEid });
    } else {
      window._iahubAuthReady?.then(() => socket.emit('join-empresa'));
    }
  });
  // Limpa terminal e status quando o servidor troca de empresa (MDI mode)
  socket.on('clear-monitor', () => {
    terminal.innerHTML = '';
    waLines = []; waCount = 0;
    document.getElementById('log-count').textContent = '';
    setStatus('stopped');
  });
  socket.on('log',          addLine);
  socket.on('status',       setStatus);
  // Carga inicial: busca status completo (com empresa_id) para exibir aviso imediatamente
  fetch(_apiUrl('/api/service/status')).then(r => r.json()).then(setStatus).catch(() => {});
  socket.on('qr', mostrarQr);
  // ── Painel QR ─────────────────────────────────────────────────────────────────
  function abrirQrPanel() {
    qrPanelOpen = true;
    document.getElementById('qr-panel').style.display = 'flex';
    document.getElementById('btn-qr').classList.add('btn-primary');
    document.getElementById('btn-qr').classList.remove('btn-ghost');
    atualizarQrPanel(currentStatus);
  }
  function fecharQrPanel() {
    qrPanelOpen = false;
    document.getElementById('qr-panel').style.display = 'none';
    document.getElementById('btn-qr').classList.remove('btn-primary');
    document.getElementById('btn-qr').classList.add('btn-ghost');
    if (startedByQrPanel && currentStatus === 'starting') {
      startedByQrPanel = false;
      stopService();
    }
  }
  function toggleQrPanel() {
    if (qrPanelOpen) {
      fecharQrPanel();
    } else {
      abrirQrPanel();
      if (currentStatus === 'stopped') {
        startedByQrPanel = true;
        startService();
      }
    }
  }
  async function trocarNumero() {
    if (!confirm('Isso desconectará o número atual e apagará a sessão salva.\n\nAo confirmar, um novo QR Code será gerado para conectar um número diferente.\n\nContinuar?')) return;
    const btn = document.getElementById('btn-qr-restart');
    btn.disabled = true; btn.textContent = '⏳ Limpando sessão…';
    try {
      const r = await fetch('/api/service/clear-session', _apiFetchOpts('POST'));
      if (!r.ok) { alert('Erro ao limpar sessão.'); return; }
      setTimeout(startService, 800);
    } catch (e) {
      alert('Erro de conexão: ' + e.message);
    } finally {
      btn.disabled = false; btn.textContent = '🔄 Trocar número (novo QR)';
    }
  }
  function _notificarMonitores() {
    try { new BroadcastChannel('iahub_monitors').postMessage({ type: 'status-changed' }); } catch(_) {}
  }
  // ── Serviço WhatsApp ──────────────────────────────────────────────────────────
  async function startService() {
    document.getElementById('btn-start').disabled    = true;
    document.getElementById('btn-qr-start').disabled = true;
    try {
      const r = await fetch('/api/service/start', _apiFetchOpts('POST'));
      if (r.status === 401) { alert('Sessão expirada. Faça login novamente.'); location.href = '/login.html'; return; }
      if (!r.ok) alert(`Erro ao iniciar serviço (HTTP ${r.status})`);
      else {
        if (qrPanelOpen) atualizarQrPanel('starting');
        _notificarMonitores();
        setTimeout(() => fetch(_apiUrl('/api/service/status')).then(r => r.json()).then(setStatus).catch(() => {}), 600);
      }
    } catch (e) {
      alert(`Erro de conexão: ${e.message}`);
    } finally {
      document.getElementById('btn-start').disabled    = false;
      document.getElementById('btn-qr-start').disabled = false;
    }
  }
  async function stopService() {
    document.getElementById('btn-stop').disabled = true;
    try {
      const r = await fetch('/api/service/stop', _apiFetchOpts('POST'));
      if (r.status === 401) { alert('Sessão expirada. Faça login novamente.'); location.href = '/login.html'; return; }
      if (!r.ok) alert(`Erro ao parar serviço (HTTP ${r.status})`);
      else {
        _notificarMonitores();
        setTimeout(() => fetch(_apiUrl('/api/service/status')).then(r => r.json()).then(setStatus).catch(() => {}), 600);
      }
    } catch (e) {
      alert(`Erro de conexão: ${e.message}`);
    } finally {
      document.getElementById('btn-stop').disabled = false;
    }
  }
  function switchWaTab(tab) {
    document.querySelectorAll('.ajuda-tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.ajuda-tab-content').forEach(c => { c.classList.remove('active'); c.style.display = 'none'; });
    document.getElementById('tab-btn-wa-' + tab).classList.add('active');
    const el = document.getElementById('tab-wa-' + tab);
    el.classList.add('active');
    el.style.display = 'block';
  }
</script>
</body>
</html>
