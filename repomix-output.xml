<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>IA Service - Acesso Web</title>
  <style>
    :root {
      --bg: #071014;
      --bg-2: #0d1b20;
      --panel: #102027;
      --panel-2: #162b33;
      --panel-3: #203740;
      --text: #edf7f5;
      --muted: #9fb4bb;
      --soft: #c9d9dd;
      --border: rgba(179, 215, 221, .18);
      --accent: #00a884;
      --accent-2: #25d366;
      --accent-dark: #07382f;
      --danger: #ff8a8a;
      --warning: #ffd166;
      --shadow: 0 28px 90px rgba(0, 0, 0, .42);
      --radius: 8px;
      --focus-ring: 0 0 0 3px rgba(37, 211, 102, .18);
    }
    * { box-sizing: border-box; }
    html, body { min-height: 100%; }
    body {
      margin: 0;
      height: 100vh;
      font-family: Inter, "Segoe UI", Arial, sans-serif;
      color: var(--text);
      background:
        linear-gradient(135deg, rgba(0, 168, 132, .18), transparent 28%),
        radial-gradient(circle at 82% 22%, rgba(37, 211, 102, .16), transparent 30%),
        linear-gradient(180deg, var(--bg), var(--bg-2));
      display: grid;
      place-items: center;
      padding: 16px;
      overflow: hidden;
    }
    button, input { font: inherit; }
    .shell {
      width: min(1080px, 100%);
      height: min(760px, calc(100vh - 32px));
      min-height: 0;
      display: grid;
      grid-template-columns: minmax(0, .82fr) minmax(430px, 1fr);
      background: rgba(16, 32, 39, .92);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
      backdrop-filter: blur(18px);
    }
    .hero {
      position: relative;
      padding: 26px 30px;
      border-right: 1px solid var(--border);
      background:
        linear-gradient(160deg, rgba(0, 168, 132, .22), transparent 46%),
        linear-gradient(180deg, rgba(255, 255, 255, .05), rgba(255, 255, 255, .01));
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 16px;
      min-height: 0;
      overflow: hidden;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .logo {
      width: 64px;
      height: 64px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: rgba(255, 255, 255, .04);
      border: 1px solid var(--border);
      overflow: hidden;
      flex-shrink: 0;
    }
    .logo-fallback {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #03251d;
      font-weight: 900;
      font-size: 22px;
    }
    .logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
    h1, h2, p { margin: 0; }
    h1 {
      font-size: 23px;
      line-height: 1.15;
      letter-spacing: 0;
    }
    .brand-sub {
      margin-top: 4px;
      color: var(--muted);
      font-size: 13px;
    }
    .hero-copy h2 {
      max-width: 420px;
      font-size: clamp(25px, 3vw, 36px);
      line-height: 1.08;
      letter-spacing: 0;
    }
    .hero-copy p {
      max-width: 440px;
      margin-top: 10px;
      color: var(--soft);
      font-size: 14px;
      line-height: 1.45;
    }
    .access-flow {
      display: grid;
      gap: 8px;
      max-width: 430px;
    }
    .flow-item {
      display: grid;
      grid-template-columns: 30px 1fr;
      gap: 10px;
      align-items: start;
      padding: 8px 10px;
      border: 1px solid rgba(179, 215, 221, .14);
      border-radius: var(--radius);
      background: rgba(7, 16, 20, .24);
    }
    .flow-num {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: rgba(0, 168, 132, .16);
      color: var(--accent-2);
      font-weight: 900;
    }
    .flow-title {
      font-size: 13px;
      font-weight: 800;
    }
    .flow-text {
      margin-top: 3px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
    }
    .visual {
      align-self: center;
      width: min(300px, 100%);
      border: 1px solid rgba(179, 215, 221, .16);
      border-radius: var(--radius);
      background: rgba(7, 16, 20, .34);
      padding: 12px;
    }
    .visual-top {
