<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command &rsaquo;</span> Gloss&aacute;rio de Conceitos Anal&iacute;ticos</span>
    </div>
    <div class="page-content">
      <section id="list-view">
        <div class="head-row">
          <div>
            <div class="page-kicker">Administracao &middot; Conhecimento da IA</div>
            <div class="head-title">Gloss&aacute;rio de Conceitos Anal&iacute;ticos <span class="head-count" id="count">carregando...</span></div>
          </div>
          <div class="head-actions">
            <button class="btn btn-ghost" id="help-btn" type="button" title="Ajuda" style="display:inline-flex;align-items:center;gap:6px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg> Ajuda</button>
            <button class="btn btn-ghost" id="toggle-inativos-btn" type="button">Mostrar inativos</button>
            <button class="btn btn-ghost" id="refresh-btn" type="button" style="font-weight:700;color:#1e3a8a;padding:5px 14px">&#8635; Atualizar</button>
          </div>
        </div>
        <div class="table-card">
          <div class="table-wrap">
            <table class="glossario-table">
              <thead>
                <tr>
                  <th class="col-action"></th>
                  <th class="col-termo sortable" data-sort="termo">Termo</th>
                  <th class="col-dominio sortable" data-sort="dominio">Dom&iacute;nio de dado</th>
                  <th class="sortable" data-sort="definicao_tecnica">Defini&ccedil;&atilde;o t&eacute;cnica</th>
                  <th class="col-origem sortable" data-sort="origem">Origem</th>
                  <th class="col-data sortable" data-sort="criado_em">Aprendido em</th>
                  <th class="col-status sortable" data-sort="ativo">Status</th>
                </tr>
                <tr class="filter-cell">
                  <th></th>
                  <th><input data-filter="termo" autocomplete="off" spellcheck="false"></th>
                  <th><input data-filter="dominio" autocomplete="off" spellcheck="false"></th>
                  <th><input data-filter="definicao_tecnica" autocomplete="off" spellcheck="false"></th>
                  <th>
                    <select data-filter="origem" autocomplete="off">
                      <option value="">Todas</option>
                      <option value="ia_aprendido">IA aprendeu</option>
                      <option value="admin_manual">Editado no painel</option>
                    </select>
                  </th>
                  <th></th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="tbody"></tbody>
            </table>
            <div class="empty-state" id="empty-state" style="display:none">Nenhum termo no gloss&aacute;rio ainda</div>
          </div>
        </div>
      </section>
      <section id="detail-view" class="detail-shell">
        <div class="editor-bar">
          <div class="editor-title">
            <strong id="detail-title">Termo</strong>
            <span id="detail-subtitle">-</span>
          </div>
          <div class="editor-actions">
            <button class="btn btn-ghost" id="toggle-ativo-btn" type="button">Desativar</button>
            <button class="btn btn-ghost" id="back-btn" type="button">Voltar &agrave; lista</button>
          </div>
        </div>
        <div class="detail-card">
          <div class="meta-grid" id="meta-grid"></div>
          <div class="text-box">
            <label>Pergunta que originou o aprendizado</label>
            <pre id="detail-pergunta"></pre>
          </div>
          <div class="text-box">
            <label>Defini&ccedil;&atilde;o t&eacute;cnica (injetada no prompt do gerador de SQL quando esse termo aparecer novamente)</label>
            <textarea id="detail-definicao"></textarea>
            <div class="save-row">
              <span class="save-hint" id="save-hint"></span>
              <button class="btn btn-ghost" id="cancel-edit-btn" type="button">Cancelar edi&ccedil;&atilde;o</button>
              <button class="btn btn-primary" id="save-btn" type="button">Salvar altera&ccedil;&atilde;o</button>
            </div>
