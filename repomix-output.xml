<file path="apps/Master Crypto/frontend/ciclo-btc.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ciclos do Bitcoin - Crypto Radar AI</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="./css/master-crypto.css">
  <style>
    body { background: var(--bg-base, #f8fafc); padding: 16px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .cycle-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, .8fr); gap: 14px; }
    .chart-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 14px; }
    canvas { width: 100%; height: 320px; display: block; }
    .text-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 16px; }
    .text-card p { color: var(--text-md); line-height: 1.55; margin: 0; font-size: 13px; white-space: pre-wrap; }
    @media (max-width: 980px) { .cycle-layout { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="page-kicker">ESTRATEGIAS / CICLOS DO BITCOIN</div>
  <div class="head-row">
    <div class="head-title">
      <span>Analise de Ciclos do Bitcoin</span>
      <span class="head-count" id="statusText">carregando...</span>
    </div>
    <div class="head-actions">
      <button class="btn btn-secondary" type="button" onclick="loadCycle()">Atualizar</button>
    </div>
  </div>
  <div class="meta-grid" id="metaGrid"></div>
  <div class="cycle-layout">
    <section class="chart-card">
      <canvas id="cycleCanvas"></canvas>
    </section>
    <aside class="text-card">
      <div class="page-kicker">LEITURA MACRO / MODELO DEMONSTRATIVO</div>
      <p id="cycleText">Aguardando comparacao.</p>
    </aside>
  </div>
  <script src="/js/auth.js"></script>
  <script>
    let currentSeries = {};
    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
    }
    function renderMeta(data) {
      document.getElementById('metaGrid').innerHTML = `
        <div class="meta-item"><span>Ano mais similar</span><strong>${esc(data.most_similar_year)}</strong></div>
        <div class="meta-item"><span>Similaridade ${esc(data.compare_year_1)}</span><strong class="text-positive">${Number(data.similarity_score_year_1 || 0).toFixed(1)}%</strong></div>
        <div class="meta-item"><span>Similaridade ${esc(data.compare_year_2)}</span><strong>${Number(data.similarity_score_year_2 || 0).toFixed(1)}%</strong></div>
        <div class="meta-item"><span>Dias pos-halving</span><strong>${Number(data.days_since_halving || 0)}</strong></div>
      `;
    }
    function drawCycle(series) {
      const canvas = document.getElementById('cycleCanvas');
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      const keys = Object.keys(series || {});
      if (!keys.length) {
        ctx.fillStyle = '#64748b';
        ctx.font = '13px Segoe UI';
        ctx.fillText('Sem serie para exibicao', 18, 32);
        return;
      }
      const all = keys.flatMap(key => series[key] || []);
      const maxDay = Math.max(...all.map(p => Number(p.day || 0)), 1);
      const values = all.map(p => Number(p.return_pct || 0));
      const min = Math.min(...values, -5);
      const max = Math.max(...values, 5);
      const range = Math.max(max - min, 1);
      const pad = 34;
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 1;
      for (let i = 0; i <= 4; i += 1) {
        const y = pad + ((canvas.height - pad * 2) / 4) * i;
        ctx.beginPath();
        ctx.moveTo(pad, y);
        ctx.lineTo(canvas.width - pad, y);
        ctx.stroke();
      }
      const colors = ['#0ecb81', '#2563eb', '#a855f7'];
      keys.forEach((key, idx) => {
        const rows = series[key] || [];
        ctx.strokeStyle = colors[idx % colors.length];
        ctx.lineWidth = idx === 0 ? 3 : 2;
        ctx.beginPath();
        rows.forEach((point, index) => {
          const x = pad + (Number(point.day || 0) / maxDay) * (canvas.width - pad * 2);
          const y = canvas.height - pad - ((Number(point.return_pct || 0) - min) / range) * (canvas.height - pad * 2);
          if (index === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        });
        ctx.stroke();
        ctx.fillStyle = colors[idx % colors.length];
        ctx.fillText(key, canvas.width - pad - 52, pad + 16 + idx * 18);
      });
    }
    async function loadCycle() {
      await (window._iahubAuthReady || Promise.resolve());
      document.getElementById('statusText').textContent = 'consultando motor...';
      try {
        const data = await fetch('/api/master-crypto/btc-cycle/compare').then(r => r.json());
        renderMeta(data);
        currentSeries = data.normalized_series || {};
        drawCycle(currentSeries);
        document.getElementById('cycleText').textContent = `${data.cycle_phase_description || ''}\n\n${data.layman_explanation || ''}\n\n${data.disclaimer || ''}`;
        document.getElementById('statusText').textContent = `ano ${data.current_year} - demonstrativo`;
      } catch (_) {
        document.getElementById('statusText').textContent = 'backend indisponivel';
        document.getElementById('metaGrid').innerHTML = '<div class="meta-item"><span>Status</span><strong>Sem dados</strong></div>';
        document.getElementById('cycleText').textContent = 'Nao foi possivel carregar a comparacao de ciclos agora.';
        drawCycle({});
      }
    }
    window.addEventListener('resize', () => drawCycle(currentSeries));
    window.addEventListener('DOMContentLoaded', loadCycle);
  </script>
</body>
</html>
</file>

<file path="apps/Master Crypto/frontend/paper-trading.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Paper Trading - Crypto Radar AI</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="./css/master-crypto.css">
  <style>
    body { background: #f8fafc; padding: 16px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .head-title { margin-bottom: 12px; }
    .empty-state { height: 220px; display: flex; align-items: center; justify-content: center; color: var(--text-lo); font-weight: 800; }
    .status-line { font-size: 12px; color: var(--text-lo); margin-bottom: 12px; }
  </style>
</head>
<body>
<div class="page-kicker">SIMULACAO / PAPER TRADING</div>
<div class="head-row">
  <div>
    <div class="head-title">Gestao de Banca Virtual & Ordens Simuladas</div>
    <div class="status-line" id="statusLine">Carregando dados da empresa...</div>
  </div>
  <div class="head-actions">
    <button class="btn btn-secondary" type="button" onclick="loadPaperTrading()">Atualizar</button>
  </div>
</div>
<div class="meta-grid">
  <div class="meta-item"><span>Banca Virtual Atual</span><strong class="text-positive" id="balanceValue">-</strong></div>
  <div class="meta-item"><span>Win Rate Simulado</span><strong class="text-positive" id="winRateValue">-</strong></div>
  <div class="meta-item"><span>Profit Factor</span><strong id="profitFactorValue">-</strong></div>
  <div class="meta-item"><span>Lucro Total Acumulado</span><strong id="netPnlValue">-</strong></div>
</div>
<div class="table-card">
  <div class="table-wrap" style="min-height:320px">
    <table class="history-table">
      <thead>
        <tr>
          <th>Ativo</th>
          <th>Estrategia</th>
          <th>Entrada</th>
          <th>Stop Loss</th>
          <th>Alvo T2</th>
          <th>Quantidade</th>
          <th>R/R</th>
          <th>Acao</th>
        </tr>
      </thead>
      <tbody id="activeTradesBody"></tbody>
    </table>
    <div class="empty-state" id="emptyState" style="display:none">Nenhuma ordem simulada aberta nesta empresa</div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script>
  const fmtUsd = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'USD' });
  const fmtPct = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 2 });
  function esc(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }
  function setMetric(id, value, positive = null) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = value;
    if (positive !== null) {
      el.classList.toggle('text-positive', positive);
      el.classList.toggle('text-negative', !positive);
    }
  }
  async function loadPaperTrading() {
    await (window._iahubAuthReady || Promise.resolve());
    const status = document.getElementById('statusLine');
    status.textContent = 'Atualizando dados da empresa...';
    try {
      const [metrics, active] = await Promise.all([
        fetch('/api/master-crypto/paper/metrics').then(r => r.json()),
        fetch('/api/master-crypto/paper/active').then(r => r.json()),
      ]);
      const net = Number(metrics.net_pnl_usd || 0);
      setMetric('balanceValue', fmtUsd.format(Number(metrics.current_balance_usd || 0)), true);
      setMetric('winRateValue', `${fmtPct.format(Number(metrics.win_rate_pct || 0))}%`, true);
      setMetric('profitFactorValue', String(metrics.profit_factor ?? '0'));
      setMetric('netPnlValue', `${net >= 0 ? '+' : ''}${fmtUsd.format(net)}`, net >= 0);
      renderTrades(Array.isArray(active.trades) ? active.trades : []);
      status.textContent = `Dados carregados para ${window._iahubEmpresa?.nome || 'empresa selecionada'}.`;
    } catch (err) {
      status.textContent = 'Nao foi possivel carregar o Paper Trading desta empresa.';
      renderTrades([]);
    }
  }
  function renderTrades(trades) {
    const tbody = document.getElementById('activeTradesBody');
    const empty = document.getElementById('emptyState');
    tbody.innerHTML = '';
    empty.style.display = trades.length ? 'none' : 'flex';
    trades.forEach(trade => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><strong>${esc(trade.symbol)}</strong></td>
        <td>${esc(trade.strategy)}</td>
        <td>${fmtUsd.format(Number(trade.simulated_fill_price || trade.entry_price || 0))}</td>
        <td><span class="text-negative">${fmtUsd.format(Number(trade.stop_loss || 0))}</span></td>
        <td><span class="text-positive">${fmtUsd.format(Number(trade.target_t2 || 0))}</span></td>
        <td>${Number(trade.quantity || 0).toFixed(6)}</td>
        <td>1:${esc(trade.risk_reward_ratio || '-')}</td>
        <td><button class="btn btn-sm btn-danger" type="button" onclick="closeTrade('${esc(trade.id)}', '${esc(trade.symbol)}')">Encerrar</button></td>
      `;
      tbody.appendChild(tr);
    });
  }
  async function closeTrade(tradeId, symbol) {
    const status = document.getElementById('statusLine');
    const cleanSymbol = String(symbol || '').replace('/', '').toUpperCase();
    if (!cleanSymbol) return;
    status.textContent = `Consultando preco real da Binance para ${cleanSymbol}...`;
    try {
      const priceData = await fetch(`/api/master-crypto/market/price?symbol=${encodeURIComponent(cleanSymbol)}`).then(r => {
        if (!r.ok) throw new Error('price');
        return r.json();
      });
      const current = Number(priceData.price || 0);
      if (!current || current <= 0) throw new Error('invalid-price');
      const res = await fetch('/api/master-crypto/paper/close', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trade_id: tradeId, current_market_price: current }),
      });
      if (!res.ok) throw new Error('close');
      await loadPaperTrading();
    } catch (_) {
      status.textContent = 'Nao foi possivel buscar preco real na Binance para encerrar a ordem simulada.';
    }
  }
  window.addEventListener('DOMContentLoaded', loadPaperTrading);
</script>
</body>
</html>
