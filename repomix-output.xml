      <div class="card">
        <div class="card-body" style="padding:0">
          <div class="grid-toolbar">
            <div>
              <div class="grid-title">Funções cadastradas</div>
              <div id="count" class="grid-meta"></div>
            </div>
            <div class="sel-bar" id="sel-bar">
              <span id="sel-count" style="font-weight:600"></span>
