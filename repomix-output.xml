<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shadow NL-SQL - IA Command</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css">
  <style>
    :root { --accent:#7c3aed; --accent-light:#a78bfa; --accent-glow:rgba(124,58,237,.1); }
    .sidebar-logo .logo-icon { background:#7c3aed !important; }
    .topbar-menu-btn { flex-shrink:0;background:none;border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;color:var(--text-md);transition:background var(--transition),color var(--transition); }
    .topbar-menu-btn:hover { background:var(--bg-hover);color:var(--text-hi); }
    .topbar-title { flex:1;min-width:0;font-weight:700; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;margin-bottom:3px; }
    .ctrl-bar { display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:10px; }
    .ctrl-bar-title { font-size:18px;font-weight:700;color:var(--text-hi);line-height:1.25;display:flex;align-items:baseline;gap:8px; }
    .ctrl-count { font-size:12px;color:var(--text-lo);font-weight:400; }
    .ctrl-bar-right { display:flex;gap:8px;align-items:center;flex-shrink:0; }
    .filter-bar { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:10px 14px;margin-bottom:10px;box-shadow:var(--shadow-sm); }
    .filter-bar-row { display:flex;align-items:center;gap:8px;flex-wrap:wrap; }
    .filter-bar-row .form-control { height:34px;font-size:13px; }
    .filter-bar-row input[type="date"].form-control { width:150px;flex:0 0 150px; }
    .filter-bar-row select.form-control { width:auto;min-width:150px; }
    .metric-row { display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:10px;margin-bottom:10px; }
    .metric { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:12px 14px;min-width:0; }
    .metric span { display:block;font-size:11px;color:var(--text-lo);text-transform:uppercase;letter-spacing:.05em;font-weight:800;margin-bottom:5px; }
    .metric strong { display:block;font-size:20px;color:var(--text-hi);line-height:1.2; }
    .metric small { display:block;font-size:11px;color:var(--text-lo);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
    .grid-card { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden; }
    .badge { display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:800;white-space:nowrap; }
    .badge-ok { background:#dcfce7;color:#15803d; }
    .badge-info { background:#dbeafe;color:#1d4ed8; }
    .badge-warn { background:#fef3c7;color:#92400e; }
    .badge-fail { background:#fee2e2;color:#b91c1c; }
    .badge-neutro { background:var(--bg-base);color:var(--text-md);border:1px solid var(--border); }
    .sql-preview { display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;white-space:normal;line-height:1.35;word-break:break-word;font-family:ui-monospace,monospace;font-size:12px; }
    .tabulator { border:none !important;background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important;border-right:none !important;color:var(--text-lo) !important;font-size:11px !important;font-weight:800 !important;text-transform:uppercase;letter-spacing:.05em; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-base) !important;color:var(--text-hi) !important;border:1px solid var(--border) !important;border-radius:4px !important;font-size:11px !important;padding:3px 6px !important;width:100% !important; }
    .tabulator .tabulator-row { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important;cursor:pointer; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row.row-selecionada { background:var(--accent-glow) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important;color:var(--text-md);font-size:13px;padding:10px 12px !important; }
    .loading-panel { display:none;align-items:center;justify-content:center;flex-direction:column;gap:10px;min-height:220px;color:var(--text-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);margin-bottom:10px; }
    .loading-panel.show { display:flex; }
    .loading-spinner { width:28px;height:28px;border-radius:50%;border:3px solid rgba(124,58,237,.18);border-top-color:var(--accent);animation:spin .8s linear infinite; }
    @keyframes spin { to { transform:rotate(360deg); } }
    .detail-section { display:none;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden; }
    .detail-head { display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px;border-bottom:1px solid var(--border); }
    .detail-title { font-size:15px;font-weight:800;color:var(--text-hi); }
    .detail-body { padding:18px; }
    .meta-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;margin-bottom:14px; }
    .meta-item { background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px;min-width:0; }
    .meta-item span { color:var(--text-lo);font-size:11px;display:block;margin-bottom:4px; }
    .meta-item strong { color:var(--text-hi);font-size:13px;word-break:break-word; }
    .compare-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px; }
    .compare-pane { border:1px solid var(--border);border-radius:var(--radius-sm);overflow:hidden;background:var(--bg-base);min-width:0; }
    .compare-head { display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 12px;border-bottom:1px solid var(--border);background:var(--bg-card); }
    .compare-title { font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--text-lo); }
    .compare-pre { margin:0;padding:12px;min-height:150px;max-height:320px;overflow:auto;font-family:ui-monospace,monospace;font-size:12px;line-height:1.55;white-space:pre-wrap;word-break:break-word;color:var(--text-md); }
    .btn-mini { height:26px;border:1px solid var(--border);border-radius:6px;background:var(--bg-base);color:var(--text-md);font-size:11px;font-weight:800;padding:0 9px;cursor:pointer; }
    .btn-mini:hover { border-color:var(--accent);color:var(--accent);background:var(--accent-glow); }
    .help-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:300;opacity:0;pointer-events:none;transition:opacity .25s;}
    .help-overlay.open{opacity:1;pointer-events:all;}
    .help-drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,100vw);background:var(--bg-card);border-left:1px solid var(--border);z-index:301;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);overflow:hidden;}
    .help-drawer.open{transform:translateX(0);}
    .help-drawer-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--border);flex-shrink:0;}
    .help-drawer-title{font-size:15px;font-weight:700;color:var(--text-hi);}
    .help-drawer-close{width:30px;height:30px;border:none;background:none;cursor:pointer;border-radius:6px;color:var(--text-lo);}
    .help-drawer-body{flex:1;overflow-y:auto;padding:22px;}
    .help-section{margin-bottom:24px;}
    .help-section-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--accent);margin-bottom:10px;}
    .help-item-desc{font-size:13px;color:var(--text-md);line-height:1.65;}
    .help-tabs{display:flex;gap:6px;border-bottom:1px solid var(--border);margin:-4px 0 18px;overflow-x:auto;}
    .help-tab{border:0;background:transparent;color:var(--text-lo);cursor:pointer;padding:9px 8px;font:inherit;font-size:12px;font-weight:800;border-bottom:2px solid transparent;white-space:nowrap;}
    .help-tab.active{color:var(--accent);border-bottom-color:var(--accent);}
    .help-panel{display:none;}
    .help-panel.active{display:block;}
    .help-list{margin:8px 0 0 18px;padding:0;color:var(--text-md);font-size:13px;line-height:1.65;}
    .help-list li{margin:0 0 7px;}
    .help-callout{border:1px solid var(--border);border-radius:8px;background:var(--bg-base);padding:11px 12px;margin-top:10px;color:var(--text-md);font-size:13px;line-height:1.55;}
    @media (max-width: 1100px) { .metric-row { grid-template-columns:repeat(3,1fr); } .compare-grid { grid-template-columns:1fr; } }
    @media (max-width: 700px) { .metric-row { grid-template-columns:1fr 1fr; } .ctrl-bar { align-items:flex-start;flex-direction:column; } }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command /</span> Shadow NL-SQL</span>
      <button class="btn btn-ghost" onclick="abrirAjuda()">Ajuda</button>
    </div>
    <div class="content">
      <section id="sec-lista">
        <div class="ctrl-bar">
          <div>
            <div class="page-kicker">Aprendizado NL-SQL</div>
            <div class="ctrl-bar-title">Auditoria do Shadow Mode <span class="ctrl-count" id="count">carregando...</span></div>
          </div>
          <div class="ctrl-bar-right">
            <button class="btn btn-secondary" id="btn-atualizar" onclick="atualizarClick()">Atualizar</button>
          </div>
        </div>
        <div class="filter-bar">
          <div class="filter-bar-row">
            <input class="form-control" type="date" id="f-inicio" title="Data inicial">
            <input class="form-control" type="date" id="f-fim" title="Data final">
            <select class="form-control" id="f-modulo">
              <option value="">Todos os modulos</option>
              <option value="financeiro">Financeiro</option>
              <option value="compras">Compras</option>
              <option value="faturamento">Faturamento</option>
              <option value="comissao">Comissao</option>
              <option value="estoque">Estoque</option>
            </select>
            <select class="form-control" id="f-resultado">
              <option value="">Todos os resultados</option>
              <option value="match_template_exato">Match template exato</option>
              <option value="match_sql_aplicado_exato">Match SQL aplicado</option>
              <option value="mismatch">Mismatch</option>
              <option value="template_invalido">Template invalido</option>
              <option value="sem_candidato">Sem candidato</option>
            </select>
            <select class="form-control" id="f-elegivel">
              <option value="">Elegibilidade</option>
              <option value="1">Elegivel shadow</option>
              <option value="0">Nao elegivel</option>
            </select>
            <select class="form-control" id="f-classificacao">
              <option value="">Todas as classificacoes</option>
              <option value="aprovado_automatico">Aprovado auto</option>
              <option value="reprovado_automatico">Reprovado auto</option>
              <option value="inconclusivo">Inconclusivo</option>
              <option value="bloqueado_por_risco">Bloqueado por risco</option>
              <option value="aprovado_usuario">Aprovado usuario</option>
              <option value="reprovado_usuario">Reprovado usuario</option>
              <option value="ignorado_usuario">Ignorado usuario</option>
              <option value="bloqueado_usuario">Bloqueado usuario</option>
            </select>
            <select class="form-control" id="f-limit">
              <option value="200">200</option>
              <option value="500" selected>500</option>
              <option value="1000">1000</option>
              <option value="2000">2000</option>
            </select>
            <button class="btn btn-primary" onclick="carregar()">Aplicar</button>
          </div>
        </div>
        <div class="metric-row">
          <div class="metric"><span>Total</span><strong id="m-total">0</strong><small>Registros avaliados</small></div>
          <div class="metric"><span>Com candidato</span><strong id="m-candidato">0</strong><small>Candidato acima do limiar</small></div>
          <div class="metric"><span>Precisao template</span><strong id="m-precisao">-</strong><small>Match template / com candidato</small></div>
          <div class="metric"><span>Match exato</span><strong id="m-match">0</strong><small>Template exatamente igual</small></div>
          <div class="metric"><span>Mismatch</span><strong id="m-mismatch">0</strong><small>Candidato divergente</small></div>
          <div class="metric"><span>Elegivel</span><strong id="m-elegivel">0</strong><small>Apenas estatistico</small></div>
        </div>
        <div class="loading-panel" id="loading">
          <div class="loading-spinner"></div>
          <div style="font-size:14px;font-weight:700;color:var(--text-hi)">Carregando shadow mode</div>
          <div style="font-size:12px;color:var(--text-lo)">Lendo candidatos semanticos comparados contra SQL real</div>
        </div>
        <div class="grid-card">
          <div id="tabela"></div>
        </div>
      </section>
      <section class="detail-section" id="sec-detalhe">
        <div class="detail-head">
          <div>
            <div class="page-kicker">Detalhe do shadow</div>
            <div class="detail-title" id="d-title">Registro</div>
          </div>
          <button class="btn btn-secondary" onclick="fecharDetalhe()">Voltar</button>
        </div>
        <div class="detail-body">
          <div class="meta-grid">
            <div class="meta-item"><span>Resultado</span><strong id="d-resultado">-</strong></div>
            <div class="meta-item"><span>Modulo</span><strong id="d-modulo">-</strong></div>
            <div class="meta-item"><span>Intent</span><strong id="d-intent">-</strong></div>
            <div class="meta-item"><span>Score</span><strong id="d-score">-</strong></div>
            <div class="meta-item"><span>Template valido</span><strong id="d-template-valido">-</strong></div>
            <div class="meta-item"><span>Elegivel shadow</span><strong id="d-elegivel">-</strong></div>
            <div class="meta-item"><span>Limiar auto</span><strong id="d-limiar">-</strong></div>
            <div class="meta-item"><span>Execucao candidata</span><strong id="d-candidate-id">-</strong></div>
            <div class="meta-item"><span>Classificacao efetiva</span><strong id="d-classificacao">-</strong></div>
            <div class="meta-item"><span>Classificacao auto</span><strong id="d-classificacao-auto">-</strong></div>
            <div class="meta-item"><span>Override</span><strong id="d-override">-</strong></div>
          </div>
          <div class="filter-bar" style="margin-bottom:14px">
            <div class="filter-bar-row">
              <select class="form-control" id="d-override-classificacao">
                <option value="">Sem override</option>
                <option value="aprovado_usuario">Aprovar por usuario</option>
                <option value="reprovado_usuario">Reprovar por usuario</option>
                <option value="ignorado_usuario">Ignorar por usuario</option>
                <option value="bloqueado_usuario">Bloquear por usuario</option>
              </select>
              <input class="form-control" id="d-override-motivo" placeholder="Motivo opcional" style="min-width:260px;flex:1">
              <button class="btn btn-primary" onclick="salvarOverride()">Salvar classificacao</button>
            </div>
          </div>
          <div class="compare-grid">
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">Template candidato</span><button class="btn-mini" onclick="copiarEl('d-candidate-template', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-candidate-template"></pre>
            </div>
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">Template real da LLM</span><button class="btn-mini" onclick="copiarEl('d-actual-template', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-actual-template"></pre>
            </div>
          </div>
          <div class="compare-grid">
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">SQL candidato aplicado</span><button class="btn-mini" onclick="copiarEl('d-candidate-applied', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-candidate-applied"></pre>
            </div>
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">SQL real final</span><button class="btn-mini" onclick="copiarEl('d-actual-final', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-actual-final"></pre>
            </div>
          </div>
          <div class="compare-grid">
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">SQL canonico real</span><button class="btn-mini" onclick="copiarEl('d-actual-canonico', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-actual-canonico"></pre>
            </div>
            <div class="compare-pane">
              <div class="compare-head"><span class="compare-title">Detalhes da comparacao</span><button class="btn-mini" onclick="copiarEl('d-detalhes', this)">Copiar</button></div>
              <pre class="compare-pre" id="d-detalhes"></pre>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script>
  let table = null;
  let dados = [];
  let rowAtual = null;
  function esc(v) {
    return String(v ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }
  function fmtData(v) {
    if (!v) return '-';
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? String(v) : d.toLocaleString('pt-BR');
  }
  function pct(v) {
    return v === null || v === undefined ? '-' : `${(Number(v) * 100).toFixed(2)}%`;
  }
  function score(v) {
    return v === null || v === undefined ? '-' : Number(v).toFixed(3);
  }
  function simNao(v) {
    return Number(v) === 1 ? 'Sim' : 'Nao';
  }
  function execCandidateId(v) {
    const texto = String(v || '').trim();
    if (!texto || /^(admin|usuario|user|sistema)$/i.test(texto)) return '-';
    if (/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(texto)) return texto;
    if (/^[a-z0-9_-]{12,}$/i.test(texto)) return texto;
    return '-';
  }
  function resultadoBadge(resultado) {
    const label = {
      match_template_exato: 'Match template',
      match_sql_aplicado_exato: 'Match aplicado',
      mismatch: 'Mismatch',
      template_invalido: 'Template invalido',
      sem_candidato: 'Sem candidato',
    }[resultado] || resultado || '-';
    const cls = resultado === 'match_template_exato' ? 'badge-ok'
      : resultado === 'match_sql_aplicado_exato' ? 'badge-info'
      : resultado === 'sem_candidato' ? 'badge-neutro'
      : resultado === 'template_invalido' ? 'badge-warn'
      : 'badge-fail';
    return `<span class="badge ${cls}">${esc(label)}</span>`;
  }
  function classificacaoBadge(v) {
    const label = {
      aprovado_automatico: 'Aprovado auto',
      reprovado_automatico: 'Reprovado auto',
      inconclusivo: 'Inconclusivo',
      bloqueado_por_risco: 'Bloqueado risco',
      aprovado_usuario: 'Aprovado usuario',
      reprovado_usuario: 'Reprovado usuario',
      ignorado_usuario: 'Ignorado usuario',
      bloqueado_usuario: 'Bloqueado usuario',
    }[v] || v || 'Nao classificado';
    const cls = /aprovado/.test(String(v)) ? 'badge-ok'
      : /bloqueado|reprovado/.test(String(v)) ? 'badge-fail'
      : /ignorado|inconclusivo/.test(String(v)) ? 'badge-warn'
      : 'badge-neutro';
    return `<span class="badge ${cls}">${esc(label)}</span>`;
  }
  function setLoading(on) {
    document.getElementById('loading').classList.toggle('show', !!on);
  }
  function paramsFiltros() {
    const p = new URLSearchParams();
    for (const [id, nome] of [['f-inicio','inicio'], ['f-fim','fim'], ['f-modulo','modulo'], ['f-resultado','resultado'], ['f-elegivel','elegivel'], ['f-classificacao','classificacao'], ['f-limit','limit']]) {
      const v = document.getElementById(id)?.value || '';
      if (v) p.set(nome, v);
    }
    return p.toString();
  }
  function atualizarMetricas(resumo) {
    document.getElementById('m-total').textContent = resumo.total || 0;
    document.getElementById('m-candidato').textContent = resumo.com_candidato || 0;
    document.getElementById('m-precisao').textContent = pct(resumo.precisao_template);
    document.getElementById('m-match').textContent = resumo.match_template_exato || 0;
    document.getElementById('m-mismatch').textContent = resumo.mismatch || 0;
    document.getElementById('m-elegivel').textContent = resumo.auto_reuse_elegivel || 0;
  }
  function criarTabela(data) {
    table = new Tabulator('#tabela', {
      data, index: 'id', layout: 'fitColumns', movableColumns: true,
      height: 'calc(100vh - 310px)',
      placeholder: '<div style="padding:40px;text-align:center;color:var(--text-lo)">Nenhum registro de shadow mode encontrado.</div>',
      tableBuilt: () => protegerFiltrosHeaderShadow(),
      dataProcessed: () => protegerFiltrosHeaderShadow(),
      renderComplete: () => protegerFiltrosHeaderShadow(),
      columns: [
        { title: 'Data/Hora', field: 'criado_em', width: 155, sorter: 'string', formatter: c => fmtData(c.getValue()) },
        { title: 'Resultado', field: 'comparacao_resultado', width: 160, headerFilter: 'select',
          headerFilterParams: { values: { '': 'Todos', match_template_exato: 'Match template', match_sql_aplicado_exato: 'Match aplicado', mismatch: 'Mismatch', template_invalido: 'Template invalido', sem_candidato: 'Sem candidato' } },
          formatter: c => resultadoBadge(c.getValue()) },
        { title: 'Modulo', field: 'module', width: 120, headerFilter: true, formatter: c => esc(c.getValue() || '-') },
        { title: 'Intent', field: 'intent', width: 125, headerFilter: true, formatter: c => esc(c.getValue() || '-') },
        { title: 'Score', field: 'candidate_score', width: 90, hozAlign: 'right', sorter: 'number', formatter: c => `<strong>${score(c.getValue())}</strong>` },
        { title: 'Classificacao', field: 'classificacao_efetiva', width: 150, headerFilter: 'select',
          headerFilterParams: { values: { '': 'Todas', aprovado_automatico: 'Aprovado auto', reprovado_automatico: 'Reprovado auto', inconclusivo: 'Inconclusivo', bloqueado_por_risco: 'Bloqueado risco', aprovado_usuario: 'Aprovado usuario', reprovado_usuario: 'Reprovado usuario', ignorado_usuario: 'Ignorado usuario', bloqueado_usuario: 'Bloqueado usuario' } },
          formatter: c => classificacaoBadge(c.getValue() || c.getData().classificacao_auto) },
        { title: 'Elegivel', field: 'auto_reuse_elegivel', width: 95, hozAlign: 'center', formatter: c => Number(c.getValue()) === 1 ? '<span class="badge badge-ok">Sim</span>' : '<span class="badge badge-neutro">Nao</span>' },
        { title: 'Template', field: 'template_valido', width: 100, hozAlign: 'center', formatter: c => Number(c.getValue()) === 1 ? '<span class="badge badge-ok">Valido</span>' : '<span class="badge badge-warn">Nao</span>' },
        { title: 'Execucao candidata', field: 'candidate_execution_log_id', width: 180, headerFilter: true, formatter: c => esc(execCandidateId(c.getValue())) },
        { title: 'Template candidato', field: 'candidate_sql_template', minWidth: 250, formatter: c => `<div class="sql-preview">${esc(c.getValue() || '-')}</div>` },
        { title: 'Template real', field: 'actual_sql_template', minWidth: 250, formatter: c => `<div class="sql-preview">${esc(c.getValue() || '-')}</div>` },
      ],
      rowClick: (e, row) => verDetalhe(row.getData()),
    });
  }
  function protegerFiltrosHeaderShadow() {
    if (!table) return;
    const root = table.element || document.getElementById('tabela') || document;
    const controls = [...root.querySelectorAll('.tabulator-header-filter input, .tabulator-header-filter select')];
    if (!controls.length) return;
    controls.forEach((el, idx) => {
      el.setAttribute('autocomplete', 'off');
      el.setAttribute('name', `iac_shadow_filter_${idx}_${Date.now()}`);
      if (el.tagName === 'INPUT') {
        el.setAttribute('spellcheck', 'false');
        el.setAttribute('autocapitalize', 'off');
        if (!el.dataset.shadowReadonlyGuarded) {
          el.dataset.shadowReadonlyGuarded = '1';
          el.setAttribute('readonly', 'readonly');
          el.addEventListener('focus', () => el.removeAttribute('readonly'), { once: true });
        }
      }
      if (!el.dataset.shadowTouchGuarded) {
        el.dataset.shadowTouchGuarded = '1';
        el.addEventListener('pointerdown', () => { el.dataset.shadowUserTouched = '1'; });
        el.addEventListener('keydown', () => { el.dataset.shadowUserTouched = '1'; });
      }
    });
    const hasTouchedValue = controls.some(el => el.dataset.shadowUserTouched === '1' && String(el.value || '').trim());
    const hasUntouchedValue = controls.some(el => el.dataset.shadowUserTouched !== '1' && String(el.value || '').trim());
    if (!hasUntouchedValue || hasTouchedValue) return;
    controls.forEach(el => {
      if (el.dataset.shadowUserTouched !== '1') el.value = '';
    });
    try { table.clearHeaderFilter(); } catch (_) {}
  }
  async function carregar() {
    setLoading(true);
    try {
      const res = await fetch(`/api/ia-command/admin/nlsql-shadow?${paramsFiltros()}`);
      const payload = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(payload.error || `Erro ${res.status}`);
      dados = payload.rows || [];
      const total = payload.resumo?.total ?? dados.length;
      document.getElementById('count').textContent = dados.length === total ? `${dados.length} registro(s)` : `${dados.length} de ${total} registro(s)`;
      atualizarMetricas(payload.resumo || {});
      if (table) {
        await table.replaceData(dados);
        setTimeout(protegerFiltrosHeaderShadow, 0);
        setTimeout(protegerFiltrosHeaderShadow, 250);
      } else criarTabela(dados);
    } catch (err) {
      dados = [];
      document.getElementById('count').textContent = 'erro ao carregar';
      atualizarMetricas({});
      if (table) await table.replaceData([]);
      alert(err.message || 'Nao foi possivel carregar o shadow mode.');
    } finally {
      setLoading(false);
    }
  }
  async function verDetalhe(row) {
    rowAtual = row;
    try {
      const res = await fetch(`/api/ia-command/admin/nlsql-shadow/${encodeURIComponent(row.id)}`);
      const detalhe = await res.json().catch(() => row);
      if (!res.ok) throw new Error(detalhe.error || `Erro ${res.status}`);
      preencherDetalhe(detalhe);
    } catch {
      preencherDetalhe(row);
    }
    document.getElementById('sec-lista').style.display = 'none';
    document.getElementById('sec-detalhe').style.display = 'block';
  }
  function preencherDetalhe(row) {
    rowAtual = row;
    document.getElementById('d-title').textContent = `${fmtData(row.criado_em)} - ${row.module || 'sem modulo'}`;
    document.getElementById('d-resultado').innerHTML = resultadoBadge(row.comparacao_resultado);
    document.getElementById('d-modulo').textContent = row.module || '-';
    document.getElementById('d-intent').textContent = row.intent || '-';
    document.getElementById('d-score').textContent = score(row.candidate_score);
    document.getElementById('d-template-valido').textContent = simNao(row.template_valido);
    document.getElementById('d-elegivel').textContent = simNao(row.auto_reuse_elegivel);
    document.getElementById('d-limiar').textContent = score(row.auto_reuse_limiar);
    document.getElementById('d-candidate-id').textContent = execCandidateId(row.candidate_execution_log_id);
    document.getElementById('d-classificacao').innerHTML = classificacaoBadge(row.classificacao_efetiva || row.classificacao_auto);
    document.getElementById('d-classificacao-auto').innerHTML = classificacaoBadge(row.classificacao_auto);
    document.getElementById('d-override').textContent = row.override_classificacao ? `${row.override_classificacao} (${row.override_usuario || 'usuario'})` : 'Sem override';
    document.getElementById('d-override-classificacao').value = row.override_classificacao || '';
    document.getElementById('d-override-motivo').value = row.override_motivo || '';
    document.getElementById('d-candidate-template').textContent = row.candidate_sql_template || '(sem candidato)';
    document.getElementById('d-actual-template').textContent = row.actual_sql_template || '(nao registrado)';
    document.getElementById('d-candidate-applied').textContent = row.candidate_sql_aplicado || '(nao aplicado)';
    document.getElementById('d-actual-final').textContent = row.actual_sql_final || '(nao registrado)';
    document.getElementById('d-actual-canonico').textContent = row.actual_sql_canonico || '(nao registrado)';
    document.getElementById('d-detalhes').textContent = JSON.stringify(row.detalhes || tryJson(row.detalhes_json) || {}, null, 2);
  }
  async function salvarOverride() {
    if (!rowAtual?.id) return;
    const classificacao = document.getElementById('d-override-classificacao').value;
    const motivo = document.getElementById('d-override-motivo').value;
    const res = await fetch(`/api/ia-command/admin/nlsql-shadow/${encodeURIComponent(rowAtual.id)}/classificacao`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ classificacao, motivo }),
    });
    const payload = await res.json().catch(() => ({}));
    if (!res.ok) {
      alert(payload.error || 'Nao foi possivel salvar classificacao.');
      return;
    }
    await carregar();
    const atualizado = dados.find(r => r.id === rowAtual.id);
    if (atualizado) preencherDetalhe(atualizado);
  }
  function tryJson(v) {
    try { return JSON.parse(v || '{}'); } catch { return {}; }
  }
  function fecharDetalhe() {
    document.getElementById('sec-detalhe').style.display = 'none';
    document.getElementById('sec-lista').style.display = '';
    rowAtual = null;
  }
  function copiarEl(id, btn) {
    const texto = document.getElementById(id)?.textContent || '';
    const original = btn.textContent;
    const ok = () => { btn.textContent = 'Copiado'; setTimeout(() => { btn.textContent = original; }, 1200); };
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(texto).then(ok).catch(ok);
    else {
      const ta = document.createElement('textarea');
      ta.value = texto;
      ta.style.cssText = 'position:fixed;left:-9999px;top:-9999px';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch {}
      document.body.removeChild(ta);
      ok();
    }
  }
  async function atualizarClick() {
    const btn = document.getElementById('btn-atualizar');
    btn.disabled = true;
    const old = btn.textContent;
    btn.textContent = 'Atualizando...';
    try { await carregar(); } finally { btn.textContent = old; btn.disabled = false; }
  }
  function abrirAjuda() {
    document.getElementById('help-overlay').classList.add('open');
    document.getElementById('help-drawer').classList.add('open');
  }
  function fecharAjuda() {
    document.getElementById('help-overlay').classList.remove('open');
    document.getElementById('help-drawer').classList.remove('open');
  }
  function trocarHelpTab(id) {
    document.querySelectorAll('.help-tab').forEach(btn => btn.classList.toggle('active', btn.dataset.helpTab === id));
    document.querySelectorAll('.help-panel').forEach(panel => panel.classList.toggle('active', panel.dataset.helpPanel === id));
  }
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      fecharAjuda();
      if (document.getElementById('sec-detalhe').style.display === 'block') fecharDetalhe();
    }
  });
  window._iahubAuthReady?.then(carregar) ?? carregar();
</script>
<div class="help-overlay" id="help-overlay" onclick="fecharAjuda()"></div>
<div class="help-drawer" id="help-drawer">
  <div class="help-drawer-header">
    <span class="help-drawer-title">Ajuda - Shadow NL-SQL</span>
    <button class="help-drawer-close" onclick="fecharAjuda()" title="Fechar">X</button>
  </div>
  <div class="help-drawer-body">
    <div class="help-tabs">
      <button class="help-tab active" type="button" data-help-tab="visao" onclick="trocarHelpTab('visao')">Visao</button>
      <button class="help-tab" type="button" data-help-tab="resultados" onclick="trocarHelpTab('resultados')">Resultados</button>
      <button class="help-tab" type="button" data-help-tab="operacao" onclick="trocarHelpTab('operacao')">Ligar e desligar</button>
    </div>
    <div class="help-panel active" data-help-panel="visao">
      <div class="help-section">
        <div class="help-section-title">O que e esta tela</div>
        <div class="help-item-desc">E a auditoria comparativa do Shadow Mode. Ela mostra qual consulta semantica o sistema teria escolhido e compara esse candidato com o SQL real gerado pela LLM na execucao de verdade.</div>
      </div>
      <div class="help-section">
        <div class="help-section-title">Objetivo</div>
        <div class="help-item-desc">Validar qualidade antes de colocar auto-reuse em producao. O candidato registrado aqui nao foi executado para o usuario; ele foi apenas medido contra o resultado real para formar estatistica confiavel.</div>
      </div>
      <div class="help-section">
        <div class="help-section-title">Como usar</div>
        <div class="help-item-desc">Filtre por periodo, modulo, resultado e classificacao. Comece pelos mismatches e templates invalidos; depois confira se os matches possuem amostra suficiente para justificar liberacao automatica.</div>
      </div>
    </div>
    <div class="help-panel" data-help-panel="resultados">
      <div class="help-section">
        <div class="help-section-title">Resultados</div>
        <div class="help-item-desc"><strong>Match template exato</strong> e o melhor sinal: o candidato tinha o mesmo template do SQL real. <strong>Match SQL aplicado</strong> indica SQL final equivalente apos parametros. <strong>Mismatch</strong> mostra divergencia. <strong>Template invalido</strong> aponta candidato inutilizavel. <strong>Sem candidato</strong> indica que nada passou do limiar.</div>
      </div>
      <div class="help-section">
        <div class="help-section-title">Exemplos praticos</div>
        <div class="help-item-desc">Se Financeiro tem muitos matches com score alto, essa faixa pode virar candidata a liberacao em Decisoes Automaticas. Se Compras tem mismatches, abra o detalhe e compare Template candidato x Template real para entender qual filtro, periodo ou agrupamento confundiu o ranking.</div>
      </div>
    </div>
    <div class="help-panel" data-help-panel="operacao">
      <div class="help-section">
        <div class="help-section-title">Configuracao recomendada para subir</div>
        <ul class="help-list">
          <li><strong>Shadow Mode ligado:</strong> grava candidatos, mede precisao e alimenta esta auditoria.</li>
          <li><strong>Auto-liberar por precisao ligado:</strong> quando atingir a amostra minima e a precisao configurada, o sistema marca a politica como <strong>liberado</strong>.</li>
          <li><strong>Auto-reuse semantico desligado:</strong> mantem producao usando IA + SQL Canonico, sem servir candidato semantico automaticamente.</li>
        </ul>
        <div class="help-callout">Essa combinacao permite aprender em producao sem mudar o comportamento das respostas.</div>
      </div>
      <div class="help-section">
        <div class="help-section-title">Quando quiser executar auto-reuse</div>
        <ul class="help-list">
          <li>Ligue <strong>Auto-reuse semantico</strong> em Aprendizado NL-SQL &gt; Decisoes Automaticas.</li>
          <li>A politica precisa estar persistida como <strong>liberado</strong>.</li>
          <li>O score do candidato precisa atingir o limite de execucao.</li>
          <li>O template precisa aplicar sem pendencias e o SQL precisa passar novamente pelos validadores.</li>
        </ul>
      </div>
      <div class="help-section">
        <div class="help-section-title">Como desligar</div>
        <ul class="help-list">
          <li>Para parar apenas a execucao automatica, desligue <strong>Auto-reuse semantico</strong>. O Shadow Mode continua gravando.</li>
          <li>Para parar tambem a coleta de aprendizado, desligue <strong>Shadow Mode</strong>.</li>
          <li>Como emergencia tecnica, a variavel <strong>IAC_NLSQL_SEMANTIC_AUTO_REUSE=0</strong> desliga o auto-reuse no ambiente.</li>
        </ul>
      </div>
    </div>
  </div>
</div>
</body>
</html>
</file>

<file path="apps/IA Command/frontend/admin-normalizacao.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Normalizacao Linguistica - IA Command</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css">
  <style>
    :root { --accent:#059669; --accent-light:#34d399; --accent-glow:rgba(5,150,105,.1); }
    .sidebar-logo .logo-icon { background:#059669 !important; }
    .topbar-menu-btn { flex-shrink:0;background:none;border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;color:var(--text-md);transition:background var(--transition),color var(--transition); }
    .topbar-menu-btn:hover { background:var(--bg-hover);color:var(--text-hi); }
    .topbar-title { flex:1;min-width:0;font-weight:700; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;margin-bottom:3px; }
    .page-title { font-size:20px;font-weight:700;color:var(--text-hi);line-height:1.25; }
    .page-subtitle { font-size:13px;color:var(--text-md);margin-top:4px; }
    .page-head { display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px; }
    .quick-panel { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:12px 16px;margin-bottom:16px;box-shadow:var(--shadow-sm); }
    .quick-row { display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
    .filter-area { padding-top:12px;border-top:1px solid var(--border);margin-top:12px; }
    .filter-status { font-size:12px;color:var(--text-lo);flex:1; }
    .quick-row .form-control { height:36px;font-size:13px; }
    .quick-row input.form-control { flex:1;min-width:200px; }
    .quick-row select.form-control { width:auto;min-width:145px; }
    .gp-wrap { margin-top:10px; }
    .gp-chips-row { display:flex;align-items:center;gap:6px;flex-wrap:wrap;position:relative; }
    .gp-label { font-size:11px;color:var(--text-lo);white-space:nowrap; }
    .grid-toolbar { display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg-card); }
    .grid-title { font-size:13px;font-weight:600;color:var(--text-hi); }
    .grid-meta { font-size:12px;color:var(--text-lo);margin-top:1px; }
    .badge-ativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:#dcfce7;color:#15803d; }
    .badge-inativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:var(--bg-hover);color:var(--text-lo); }
    .badge-tipo { display:inline-block;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:rgba(5,150,105,.12);color:#059669; }
    .btn-icon { background:none;border:none;cursor:pointer;padding:4px 6px;border-radius:5px;font-size:15px;transition:background .15s; }
    .btn-icon:hover { background:var(--bg-hover); }
    .tabulator { border:none !important;background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important;border-right:none !important;color:var(--text-lo) !important;font-size:11px !important;font-weight:700 !important;text-transform:uppercase;letter-spacing:.05em; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-base) !important;color:var(--text-hi) !important;border:1px solid var(--border) !important;border-radius:4px !important;font-size:11px !important;padding:3px 6px !important;width:100% !important; }
    .tabulator .tabulator-row { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important;cursor:pointer; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important;color:var(--text-md);font-size:13px;padding:10px 12px !important; }
    .save-feedback { font-size:13px;color:var(--text-lo); }
    .save-feedback.ok { color:#15803d; }
    .save-feedback.fail { color:#b91c1c; }
    .reg-field { margin-bottom:16px; }
    .reg-label { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:700;margin-bottom:5px; }
    /* Help drawer */
    .help-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:300;opacity:0;pointer-events:none;transition:opacity .25s;}
    .help-overlay.open{opacity:1;pointer-events:all;}
    .help-drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,100vw);background:var(--bg-card);border-left:1px solid var(--border);z-index:301;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);overflow:hidden;}
    .help-drawer.open{transform:translateX(0);}
    .help-drawer-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--border);flex-shrink:0;}
    .help-drawer-title{font-size:15px;font-weight:700;color:var(--text-hi);}
    .help-drawer-close{width:30px;height:30px;border:none;background:none;cursor:pointer;border-radius:6px;color:var(--text-lo);display:flex;align-items:center;justify-content:center;transition:background var(--transition),color var(--transition);}
    .help-drawer-close:hover{background:var(--bg-hover);color:var(--text-hi);}
    .help-drawer-body{flex:1;overflow-y:auto;}
    .help-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0;padding:0 22px;}
    .help-tab{padding:10px 14px;font-size:12px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;color:var(--text-lo);transition:color var(--transition),border-color var(--transition);}
    .help-tab.active{color:var(--accent);border-bottom-color:var(--accent);}
    .help-panel{display:none;padding:22px;} .help-panel.active{display:block;}
    .help-section{margin-bottom:28px;} .help-section:last-child{margin-bottom:0;}
    .help-section-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--accent);margin-bottom:12px;}
    .fmt-table{width:100%;border-collapse:collapse;font-size:12px;}
    .fmt-table th,.fmt-table td{padding:6px 10px;border:1px solid var(--border);text-align:left;}
    .fmt-table th{background:var(--bg-hover);font-weight:700;color:var(--text-hi);}
    .fmt-table td:first-child{white-space:nowrap;}
    .fmt-table code{background:var(--bg-hover);padding:1px 4px;border-radius:3px;font-size:11px;}
    .help-item{margin-bottom:14px;}
    .help-item-label{font-size:13px;font-weight:700;color:var(--text-hi);margin-bottom:4px;}
    .help-item-desc{font-size:13px;color:var(--text-md);line-height:1.65;}
    .help-tip{background:var(--accent-glow);border-left:3px solid var(--accent);border-radius:0 6px 6px 0;padding:10px 14px;font-size:13px;color:var(--text-md);line-height:1.6;margin-top:12px;}
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command ></span> Normalizacao Linguistica</span>
    </div>
    <div class="page-content">
      <div id="sec-lista">
        <div class="page-head">
          <div>
            <div class="page-kicker">Cadastros</div>
            <div class="page-title">Normalizacao Linguistica</div>
            <div class="page-subtitle">Corrija erros de digitacao, abreviacoes e variacoes antes da interpretacao da engine.</div>
          </div>
          <div style="display:flex;gap:8px;align-items:center">
