</div>
<aside class="help-drawer" id="help-drawer">
  <div class="help-head">
    <strong>Ajuda - Gloss&aacute;rio de Conceitos Anal&iacute;ticos</strong>
    <button class="modal-close" id="close-help" type="button">&times;</button>
  </div>
  <div class="help-body">
    <h3>O que e esta tela</h3>
    <p>Quando um usuario pergunta algo usando um termo de analise formal que o sistema ainda nao conhece (ex: "analise horizontal", "analise vertical", "indice de liquidez"), o IA Command consulta uma IA auxiliar so para obter a definicao tecnica do conceito — sem gerar SQL nesse momento — e guarda essa definicao aqui. Da proxima vez que qualquer empresa perguntar o mesmo termo, para o mesmo tipo de dado, o sistema reaproveita a definicao guardada em vez de consultar a IA de novo.</p>
    <h3>Por que o gloss&aacute;rio e global</h3>
    <p>Um conceito analitico (o que "analise horizontal" significa matematicamente) nao muda de uma empresa para outra — por isso ele fica guardado uma unica vez aqui, nao por empresa. So o dominio de dado ao qual o conceito foi aplicado (financeiro, compras, faturamento, estoque, etc.) varia; por isso o mesmo termo pode aparecer mais de uma vez na lista, uma linha para cada dominio diferente em que ja foi usado.</p>
    <h3>Coluna Dom&iacute;nio de dado</h3>
    <p>O sistema nunca adivinha a qual dado aplicar um conceito ambiguo (ex: uma pergunta generica sobre "movimentacoes do mes" sem dizer se e financeiro ou fluxo de caixa) — nesses casos ele pergunta ao usuario antes de gerar qualquer SQL, e so grava aqui depois que o dominio ja estiver claro.</p>
    <h3>Coluna Origem</h3>
    <p><strong>IA aprendeu:</strong> a definicao veio de uma consulta automatica a IA auxiliar, sem revisao humana previa. <strong>Editado no painel:</strong> um administrador ajustou manualmente o texto por esta tela.</p>
    <h3>Editar ou desativar um termo</h3>
    <p>Clique numa linha para abrir o detalhe. Voce pode corrigir o texto da definicao (por exemplo, se a IA auxiliar tiver aprendido algo impreciso) ou desativar o termo — um termo desativado deixa de ser reaproveitado e a proxima pergunta com aquele termo consulta a IA auxiliar novamente, gerando uma nova definicao.</p>
  </div>
</aside>
<script src="/js/auth.js"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
(function () {
  const state = {
    rows: [],
    view: [],
    sortField: 'criado_em',
    sortDir: 'desc',
    filters: {},
    mostrarInativos: false,
    detail: null,
  };
  const $ = id => document.getElementById(id);
  function esc(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }
  function fmtDate(value) {
    if (!value) return '-';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return value;
    const p = n => String(n).padStart(2, '0');
    return `${p(d.getDate())}/${p(d.getMonth() + 1)}/${d.getFullYear()} ${p(d.getHours())}:${p(d.getMinutes())}`;
  }
  function badge(value, type) {
    const cls = type || 'badge-muted';
    return `<span class="badge ${cls}">${esc(value || '-')}</span>`;
  }
  function origemLabel(value) {
    return { ia_aprendido: 'IA aprendeu', admin_manual: 'Editado no painel' }[value] || value || '-';
  }
  function origemBadge(value) {
    if (value === 'ia_aprendido') return badge('IA aprendeu', 'badge-purple');
    if (value === 'admin_manual') return badge('Editado no painel', 'badge-blue');
    return badge(value || '-', 'badge-muted');
  }
  function dominioLabel(value) {
    if (!value) return '(nao especificado)';
    return value.split('_x_').map(v => v.charAt(0).toUpperCase() + v.slice(1)).join(' x ');
  }
  function statusBadge(row) {
    return row.ativo ? badge('Ativo', 'badge-ok') : badge('Inativo', 'badge-muted');
  }
  function rowValue(row, field) {
    if (field === 'dominio') return dominioLabel(row.dominio);
    if (field === 'origem') return origemLabel(row.origem);
    if (field === 'ativo') return row.ativo ? 'ativo' : 'inativo';
    return row[field] ?? '';
  }
  function applyFilters() {
    const filters = state.filters;
    state.view = state.rows.filter(row => {
      if (!state.mostrarInativos && !row.ativo) return false;
      for (const [field, raw] of Object.entries(filters)) {
        const needle = String(raw || '').trim().toLowerCase();
        if (!needle) continue;
        const value = String(rowValue(row, field) || '').toLowerCase();
        if (!value.includes(needle)) return false;
      }
      return true;
    });
    sortRows();
    renderTable();
  }
  function sortRows() {
    const field = state.sortField;
    const dir = state.sortDir === 'asc' ? 1 : -1;
    state.view.sort((a, b) => {
      const av = String(rowValue(a, field) || '').toLowerCase();
      const bv = String(rowValue(b, field) || '').toLowerCase();
      return av.localeCompare(bv, 'pt-BR') * dir;
    });
  }
  function renderDataRow(row) {
    return `
      <tr class="data-row${row.ativo ? '' : ' inativo'}" data-id="${esc(row.id)}">
        <td class="col-action"><button class="icon-btn" type="button" title="Visualizar" data-id="${esc(row.id)}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </button></td>
        <td><span class="termo-label">${esc(row.termo)}</span></td>
        <td>${esc(dominioLabel(row.dominio))}</td>
        <td><div class="text-preview" title="${esc(row.definicao_tecnica || '')}">${esc(row.definicao_tecnica || '-')}</div></td>
        <td>${origemBadge(row.origem)}</td>
        <td>${esc(fmtDate(row.criado_em))}</td>
        <td>${statusBadge(row)}</td>
      </tr>`;
  }
  function renderTable() {
    const tbody = $('tbody');
    const rows = state.view;
    $('empty-state').style.display = rows.length ? 'none' : 'flex';
    $('count').textContent = `${rows.length} de ${state.rows.length} termo(s)`;
    tbody.innerHTML = rows.length ? rows.map(renderDataRow).join('') : '';
  }
  async function loadRows() {
    $('count').textContent = 'carregando...';
    const res = await fetch('/api/ia-command/admin/glossario?somenteAtivos=false&limit=1000');
    if (res.status === 401) { location.href = '/login.html'; return; }
    if (!res.ok) throw new Error(`Erro ${res.status} ao carregar o glossario.`);
    state.rows = await res.json();
    applyFilters();
  }
  async function refreshRows() {
    const btn = $('refresh-btn');
    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Atualizando...';
    try { await loadRows(); } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  }
  async function openDetail(id) {
    const res = await fetch(`/api/ia-command/admin/glossario/${encodeURIComponent(id)}`);
    if (res.status === 401) { location.href = '/login.html'; return; }
    if (!res.ok) return alert('Nao foi possivel carregar o termo.');
    const row = await res.json();
    state.detail = row;
    fillDetail(row);
    $('list-view').style.display = 'none';
    $('detail-view').classList.add('open');
  }
  function fillDetail(row) {
    $('detail-title').textContent = row.termo;
    $('detail-subtitle').textContent = `Dominio: ${dominioLabel(row.dominio)}`;
    const meta = [
      ['Termo', row.termo],
      ['Dominio de dado', dominioLabel(row.dominio)],
      ['Origem', origemLabel(row.origem)],
      ['Status', row.ativo ? 'Ativo' : 'Inativo'],
      ['Aprendido em', fmtDate(row.criado_em)],
      ['Ultima atualizacao', fmtDate(row.atualizado_em)],
    ];
    $('meta-grid').innerHTML = meta.map(([label, value]) => `<div class="meta-item"><span>${esc(label)}</span><strong>${esc(value)}</strong></div>`).join('');
    $('detail-pergunta').textContent = row.pergunta_origem || '(nao registrada)';
    $('detail-definicao').value = row.definicao_tecnica || '';
    $('save-hint').textContent = '';
    $('toggle-ativo-btn').textContent = row.ativo ? 'Desativar' : 'Reativar';
  }
  async function salvarDefinicao() {
    const row = state.detail;
    if (!row) return;
    const definicaoTecnica = $('detail-definicao').value.trim();
    if (!definicaoTecnica) return alert('A definicao nao pode ficar vazia.');
    const btn = $('save-btn');
    btn.disabled = true;
    btn.textContent = 'Salvando...';
    try {
      const res = await fetch(`/api/ia-command/admin/glossario/${encodeURIComponent(row.id)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ definicaoTecnica }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Nao foi possivel salvar.');
      $('save-hint').textContent = 'Alteracao salva.';
      await loadRows();
      await openDetail(row.id);
    } catch (err) {
      alert(err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Salvar alteracao';
    }
  }
  async function alternarAtivo() {
    const row = state.detail;
    if (!row) return;
    const acao = row.ativo ? 'desativar' : 'reativar';
    const res = await fetch(`/api/ia-command/admin/glossario/${encodeURIComponent(row.id)}/${acao}`, { method: 'POST' });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) return alert(data.error || `Nao foi possivel ${acao}.`);
    await loadRows();
    await openDetail(row.id);
  }
  function bindEvents() {
    $('refresh-btn').addEventListener('click', () => refreshRows().catch(err => alert(err.message)));
    $('toggle-inativos-btn').addEventListener('click', () => {
      state.mostrarInativos = !state.mostrarInativos;
      $('toggle-inativos-btn').textContent = state.mostrarInativos ? 'Ocultar inativos' : 'Mostrar inativos';
      applyFilters();
    });
    $('help-btn').addEventListener('click', () => $('help-drawer').classList.add('open'));
    $('close-help').addEventListener('click', () => $('help-drawer').classList.remove('open'));
    $('back-btn').addEventListener('click', () => {
      $('detail-view').classList.remove('open');
      $('list-view').style.display = '';
      state.detail = null;
    });
    $('save-btn').addEventListener('click', () => salvarDefinicao().catch(err => alert(err.message)));
    $('cancel-edit-btn').addEventListener('click', () => { if (state.detail) fillDetail(state.detail); });
    $('toggle-ativo-btn').addEventListener('click', () => alternarAtivo().catch(err => alert(err.message)));
    document.querySelectorAll('[data-filter]').forEach(el => {
      el.addEventListener('input', () => { state.filters[el.dataset.filter] = el.value; applyFilters(); });
      el.addEventListener('change', () => { state.filters[el.dataset.filter] = el.value; applyFilters(); });
    });
    document.querySelectorAll('th.sortable').forEach(th => th.addEventListener('click', () => {
      const field = th.dataset.sort;
      if (state.sortField === field) state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
      else { state.sortField = field; state.sortDir = 'asc'; }
      applyFilters();
    }));
    $('tbody').addEventListener('click', event => {
      const tr = event.target.closest('tr.data-row');
      if (tr) openDetail(tr.dataset.id).catch(err => alert(err.message));
    });
  }
  bindEvents();
  window._iahubAuthReady?.then(() => loadRows().catch(err => alert(err.message))) ?? loadRows().catch(err => alert(err.message));
})();
</script>
</body>
</html>
</file>

