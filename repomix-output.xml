<file path="modules/empresas/frontend/empresas.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Empresas — IAHub</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css">
  <style>
    .form-row      { display:grid;grid-template-columns:1fr 1fr;gap:16px; }
    .btn-icon      { background:none;border:none;cursor:pointer;padding:5px 8px;border-radius:6px;font-size:16px;transition:background .15s; }
    .btn-icon:hover { background:var(--bg-hover); }
    .empty-state   { text-align:center;padding:60px 20px;color:var(--text-lo); }
    .empty-state div { font-size:40px;margin-bottom:12px; }
    .emp-tab-panel { display:none; }
    .emp-tab-panel.active { display:block; }
    .identity-grid { display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px; }
    .identity-card { border:1px solid var(--border);border-radius:8px;padding:14px;background:var(--bg-card); }
    .identity-title { font-size:13px;font-weight:700;color:var(--text-hi);margin-bottom:4px; }
    .identity-hint { font-size:11.5px;color:var(--text-md);line-height:1.45;margin-bottom:10px; }
    .identity-preview { height:130px;border:1px dashed var(--border-hi);border-radius:8px;background:var(--bg-base);display:flex;align-items:center;justify-content:center;overflow:hidden;color:var(--text-lo);font-size:12px;margin-bottom:10px;text-align:center;padding:10px; }
    .identity-preview.logo img { max-width:90%;max-height:90%;object-fit:contain; }
    .identity-preview.background img { width:100%;height:100%;object-fit:cover; }
    .identity-actions { display:flex;gap:8px;flex-wrap:wrap; }
    .identity-actions .btn { padding:6px 10px;font-size:12px; }
    .identity-locked { border:1px dashed var(--border-hi);border-radius:8px;padding:12px;color:var(--text-md);font-size:12px;background:var(--bg-base);margin-bottom:16px; }
    .page-head { display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;margin-bottom:3px; }
    .page-title { font-size:20px;font-weight:700;color:var(--text-hi);line-height:1.25; }
    .page-subtitle { font-size:13px;color:var(--text-md);margin-top:4px; }
    .quick-panel { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;margin-bottom:14px;box-shadow:var(--shadow-sm); }
    .quick-row { display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
    .quick-search { flex:1;min-width:280px; }
    .quick-row .form-control { height:36px;margin:0;font-size:13px; }
    .quick-row select.form-control { width:auto;min-width:145px; }
    .grid-toolbar { display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg-card); }
    .grid-title { font-size:13px;font-weight:600;color:var(--text-hi); }
    .grid-meta { font-size:12px;color:var(--text-lo);margin-top:1px; }
    .empresa-editor-tabs { display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:18px; }
    .empresa-editor-tab { background:none;border:none;color:var(--text-md);cursor:pointer;font-size:13px;font-weight:600;padding:10px 14px;border-bottom:2px solid transparent; }
    .empresa-editor-tab.active { color:var(--accent);border-bottom-color:var(--accent); }
    .empresa-summary { display:grid;gap:12px; }
    .empresa-summary-item { border:1px solid var(--border);border-radius:8px;background:var(--bg-base);padding:12px; }
    .empresa-summary-label { color:var(--text-lo);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px; }
    .empresa-summary-value { color:var(--text-hi);font-size:13px;font-weight:600;line-height:1.35;word-break:break-word; }
    .empresa-editor-note { color:var(--text-md);font-size:12px;line-height:1.5;margin-top:10px; }
    @media (max-width: 920px) {
      .page-head { flex-direction:column; }
      .page-head .btn { align-self:flex-start; }
      .editor-actions { width:100%;justify-content:flex-start; }
    }
    @media (max-width: 720px) { .form-row,.identity-grid { grid-template-columns:1fr; } }
    @media (max-width: 560px) {
      .quick-search { min-width:100%; }
      .quick-row select.form-control { width:100%; }
    }
    /* ── Group panel ── */
    .gp-wrap { margin-top:12px;padding-top:12px;border-top:1px solid var(--border); }
    .gp-chips-row { display:flex;align-items:center;gap:6px;flex-wrap:wrap;position:relative;margin-bottom:8px; }
    .gp-label     { font-size:11px;color:var(--text-lo);white-space:nowrap; }
    /* ── Tabulator overrides ── */
    .tabulator { border:none !important; background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important; border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important; border-right:none !important; color:var(--text-lo) !important; font-size:11px !important; font-weight:700 !important; text-transform:uppercase; letter-spacing:.05em; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-body) !important; color:var(--text-hi) !important; border:1px solid var(--border) !important; border-radius:4px !important; font-size:11px !important; padding:3px 6px !important; width:100% !important; }
    .tabulator .tabulator-row { background:var(--bg-card) !important; border-bottom:1px solid var(--border) !important; cursor:pointer; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important; color:var(--text-md); font-size:13px; padding:10px 12px !important; }
    .tabulator .tabulator-row.tabulator-group { background:var(--bg-body) !important; border-bottom:1px solid var(--border) !important; font-size:12px !important; font-weight:700 !important; color:var(--text-lo) !important; }
    .tabulator .tabulator-placeholder { background:var(--bg-card) !important; }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IAHub</span>
    </div>
    <div class="sidebar-nav">
    </div>
    <div class="sidebar-footer">
    </div>
  </nav>
  <div class="main">
    <div class="topbar">
      <span class="topbar-title"><span class="topbar-path">Configurador › Administração ›</span> Empresas</span>
    </div>
    <div class="page-content">
      <div id="list-view">
      <div class="page-head">
        <div>
          <div class="page-kicker">Administração</div>
          <div class="page-title">Cadastro de Empresas</div>
          <div class="page-subtitle">Gerencie empresas, documentos e identidade visual usada no acesso ao sistema.</div>
        </div>
        <button class="btn btn-primary" onclick="abrirModal()">＋ Nova Empresa</button>
      </div>
      <div class="quick-panel">
        <div class="quick-row">
          <input id="q-busca" class="form-control quick-search" placeholder="Buscar por razão social, documento, e-mail ou telefone..." oninput="aplicarFiltrosRapidos()">
          <select id="q-tipo" class="form-control" onchange="aplicarFiltrosRapidos()">
            <option value="">Todos os tipos</option>
            <option value="CPF">CPF</option>
            <option value="CNPJ">CNPJ</option>
          </select>
          <button class="btn btn-ghost" onclick="limparFiltrosRapidos()">Limpar</button>
        </div>
        <div class="gp-wrap">
          <div class="gp-chips-row" id="gp-chips">
            <span class="gp-label">Agrupar por:</span>
          </div>
          <div id="gp-dz"></div>
        </div>
      </div>
      <div class="card" style="padding:0;overflow:hidden">
        <div class="grid-toolbar">
          <div>
            <div class="grid-title">Empresas cadastradas</div>
            <div id="count" class="grid-meta"></div>
          </div>
        </div>
        <div id="grid"></div>
      </div>
      </div>
      <section id="editor-view" class="editor-shell d-none">
        <div class="editor-actionbar">
          <div class="editor-actionbar-title">
            <strong id="modal-title">Nova Empresa</strong>
            <span id="editor-status">Preencha os dados cadastrais e salve para liberar a identidade visual.</span>
          </div>
          <div class="editor-actions">
            <button class="btn btn-ghost" type="button" onclick="fecharModal()">Cancelar</button>
            <button class="btn btn-primary" type="button" id="btn-salvar" onclick="salvar()">Salvar</button>
          </div>
        </div>
        <div class="editor-grid editor-grid-wide">
          <main class="editor-main">
            <div class="empresa-editor-tabs">
              <button type="button" class="empresa-editor-tab active" id="tab-dados" onclick="mudarTabEmpresa('dados')">Dados cadastrais</button>
              <button type="button" class="empresa-editor-tab" id="tab-identidade" onclick="mudarTabEmpresa('identidade')">Identidade visual</button>
            </div>
            <div id="panel-dados" class="emp-tab-panel active">
              <section class="form-section">
                <div class="form-section-header">
                  <div>
                    <div class="form-section-title">Dados principais</div>
                    <div class="form-section-subtitle">Identificação fiscal e informações de contato da empresa.</div>
                  </div>
                </div>
                <div class="form-section-body">
                  <div class="form-row" style="margin-bottom:16px">
                    <div class="form-group">
                      <label class="form-label">Razão Social <span style="color:#dc2626">*</span></label>
                      <input id="f-razao" type="text" class="form-control" placeholder="Nome da empresa ou produtor rural" oninput="atualizarCabecalhoEmpresa()">
                    </div>
                    <div class="form-group">
                      <label class="form-label">CPF / CNPJ <span style="color:#dc2626">*</span></label>
                      <input id="f-doc" type="text" class="form-control" placeholder="000.000.000-00 ou 00.000.000/0001-00"
                             oninput="maskDoc(this); atualizarCabecalhoEmpresa()" inputmode="numeric" maxlength="18">
                    </div>
                  </div>
                  <div class="form-row" style="margin-bottom:16px">
                    <div class="form-group">
                      <label class="form-label">Telefone</label>
                      <input id="f-tel" type="text" class="form-control" placeholder="(00) 00000-0000">
                    </div>
                    <div class="form-group">
                      <label class="form-label">E-mail</label>
                      <input id="f-email" type="email" class="form-control" placeholder="contato@empresa.com.br">
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">Site</label>
                      <input id="f-site" type="text" class="form-control" placeholder="https://empresa.com.br">
                    </div>
                    <div class="form-group">
                      <label class="form-label">Endereço</label>
                      <input id="f-end" type="text" class="form-control" placeholder="Rua, número, cidade - UF">
                    </div>
                  </div>
                </div>
              </section>
            </div>
            <div id="panel-identidade" class="emp-tab-panel">
              <section class="form-section">
                <div class="form-section-header">
                  <div>
                    <div class="form-section-title">Identidade visual</div>
                    <div class="form-section-subtitle">Imagens usadas para personalizar a experiência de login.</div>
                  </div>
                </div>
                <div class="form-section-body">
                  <div id="identity-locked" class="identity-locked">Salve a empresa antes de enviar as imagens da tela de login.</div>
                  <div class="identity-grid">
                    <div class="identity-card">
                      <div class="identity-title">Logomarca acima do login</div>
                      <div class="identity-hint">Tamanho ideal: 400 x 200 px. Use PNG com fundo transparente, JPG ou WEBP. Limite: 4 MB.</div>
                      <div class="identity-preview logo" id="preview-logo">Nenhuma logomarca enviada.</div>
                      <input id="file-logo" type="file" accept="image/png,image/jpeg,image/webp" class="d-none" onchange="uploadIdentidade('logo', this)">
                      <div class="identity-actions">
                        <button type="button" class="btn btn-ghost" onclick="selecionarArquivoIdentidade('logo')">Enviar imagem</button>
                        <button type="button" class="btn btn-danger" onclick="removerIdentidade('logo')">Remover</button>
                      </div>
                    </div>
                    <div class="identity-card">
                      <div class="identity-title">Imagem lateral do login</div>
                      <div class="identity-hint">Tamanho ideal: 1920 x 1080 px, proporção 16:9. Prefira JPG ou WEBP. Limite: 6 MB.</div>
                      <div class="identity-preview background" id="preview-background">Nenhuma imagem lateral enviada.</div>
                      <input id="file-background" type="file" accept="image/png,image/jpeg,image/webp" class="d-none" onchange="uploadIdentidade('background', this)">
                      <div class="identity-actions">
                        <button type="button" class="btn btn-ghost" onclick="selecionarArquivoIdentidade('background')">Enviar imagem</button>
                        <button type="button" class="btn btn-danger" onclick="removerIdentidade('background')">Remover</button>
                      </div>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Texto sobre a imagem lateral</label>
                    <textarea id="f-login-slogan" class="form-control" rows="2" maxlength="180" placeholder="Frase institucional que aparecerá sobre a imagem lateral"></textarea>
                    <div class="form-hint">Opcional. Será usado na fase 2, quando aplicarmos o novo layout do login.</div>
                  </div>
                </div>
              </section>
            </div>
            <div id="form-error" class="login-error" style="display:none;margin-top:12px"></div>
          </main>
          <aside class="editor-side">
            <section class="form-section">
              <div class="form-section-header">
                <div>
                  <div class="form-section-title">Resumo do registro</div>
                  <div class="form-section-subtitle">Referência rápida para conferência durante a edição.</div>
                </div>
              </div>
              <div class="form-section-body">
                <div class="empresa-summary">
                  <div class="empresa-summary-item">
                    <div class="empresa-summary-label">Código</div>
                    <div class="empresa-summary-value" id="meta-registro">Novo</div>
                  </div>
                  <div class="empresa-summary-item">
                    <div class="empresa-summary-label">Empresa</div>
                    <div class="empresa-summary-value" id="meta-razao">Nova Empresa</div>
                  </div>
                  <div class="empresa-summary-item">
                    <div class="empresa-summary-label">Documento</div>
                    <div class="empresa-summary-value" id="meta-doc">-</div>
                  </div>
                  <div class="empresa-summary-item">
                    <div class="empresa-summary-label">Identidade visual</div>
                    <div class="empresa-summary-value" id="meta-identidade">Disponível após salvar</div>
                  </div>
                </div>
                <p class="empresa-editor-note">As imagens de identidade visual continuam liberadas apenas depois que a empresa possui um código salvo.</p>
              </div>
            </section>
          </aside>
        </div>
      </section>
    </div>
  </div>
</div>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/sidebar.js"></script>
<script src="/js/grid-group-panel.js"></script>
<script>
  let empresas = [];
  let editId   = null;
  let table    = null;
  let _quickFilterFn = null;
  const gp = createGroupPanel({
    chipsRowId: 'gp-chips',
    dropZoneId: 'gp-dz',
    storageKey: 'empresas_group_fields',
    getTable:   () => table,
  });
  // ── Máscara CPF / CNPJ ──────────────────────────────────────────────────────
  function maskDoc(input) {
    let v = input.value.replace(/\D/g, '').substring(0, 14);
    if (v.length <= 11) {
      v = v.replace(/(\d{3})(\d)/,       '$1.$2');
      v = v.replace(/(\d{3})(\d)/,       '$1.$2');
      v = v.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
    } else {
      v = v.replace(/(\d{2})(\d)/,       '$1.$2');
      v = v.replace(/(\d{3})(\d)/,       '$1.$2');
      v = v.replace(/(\d{3})(\d)/,       '$1/$2');
      v = v.replace(/(\d{4})(\d{1,2})$/, '$1-$2');
    }
    input.value = v;
  }
  function formatarDoc(doc) {
    if (!doc) return '';
    const v = String(doc).replace(/\D/g, '');
    if (v.length <= 11) {
      return v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
    }
    return v.replace(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{1,2})/, '$1.$2.$3/$4-$5');
  }
  function soNumeros(str) { return String(str || '').replace(/\D/g, ''); }
  function labelEmpresas(qtd) {
    return qtd === 1 ? '1 empresa' : `${qtd} empresas`;
  }
  function aplicarFiltrosRapidos() {
    if (!table) return;
    const busca = document.getElementById('q-busca').value.trim().toLowerCase();
    const tipo  = document.getElementById('q-tipo').value;
    if (_quickFilterFn) {
      table.removeFilter(_quickFilterFn);
      _quickFilterFn = null;
    }
    if (!busca && !tipo) return;
    _quickFilterFn = rowData => {
      if (tipo && rowData.tipo_doc !== tipo) return false;
      if (busca) {
        const termos = [
          rowData.razao_social || '',
          rowData.documento || '',
          rowData.documento_fmt || '',
          rowData.telefone || '',
          rowData.email || '',
          rowData.site || '',
        ].join(' ').toLowerCase();
        if (!termos.includes(busca)) return false;
      }
      return true;
    };
    table.addFilter(_quickFilterFn);
  }
  function limparFiltrosRapidos() {
    document.getElementById('q-busca').value = '';
    document.getElementById('q-tipo').value = '';
    aplicarFiltrosRapidos();
  }
  // ── Tabulator ───────────────────────────────────────────────────────────────
  function initTabulator(dados) {
    table = new Tabulator('#grid', {
      data: dados,
      layout: 'fitColumns',
      height: 'calc(100vh - 315px)',
      groupStartOpen: true,
      groupBy: gp.getActiveFields(),
      placeholder: '<div class="empty-state"><div>🏢</div><strong style="color:var(--text-md)">Nenhuma empresa cadastrada</strong></div>',
      columns: [
        {
          title: '#', field: 'id', width: 60, headerFilter: false, groupable: false,
          formatter: cell => `<span style="color:var(--text-lo);font-size:12px">${cell.getValue()}</span>`,
        },
        {
          title: 'Razão Social', field: 'razao_social', minWidth: 200, headerFilter: true,
          formatter: cell => {
            const row  = cell.getRow().getData();
            const site = row.site
              ? `<br><a href="${esc(row.site)}" target="_blank" style="font-size:11px;color:var(--accent);text-decoration:none">${esc(row.site)}</a>`
              : '';
            return `<strong style="color:var(--text-hi)">${esc(row.razao_social)}</strong>${site}`;
          },
        },
        {
          title: 'Tipo', field: 'tipo_doc', width: 80,
          headerFilter: 'select',
          headerFilterParams: { values: { '': 'Todos', CPF: 'CPF', CNPJ: 'CNPJ' } },
        },
        {
          title: 'CPF / CNPJ', field: 'documento_fmt', width: 170, headerFilter: true,
          formatter: cell => {
            const v = cell.getValue();
            return v
              ? `<span style="font-family:monospace;font-size:12px;color:var(--text-md)">${v}</span>`
              : `<span style="color:var(--text-lo)">—</span>`;
          },
        },
        {
          title: 'Telefone', field: 'telefone', headerFilter: true,
          formatter: cell => cell.getValue() || `<span style="color:var(--text-lo)">—</span>`,
        },
        {
          title: 'E-mail', field: 'email', headerFilter: true,
          formatter: cell => cell.getValue() || `<span style="color:var(--text-lo)">—</span>`,
        },
        {
          title: 'Ações', headerFilter: false, width: 90, hozAlign: 'right',
          formatter: cell => {
            const row  = cell.getRow().getData();
            const id   = row.id;
            const nome = esc(row.razao_social);
            return `<button class="btn-icon" onclick="event.stopPropagation();editar(${id})" title="Editar">✏️</button>
                    <button class="btn-icon" onclick="event.stopPropagation();confirmarExcluir(${id},'${nome}')" title="Excluir" style="color:#dc2626">🗑</button>`;
          },
        },
      ],
      rowClick: (_e, row) => editar(row.getData().id),
      dataFiltered: (_filters, rows) => {
        const total = dados.length;
        const qtd = rows?.length ?? total;
        document.getElementById('count').textContent =
          qtd === total ? labelEmpresas(qtd) : `${qtd} de ${total} empresas`;
      },
    });
  }
  // ── Carregamento ────────────────────────────────────────────────────────────
  async function carregar() {
    try {
      const res  = await fetch('/api/empresas');
      empresas   = await res.json();
      const dados = empresas.map(e => ({
        ...e,
        tipo_doc:     soNumeros(e.documento || '').length <= 11 ? 'CPF' : 'CNPJ',
        documento_fmt: formatarDoc(e.documento),
      }));
      if (table) {
        table.replaceData(dados);
      } else {
        initTabulator(dados);
        setTimeout(() => gp.refresh(), 0);
      }
      document.getElementById('count').textContent = labelEmpresas(dados.length);
      aplicarFiltrosRapidos();
    } catch (_) {
      console.error('Erro ao carregar empresas.');
    }
  }
  // ── Editor ──────────────────────────────────────────────────────────────────
  function atualizarCabecalhoEmpresa() {
    const nome = document.getElementById('f-razao').value.trim() || 'Nova Empresa';
    const doc  = document.getElementById('f-doc').value.trim();
    const titulo = editId ? `#${editId} - ${nome}` : `Novo registro - ${nome}`;
    document.getElementById('modal-title').textContent = titulo;
    document.getElementById('meta-registro').textContent = editId ? `#${editId}` : 'Novo';
    document.getElementById('meta-razao').textContent = nome;
    document.getElementById('meta-doc').textContent = doc || '-';
    document.getElementById('meta-identidade').textContent = editId ? 'Disponível para envio' : 'Disponível após salvar';
    document.getElementById('editor-status').textContent = editId
      ? 'Revise os dados cadastrais ou atualize a identidade visual.'
      : 'Preencha os dados cadastrais e salve para liberar a identidade visual.';
  }
  function abrirModal(empresa = null) {
    editId = empresa?.id ?? null;
    document.getElementById('f-razao').value = empresa?.razao_social ?? '';
    document.getElementById('f-doc').value   = formatarDoc(empresa?.documento ?? '');
    document.getElementById('f-tel').value   = empresa?.telefone     ?? '';
    document.getElementById('f-email').value = empresa?.email        ?? '';
    document.getElementById('f-site').value  = empresa?.site         ?? '';
    document.getElementById('f-end').value   = empresa?.endereco     ?? '';
    document.getElementById('f-login-slogan').value = empresa?.login_slogan ?? '';
    mudarTabEmpresa('dados');
    renderIdentidade(empresa || {});
    atualizarCabecalhoEmpresa();
    document.getElementById('form-error').style.display = 'none';
    document.getElementById('list-view').classList.add('d-none');
    document.getElementById('editor-view').classList.remove('d-none');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => document.getElementById('f-razao').focus(), 50);
  }
  function fecharModal() {
    document.getElementById('editor-view').classList.add('d-none');
    document.getElementById('list-view').classList.remove('d-none');
    editId = null;
  }
  function editar(id) {
    const e = empresas.find(x => x.id === id);
    if (e) abrirModal(e);
  }
  async function confirmarExcluir(id, nome) {
    if (!confirm(`Excluir a empresa "${nome}"?\nEsta ação não pode ser desfeita.`)) return;
    const res = await fetch(`/api/empresas/${id}`, { method: 'DELETE' });
    if (res.ok) { carregar(); }
    else {
      const err = await res.json().catch(() => ({}));
      alert(err.error || 'Erro ao excluir empresa.');
    }
  }
  async function salvar() {
    const errEl = document.getElementById('form-error');
    errEl.style.display = 'none';
    const razao = document.getElementById('f-razao').value.trim();
    const doc   = soNumeros(document.getElementById('f-doc').value);
    if (!razao) {
      errEl.textContent = 'Razão Social é obrigatória.';
      errEl.style.display = 'block';
      document.getElementById('f-razao').focus();
      return;
    }
    if (!doc) {
      errEl.textContent = 'CPF / CNPJ é obrigatório.';
      errEl.style.display = 'block';
      document.getElementById('f-doc').focus();
      return;
    }
    const dados = {
      razao_social: razao,
      documento:    doc,
      telefone:     document.getElementById('f-tel').value.trim(),
      email:        document.getElementById('f-email').value.trim(),
      site:         document.getElementById('f-site').value.trim(),
      endereco:     document.getElementById('f-end').value.trim(),
      login_slogan: document.getElementById('f-login-slogan').value.trim(),
    };
    const btn = document.getElementById('btn-salvar');
    btn.textContent = 'Salvando...';
    btn.disabled    = true;
    try {
      const url    = editId ? `/api/empresas/${editId}` : '/api/empresas';
      const method = editId ? 'PUT' : 'POST';
      const res    = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(dados),
      });
      if (res.ok) {
        const salvo = await res.json();
        if (!editId) editId = salvo.id;
        fecharModal();
        carregar();
      }
      else {
        const err = await res.json().catch(() => ({}));
        errEl.textContent = err.error || 'Erro ao salvar empresa.';
        errEl.style.display = 'block';
      }
    } finally {
      btn.textContent = 'Salvar';
      btn.disabled    = false;
    }
  }
  function esc(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function mudarTabEmpresa(tab) {
    document.getElementById('tab-dados').classList.toggle('active', tab === 'dados');
    document.getElementById('tab-identidade').classList.toggle('active', tab === 'identidade');
    document.getElementById('panel-dados').classList.toggle('active', tab === 'dados');
    document.getElementById('panel-identidade').classList.toggle('active', tab === 'identidade');
  }
  function renderIdentidade(empresa) {
    document.getElementById('identity-locked').style.display = editId ? 'none' : 'block';
    renderPreview('logo', empresa.login_logo_url);
    renderPreview('background', empresa.login_background_url);
  }
  function renderPreview(tipo, url) {
    const el = document.getElementById(`preview-${tipo}`);
    if (!url) {
      el.innerHTML = tipo === 'logo' ? 'Nenhuma logomarca enviada.' : 'Nenhuma imagem lateral enviada.';
      return;
    }
    el.innerHTML = `<img src="${esc(url)}" alt="">`;
  }
  function selecionarArquivoIdentidade(tipo) {
    if (!editId) {
      alert('Salve a empresa antes de enviar imagens.');
      return;
    }
    document.getElementById(`file-${tipo}`).click();
  }
  function lerArquivoComoDataUrl(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = () => reject(reader.error);
      reader.readAsDataURL(file);
    });
  }
  async function uploadIdentidade(tipo, input) {
    const file = input.files?.[0];
    input.value = '';
    if (!file || !editId) return;
    const limite = tipo === 'logo' ? 4 * 1024 * 1024 : 6 * 1024 * 1024;
    if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) {
      alert('Envie uma imagem em PNG, JPG ou WEBP.');
      return;
    }
    if (file.size > limite) {
      alert(`Arquivo muito grande. Limite: ${Math.round(limite / 1024 / 1024)} MB.`);
      return;
    }
    try {
      const dataUrl = await lerArquivoComoDataUrl(file);
      const res = await fetch(`/api/empresas/${editId}/identidade`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo, dataUrl }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Erro ao enviar imagem.');
      renderPreview(tipo, data.url);
      const idx = empresas.findIndex(e => e.id === editId);
      if (idx >= 0 && data.empresa) empresas[idx] = data.empresa;
      carregar();
    } catch (err) {
      alert(err.message || 'Erro ao enviar imagem.');
    }
  }
  async function removerIdentidade(tipo) {
    if (!editId) {
      alert('Salve a empresa antes de remover imagens.');
      return;
    }
    if (!confirm('Remover esta imagem da identidade visual?')) return;
    try {
      const res = await fetch(`/api/empresas/${editId}/identidade/${tipo}`, { method: 'DELETE' });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Erro ao remover imagem.');
      renderPreview(tipo, '');
      const idx = empresas.findIndex(e => e.id === editId);
      if (idx >= 0 && data.empresa) empresas[idx] = data.empresa;
      carregar();
    } catch (err) {
      alert(err.message || 'Erro ao remover imagem.');
    }
  }
  document.addEventListener('DOMContentLoaded', carregar);
</script>
</body>
