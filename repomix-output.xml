    .badge-cand    { background:rgba(37,99,235,.1);color:var(--accent);border-radius:20px;padding:2px 9px;font-size:11px;font-weight:600; }
    .vaga-card.selecionada { border-color:var(--accent);box-shadow:0 0 0 2px rgba(37,99,235,.15); }
