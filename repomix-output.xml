    .grid-meta { font-size:12px;color:var(--text-lo);margin-top:1px; }
    .badge-ativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:#dcfce7;color:#15803d; }
    .badge-inativo { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:var(--bg-hover);color:var(--text-lo); }
    .btn-icon { background:none;border:none;cursor:pointer;padding:4px 6px;border-radius:5px;font-size:15px;transition:background .15s; }
    .btn-icon:hover { background:var(--bg-hover); }
    .tabulator { border:none !important;background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important;border-right:none !important;color:var(--text-lo) !important;font-size:11px !important;font-weight:700 !important;text-transform:uppercase;letter-spacing:.05em; }
    .tabulator .tabulator-row { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important;cursor:pointer; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important;color:var(--text-md);font-size:13px;padding:10px 12px !important; }
    .save-feedback { font-size:13px;color:var(--text-lo); }
    .save-feedback.ok { color:#15803d; }
    .save-feedback.fail { color:#b91c1c; }
    .reg-field { margin-bottom:16px; }
    .reg-label { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:700;margin-bottom:5px; }
    .linked-list { display:grid;gap:8px; }
    .linked-item { display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;border:1px solid var(--border);border-radius:8px;padding:10px 12px;background:var(--bg-card); }
    .linked-title { font-size:13px;font-weight:700;color:var(--text-hi); }
    .linked-sub { font-size:12px;color:var(--text-lo);margin-top:2px; }
    .inline-form { display:grid;grid-template-columns:minmax(240px,1fr) 1fr auto;gap:8px;align-items:end;margin-top:12px; }
    .filter-area { padding-top:12px;border-top:1px solid var(--border);margin-top:12px; }
    .filter-status { font-size:12px;color:var(--text-lo);flex:1; }
    .quick-row input.form-control { flex:1;min-width:200px; }
    .quick-row select.form-control { width:auto;min-width:145px; }
    .gp-wrap { margin-top:10px; }
    .gp-chips-row { display:flex;align-items:center;gap:6px;flex-wrap:wrap;position:relative; }
    .gp-label { font-size:11px;color:var(--text-lo);white-space:nowrap; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-base) !important;color:var(--text-hi) !important;border:1px solid var(--border) !important;border-radius:4px !important;font-size:11px !important;padding:3px 6px !important;width:100% !important; }
    .tabulator .tabulator-row.tabulator-group { background:var(--bg-base) !important;border-bottom:1px solid var(--border) !important;font-size:12px !important;font-weight:700 !important;color:var(--text-lo) !important; }
    .tabulator .tabulator-placeholder { background:var(--bg-card) !important; }
    .form-tabs { display:flex;gap:8px;flex-wrap:wrap;border-bottom:1px solid var(--border);margin-top:18px; }
    .form-tab-btn { border:0;background:transparent;color:var(--text-md);font-size:13px;font-weight:700;padding:10px 12px;border-bottom:2px solid transparent;cursor:pointer; }
    .form-tab-btn:hover { color:var(--text-hi); }
    .form-tab-btn.active { color:var(--accent);border-bottom-color:var(--accent); }
    .form-tab-btn:disabled { opacity:.45;cursor:not-allowed; }
    .tab-panel { display:none;margin-top:20px; }
    .tab-panel.active { display:block; }
    .help-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:300;opacity:0;pointer-events:none;transition:opacity .25s;}
    .help-overlay.open{opacity:1;pointer-events:all;}
    .help-drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,100vw);background:var(--bg-card);border-left:1px solid var(--border);z-index:301;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);overflow:hidden;}
    .help-drawer.open{transform:translateX(0);}
    .help-drawer-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--border);flex-shrink:0;}
    .help-drawer-title{font-size:15px;font-weight:700;color:var(--text-hi);}
    .help-drawer-close{width:30px;height:30px;border:none;background:none;cursor:pointer;border-radius:6px;color:var(--text-lo);display:flex;align-items:center;justify-content:center;}
    .help-drawer-close:hover{background:var(--bg-hover);color:var(--text-hi);}
    .help-drawer-body{flex:1;overflow-y:auto;padding:22px;}
    .help-section{margin-bottom:28px;}
    .help-section-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--accent);margin-bottom:12px;}
    .help-item{margin-bottom:14px;}
    .help-item-label{font-size:13px;font-weight:700;color:var(--text-hi);margin-bottom:4px;}
    .help-item-desc{font-size:13px;color:var(--text-md);line-height:1.65;}
    .help-tip{background:var(--accent-glow);border-left:3px solid var(--accent);border-radius:0 6px 6px 0;padding:10px 14px;font-size:13px;color:var(--text-md);line-height:1.6;margin-top:12px;}
    @media(max-width:720px){ .inline-form { grid-template-columns:1fr; } }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">⚡</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command ›</span> Canais WhatsApp</span>
    </div>
    <div class="page-content">
      <div id="sec-lista">
        <div class="page-head">
          <div>
            <div class="page-kicker">WhatsApp</div>
            <div class="page-title">Canais WhatsApp</div>
            <div class="page-subtitle">Cadastre canais e vincule apenas empresas que podem compartilhar o mesmo numero.</div>
          </div>
          <button class="btn btn-primary" onclick="abrirFormulario()">+ Novo Canal</button>
        </div>
        <div class="quick-panel">
          <div class="quick-row">
            <button class="btn btn-ghost" id="btn-filtros" onclick="toggleFiltros()">+ Mostrar filtros</button>
            <span class="filter-status" id="filter-status">Sem filtros ou agrupamentos ativos</span>
          </div>
          <div class="filter-area" id="filter-area" style="display:none">
            <div class="quick-row" style="margin-bottom:10px">
              <input id="q-busca" class="form-control" placeholder="Buscar por nome, numero ou empresa..." oninput="filtrar()">
              <select id="q-ativo" class="form-control" onchange="filtrar()">
                <option value="">Todos os status</option>
                <option value="1">Ativo</option>
                <option value="0">Inativo</option>
              </select>
              <button class="btn btn-ghost" onclick="limparFiltros()">Limpar</button>
            </div>
            <div class="gp-wrap">
              <div class="gp-chips-row" id="gp-chips-row"><span class="gp-label">Agrupar por:</span></div>
              <div id="dz"></div>
            </div>
          </div>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <div class="grid-toolbar">
            <div><div class="grid-title">Canais vinculados a esta empresa</div><div id="count" class="grid-meta"></div></div>
          </div>
          <div id="tabela"></div>
        </div>
      </div>
      <div id="sec-form" style="display:none">
        <div class="editor-shell">
          <div class="editor-actionbar">
            <div class="editor-actionbar-title">
              <strong id="form-title">Novo Canal</strong>
              <span id="form-subtitle">Configure o canal e seus vinculos.</span>
            </div>
            <div class="editor-actions">
              <span class="save-feedback" id="save-feedback"></span>
              <button class="btn btn-ghost" onclick="fecharFormulario()">Voltar</button>
              <button class="btn btn-primary" onclick="salvar()">Salvar</button>
            </div>
          </div>
          <div class="form-tabs">
            <button class="form-tab-btn active" id="tab-btn-dados" onclick="setAba('dados')">Dados do canal</button>
            <button class="form-tab-btn" id="tab-btn-empresas" onclick="setAba('empresas')" disabled>Empresas vinculadas</button>
          </div>
          <div class="editor-grid editor-grid-wide tab-panel active" id="tab-dados">
            <main class="editor-main">
              <section class="form-section">
                <div class="form-section-header">
                  <div class="form-section-title">Identificacao</div>
                  <div class="form-section-subtitle">Dados do canal usado pelo monitor e pela sessao WhatsApp.</div>
                </div>
                <div class="form-section-body">
                  <div class="form-group">
                    <label class="form-label">Nome <span style="color:#dc2626">*</span></label>
                    <input id="f-nome" class="form-control" placeholder="ex: WhatsApp Principal">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Numero esperado</label>
                    <input id="f-numero" class="form-control" placeholder="5592999999999" oninput="this.value=this.value.replace(/\D/g,'').slice(0,15)">
                    <div class="form-hint">Opcional. Quando conectado, o numero real tambem e atualizado pelo WhatsApp.</div>
                  </div>
                </div>
              </section>
            </main>
            <aside class="editor-side">
              <section class="form-section" style="position:sticky;top:56px">
                <div class="form-section-header"><div class="form-section-title">Registro</div></div>
                <div class="form-section-body">
                  <div class="reg-field"><div class="reg-label">ID</div><input id="f-id" class="form-control" disabled style="font-family:monospace;background:var(--bg-hover)"></div>
                  <div class="reg-field"><div class="reg-label">Status</div><select id="f-ativo" class="form-control"><option value="1">Ativo</option><option value="0">Inativo</option></select></div>
                  <div class="reg-field"><div class="reg-label">Padrao nesta empresa</div><select id="f-padrao" class="form-control"><option value="0">Nao</option><option value="1">Sim</option></select></div>
                  <div class="reg-field"><div class="reg-label">Aliases nesta empresa</div><textarea id="f-aliases" class="form-control" rows="3"></textarea></div>
                </div>
              </section>
            </aside>
          </div>
          <div class="tab-panel" id="tab-empresas">
            <section class="form-section" id="sec-vinculos">
              <div class="form-section-header">
                <div class="form-section-title">Empresas vinculadas</div>
                <div class="form-section-subtitle">Somente empresas autorizadas ao seu usuario podem ser adicionadas ou removidas.</div>
              </div>
              <div class="form-section-body">
                <div class="linked-list" id="linked-list"></div>
                <div class="inline-form">
                  <div>
                    <label class="form-label">Empresa</label>
                    <select id="add-empresa-id" class="form-control"></select>
                  </div>
                  <div>
                    <label class="form-label">Aliases</label>
                    <input id="add-aliases" class="form-control" placeholder="ex: matriz, caieira">
                  </div>
                  <button class="btn btn-ghost" onclick="adicionarEmpresa()">Adicionar empresa</button>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="help-overlay" id="help-overlay" onclick="fecharAjuda()"></div>
<div class="help-drawer" id="help-drawer">
  <div class="help-drawer-header">
    <span class="help-drawer-title">Ajuda - Canais WhatsApp</span>
    <button class="help-drawer-close" onclick="fecharAjuda()" title="Fechar">&times;</button>
  </div>
  <div class="help-drawer-body">
    <div class="help-section">
      <div class="help-section-title">O que esta rotina controla</div>
      <div class="help-item-desc">Canais WhatsApp representam os numeros operacionais usados pelo IA Command. Um canal pode atender uma ou mais empresas vinculadas, desde que essa escolha faca sentido para a operacao e para o isolamento de dados.</div>
      <div class="help-tip">Pense no canal como a "linha de atendimento". O numero autorizado e o usuario final ficam em outra rotina; aqui voce define o canal que recebe e envia as mensagens.</div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Campos importantes</div>
      <div class="help-item"><div class="help-item-label">Nome</div><div class="help-item-desc">Use um nome operacional claro, como WhatsApp Financeiro, Canal Matriz ou Atendimento Vendas. Isso facilita o monitoramento e o suporte.</div></div>
      <div class="help-item"><div class="help-item-label">Numero esperado</div><div class="help-item-desc">Informe apenas digitos com DDI e DDD. O numero real tambem pode ser atualizado quando a sessao WhatsApp conecta.</div></div>
      <div class="help-item"><div class="help-item-label">Padrao nesta empresa</div><div class="help-item-desc">Define qual canal sera sugerido primeiro para a empresa atual quando houver mais de um canal disponivel.</div></div>
      <div class="help-item"><div class="help-item-label">Aliases</div><div class="help-item-desc">Apelidos usados para identificar a empresa dentro do canal, como matriz, filial norte ou nome fantasia.</div></div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Fluxo recomendado</div>
      <div class="help-item"><div class="help-item-label">1. Crie o canal</div><div class="help-item-desc">Cadastre nome, numero esperado e status ativo.</div></div>
      <div class="help-item"><div class="help-item-label">2. Vincule empresas</div><div class="help-item-desc">Depois de salvar, abra a aba Empresas vinculadas e associe somente empresas que podem usar esse mesmo numero.</div></div>
      <div class="help-item"><div class="help-item-label">3. Valide no monitor</div><div class="help-item-desc">Use WhatsApp Services ou Monitor para iniciar a sessao, ler QR Code e acompanhar mensagens.</div></div>
    </div>
    <div class="help-section">
      <div class="help-section-title">Cuidados</div>
      <div class="help-item-desc">Evite misturar empresas sem necessidade no mesmo numero. Quando houver risco de confusao operacional ou regras diferentes de acesso ao ERP, prefira canais separados.</div>
    </div>
  </div>
</div>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/grid-group-panel.js?v=20260617-grid-guard-v2"></script>
<script src="/app/ia-command/js/sidebar.js"></script>
<script>
  let table, gp;
  let dados = [];
  let edit = null;
  let quickFilterFn = null;
  let filtrosVisiveis = false;
  let empresasDisponiveis = [];
  function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtNumero(n) { const v = String(n || '').replace(/\D/g,''); return v ? `+${v}` : '-'; }
  function empresaNome(e) { return e.razao_social || e.nome || `Empresa #${e.id}`; }
  async function carregarEmpresasDisponiveis() {
    empresasDisponiveis = await fetch('/api/empresas/minhas').then(r => r.json()).catch(() => []);
    empresasDisponiveis.sort((a, b) => empresaNome(a).localeCompare(empresaNome(b), 'pt-BR'));
    renderEmpresaSelect();
  }
  function renderEmpresaSelect() {
    const sel = document.getElementById('add-empresa-id');
    if (!sel) return;
    const vinculadas = new Set((edit?.empresas || []).map(e => Number(e.empresa_id)));
    const opcoes = empresasDisponiveis.filter(e => !vinculadas.has(Number(e.id)));
    sel.innerHTML = opcoes.length
      ? '<option value="">Selecione uma empresa...</option>' + opcoes.map(e => `<option value="${Number(e.id)}">${esc(empresaNome(e))}</option>`).join('')
      : '<option value="">Todas as empresas permitidas ja estao vinculadas</option>';
    sel.disabled = opcoes.length === 0;
  }
  function setAba(aba) {
    const empresasLiberada = Boolean(edit);
    if (aba === 'empresas' && !empresasLiberada) return feedback('Salve o canal antes de vincular empresas.', false);
    document.getElementById('tab-dados').classList.toggle('active', aba === 'dados');
    document.getElementById('tab-empresas').classList.toggle('active', aba === 'empresas');
    document.getElementById('tab-btn-dados').classList.toggle('active', aba === 'dados');
    document.getElementById('tab-btn-empresas').classList.toggle('active', aba === 'empresas');
  }
  async function carregar() {
    dados = await fetch('/api/ia-command/admin/canais-whatsapp').then(r => r.json()).catch(() => []);
    if (table) return table.replaceData(dados);
    gp = createGroupPanel({ chipsRowId:'gp-chips-row', dropZoneId:'dz', storageKey:'iac_admin_canais_whatsapp_group', getTable:()=>table });
    table = new Tabulator('#tabela', {
      data:dados, index:'id', layout:'fitColumns', height:'calc(100vh - 300px)',
      movableColumns:true,
      groupBy:gp.getActiveFields(),
      groupStartOpen:true,
      placeholder:'<div style="padding:40px;text-align:center;color:var(--text-lo)">Nenhum canal cadastrado.</div>',
      columns:[
        { title:'Nome', field:'nome', minWidth:180, headerFilter:true, formatter:c=>`<strong style="color:var(--text-hi)">${esc(c.getValue())}</strong>` },
        { title:'Numero', field:'numero', width:150, headerFilter:true, formatter:c=>`<span style="font-family:monospace">${esc(fmtNumero(c.getValue()))}</span>` },
        { title:'Empresas', field:'empresas', minWidth:220, headerFilter:true, headerFilterFunc:(hv,rv)=>!hv||(rv||[]).some(e=>e.nome?.toLowerCase().includes(hv.toLowerCase())), formatter:c=>{
          const nomes = (c.getValue() || []).map(e => e.nome).join(', ');
          return nomes ? esc(nomes) : '<span class="badge-inativo">Sem empresas</span>';
        } },
        { title:'Padrao', field:'padrao', width:90, headerFilter:'select', headerFilterParams:{values:{'':'Todos','1':'Sim','0':'Nao'}}, headerFilterFunc:(hv,rv)=>hv===''||(hv==='1'?!!rv:!rv), formatter:c=>c.getValue()?'<span class="badge-ativo">Sim</span>':'<span class="badge-inativo">Nao</span>' },
        { title:'Status', field:'ativo', width:95, headerFilter:'select', headerFilterParams:{values:{'':'Todos','1':'Ativo','0':'Inativo'}}, formatter:c=>c.getValue()?'<span class="badge-ativo">Ativo</span>':'<span class="badge-inativo">Inativo</span>' },
        { title:'Acoes', field:'id', width:95, hozAlign:'right', headerFilter:false, groupable:false, formatter:c=>`<button class="btn-icon" onclick="event.stopPropagation();abrirFormulario('${esc(c.getValue())}')" title="Editar">✏️</button><button class="btn-icon" onclick="event.stopPropagation();excluir('${esc(c.getValue())}')" title="Excluir" style="color:#dc2626">🗑</button>` },
      ],
      rowClick:(e,row)=>{ if(!e.target.closest('button')) abrirFormulario(row.getData().id); },
      dataFiltered:(_f, rows)=>document.getElementById('count').textContent = rows.length === 1 ? '1 canal' : `${rows.length} canais`,
    });
    gp.refresh();
    gp.applyToTable();
    document.getElementById('count').textContent = dados.length === 1 ? '1 canal' : `${dados.length} canais`;
  }
  function toggleFiltros() {
    filtrosVisiveis = !filtrosVisiveis;
    document.getElementById('filter-area').style.display = filtrosVisiveis ? '' : 'none';
    document.getElementById('btn-filtros').textContent = filtrosVisiveis ? '- Ocultar filtros' : '+ Mostrar filtros';
    if (filtrosVisiveis && gp) setTimeout(() => gp.refresh(), 50);
  }
  function filtrar() {
    if (!table) return;
    if (quickFilterFn) { table.removeFilter(quickFilterFn); quickFilterFn = null; }
    const busca = document.getElementById('q-busca').value.trim().toLowerCase();
    const ativo = document.getElementById('q-ativo').value;
    if (busca || ativo !== '') {
      quickFilterFn = row => {
        if (ativo !== '' && String(row.ativo) !== ativo) return false;
        const texto = `${row.nome} ${row.numero} ${(row.empresas || []).map(e => e.nome).join(' ')}`.toLowerCase();
        return !busca || texto.includes(busca);
      };
      table.addFilter(quickFilterFn);
    }
    const qtd = [busca, ativo].filter(Boolean).length;
    document.getElementById('filter-status').textContent = qtd ? `${qtd} filtro(s) ativo(s)` : 'Sem filtros ou agrupamentos ativos';
  }
  function limparFiltros() { document.getElementById('q-busca').value = ''; document.getElementById('q-ativo').value = ''; filtrar(); }
  async function abrirFormulario(id) {
    edit = id ? await fetch(`/api/ia-command/admin/canais-whatsapp/${encodeURIComponent(id)}`).then(r => r.json()).catch(() => null) : null;
    document.getElementById('sec-lista').style.display = 'none';
    document.getElementById('sec-form').style.display = '';
    document.getElementById('form-title').textContent = edit ? edit.nome : 'Novo Canal';
    document.getElementById('f-id').value = edit?.id || '';
    document.getElementById('f-nome').value = edit?.nome || '';
    document.getElementById('f-numero').value = edit?.numero || '';
    document.getElementById('f-ativo').value = String(edit?.ativo ?? 1);
    document.getElementById('f-padrao').value = String(edit?.padrao ?? 0);
    document.getElementById('f-aliases').value = edit?.aliases || '';
    document.getElementById('tab-btn-empresas').disabled = !edit;
    setAba('dados');
    feedback('', true);
    renderVinculos();
  }
  function renderVinculos() {
    const el = document.getElementById('linked-list');
    if (!edit) { el.innerHTML = ''; return; }
    el.innerHTML = (edit.empresas || []).map(e => {
      const oculta = !!e.ocultar_selecao;
      return `
      <div class="linked-item">
        <div>
          <div class="linked-title">#${esc(e.empresa_id)} - ${esc(e.nome)}</div>
          <div class="linked-sub">Aliases: ${esc(e.aliases || '-')}${e.padrao ? ' · padrão' : ''}</div>
        </div>
        <div style="display:flex;align-items:center;gap:6px">
          <button class="btn btn-ghost" style="font-size:12px;padding:3px 10px;${oculta ? 'color:#b45309;border-color:#b45309' : ''}"
            onclick="toggleOcultarSelecao(${Number(e.empresa_id)},${oculta ? 0 : 1})"
            title="${oculta ? 'Empresa oculta do menu WhatsApp — clique para tornar visível' : 'Clique para ocultar do menu WhatsApp'}">
            ${oculta ? '🚫 Oculta do menu' : '👁 Visível no menu'}
          </button>
          <button class="btn-icon" onclick="editarVinculo(${Number(e.empresa_id)})" title="Editar aliases/padrão">✏️</button>
          <button class="btn-icon" onclick="removerVinculo(${Number(e.empresa_id)})" title="Remover" style="color:#dc2626">🗑</button>
        </div>
      </div>`;
    }).join('') || '<div style="color:var(--text-lo);font-size:13px">Nenhuma empresa vinculada.</div>';
    renderEmpresaSelect();
  }
  async function toggleOcultarSelecao(empresa_id, novoValor) {
    const res = await fetch(`/api/ia-command/admin/canais-whatsapp/${encodeURIComponent(edit.id)}/empresas/${empresa_id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ocultar_selecao: novoValor }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) return feedback(data.error || 'Erro ao atualizar visibilidade.', false);
    edit = data;
    renderVinculos();
    feedback(novoValor ? 'Empresa ocultada do menu WhatsApp.' : 'Empresa voltou a aparecer no menu WhatsApp.', true);
  }
  function fecharFormulario() {
    document.getElementById('sec-form').style.display = 'none';
    document.getElementById('sec-lista').style.display = '';
    edit = null;
  }
  async function salvar() {
    const nome = document.getElementById('f-nome').value.trim();
    if (!nome) return feedback('Campo Nome e obrigatorio.', false);
    const body = {
      nome,
      numero: document.getElementById('f-numero').value.replace(/\D/g,''),
      ativo: parseInt(document.getElementById('f-ativo').value),
      padrao: parseInt(document.getElementById('f-padrao').value),
      aliases: document.getElementById('f-aliases').value.trim() || null,
    };
    const url = edit ? `/api/ia-command/admin/canais-whatsapp/${encodeURIComponent(edit.id)}` : '/api/ia-command/admin/canais-whatsapp';
    const method = edit ? 'PUT' : 'POST';
    const res = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) return feedback(data.error || 'Erro ao salvar.', false);
    feedback('Salvo com sucesso!', true);
    setTimeout(() => { fecharFormulario(); carregar(); }, 600);
  }
  async function excluir(id) {
    if (!confirm('Excluir/desvincular este canal desta empresa?')) return;
    await fetch(`/api/ia-command/admin/canais-whatsapp/${encodeURIComponent(id)}`, { method:'DELETE' });
    carregar();
  }
  async function adicionarEmpresa() {
    if (!edit) return;
    const empresa_id = Number(document.getElementById('add-empresa-id').value);
    const aliases = document.getElementById('add-aliases').value.trim();
    if (!empresa_id) return feedback('Selecione a empresa.', false);
    const res = await fetch(`/api/ia-command/admin/canais-whatsapp/${encodeURIComponent(edit.id)}/empresas`, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ target_empresa_id: empresa_id, aliases }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) return feedback(data.error || 'Erro ao vincular empresa.', false);
    edit = data;
    document.getElementById('add-aliases').value = '';
    renderVinculos();
    feedback('Empresa vinculada.', true);
  }
  async function editarVinculo(empresa_id) {
    const atual = (edit.empresas || []).find(e => e.empresa_id === empresa_id) || {};
    const aliases = prompt('Aliases desta empresa no canal:', atual.aliases || '');
    if (aliases === null) return;
    const padrao = confirm('Marcar este canal como padrão para esta empresa?');
    const res = await fetch(`/api/ia-command/admin/canais-whatsapp/${encodeURIComponent(edit.id)}/empresas/${empresa_id}`, {
      method:'PUT',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ aliases, padrao }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) return feedback(data.error || 'Erro ao editar vinculo.', false);
    edit = data;
    renderVinculos();
  }
  async function removerVinculo(empresa_id) {
    if (!confirm('Remover esta empresa do canal?')) return;
    const res = await fetch(`/api/ia-command/admin/canais-whatsapp/${encodeURIComponent(edit.id)}/empresas/${empresa_id}`, { method:'DELETE' });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) return feedback(data.error || 'Erro ao remover vinculo.', false);
    edit = data;
    renderVinculos();
  }
  function feedback(msg, ok) {
    const el = document.getElementById('save-feedback');
    el.textContent = msg;
    el.className = 'save-feedback ' + (ok ? 'ok' : 'fail');
  }
  function abrirAjuda() { document.getElementById('help-overlay').classList.add('open'); document.getElementById('help-drawer').classList.add('open'); }
  function fecharAjuda() { document.getElementById('help-overlay').classList.remove('open'); document.getElementById('help-drawer').classList.remove('open'); }
  window._iahubAuthReady?.then(async () => {
    await carregarEmpresasDisponiveis();
    await carregar();
  }) ?? carregar();
</script>
</body>
</html>
</file>

<file path="apps/IA Command/frontend/admin-chat-favoritos.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chat Favoritos - IA Command</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css">
  <style>
    :root { --accent:#7c3aed; --accent-light:#a78bfa; --accent-glow:rgba(124,58,237,.1); }
    .sidebar-logo .logo-icon { background:#7c3aed !important; }
    .topbar-menu-btn { flex-shrink:0;background:none;border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;color:var(--text-md);transition:background var(--transition),color var(--transition); }
    .topbar-menu-btn:hover { background:var(--bg-hover);color:var(--text-hi); }
    .topbar-title { flex:1;min-width:0;font-weight:700; }
    .page-head { display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:8px; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:700;margin-bottom:3px; }
    .page-title { font-size:20px;font-weight:800;color:var(--text-hi);line-height:1.25; }
    .page-subtitle { font-size:13px;color:var(--text-md);line-height:1.5;margin-top:4px;max-width:760px; }
    .head-actions { display:flex;align-items:center;gap:8px;flex-wrap:wrap; }
    .btn { display:inline-flex;align-items:center;justify-content:center;gap:6px; }
    .btn svg { width:14px;height:14px;flex-shrink:0; }
    .kpi-strip { display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:10px;color:var(--text-md);font-size:12px; }
    .kpi-item { display:inline-flex;align-items:baseline;gap:5px;white-space:nowrap; }
    .kpi-item span { color:var(--text-lo);font-weight:800;text-transform:uppercase;letter-spacing:.04em;font-size:10px; }
    .kpi-item strong { color:var(--text-hi);font-size:13px;font-weight:800; }
    .filter-row { display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px; }
    .filter-row .form-control { height:36px;font-size:13px; }
    .filter-row input.form-control { flex:1;min-width:240px; }
    .filter-row select.form-control { width:auto;min-width:150px; }
    .panel { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden; }
    .sr-status { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }
    .tabulator { border:none !important;background:transparent !important; }
    .tabulator .tabulator-header { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important; }
    .tabulator .tabulator-header .tabulator-col { background:var(--bg-card) !important;border-right:none !important;color:var(--text-lo) !important;font-size:11px !important;font-weight:800 !important;text-transform:uppercase;letter-spacing:.05em; }
    .tabulator .tabulator-row { background:var(--bg-card) !important;border-bottom:1px solid var(--border) !important;cursor:pointer; }
    .tabulator .tabulator-row:hover { background:var(--bg-hover) !important; }
    .tabulator .tabulator-row .tabulator-cell { border-right:none !important;color:var(--text-md);font-size:13px;padding:10px 12px !important; }
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input,
    .tabulator .tabulator-header .tabulator-col .tabulator-header-filter select { background:var(--bg-base) !important;color:var(--text-hi) !important;border:1px solid var(--border) !important;border-radius:4px !important;font-size:11px !important;padding:3px 6px !important;width:100% !important; }
    .fav-cell { display:flex;align-items:flex-start;gap:9px;min-width:0; }
    .fav-dot { width:9px;height:9px;border-radius:99px;flex:0 0 9px;margin-top:5px;background:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.16); }
    .fav-dot.off { background:#94a3b8;box-shadow:0 0 0 3px rgba(148,163,184,.18); }
    .fav-main { min-width:0; }
    .fav-title { font-weight:800;color:var(--text-hi);margin-bottom:2px; }
    .fav-sub { color:var(--text-lo);font-size:12px;line-height:1.45;max-width:620px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
    .badge { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:800;white-space:nowrap; }
    .badge-ok { background:#dcfce7;color:#15803d; }
    .badge-paused { background:var(--bg-hover);color:var(--text-lo); }
    .badge-mod { background:var(--accent-glow);color:var(--accent); }
    .btn-icon { width:28px;height:28px;background:none;border:none;cursor:pointer;padding:0;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;transition:background .15s,color .15s;color:var(--text-md);vertical-align:middle; }
    .btn-icon svg { width:15px;height:15px;display:block; }
    .btn-icon:hover { background:var(--bg-hover);color:var(--text-hi); }
    .btn-icon.primary { color:var(--accent); }
    .btn-icon.danger { color:#dc2626; }
    .save-feedback { font-size:13px;color:var(--text-lo); }
    .save-feedback.ok { color:#15803d; }
    .save-feedback.fail { color:#b91c1c; }
    .form-grid { display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:16px;align-items:start;margin-top:16px; }
    .form-section { background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden;margin-bottom:14px; }
    .form-section-header { padding:14px 16px;border-bottom:1px solid var(--border); }
    .form-section-title { font-size:13px;font-weight:800;color:var(--text-hi); }
    .form-section-subtitle { font-size:12px;color:var(--text-lo);margin-top:2px;line-height:1.45; }
    .form-section-body { padding:16px; }
    .form-row { display:grid;grid-template-columns:1fr 1fr;gap:12px; }
    .form-group { margin-bottom:13px; }
    .form-group:last-child { margin-bottom:0; }
    .form-label { display:block;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--text-lo);margin-bottom:5px; }
    .form-help { font-size:12px;color:var(--text-lo);line-height:1.45;margin-top:5px; }
    textarea.form-control { min-height:92px;resize:vertical;line-height:1.45; }
    .sql-textarea { min-height:430px;font-family:Consolas,'Courier New',monospace;font-size:12px;resize:vertical; }
    .json-textarea { min-height:140px;font-family:Consolas,'Courier New',monospace;font-size:12px;resize:vertical; }
    .summary-list { display:grid;gap:10px; }
    .summary-item { border:1px solid var(--border);border-radius:8px;background:var(--bg-base);padding:11px; }
    .summary-label { color:var(--text-lo);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px; }
    .summary-value { color:var(--text-hi);font-size:13px;font-weight:800;line-height:1.35;word-break:break-word; }
    .readonly-note { background:var(--accent-glow);border-left:3px solid var(--accent);border-radius:0 6px 6px 0;padding:10px 14px;font-size:13px;color:var(--text-md);line-height:1.6;margin-bottom:14px; }
    .macro-help { display:grid;gap:10px;font-size:12px;color:var(--text-md);line-height:1.55; }
    .macro-help p { margin:0; }
    .macro-help code { display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:5px;background:var(--bg-base);color:var(--text-hi);padding:1px 5px;font-family:Consolas,'Courier New',monospace;font-size:11px; }
    .macro-grid { display:grid;grid-template-columns:1fr 1fr;gap:6px; }
    .macro-example { margin:0;padding:10px;border:1px solid var(--border);border-radius:8px;background:var(--bg-base);color:var(--text-hi);font-family:Consolas,'Courier New',monospace;font-size:11px;line-height:1.5;white-space:pre-wrap;overflow:auto; }
    .d-none { display:none !important; }
    @media (max-width: 980px) { .page-head { flex-direction:column;align-items:flex-start; } .form-grid { grid-template-columns:1fr; } }
    @media (max-width: 620px) { .form-row { grid-template-columns:1fr; } }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">IA</div>
      <span class="logo-text">IA Command</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Command &rsaquo; Agendamento &rsaquo;</span> Chat Favoritos</span>
    </div>
    <div class="page-content">
      <div id="sec-lista">
        <div class="page-head">
          <div>
            <div class="page-kicker">Agendamento</div>
            <div class="page-title">Chat Favoritos</div>
            <div class="page-subtitle">Audite e ajuste o SQL salvo nos favoritos do chat Protheus. A reexecucao do favorito usa este SQL sem consumir tokens de IA.</div>
          </div>
          <div class="head-actions">
            <button class="btn btn-ghost" id="btn-atualizar" type="button" onclick="carregarFavoritos()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-15.5 6.3L3 16"/><path d="M3 21v-5h5"/><path d="M3 12A9 9 0 0 1 18.5 5.7L21 8"/><path d="M21 3v5h-5"/></svg>
              <span>Atualizar</span>
            </button>
            <button class="btn btn-primary" type="button" onclick="abrirFormulario()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
              <span>Novo favorito</span>
            </button>
          </div>
        </div>
        <div class="kpi-strip">
          <div class="kpi-item"><span>Ativos</span><strong id="m-ativos">0</strong></div>
          <div class="kpi-item"><span>Inativos</span><strong id="m-inativos">0</strong></div>
          <div class="kpi-item"><span>Modulos</span><strong id="m-modulos">0</strong></div>
          <div class="kpi-item"><span>Total</span><strong id="m-total">0</strong></div>
        </div>
        <div class="filter-row">
          <input class="form-control" id="filtro-texto" type="text" placeholder="Buscar por titulo, pergunta, celular ou SQL..." oninput="renderTabela()">
          <select class="form-control" id="filtro-modulo" onchange="renderTabela()">
            <option value="">Todos os modulos</option>
          </select>
          <select class="form-control" id="filtro-status" onchange="renderTabela()">
            <option value="ativos">Ativos</option>
            <option value="todos">Ativos e inativos</option>
            <option value="inativos">Somente inativos</option>
          </select>
        </div>
        <div class="panel">
          <div id="count" class="sr-status" aria-live="polite">carregando...</div>
          <div id="tabela"></div>
        </div>
      </div>
      <div id="sec-form" class="d-none">
        <div class="editor-actionbar">
          <div class="editor-actionbar-title">
            <strong id="form-title">Novo favorito</strong>
            <span id="form-subtitle">Ajuste o SQL que sera reaproveitado pelo chat sem IA.</span>
          </div>
          <div class="editor-actions">
            <span class="save-feedback" id="save-feedback"></span>
            <button class="btn btn-ghost" type="button" onclick="fecharFormulario()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              <span>Voltar</span>
            </button>
            <button class="btn btn-ghost" type="button" onclick="copiarSql()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><rect x="3" y="3" width="12" height="12" rx="2"/></svg>
              <span>Copiar SQL</span>
            </button>
            <button class="btn btn-primary" type="button" onclick="salvarFavorito()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
              <span>Salvar</span>
            </button>
          </div>
        </div>
        <div class="form-grid">
          <main>
            <section class="form-section">
              <div class="form-section-header">
                <div class="form-section-title">Consulta favorita</div>
                <div class="form-section-subtitle">O SQL final executado e o ponto principal: ele sera usado novamente quando o favorito for acionado no chat.</div>
              </div>
              <div class="form-section-body">
                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label" for="f-titulo">Titulo</label>
                    <input class="form-control" id="f-titulo" type="text" maxlength="160">
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="f-celular">Celular</label>
                    <input class="form-control" id="f-celular" type="text" maxlength="32">
                    <div class="form-help">Use somente digitos ou cole o numero com mascara; o backend normaliza ao criar.</div>
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label" for="f-modulo">Modulo</label>
                    <input class="form-control" id="f-modulo" type="text" maxlength="80" placeholder="financeiro, faturamento, compras...">
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="f-ativo">Status</label>
                    <select class="form-control" id="f-ativo">
                      <option value="1">Ativo</option>
                      <option value="0">Inativo</option>
                    </select>
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label" for="f-pergunta">Pergunta original</label>
                  <textarea class="form-control" id="f-pergunta"></textarea>
                </div>
                <div class="form-group">
                  <label class="form-label" for="f-sql-final">SQL final executado</label>
                  <textarea class="form-control sql-textarea" id="f-sql-final" spellcheck="false"></textarea>
                  <div class="form-help">Aceita SELECT/WITH e tambem SET ROWCOUNT antes da consulta. Use macros de data para favoritos recorrentes.</div>
                </div>
              </div>
            </section>
          </main>
          <aside>
            <section class="form-section">
              <div class="form-section-header">
                <div class="form-section-title">Auditoria</div>
                <div class="form-section-subtitle">Metadados gravados quando o favorito foi criado pelo chat.</div>
              </div>
              <div class="form-section-body">
                <div class="readonly-note">Editar o SQL aqui altera a proxima execucao do favorito no chat, sem consumir tokens de IA.</div>
                <div class="summary-list">
                  <div class="summary-item"><div class="summary-label">ID</div><div class="summary-value" id="s-id">-</div></div>
                  <div class="summary-item"><div class="summary-label">Mensagem</div><div class="summary-value" id="s-msg">-</div></div>
                  <div class="summary-item"><div class="summary-label">Log de interpretacao</div><div class="summary-value" id="s-log">-</div></div>
                  <div class="summary-item"><div class="summary-label">Criado</div><div class="summary-value" id="s-criado">-</div></div>
                  <div class="summary-item"><div class="summary-label">Atualizado</div><div class="summary-value" id="s-atualizado">-</div></div>
                  <div class="summary-item"><div class="summary-label">Ultimo uso</div><div class="summary-value" id="s-uso">-</div></div>
                </div>
              </div>
            </section>
            <section class="form-section">
              <div class="form-section-header">
                <div class="form-section-title">Ajuda: macros e execucao</div>
                <div class="form-section-subtitle">Use estas variaveis no SQL final para evitar datas fixas em favoritos recorrentes.</div>
              </div>
              <div class="form-section-body">
                <div class="macro-help">
                  <p>Ao executar um favorito no chat, o IA Command usa o SQL salvo diretamente, sem chamar IA e sem consumir token. Antes de consultar o ERP, o executor troca as macros abaixo pela data atual do servidor.</p>
                  <div class="macro-grid">
                    <code>{{HOJE}}</code>
                    <code>{{ONTEM}}</code>
                    <code>{{AMANHA}}</code>
                    <code>{{HOJE:-7}}</code>
                    <code>{{INICIO_SEMANA}}</code>
                    <code>{{FIM_SEMANA}}</code>
                    <code>{{INICIO_SEMANA_ANTERIOR}}</code>
                    <code>{{FIM_SEMANA_ANTERIOR}}</code>
                    <code>{{INICIO_PROXIMA_SEMANA}}</code>
                    <code>{{FIM_PROXIMA_SEMANA}}</code>
                    <code>{{INICIO_MES}}</code>
                    <code>{{FIM_MES}}</code>
                    <code>{{INICIO_MES_ANTERIOR}}</code>
                    <code>{{FIM_MES_ANTERIOR}}</code>
                    <code>{{INICIO_ANO}}</code>
                    <code>{{FIM_ANO}}</code>
                    <code>{{INICIO_ANO_ANTERIOR}}</code>
                    <code>{{FIM_ANO_ANTERIOR}}</code>
                  </div>
                  <p>Campos Protheus em AAAAMMDD usam as macros acima. Para campos em YYYY-MM-DD, use a versao <code>_ISO</code>, como <code>{{ONTEM_ISO}}</code>.</p>
                  <pre class="macro-example">SET ROWCOUNT 10000;
SELECT *
FROM SE2010 SE2
WHERE SE2.D_E_L_E_T_ = ' '
  AND SE2.E2_VENCREA = '{{ONTEM}}';</pre>
                  <p>Novos favoritos criados pelo chat tentam gravar macro automaticamente quando a pergunta tem periodo relativo claro, como hoje, ontem, semana atual, semana passada, proxima semana, mes atual ou mes anterior. Favoritos antigos podem ser ajustados manualmente aqui.</p>
                </div>
              </div>
            </section>
            <section class="form-section">
              <div class="form-section-header">
                <div class="form-section-title">Template e contexto</div>
                <div class="form-section-subtitle">Campos tecnicos opcionais preservados do favorito original.</div>
              </div>
              <div class="form-section-body">
                <div class="form-group">
                  <label class="form-label" for="f-sql-template">SQL template</label>
                  <textarea class="form-control json-textarea" id="f-sql-template" spellcheck="false"></textarea>
                </div>
                <div class="form-group">
                  <label class="form-label" for="f-intent">Intent JSON</label>
                  <textarea class="form-control json-textarea" id="f-intent" spellcheck="false"></textarea>
                </div>
                <div class="form-group">
                  <label class="form-label" for="f-grid">Grid config JSON</label>
                  <textarea class="form-control json-textarea" id="f-grid" spellcheck="false"></textarea>
                </div>
                <div class="form-group">
                  <label class="form-label" for="f-preview">Preview de linhas</label>
                  <textarea class="form-control json-textarea" id="f-preview" spellcheck="false"></textarea>
                </div>
              </div>
            </section>
          </aside>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script src="/js/sidebar.js"></script>
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script>
  const API = '/api/ia-command/admin/chat-favoritos';
  let favoritos = [];
  let table = null;
  let editId = null;
  const ICONS = {
    edit:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>',
    trash:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>',
    play:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M8 5v14l11-7Z"/></svg>',
    pause:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5v14"/><path d="M14 5v14"/></svg>',
  };
  function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function api(url, opts = {}) {
    return fetch(url, opts).then(async r => {
      const data = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(data.error || 'Erro na requisicao.');
      return data;
    });
  }
  function fmtData(iso) {
    if (!iso) return '-';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '-';
    return d.toLocaleString('pt-BR', { dateStyle:'short', timeStyle:'short' });
  }
  function setFeedback(msg, ok = true) {
    const el = document.getElementById('save-feedback');
    el.textContent = msg || '';
    el.className = 'save-feedback ' + (msg ? (ok ? 'ok' : 'fail') : '');
  }
  function normalizarBusca(s) {
    return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }
  function dadosFiltrados() {
    const termo = normalizarBusca(document.getElementById('filtro-texto').value);
    const modulo = document.getElementById('filtro-modulo').value;
    const status = document.getElementById('filtro-status').value;
    return favoritos.filter(f => {
      if (modulo && String(f.modulo || '') !== modulo) return false;
      if (status === 'ativos' && !f.ativo) return false;
      if (status === 'inativos' && f.ativo) return false;
      if (!termo) return true;
      const hay = normalizarBusca([f.titulo, f.pergunta_texto, f.celular, f.modulo, f.sql_final_executado].join(' '));
      return hay.includes(termo);
    });
  }
  function atualizarKpis() {
    const ativos = favoritos.filter(f => f.ativo).length;
    const inativos = favoritos.length - ativos;
    const modulos = new Set(favoritos.map(f => f.modulo).filter(Boolean)).size;
    document.getElementById('m-ativos').textContent = String(ativos);
    document.getElementById('m-inativos').textContent = String(inativos);
    document.getElementById('m-modulos').textContent = String(modulos);
    document.getElementById('m-total').textContent = String(favoritos.length);
  }
  function atualizarFiltroModulos() {
    const select = document.getElementById('filtro-modulo');
    const atual = select.value;
    const modulos = [...new Set(favoritos.map(f => f.modulo).filter(Boolean))].sort();
    select.innerHTML = '<option value="">Todos os modulos</option>' + modulos.map(m => `<option value="${esc(m)}">${esc(m)}</option>`).join('');
    if (modulos.includes(atual)) select.value = atual;
  }
  function renderTabela() {
    const data = dadosFiltrados();
    if (table) {
      table.replaceData(data);
      document.getElementById('count').textContent = `${data.length} favorito(s) encontrado(s)`;
      return;
    }
    table = new Tabulator('#tabela', {
      data,
      index:'id',
      layout:'fitColumns',
      height:'calc(100vh - 230px)',
      movableColumns:true,
      placeholder:'<div style="padding:40px;text-align:center;color:var(--text-lo)">Nenhum favorito encontrado.</div>',
      columns:[
        { title:'Favorito', field:'titulo', minWidth:300, headerFilter:true, formatter:c => {
          const row = c.getRow().getData();
          return `<div class="fav-cell">
            <span class="fav-dot ${row.ativo ? '' : 'off'}"></span>
            <div class="fav-main">
              <div class="fav-title">${esc(row.titulo)}</div>
              <div class="fav-sub">${esc(row.pergunta_texto)}</div>
            </div>
          </div>`;
        }},
        { title:'Modulo', field:'modulo', width:135, headerFilter:true, formatter:c => `<span class="badge badge-mod">${esc(c.getValue() || '-')}</span>` },
        { title:'Celular', field:'celular', width:145, headerFilter:true },
        { title:'Status', field:'ativo', width:105, headerFilter:'select', headerFilterParams:{values:{'':'Todos','true':'Ativo','false':'Inativo'}}, formatter:c => c.getValue() ? '<span class="badge badge-ok">Ativo</span>' : '<span class="badge badge-paused">Inativo</span>' },
        { title:'Atualizado', field:'atualizado_em', width:150, sorter:'datetime', formatter:c => esc(fmtData(c.getValue())) },
        { title:'Ultimo uso', field:'ultimo_uso_em', width:150, sorter:'datetime', formatter:c => esc(fmtData(c.getValue())) },
        { title:'Acoes', field:'id', width:132, hozAlign:'right', headerSort:false, formatter:c => {
          const row = c.getRow().getData();
          return `<button class="btn-icon primary" title="Editar" aria-label="Editar" onclick="event.stopPropagation();abrirFormulario('${esc(row.id)}')">${ICONS.edit}</button>
            <button class="btn-icon" title="${row.ativo ? 'Inativar' : 'Reativar'}" aria-label="${row.ativo ? 'Inativar' : 'Reativar'}" onclick="event.stopPropagation();alterarStatus('${esc(row.id)}',${row.ativo ? 'false' : 'true'})">${row.ativo ? ICONS.pause : ICONS.play}</button>
            <button class="btn-icon danger" title="Inativar" aria-label="Inativar" onclick="event.stopPropagation();excluirFavorito('${esc(row.id)}')">${ICONS.trash}</button>`;
        }},
      ],
      rowClick:(e,row) => { if (!e.target.closest('button')) abrirFormulario(row.getData().id); },
      dataFiltered:(_filters, rows) => {
        const total = table?.getData?.().length ?? favoritos.length;
        document.getElementById('count').textContent = rows.length === total
          ? `${rows.length} favorito(s) encontrado(s)`
          : `${rows.length} de ${total} favorito(s) encontrado(s)`;
      },
    });
    document.getElementById('count').textContent = `${data.length} favorito(s) encontrado(s)`;
  }
  async function carregarFavoritos() {
    favoritos = await api(API + '?incluir_inativos=1', { cache:'no-store' });
    atualizarKpis();
    atualizarFiltroModulos();
    renderTabela();
  }
  function limparFormulario() {
    editId = null;
    document.getElementById('form-title').textContent = 'Novo favorito';
    document.getElementById('form-subtitle').textContent = 'Cadastre uma consulta favorita manualmente.';
    ['f-titulo','f-celular','f-modulo','f-pergunta','f-sql-final','f-sql-template','f-intent','f-grid','f-preview'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('f-ativo').value = '1';
    ['s-id','s-msg','s-log','s-criado','s-atualizado','s-uso'].forEach(id => document.getElementById(id).textContent = '-');
    setFeedback('');
  }
  function preencherFormulario(row) {
    editId = row.id;
    document.getElementById('form-title').textContent = row.titulo || 'Favorito';
    document.getElementById('form-subtitle').textContent = 'Edite o SQL salvo que sera usado na reexecucao sem IA.';
    document.getElementById('f-titulo').value = row.titulo || '';
    document.getElementById('f-celular').value = row.celular || '';
    document.getElementById('f-modulo').value = row.modulo || '';
    document.getElementById('f-ativo').value = row.ativo ? '1' : '0';
    document.getElementById('f-pergunta').value = row.pergunta_texto || '';
    document.getElementById('f-sql-final').value = row.sql_final_executado || '';
    document.getElementById('f-sql-template').value = row.sql_template || '';
    document.getElementById('f-intent').value = row.intent_json || '';
    document.getElementById('f-grid').value = row.grid_config_json || '';
    document.getElementById('f-preview').value = row.rows_preview_json || '';
    document.getElementById('s-id').textContent = row.id || '-';
    document.getElementById('s-msg').textContent = row.resposta_mensagem_id || '-';
    document.getElementById('s-log').textContent = row.interpretation_log_id || '-';
    document.getElementById('s-criado').textContent = fmtData(row.criado_em);
    document.getElementById('s-atualizado').textContent = fmtData(row.atualizado_em);
    document.getElementById('s-uso').textContent = fmtData(row.ultimo_uso_em);
    setFeedback('');
  }
  async function abrirFormulario(id = null) {
    limparFormulario();
    document.getElementById('sec-lista').classList.add('d-none');
    document.getElementById('sec-form').classList.remove('d-none');
    if (id) {
      const row = await api(`${API}/${encodeURIComponent(id)}`, { cache:'no-store' });
      preencherFormulario(row);
    }
    document.getElementById('f-titulo').focus();
  }
  function fecharFormulario() {
    document.getElementById('sec-form').classList.add('d-none');
    document.getElementById('sec-lista').classList.remove('d-none');
    setFeedback('');
  }
  function payloadFormulario() {
    return {
      titulo: document.getElementById('f-titulo').value.trim(),
      celular: document.getElementById('f-celular').value.trim(),
      modulo: document.getElementById('f-modulo').value.trim(),
      ativo: document.getElementById('f-ativo').value === '1',
      pergunta_texto: document.getElementById('f-pergunta').value.trim(),
      sql_final_executado: document.getElementById('f-sql-final').value.trim(),
      sql_template: document.getElementById('f-sql-template').value.trim() || null,
      intent_json: document.getElementById('f-intent').value.trim() || null,
      grid_config_json: document.getElementById('f-grid').value.trim() || null,
      rows_preview_json: document.getElementById('f-preview').value.trim() || null,
    };
  }
  async function salvarFavorito() {
    try {
      setFeedback('Salvando...');
      const payload = payloadFormulario();
      const url = editId ? `${API}/${encodeURIComponent(editId)}` : API;
      const method = editId ? 'PUT' : 'POST';
      const row = await api(url, {
        method,
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify(payload),
      });
      preencherFormulario(row);
      await carregarFavoritos();
      setFeedback('Salvo com sucesso.', true);
    } catch (err) {
      setFeedback(err.message || 'Falha ao salvar.', false);
    }
  }
  async function alterarStatus(id, ativo) {
    await api(`${API}/${encodeURIComponent(id)}/status`, {
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({ ativo }),
    });
    await carregarFavoritos();
  }
  async function excluirFavorito(id) {
    if (!confirm('Inativar este favorito? Ele deixara de aparecer no chat.')) return;
    await api(`${API}/${encodeURIComponent(id)}`, { method:'DELETE' });
    await carregarFavoritos();
  }
  async function copiarSql() {
    const campo = document.getElementById('f-sql-final');
    const sql = campo.value;
    try {
      if (!navigator.clipboard || !window.isSecureContext) {
        throw new Error('clipboard_indisponivel');
      }
      await navigator.clipboard.writeText(sql);
      setFeedback('SQL copiado.', true);
    } catch (_) {
      try {
        campo.focus();
        campo.select();
        campo.setSelectionRange(0, campo.value.length);
        if (!document.execCommand('copy')) {
          throw new Error('copy_falhou');
        }
        setFeedback('SQL copiado.', true);
      } catch (_) {
        setFeedback('Nao foi possivel copiar automaticamente. O SQL ficou selecionado para copiar com Ctrl+C.', false);
      }
    }
  }
  document.addEventListener('DOMContentLoaded', () => {
    carregarFavoritos().catch(err => {
      document.getElementById('count').textContent = err.message || 'Falha ao carregar favoritos.';
    });
    window.addEventListener('storage', (event) => {
      if (event.key !== 'iaCommandChatFavoritoAtualizado') return;
      carregarFavoritos().catch(() => {});
    });
  });
</script>
</body>
</html>
