.link-safe { color: var(--brand); text-decoration: none; overflow-wrap: anywhere; }
.link-safe:hover { text-decoration: underline; }
⋮----
.summary-panel { display: grid; grid-template-rows: auto 1fr; }
.summary-panel .panel-head p { font-size: 11px; }
.summary-content { overflow: auto; padding: 10px; display: grid; gap: 8px; align-content: start; }
.empty-block { padding: 12px; border: 1px dashed var(--line); border-radius: 7px; color: var(--muted); font-size: 12px; line-height: 1.4; }
.summary-card { padding: 10px; }
.summary-card h3 { font-size: 12px; text-transform: uppercase; letter-spacing: .03em; color: var(--muted); font-weight: 800; }
.summary-list { display: grid; gap: 6px; }
.summary-item { border-bottom: 1px solid var(--line); padding-bottom: 6px; }
.summary-item:last-child { border-bottom: 0; padding-bottom: 0; }
.summary-item span { display: block; color: var(--muted); font-size: 10px; font-weight: 800; text-transform: uppercase; }
.summary-item strong, .summary-item div { display: block; margin-top: 2px; font-size: 12.5px; line-height: 1.35; }
.progress { height: 8px; background: var(--panel-3); border-radius: 999px; overflow: hidden; border: 1px solid var(--line); }
.progress > span { display: block; height: 100%; width: var(--value, 0%); background: var(--danger); }
⋮----
.risk-toolbar {
.risk-toolbar .segmented {
.risk-toolbar .segmented button {
.risk-toolbar .segmented button.active { background: var(--panel); color: var(--brand); box-shadow: 0 1px 3px rgba(18, 36, 58, .12); border-color: transparent; }
.risk-toolbar .segmented button:not(.active):hover { color: var(--text); }
.risk-toolbar select, .risk-toolbar input {
.risk-toolbar select { flex: none; width: 180px; padding: 0 28px 0 14px; }
.risk-toolbar input { flex: 1; min-width: 180px; padding: 0 14px; }
.risk-toolbar select {
.risk-toolbar input:focus, .risk-toolbar select:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(0, 107, 214, .12); }
.risk-layout {
.risk-layout.consultants-collapsed { grid-template-columns: 0 1fr; }
.risk-layout.consultants-collapsed .risk-consultants-wrap { display: none; }
.risk-consultants-wrap { min-height: 0; display: grid; grid-template-rows: auto 1fr; border-right: 1px solid var(--line); background: var(--panel-2); }
.risk-consultants-head {
.risk-consultants-head .icon-button {
.risk-consultants { overflow: auto; }
.risk-consultant {
.risk-consultant:hover { background: var(--panel-3); }
.risk-consultant strong { font-weight: 700; }
.risk-consultant small { color: var(--muted); font-size: 11px; }
.risk-consultant.active { background: rgba(0, 168, 132, .1); border-left-color: var(--brand-2); color: var(--brand-2); }
.risk-grid-wrap { min-width: 0; min-height: 0; height: 100%; display: flex; padding: 8px; }
.risk-grid { flex: 1; min-height: 0; min-width: 0; overflow: auto; border: 1px solid var(--line); border-radius: 7px; box-shadow: 0 1px 3px rgba(18, 36, 58, .06); }
.risk-table { width: max-content; min-width: 100%; border-collapse: collapse; font-size: 12px; }
.risk-table th, .risk-table td { border-bottom: 1px solid var(--line); padding: 7px 9px; text-align: left; white-space: nowrap; }
.risk-table th { position: sticky; top: 0; background: var(--panel-3); z-index: 1; font-size: 10.5px; font-weight: 800; letter-spacing: .02em; text-transform: uppercase; color: var(--muted); box-shadow: 0 1px 0 var(--line); }
.risk-table tbody tr:hover td { background: var(--panel-2); }
.group-row td { background: rgba(0, 168, 132, .14) !important; color: var(--brand-2); font-weight: 900; font-size: 12px; }
.risk-table button { border: 0; background: transparent; color: var(--brand); font-weight: 800; font-size: 12px; padding: 3px 6px; border-radius: 5px; transition: background .12s ease; }
.risk-table button:hover { background: rgba(0, 107, 214, .1); }
.risk-table td .badge { font-size: 10.5px; padding: 3px 8px; }
⋮----
.toast {
.toast.active { display: block; }
⋮----
.mobile-nav { display: none; }
⋮----
.radar-layout { grid-template-columns: 300px minmax(420px, 1fr) 330px; }
.case-meta { grid-template-columns: repeat(3, minmax(100px, 1fr)); }
⋮----
body { overflow: auto; }
.access-screen { min-height: 100vh; height: auto; padding: 18px; }
