                  <input id="cur-se-url" class="form-control" placeholder="https://...">
                </div>
                <div>
                  <label class="form-label">Token (Authorization)</label>
                  <input id="cur-se-token" class="form-control" placeholder="Bearer ...">
                </div>
                <div>
