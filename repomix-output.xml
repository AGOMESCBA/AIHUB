    }
    .input-wrap:focus-within .prefix {
      background: rgba(37, 211, 102, .22);
      color: #fff;
    }
    .prefix {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: rgba(37, 211, 102, .15);
      color: var(--accent-2);
      pointer-events: none;
      transition: background .16s ease, color .16s ease;
    }
    .prefix svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }
    input {
      width: 100%;
      height: 54px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
