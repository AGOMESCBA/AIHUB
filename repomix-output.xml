<body>
<div id="toastStatus" class="toast-status">
  <span id="toastIcon">🔄</span>
  <span id="toastText">Atualizando carteira Binance...</span>
</div>
<div class="page-kicker">OPERACAO / ATIVOS</div>
<main class="wallet-shell">
  <section class="wallet-hero">
    <div class="wallet-hero-main">
      <div class="wallet-total">
        <div class="wallet-kicker">Spot Wallet / Binance</div>
        <div class="wallet-title-row">
          <h1 class="wallet-title">Valor total est.</h1>
          <span class="wallet-eye">◉</span>
        </div>
        <strong id="totalEstimated">-</strong>
        <div class="wallet-converted">Convertido para USDT</div>
        <div class="wallet-company" id="companyContext">Empresa ativa: sincronizando...</div>
      </div>
      <div class="wallet-actions">
        <button class="wallet-action" type="button">Deposito</button>
        <button class="wallet-action" type="button">Saque</button>
        <button class="wallet-action" type="button">Transferir</button>
        <button class="wallet-action" type="button">Historico</button>
      </div>
    </div>
    <div class="wallet-stats">
      <div class="wallet-stat"><span>Exchange</span><strong id="exchangeName">BINANCE</strong></div>
      <div class="wallet-stat"><span>Ativos com saldo</span><strong id="assetCount">-</strong></div>
      <div class="wallet-stat"><span>Atualizacao</span><strong id="updatedAt">-</strong></div>
    </div>
  </section>
  <section class="wallet-controls">
    <input class="asset-search" id="assetSearch" type="search" placeholder="Buscar ativo, exemplo BTC, ETH, USDT..." oninput="renderAssets()">
    <button class="btn-refresh" id="btnRefreshAssets" type="button" onclick="loadAssets(true)">
      <span id="btnRefreshSpinner">🔄</span>
      <span id="btnRefreshText">Atualizar Ativos</span>
    </button>
  </section>
  <div class="wallet-status" id="statusLine">Carregando saldos da Binance...</div>
  <div class="wallet-alert" id="errorBox"></div>
  <section class="portfolio-card">
    <div class="portfolio-head">
      <div>
        <strong>Meus Ativos</strong>
        <div class="asset-tabs">
          <span class="active">Visao de ativos</span>
          <span>Visualizar Conta</span>
        </div>
      </div>
      <div class="portfolio-tools">
        <span id="portfolioHint">Somente ativos com saldo livre ou bloqueado.</span>
        <label class="hide-small">
          <input id="hideSmallAssets" type="checkbox" onchange="renderAssets()">
          Ocultar ativos &lt; 1 USD
        </label>
      </div>
    </div>
    <div class="portfolio-table-wrap">
      <table class="portfolio-table">
        <thead>
          <tr>
            <th>Ativo</th>
            <th>Total</th>
            <th>Preco do ativo</th>
            <th>Disponivel</th>
            <th>Bloqueado</th>
            <th>Valor estimado</th>
          </tr>
        </thead>
        <tbody id="assetsBody"></tbody>
      </table>
      <div class="assets-loading-state" id="assetsLoadingState">
        <span class="assets-loading-pulse"></span>
        <span id="assetsLoadingText">Consultando carteira Spot na Binance...</span>
      </div>
      <div class="empty-state" id="emptyState">Nenhum ativo com saldo foi retornado pela Binance.</div>
    </div>
  </section>
</main>
<script src="/js/auth.js"></script>
<script>
  const fmtUsd = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'USD' });
  const fmtQty = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 10 });
  let allAssets = [];
  let lastError = '';
  let isLoadingAssets = false;
  function esc(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }
  function formatNumber(value) {
    return fmtQty.format(Number(value || 0));
  }
  function setStatus(text) {
    document.getElementById('statusLine').textContent = text;
  }
  function showToast(text, isError = false) {
    const toast = document.getElementById('toastStatus');
    document.getElementById('toastIcon').textContent = isError ? '⚠️' : '🔄';
    document.getElementById('toastText').textContent = text;
    toast.style.display = 'flex';
    if (!text.includes('Consultando') && !text.includes('Atualizando')) {
      setTimeout(() => { toast.style.display = 'none'; }, 3800);
    }
  }
  function hideToast() {
    document.getElementById('toastStatus').style.display = 'none';
  }
  function setAssetsLoading(active, text = 'Consultando carteira Spot na Binance...') {
    const loading = document.getElementById('assetsLoadingState');
    const loadingText = document.getElementById('assetsLoadingText');
    const empty = document.getElementById('emptyState');
    const btn = document.getElementById('btnRefreshAssets');
    const btnText = document.getElementById('btnRefreshText');
    const btnSpinner = document.getElementById('btnRefreshSpinner');
    isLoadingAssets = Boolean(active);
    if (loadingText) loadingText.textContent = text;
    loading.classList.toggle('show', Boolean(active));
    if (empty && active) empty.style.display = 'none';
    if (btn) {
      btn.classList.toggle('loading', Boolean(active));
      btn.disabled = Boolean(active);
    }
    if (btnText) btnText.textContent = active ? 'Atualizando...' : 'Atualizar Ativos';
    if (btnSpinner) btnSpinner.textContent = active ? '⏳' : '🔄';
  }
  function setError(message = '') {
    lastError = message;
    const box = document.getElementById('errorBox');
    if (!message) {
      box.style.display = 'none';
      box.innerHTML = '';
      return;
    }
    box.style.display = 'block';
    box.innerHTML = `<strong>Conexao Binance nao autorizada</strong>${esc(message)}`;
  }
  function resetSummary() {
    document.getElementById('assetCount').textContent = '-';
    document.getElementById('totalEstimated').textContent = '-';
    document.getElementById('updatedAt').textContent = '-';
  }
  function getEmpresaId() {
    return window._iahubEmpresa?.id || window._iahubEmpresa?.empresa_id || '';
  }
  function updateCompanyContext() {
    const companyName = window._iahubEmpresa?.nome || window._iahubEmpresa?.empresa_nome || 'Empresa selecionada';
    const companyId = getEmpresaId();
    document.getElementById('companyContext').textContent = companyId
      ? `Empresa ativa: ${companyName} (ID: ${companyId})`
      : `Empresa ativa: ${companyName}`;
  }
  function apiUrl(path) {
    const companyId = getEmpresaId();
    if (!companyId) return path;
    const sep = path.includes('?') ? '&' : '?';
    return `${path}${sep}empresa_id=${encodeURIComponent(companyId)}`;
  }
  async function loadAssets(userClicked = false) {
    if (isLoadingAssets) return;
    await (window._iahubAuthReady || Promise.resolve());
    updateCompanyContext();
    const loadingMessage = userClicked
      ? 'Atualizando Ativos: consultando carteira Spot na Binance...'
      : 'Abrindo Ativos: consultando carteira Spot na Binance...';
    setStatus('Consultando saldos reais da Binance...');
    setError('');
    setAssetsLoading(true, loadingMessage);
    showToast(`📡 ${loadingMessage}`);
    try {
      const res = await fetch(apiUrl('/api/master-crypto/orders/assets?exchange=BINANCE'));
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.detail || 'Nao foi possivel consultar ativos.');
      allAssets = Array.isArray(data.assets) ? data.assets : [];
      document.getElementById('exchangeName').textContent = data.exchange || 'BINANCE';
      document.getElementById('assetCount').textContent = String(data.assets_count ?? allAssets.length);
      document.getElementById('totalEstimated').textContent = fmtUsd.format(Number(data.total_estimated_usdt || 0));
      document.getElementById('updatedAt').textContent = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
      setStatus(allAssets.length ? 'Saldos carregados com sucesso.' : 'Consulta concluida, mas a Binance nao retornou ativos com saldo.');
      setAssetsLoading(false);
      renderAssets();
      showToast(allAssets.length ? '✅ Ativos da Binance atualizados.' : '⚠️ Binance respondeu sem ativos com saldo.', !allAssets.length);
    } catch (err) {
      allAssets = [];
      resetSummary();
      setStatus('Nao foi possivel carregar os ativos.');
      setError(err.message || 'Verifique a API Key, Secret, permissoes e whitelist de IP na Binance.');
      setAssetsLoading(false);
      renderAssets();
      showToast('⚠️ Não foi possível consultar a carteira Binance.', true);
    }
  }
  function renderAssets() {
    const query = document.getElementById('assetSearch').value.trim().toUpperCase();
    const hideSmall = document.getElementById('hideSmallAssets')?.checked;
    let rows = query ? allAssets.filter(item => String(item.asset || '').includes(query)) : allAssets;
    if (hideSmall) {
      rows = rows.filter(item => Number(item.estimated_usdt || 0) >= 1);
    }
    const tbody = document.getElementById('assetsBody');
    const empty = document.getElementById('emptyState');
    tbody.innerHTML = '';
    empty.style.display = rows.length ? 'none' : 'flex';
    empty.textContent = lastError
      ? 'A carteira nao pode ser exibida enquanto a Binance recusar a chave configurada.'
      : 'Nenhum ativo com saldo foi retornado pela Binance.';
    rows.forEach(item => {
      const tr = document.createElement('tr');
      const asset = String(item.asset || '-').toUpperCase();
      tr.innerHTML = `
        <td>
          <div class="asset-symbol">
            <span class="asset-avatar">${esc(asset.slice(0, 4))}</span>
            <span class="asset-name">${esc(asset)}<small>Spot</small></span>
          </div>
        </td>
        <td><strong>${formatNumber(item.total)}</strong></td>
        <td>${Number(item.price_usdt || 0) ? fmtUsd.format(Number(item.price_usdt)) : '-'}</td>
        <td>${formatNumber(item.free)}</td>
        <td>${formatNumber(item.locked)}</td>
        <td><strong class="value-usdt">${fmtUsd.format(Number(item.estimated_usdt || 0))}</strong></td>
      `;
      tbody.appendChild(tr);
    });
  }
  window.addEventListener('DOMContentLoaded', loadAssets);
</script>
</body>
</html>
</file>

<file path="apps/Master Crypto/frontend/backtest.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Backtest - Crypto Radar AI</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <link rel="stylesheet" href="./css/master-crypto.css">
  <style>
    body { background: var(--bg-base, #f8fafc); padding: 16px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .toolbar { display:flex; align-items:end; gap:10px; flex-wrap:wrap; margin-bottom:12px; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:12px; box-shadow:var(--shadow-sm); }
    .field { display:flex; flex-direction:column; gap:4px; min-width:150px; }
    .field label { font-size:11px; color:var(--text-lo); font-weight:800; text-transform:uppercase; }
    .field input, .field select { height:34px; border:1px solid var(--border); border-radius:6px; padding:0 10px; color:var(--text-hi); background:#fff; }
    .empty-state { height:200px; display:flex; align-items:center; justify-content:center; color:var(--text-lo); font-weight:800; }
  </style>
</head>
<body>
  <div class="page-kicker">ESTRATEGIAS / BACKTEST HISTORICO</div>
  <div class="head-row">
    <div class="head-title">
      <span>Backtest & Performance</span>
      <span class="head-count" id="statusText">aguardando execucao</span>
    </div>
  </div>
  <div class="toolbar">
    <div class="field">
      <label for="symbolInput">Ativo</label>
      <input id="symbolInput" value="BTCUSDT">
    </div>
    <div class="field">
      <label for="timeframeInput">Timeframe</label>
      <select id="timeframeInput">
        <option value="4h">4H</option>
        <option value="1h">1H</option>
        <option value="1d">1D</option>
      </select>
    </div>
    <div class="field">
      <label for="limitInput">Candles</label>
      <input id="limitInput" type="number" min="60" max="1000" step="20" value="300">
    </div>
    <button class="btn btn-primary" type="button" onclick="runBacktest()">Executar</button>
  </div>
  <div class="meta-grid" id="metaGrid"></div>
  <div class="table-card">
    <div class="table-wrap">
      <table class="history-table">
        <thead>
          <tr>
            <th>Entrada</th>
            <th>Saida</th>
            <th>Estrategia</th>
            <th>Resultado</th>
            <th>PNL %</th>
            <th>PNL USD</th>
          </tr>
        </thead>
        <tbody id="tradesBody"></tbody>
      </table>
      <div class="empty-state" id="emptyState">Execute um backtest para visualizar os resultados</div>
    </div>
  </div>
  <script src="/js/auth.js"></script>
  <script>
    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
    }
    function fmtPct(value) {
      return `${Number(value || 0).toFixed(2)}%`;
    }
    function renderResult(data) {
      document.getElementById('metaGrid').innerHTML = `
        <div class="meta-item"><span>Candles analisados</span><strong>${Number(data.total_candles_analyzed || 0)}</strong></div>
        <div class="meta-item"><span>Total de operacoes</span><strong>${Number(data.total_trades || 0)}</strong></div>
        <div class="meta-item"><span>Win rate</span><strong class="text-positive">${fmtPct(data.win_rate_pct)}</strong></div>
        <div class="meta-item"><span>Profit factor</span><strong>${Number(data.profit_factor || 0).toFixed(2)}</strong></div>
        <div class="meta-item"><span>Max drawdown</span><strong class="text-negative">${fmtPct(data.max_drawdown_pct)}</strong></div>
        <div class="meta-item"><span>Retorno liquido</span><strong class="${Number(data.net_return_pct || 0) >= 0 ? 'text-positive' : 'text-negative'}">${fmtPct(data.net_return_pct)}</strong></div>
      `;
      const trades = Array.isArray(data.trades) ? data.trades : [];
      const tbody = document.getElementById('tradesBody');
      const empty = document.getElementById('emptyState');
      tbody.innerHTML = trades.map(trade => `
        <tr>
          <td>${esc(trade.entry_idx)}</td>
          <td>${esc(trade.exit_idx)}</td>
          <td><span class="badge badge-blue">${esc(trade.strategy)}</span></td>
          <td><span class="badge ${trade.result === 'WIN' ? 'badge-ok' : 'badge-red'}">${esc(trade.result)}</span></td>
          <td class="${Number(trade.pnl_pct || 0) >= 0 ? 'text-positive' : 'text-negative'}">${fmtPct(trade.pnl_pct)}</td>
          <td class="${Number(trade.pnl_usd || 0) >= 0 ? 'text-positive' : 'text-negative'}">${Number(trade.pnl_usd || 0).toFixed(2)}</td>
        </tr>
      `).join('');
      empty.style.display = trades.length ? 'none' : 'flex';
    }
    async function runBacktest() {
      await (window._iahubAuthReady || Promise.resolve());
      const symbol = document.getElementById('symbolInput').value.trim().replace('/', '').toUpperCase() || 'BTCUSDT';
      const timeframe = document.getElementById('timeframeInput').value;
      const limit = Number(document.getElementById('limitInput').value || 300);
      document.getElementById('statusText').textContent = 'executando...';
      try {
        const data = await fetch(`/api/master-crypto/backtest/run?symbol=${encodeURIComponent(symbol)}&timeframe=${encodeURIComponent(timeframe)}&limit=${limit}`).then(r => r.json());
        renderResult(data);
        document.getElementById('statusText').textContent = `${data.symbol || symbol} - ${String(data.timeframe || timeframe).toUpperCase()}`;
      } catch (_) {
        document.getElementById('statusText').textContent = 'backend indisponivel';
        document.getElementById('metaGrid').innerHTML = '<div class="meta-item"><span>Status</span><strong>Falha ao executar</strong></div>';
      }
    }
    window.addEventListener('DOMContentLoaded', runBacktest);
  </script>
</body>
</html>
