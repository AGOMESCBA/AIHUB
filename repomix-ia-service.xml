<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Atendimentos - IA Service</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    :root { --accent:#1d4ed8; --accent-light:#3b82f6; --accent-glow:rgba(29,78,216,.1); }
    .sidebar-logo .logo-icon { background:var(--accent) !important; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;margin-bottom:3px; }
    .page-title { font-size:20px;font-weight:700;color:var(--text-hi);line-height:1.25; }
    .page-subtitle { font-size:13px;color:var(--text-md);margin-top:4px; }
    .page-head { margin-bottom:18px; }
    .composer-actions { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:10px; }
    .composer-hint { font-size:12px; color:var(--text-lo); }
    #anexos-input { font-size:12px; color:var(--text-md); }
    .lista-header { padding:12px 16px; border-bottom:1px solid var(--border); font-size:13px; font-weight:800; color:var(--text-hi); }
    .atendimento-item { padding:12px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:10px; cursor:pointer; transition:background .15s; }
    .atendimento-item:hover { background:var(--bg-hover); }
    .atendimento-item:last-child { border-bottom:none; }
    .atendimento-codigo { font-weight:700; color:var(--accent); font-size:13px; }
    .atendimento-preview { font-size:13px; color:var(--text-md); flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin:0 12px; }
    .atendimento-status { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--text-lo); }
    .empty-state { padding:24px 16px; text-align:center; color:var(--text-lo); font-size:13px; }
    .error-banner { display:none; background:#fee2e2; color:#991b1b; border:1px solid #fecaca; border-radius:8px; padding:10px 12px; font-size:13px; margin-bottom:14px; }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">⚡</div>
      <span class="logo-text">IA Service</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Service ›</span> Atendimentos</span>
    </div>
    <div class="page-content">
      <div class="page-head">
        <div class="page-kicker">Operação</div>
        <div class="page-title">Atendimentos</div>
        <div class="page-subtitle">Cole o conteúdo do chamado e pressione Enter para criar o atendimento. Depois de criado, abra-o para anexar evidências (prints, logs, fonte) e investigar com a IA.</div>
      </div>
      <div id="error-banner" class="error-banner"></div>
      <div class="card" style="margin-bottom:20px">
        <div class="card-body">
          <textarea id="conteudo-bruto" class="form-control" rows="6" placeholder="Cole aqui o conteúdo do chamado..."></textarea>
          <div class="composer-actions">
            <input type="file" id="anexos-input" multiple disabled title="Upload de anexos chega na Etapa 2 — fundação de metadados já implementada no backend">
            <div style="display:flex;align-items:center;gap:10px">
              <span class="composer-hint">Ctrl+Enter para criar</span>
              <button class="btn btn-primary" type="button" onclick="criarAtendimento()">Criar atendimento</button>
            </div>
          </div>
        </div>
      </div>
      <div class="card" style="padding:0;overflow:hidden">
        <div class="lista-header">Atendimentos recentes</div>
        <div id="lista-atendimentos"><div class="empty-state">Carregando…</div></div>
      </div>
    </div>
  </div>
</div>
  <script src="/js/auth.js"></script>
  <script src="/app/ia-service/js/sidebar.js"></script>
  <script>
    function showError(msg) {
      const el = document.getElementById('error-banner');
      el.textContent = msg;
      el.style.display = 'block';
    }
    function hideError() {
      document.getElementById('error-banner').style.display = 'none';
    }
    async function api(path, opts = {}) {
      const r = await fetch(path, {
        headers: { 'Content-Type': 'application/json' },
        ...opts,
      });
      const body = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(body.error || `Erro ${r.status}`);
      return body;
    }
    function empresaIdAtual() {
      return window._iahubEmpresa?.id || null;
    }
    async function carregarAtendimentos() {
      const empresaId = empresaIdAtual();
      if (!empresaId) return;
      try {
        const lista = await api(`/api/ia-service/atendimentos?empresa_id=${empresaId}`);
        const container = document.getElementById('lista-atendimentos');
        if (!lista.length) {
          container.innerHTML = '<div class="empty-state">Nenhum atendimento ainda.</div>';
          return;
        }
        container.innerHTML = lista.map(a => `
          <div class="atendimento-item" onclick="location.href='/app/ia-service/atendimento.html?id=${a.id}'">
            <span class="atendimento-codigo">${a.codigo}</span>
            <span class="atendimento-preview">${escapeHtml(a.conteudoBruto || '')}</span>
            <span class="atendimento-status">${a.status}</span>
          </div>
        `).join('');
      } catch (err) {
        showError('Não foi possível carregar os atendimentos: ' + err.message);
      }
    }
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
    }
    async function criarAtendimento() {
      hideError();
      const empresaId = empresaIdAtual();
      if (!empresaId) return showError('Selecione uma empresa antes de criar um atendimento.');
      const conteudoBruto = document.getElementById('conteudo-bruto').value.trim();
      if (!conteudoBruto) return showError('Cole o conteúdo do chamado antes de criar o atendimento.');
      try {
        const atendimento = await api('/api/ia-service/atendimentos', {
          method: 'POST',
          body: JSON.stringify({ empresa_id: empresaId, conteudoBruto, origem: 'manual' }),
        });
        location.href = `/app/ia-service/atendimento.html?id=${atendimento.id}`;
      } catch (err) {
        showError('Não foi possível criar o atendimento: ' + err.message);
      }
    }
    document.getElementById('conteudo-bruto').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.ctrlKey) {
        e.preventDefault();
        criarAtendimento();
      }
    });
    window._iahubAuthReady?.then(carregarAtendimentos) ?? carregarAtendimentos();
  </script>
</body>
</html>
