<script>
  // Interceptação de clique no menu — mesmo padrão do shell.html do IA
  // Command: abre a rotina numa aba interna em vez de navegar a página
  // inteira. Exceção: itens com target="_blank" (ex. Radar de Chamados,
  // que abre em nova guia do navegador por decisão arquitetural anterior —
  // nunca depende de cookie de sessão cruzando abas) continuam navegando
  // normalmente, sem passar pelo MDI.
  document.addEventListener('click', (e) => {
    const link = e.target.closest('#sidebar a.nav-item');
    if (!link) return;
    if (link.target === '_blank') return; // deixa o navegador abrir a nova guia normalmente
    e.preventDefault();
    const url   = new URL(link.href, location.origin).pathname;
    const label = link.querySelector('.nav-label')?.textContent?.trim() || url;
    const icon  = link.querySelector('.nav-icon')?.textContent?.trim()  || '📄';
    window.openTab(url, label, icon);
    window.closeSidebarDrawer?.();
  });
  // No shell MDI, trocar empresa atualiza todas as abas abertas sem
  // recarregar a janela — auth.js define _trocarEmpresa com
  // location.reload() por padrão; sobrescrevemos aqui (mesmo padrão do
  // shell.html do IA Command).
  window._iahubAuthReady?.then(() => {
    let empresaSwitchQueue = Promise.resolve();
    window._trocarEmpresa = async function (empresa_id) {
      empresaSwitchQueue = empresaSwitchQueue
        .catch(() => null)
        .then(async () => {
          const res = await fetch('/api/empresas/selecionar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ empresa_id, system_code: 'ia-service' }),
          });
          if (!res.ok) return;
          const lista = await fetch('/api/empresas/minhas').then(r => r.json()).catch(() => []);
          const emp = lista.find(e => Number(e.id) === Number(empresa_id));
          if (emp) {
            const empresaNome = emp.razao_social || emp.nome || '';
            window._iahubEmpresa = { id: emp.id, nome: empresaNome };
            window._iahubAtualizarEmpresaBadge?.({ id: emp.id, nome: empresaNome });
            await window.trocarEmpresaTodasAbas?.(emp.id, empresaNome);
          }
          const drop = document.getElementById('_empresa-dropdown');
          if (drop) drop.style.display = 'none';
        });
      return empresaSwitchQueue;
    };
  });
</script>
</body>
</html>
