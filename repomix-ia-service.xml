<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Homologação da IA - IA Service</title>
  <link rel="stylesheet" href="/css/iahub.css">
  <style>
    :root { --accent:#1d4ed8; --accent-light:#3b82f6; --accent-glow:rgba(29,78,216,.1); }
    .sidebar-logo .logo-icon { background:var(--accent) !important; }
    .page-kicker { font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-lo);font-weight:600;margin-bottom:3px; }
    .page-title { font-size:20px;font-weight:700;color:var(--text-hi);line-height:1.25; }
    .page-subtitle { font-size:13px;color:var(--text-md);margin-top:4px; }
    .page-head { margin-bottom:18px; }
    .error-banner { display:none; background:#fee2e2; color:#991b1b; border:1px solid #fecaca; border-radius:8px; padding:10px 12px; font-size:13px; margin-bottom:14px; }
    .filtros-homologacao { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:18px; }
    .filtros-homologacao select { font-size:13px; padding:6px 10px; border:1px solid var(--border); background:var(--bg-card); color:var(--text-hi); border-radius:7px; }
    .cards-resumo { display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:14px; margin-bottom:20px; }
    .card-resumo { padding:16px; }
    .card-resumo-label { font-size:11.5px; color:var(--text-lo); text-transform:uppercase; letter-spacing:.04em; font-weight:700; margin-bottom:6px; }
    .card-resumo-valor { font-size:26px; font-weight:800; color:var(--text-hi); }
    .faixas-distribuicao { display:flex; gap:10px; flex-wrap:wrap; }
    .faixa-badge { display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; font-size:11.5px; font-weight:800; }
    .faixa-EXCELENTE { background:rgba(34,197,94,.14); color:#15803d; border:1px solid rgba(34,197,94,.28); }
    .faixa-BOA { background:rgba(59,130,246,.14); color:#1d4ed8; border:1px solid rgba(59,130,246,.28); }
    .faixa-PARCIAL { background:rgba(234,179,8,.16); color:#854d0e; border:1px solid rgba(234,179,8,.28); }
    .faixa-INSATISFATORIA { background:rgba(239,68,68,.14); color:#b91c1c; border:1px solid rgba(239,68,68,.28); }
    .tabelas-homologacao { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px; margin-bottom:20px; }
    .tabela-homologacao table { width:100%; border-collapse:collapse; font-size:13px; }
    .tabela-homologacao th, .tabela-homologacao td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--border); }
    .tabela-homologacao th { color:var(--text-lo); font-size:11px; text-transform:uppercase; letter-spacing:.03em; }
    .lista-header { padding:12px 16px; border-bottom:1px solid var(--border); font-size:13px; font-weight:800; color:var(--text-hi); }
    .alerta-item { padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:10px; }
    .alerta-item:last-child { border-bottom:none; }
    .alerta-link { font-size:12.5px; color:var(--accent); text-decoration:underline; cursor:pointer; }
    .alerta-detalhe { font-size:12px; color:var(--text-md); }
    .empty-state { padding:24px 16px; text-align:center; color:var(--text-lo); font-size:13px; }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo" onclick="toggleSidebar()">
      <div class="logo-icon">⚡</div>
      <span class="logo-text">IA Service</span>
    </div>
    <div class="sidebar-nav"></div>
    <div class="sidebar-footer"></div>
  </nav>
  <div class="main">
    <div class="topbar">
      <button class="topbar-menu-btn" onclick="toggleSidebar()" title="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="topbar-title"><span style="color:var(--text-lo);font-weight:400">IA Service ›</span> Homologação da IA</span>
    </div>
    <div class="page-content">
      <div class="page-head">
        <div class="page-kicker">Operação</div>
        <div class="page-title">Homologação da IA</div>
        <div class="page-subtitle">Utilidade técnica real das investigações, medida pela avaliação de consultores — independente da aprovação do Quality Gate.</div>
      </div>
      <div id="error-banner" class="error-banner"></div>
      <div class="filtros-homologacao">
        <select id="filtro-provider" onchange="carregarRelatorio()"><option value="">Todos os providers</option></select>
        <select id="filtro-model" onchange="carregarRelatorio()"><option value="">Todos os modelos</option></select>
        <select id="filtro-produto" onchange="carregarRelatorio()"><option value="">Todos os produtos</option></select>
      </div>
      <div class="cards-resumo">
        <div class="card card-resumo">
          <div class="card-resumo-label">Total avaliado</div>
          <div class="card-resumo-valor" id="resumo-total">—</div>
        </div>
        <div class="card card-resumo">
          <div class="card-resumo-label">Média geral (0-25)</div>
          <div class="card-resumo-valor" id="resumo-media">—</div>
        </div>
        <div class="card card-resumo" style="grid-column: span 2">
          <div class="card-resumo-label">Distribuição por faixa</div>
          <div class="faixas-distribuicao" id="resumo-faixas"></div>
        </div>
      </div>
      <div class="tabelas-homologacao">
        <div class="card tabela-homologacao" style="padding:0;overflow:hidden">
          <div class="lista-header">Por provider</div>
          <div id="tabela-provider"><div class="empty-state">Carregando…</div></div>
        </div>
        <div class="card tabela-homologacao" style="padding:0;overflow:hidden">
          <div class="lista-header">Por modelo</div>
          <div id="tabela-model"><div class="empty-state">Carregando…</div></div>
        </div>
        <div class="card tabela-homologacao" style="padding:0;overflow:hidden">
          <div class="lista-header">Por produto</div>
          <div id="tabela-produto"><div class="empty-state">Carregando…</div></div>
        </div>
      </div>
      <div class="card" style="padding:0;overflow:hidden;margin-bottom:16px">
        <div class="lista-header">Aprovadas pelo Quality Gate, mas mal avaliadas pelos consultores</div>
        <div id="lista-qg-mal-avaliadas"><div class="empty-state">Carregando…</div></div>
      </div>
      <div class="card" style="padding:0;overflow:hidden">
        <div class="lista-header">Erro técnico crítico sinalizado</div>
        <div id="lista-erro-critico"><div class="empty-state">Carregando…</div></div>
      </div>
    </div>
  </div>
</div>
  <script src="/js/auth.js"></script>
  <script src="/app/ia-service/js/sidebar.js"></script>
  <script>
    function showError(msg) {
      const el = document.getElementById('error-banner');
      el.textContent = msg;
      el.style.display = 'block';
    }
    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
    }
    async function api(path, opts = {}) {
      const r = await fetch(path, { headers: { 'Content-Type': 'application/json' }, ...opts });
      const body = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(body.error || `Erro ${r.status}`);
      return body;
    }
    function empresaIdAtual() {
      return window._iahubEmpresa?.id || null;
    }
    const ROTULO_FAIXA = { EXCELENTE: 'Excelente', BOA: 'Boa', PARCIAL: 'Parcial', INSATISFATORIA: 'Insatisfatória' };
    function preencherFiltro(selectId, valores, atual) {
      const select = document.getElementById(selectId);
      const atuais = new Set(Array.from(select.options).slice(1).map(o => o.value));
      for (const v of valores) {
        if (!v || atuais.has(v)) continue;
        const opt = document.createElement('option');
        opt.value = v; opt.textContent = v;
        select.appendChild(opt);
        atuais.add(v);
      }
      select.value = atual || '';
    }
    function renderizarTabelaAgrupada(containerId, grupos) {
      const container = document.getElementById(containerId);
      if (!grupos || !grupos.length) {
        container.innerHTML = '<div class="empty-state">Sem avaliações ainda.</div>';
        return;
      }
      container.innerHTML = `
        <table>
          <thead><tr><th>Valor</th><th>Total</th><th>Média (0-25)</th></tr></thead>
          <tbody>
            ${grupos.map(g => `<tr><td>${escapeHtml(g.valor)}</td><td>${g.total}</td><td>${g.media}</td></tr>`).join('')}
          </tbody>
        </table>
      `;
    }
    function renderizarAlertas(containerId, itens, vazio) {
      const container = document.getElementById(containerId);
      if (!itens || !itens.length) {
        container.innerHTML = `<div class="empty-state">${escapeHtml(vazio)}</div>`;
        return;
      }
      container.innerHTML = itens.map(item => `
        <div class="alerta-item">
          <span class="alerta-detalhe">Nota: ${item.notaTotal}/25${item.faixa ? ' · ' + escapeHtml(ROTULO_FAIXA[item.faixa] || item.faixa) : ''}${item.provider ? ' · ' + escapeHtml(item.provider) : ''}${item.observacoes ? ' · ' + escapeHtml(item.observacoes) : ''}</span>
          <a class="alerta-link" href="/app/ia-service/atendimento.html?id=${escapeHtml(item.atendimentoId)}">Abrir atendimento</a>
        </div>
      `).join('');
    }
    async function carregarRelatorio() {
      const empresaId = empresaIdAtual();
      if (!empresaId) return;
      const provider = document.getElementById('filtro-provider').value;
      const model = document.getElementById('filtro-model').value;
      const produto = document.getElementById('filtro-produto').value;
      try {
        const qs = new URLSearchParams({ empresa_id: empresaId });
        if (provider) qs.set('provider', provider);
        if (model) qs.set('model', model);
        if (produto) qs.set('produto', produto);
        const relatorio = await api(`/api/ia-service/homologacao/resumo?${qs.toString()}`);
        document.getElementById('resumo-total').textContent = relatorio.total;
        document.getElementById('resumo-media').textContent = relatorio.mediaGeral;
        const faixas = relatorio.distribuicaoFaixas || {};
        document.getElementById('resumo-faixas').innerHTML = Object.entries(ROTULO_FAIXA).map(([chave, rotulo]) => `
          <span class="faixa-badge faixa-${chave}">${rotulo}: ${faixas[chave] || 0}</span>
        `).join('');
        renderizarTabelaAgrupada('tabela-provider', relatorio.porProvider);
        renderizarTabelaAgrupada('tabela-model', relatorio.porModel);
        renderizarTabelaAgrupada('tabela-produto', relatorio.porProduto);
        renderizarAlertas('lista-qg-mal-avaliadas', relatorio.qgAprovadoMasMalAvaliadas, 'Nenhum caso encontrado — ótimo sinal.');
        renderizarAlertas('lista-erro-critico', relatorio.erroTecnicoCriticoSinalizado, 'Nenhum erro técnico crítico sinalizado.');
        preencherFiltro('filtro-provider', (relatorio.porProvider || []).map(g => g.valor), provider);
        preencherFiltro('filtro-model', (relatorio.porModel || []).map(g => g.valor), model);
        preencherFiltro('filtro-produto', (relatorio.porProduto || []).map(g => g.valor), produto);
      } catch (err) {
        showError('Não foi possível carregar o relatório de homologação: ' + err.message);
      }
    }
    window._iahubAuthReady?.then(carregarRelatorio) ?? carregarRelatorio();
  </script>
</body>
